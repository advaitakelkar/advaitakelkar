# Firebase web config for the /admin console.
# These are PUBLIC values — Firebase web config is designed to ship in the
# client bundle. The apiKey is an identifier, not a secret. What protects the
# visit log is firestore.rules, enforced server-side by Google.
#
# Copy to .env and fill in from:
#   Firebase console -> Project settings -> General -> Your apps -> Web app -> Config
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=advaitakelkar-site.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=advaitakelkar-site
PUBLIC_FIREBASE_STORAGE_BUCKET=advaitakelkar-site.appspot.com
PUBLIC_FIREBASE_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=

# The one account allowed to read the console. /admin shows a password field
# only; this email is never typed.
PUBLIC_ADMIN_EMAIL=advaitakelkar@gmail.com
