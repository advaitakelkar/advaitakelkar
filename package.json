{
  "name": "advaitakelkar-website",
  "type": "module",
  "version": "1.0.0",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "node scripts/build-project-thumbnails.mjs && astro dev",
    "build": "node scripts/build-project-thumbnails.mjs && astro build",
    "preview": "astro preview",
    "sync": "astro sync",
    "sync-notion": "node scripts/sync_from_notion.cjs",
    "sync-to-notion": "node scripts/sync_to_notion.cjs",
    "shoot": "node scripts/shoot.mjs",
    "lint:bp": "node scripts/lint-breakpoints.mjs",
    "lint:glyphs": "node scripts/lint-glyphs.mjs",
    "lint:icons": "node scripts/lint-icons.mjs",
    "lint": "pnpm lint:bp && pnpm lint:glyphs && pnpm lint:icons",
    "images:projects": "node scripts/build-project-thumbnails.mjs",
    "audit:jev": "node scripts/jev-audit.mjs",
    "book:pdf": "node scripts/sync-powerhouse-pdf.mjs",
    "audit:site": "python3 scripts/audit-built-site.py",
    "audit:responsive": "node scripts/shoot.mjs --check",
    "check": "pnpm lint && pnpm audit:editor && pnpm build && pnpm audit:site",
    "audit:deps": "pnpm audit",
    "audit:editor": "node scripts/audit-editor.mjs"
  },
  "dependencies": {
    "astro": "^7.4.4",
    "d3": "7.9.0",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "firebase": "^13.1.0",
    "maplibre-gl": "^6.16.0"
  },
  "devDependencies": {
    "@astrojs/react": "^7.1.2",
    "@keystar/ui": "~0.10.0",
    "@keystatic/astro": "^6.0.0",
    "@keystatic/core": "^0.6.9",
    "@mapbox/vector-tile": "^3.0.0",
    "@turf/bbox-clip": "^7.4.0",
    "@types/d3": "7.4.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "d3-geo": "^3.1.1",
    "js-yaml": "^4.3.2",
    "mapshaper": "^0.7.101",
    "pbf": "^5.1.2",
    "playwright": "^1.64.1",
    "react": "^19.2.7",
    "react-aria": "3.50.0",
    "react-dom": "^19.2.7",
    "react-stately": "3.48.0",
    "topojson-client": "^3.1.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "pnpm": {
    "overrides": {
      "vite>esbuild": "0.28.1",
      "@firebase/firestore>@grpc/grpc-js": "1.14.7",
      "@keystatic/core>minimatch": "11.0.1"
    }
  }
}
