---
import Base from './Base.astro';
import SideNav from '../components/SideNav.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import WayfindingNav from '../components/WayfindingNav.astro';
import Footer from '../components/Footer.astro';
import SiteLock from '../components/SiteLock.astro';
import EditMode from '../components/EditMode.astro';

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  crumbs?: Array<{ label: string; href?: string }>;
  label?: string;
  sections?: Array<{ id: string; label: string }>;
  showFooter?: boolean;
  /** Forwarded to Base — keeps /admin out of search results. */
  noindex?: boolean;
  categoryId?: string;
  /** Project ids to highlight in the footer pill cloud (others dim). */
  activeIds?: string[];
}

const { title, description, ogImage, crumbs = [], label, sections, showFooter = true, categoryId, activeIds, noindex = false } = Astro.props;
const currentPath = Astro.url.pathname;
---

<Base title={title} description={description} ogImage={ogImage} noindex={noindex}>
  <div class="page-wrap">
    <SideNav currentPath={currentPath} />

    <main class:list={["page-main", sections && "page-main--has-wayfinding"]}>
      <div class="page-breadcrumb">
        <Breadcrumb currentPath={currentPath} />
      </div>
      <slot />
      {showFooter && <Footer categoryId={categoryId} activeIds={activeIds} />}
      {sections && <WayfindingNav sections={sections} />}
    </main>
  </div>
  <SiteLock />
  <EditMode />
</Base>

<script>
  // Scrolled-state marker for the fixed breadcrumb bar (hairline in CSS above).
  const bar = document.querySelector('.page-breadcrumb');
  if (bar) {
    const onScroll = () => bar.classList.toggle('is-scrolled', window.scrollY > 8);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  // ── Desktop chrome: no rail ───────────────────────────────────
  // From 1024 up the colour swatches take the top bar's right end, where
  // Pages was, and Pages docks at the right end of the Quick Search bar.
  // Both are the same elements, moved — their listeners come with them —
  // and both go home again below 1024, where the bottom dock owns Pages
  // and there are no swatches. A page with no such bar (Admin) keeps Pages
  // in the top bar, after the swatches.
  const scheme   = document.getElementById('sn-scheme');
  const pages    = document.getElementById('breadcrumb-custom-dropdown');
  const rightNav = document.querySelector('.breadcrumb__project-nav');
  // Whichever bar carries data-pages-dock: the footer's Quick Search, or on
  // the projects page its own search, which takes the footer's place.
  const qsBar    = document.querySelector('[data-pages-dock]');
  if (scheme && pages && rightNav) {
    const schemeHome = { parent: scheme.parentElement!, next: scheme.nextSibling };
    const pagesHome  = { parent: pages.parentElement!,  next: pages.nextSibling };
    const mq = window.matchMedia('(min-width: 1024px)');

    const apply = () => {
      if (mq.matches) {
        scheme.classList.add('sn-scheme--inline');
        rightNav.prepend(scheme);
        if (qsBar) {
          qsBar.append(pages);
          pages.classList.add('is-docked');
          document.documentElement.setAttribute('data-pages-docked', '');
        }
      } else {
        scheme.classList.remove('sn-scheme--inline');
        schemeHome.parent.insertBefore(scheme, schemeHome.next);
        pagesHome.parent.insertBefore(pages, pagesHome.next);
        pages.classList.remove('is-docked');
        document.documentElement.removeAttribute('data-pages-docked');
      }
    };
    apply();
    mq.addEventListener('change', () => {
      (window as any).closeBreadcrumbDropdown?.();
      apply();
    });

    // Docked, the list opens toward the larger gap. Capture phase, so the side
    // is set before Breadcrumb's own click handler opens the panel.
    document.getElementById('breadcrumb-dropdown-trigger')?.addEventListener('click', () => {
      if (!pages.classList.contains('is-docked')) return;
      const r = pages.getBoundingClientRect();
      const above = r.top - 72;                        // clear the top bar
      const below = window.innerHeight - r.bottom - 16;
      const side = below > above ? 'below' : 'above';
      pages.dataset.side = side;
      pages.style.setProperty('--bc-dock-room', `${Math.max(160, side === 'below' ? below : above)}px`);
    }, { capture: true });
  }
</script>

<style>
  .page-wrap {
    display: flex;
    min-height: 100dvh;
    position: relative;
    z-index: 1;
  }

  .page-main {
    flex: 1;
    min-width: 0; /* allow flex child to shrink; prevents slider min-content from blowing out page width */
    margin-left: var(--_tokens---layout--nav);
    padding: 0;
    /* The gutter is fluid at every width now, so it applies unconditionally.
       It used to be space--small here and layout--gutter only above 1200px,
       which is what made the page inset jump 48px -> 154px in one step. */
    padding-inline: var(--_tokens---layout--gutter);
    transition: padding var(--_tokens---motion--base) ease;
  }

  @media (min-width: 700px) and (max-width: 1365.98px) {
    .page-main--has-wayfinding {
      padding-right: 2rem;
    }
  }



  /* Fixed global breadcrumb bar */
  .page-breadcrumb {
    position: fixed;
    top: 0;
    left: var(--_tokens---layout--nav);
    right: 0;
    z-index: 100;
    background-color: var(--_tokens---color--bg);
    /* Match the content gutter below (.page-main) so the nav pills line up with
       the page text at every breakpoint, instead of hugging closer at 16px. */
    padding-inline: var(--_tokens---layout--gutter);
    padding-block: 14px 12px;
    border-bottom: 1px solid transparent;
    transition: background-color var(--_tokens---motion--base) ease,
                border-color var(--_tokens---motion--base) ease;
  }
  /* With the rail hidden below 700 (see SideNav), the page and the breadcrumb
     take back the 44px that was reserved for it. Placed after both rules it
     overrides — same classes, same specificity, source order decides. */


  /* Top-docked bands only (>= 1024px): below 1024px the bar sits at the bottom and already carries a border-top. */
  @media (min-width: 1024px) {
    .page-breadcrumb.is-scrolled {
      border-bottom-color: var(--_tokens---color--line-soft);
    }
  }

  @media (min-width: 1366px) {
    .page-breadcrumb {
      padding-top: 14px;
    }
  }
 
  /* Phone and Tablet docking on bottom */
  @media (max-width: 1023.98px) {
    .page-main {
      padding-bottom: calc(var(--_tokens---layout--bar, 52px) + 24px);
    }

    .page-breadcrumb {
      position: fixed !important;
      bottom: 0 !important;
      top: auto !important;
      left: var(--_tokens---layout--nav) !important;
      right: 0 !important;
      padding-inline: 12px !important;
      padding-top: 12px !important;
      padding-bottom: max(12px, env(safe-area-inset-bottom)) !important;
      background-color: var(--_tokens---color--bg) !important;
      border-top: 1px solid var(--_tokens---color--line-soft) !important; /* matches the page-heading hairline */
      z-index: 150 !important;
      transition: transform var(--_tokens---motion--base) ease;
    }
    /* While the keyboard is up the dock is behind it — unreachable, and
       taking a band of screen off the list you are filtering. It steps out
       and comes back when the field is dismissed. */
    :global(html[data-kb="open"]) .page-breadcrumb {
      transform: translateY(100%);
    }
  }

  /* Tablet only: floating navigation pill dock (not full width) */
  @media (min-width: 700px) and (max-width: 1023.98px) {
    .page-breadcrumb {
      left: 50% !important;
      right: auto !important;
      transform: translateX(-50%) !important;
      bottom: 18px !important;
      width: auto !important;
      min-width: 380px !important;
      max-width: calc(100vw - 32px) !important;
      border: 1px solid var(--_tokens---color--line-soft) !important;
      border-radius: var(--_tokens---radius--pill) !important;
      padding: 8px 14px !important;
      box-shadow: 0 4px 24px rgba(0, 0, 0, 0.08) !important;
    }

    :global(html[data-kb="open"]) .page-breadcrumb {
      transform: translate(-50%, calc(100% + 40px)) !important;
    }
  }
</style>
