---
import Base from './Base.astro';
import SideNav from '../components/SideNav.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import WayfindingNav from '../components/WayfindingNav.astro';
import Footer from '../components/Footer.astro';
import SiteLock from '../components/SiteLock.astro';
import EditMode from '../components/EditMode.astro';

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  crumbs?: Array<{ label: string; href?: string }>;
  label?: string;
  sections?: Array<{ id: string; label: string }>;
  showFooter?: boolean;
  categoryId?: string;
  /** Project ids to highlight in the footer pill cloud (others dim). */
  activeIds?: string[];
}

const { title, description, ogImage, crumbs = [], label, sections, showFooter = true, categoryId, activeIds } = Astro.props;
const currentPath = Astro.url.pathname;
---

<Base title={title} description={description} ogImage={ogImage}>
  <div class="page-wrap">
    <SideNav currentPath={currentPath} />

    <main class:list={["page-main", sections && "page-main--has-wayfinding"]}>
      <div class="page-breadcrumb">
        <Breadcrumb currentPath={currentPath} />
      </div>
      <slot />
      {showFooter && <Footer categoryId={categoryId} activeIds={activeIds} />}
      {sections && <WayfindingNav sections={sections} />}
    </main>
  </div>
  <SiteLock />
  <EditMode />
</Base>

<style>
  .page-wrap {
    display: flex;
    min-height: 100dvh;
    position: relative;
    z-index: 1;
  }

  .page-main {
    flex: 1;
    min-width: 0; /* allow flex child to shrink; prevents slider min-content from blowing out page width */
    margin-left: 44px; /* Offset adjusted for 44px wide sidebar */
    padding: 0;
    /* The gutter is fluid at every width now, so it applies unconditionally.
       It used to be space--small here and layout--gutter only above 1200px,
       which is what made the page inset jump 48px -> 154px in one step. */
    padding-inline: var(--_tokens---layout--gutter);
    transition: padding 0.3s ease;
  }

  @media (min-width: 700px) and (max-width: 1365.98px) {
    .page-main--has-wayfinding {
      padding-right: 2rem;
    }
  }

  /* Clear the fixed breadcrumb bar in the medium band.
     Below 700px the bar docks to the bottom, so nothing is needed; from
     1024px up each page's own desktop rules already allow for it. In between
     neither applied, and every page title sat underneath the bar — the
     ladder made that gap visible on six routes at once, so the clearance
     belongs here rather than being re-guessed per page. */
  @media (min-width: 700px) and (max-width: 1023.98px) {
    .page-main {
      padding-top: var(--_tokens---layout--bar);
    }
  }

  /* Fixed global breadcrumb bar */
  .page-breadcrumb {
    position: fixed;
    top: 0;
    left: 44px;
    right: 0;
    z-index: 100;
    background-color: var(--_tokens---color--bg);
    /* Match the content gutter below (.page-main) so the nav pills line up with
       the page text at every breakpoint, instead of hugging closer at 16px. */
    padding-inline: var(--_tokens---layout--gutter);
    padding-block: 14px 12px;
    transition: background-color 0.3s ease;
  }

  @media (min-width: 1366px) {
    .page-breadcrumb {
      padding-top: 14px;
    }
  }
 
  /* Mobile Portrait docking on bottom */
  @media (max-width: 699.98px) {
    .page-breadcrumb {
      position: fixed !important;
      bottom: 0 !important;
      top: auto !important;
      left: 44px !important;
      right: 0 !important;
      padding-inline: 12px !important;
      padding-block: 12px !important;
      background-color: var(--_tokens---color--bg) !important;
      border-top: 1px solid var(--_tokens---color--line-soft) !important; /* matches the page-heading hairline */
      box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.15);
      z-index: 150 !important;
    }
  }
</style>
