    "mediumUp": "(min-width: 700px)",
    "mediumDown": "(max-width: 1023.98px)",
    "expandedUp": "(min-width: 1024px)",
    "expandedDown": "(max-width: 1365.98px)",
    "wideUp": "(min-width: 1366px)"
