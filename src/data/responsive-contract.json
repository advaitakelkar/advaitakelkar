  "readingSelectors": [
    ".home-intro__desc",
    ".about-bio__text p",
    ".work-article__text p",
    ".work-proposition > p:not(.work-proposition__brief)",
    ".design-brief__abstract p",
    ".project-card__desc p",
    ".ph__intro p:not(.ph__kicker):not(.ph__intro-claim)",
    ".ph__read-text p",
    ".ph__book-body p"
  ],
  "minimumReadingSize": 16,
  "minimumReadingLineHeight": 1.5,
  "touchSelectors": [
    ".read-more",
    ".page-breadcrumb button",
    ".page-breadcrumb a",
    ".vg-toolbar > a",
    ".vg-toolbar .vg-dropdown > summary",
    ".filter-bar button"
  ],
  "minimumTouchSize": 44,
  "fixedControlSelectors": [
    ".page-breadcrumb",
    ".projects-page .filter-bar",
    ".projects-search-bar"
  ],
  "minimumReadingSamples": {
    "home": 2,
    "about": 1,
    "work-article": 1,
    "work-drawings": 1,
    "work-intro": 1,
    "ai-portrait": 1,
    "ai-landscape": 1,
    "study": 1,
    "study-chapters": 1,
    "exhibition": 1,
    "powerhouse": 1,
    "bom-mum": 1
  },
  "readySelectors": {
    "home": "#slider-track:not([data-pending]) .home-slider__slide.is-active"
  }
}
