---
/**
 * Scramble alphabet preview — dev reference, not linked from anywhere.
 * Visit /glyphs to see every group and watch the effect on real headings.
 */
import Base from '../layouts/Base.astro';
import { GLYPH_GROUPS, GLYPHS } from '../lib/glyphs';

const groups = Object.entries(GLYPH_GROUPS).map(([name, chars]) => ({
  name,
  chars: [...chars],
}));
---

<Base title="Glyphs">
  <main class="gp">
    <header class="gp__head">
      <h1 class="gp__title" data-scramble>Scramble Alphabet</h1>
      <p class="gp__lede">
        {GLYPHS.length} symbols across {groups.length} density bands — no
        letterforms, and every one inside Inter's <code>latin</code> subset,
        which is already loaded at first paint. Widths span 9.25px to 11.89px
        against a 10.96px average letter, so substituted glyphs barely move
        the text they replace. Hover anything below to scramble it.
      </p>
    </header>

    <section class="gp__demo">
      <h2 class="gp__sub">On real headings</h2>
      <p class="gp__hint">Hover each line.</p>
      <div class="gp__lines">
        <p class="gp__line gp__line--xl" data-scramble>Architectural Designer</p>
        <p class="gp__line gp__line--lg" data-scramble>Professional Journey</p>
        <p class="gp__line gp__line--md" data-scramble>Advaita Kelkar</p>
        <p class="gp__line gp__line--sm" data-scramble>Master of Architecture · SCAD '27 · Mumbai</p>
      </div>
    </section>

    <section class="gp__demo">
      <h2 class="gp__sub">The alphabet</h2>
      <div class="gp__groups">
        {groups.map((g) => (
          <div class="gp__group">
            <div class="gp__group-head">
              <span class="gp__group-name">{g.name}</span>
              <span class="gp__group-meta">{g.chars.length}</span>
            </div>
            <div class="gp__cells">
              {g.chars.map((c) => (
                <span class="gp__cell" title={`U+${c.codePointAt(0)!.toString(16).toUpperCase().padStart(4, '0')}`}>{c}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="gp__demo">
      <h2 class="gp__sub">Coverage</h2>
      <p class="gp__hint">
        Checked in the browser, because the unicode-range table cannot answer
        this — a codepoint inside <code>latin</code> is not a promise that Inter
        ships a glyph for it. <code>‡</code> U+2021 sat in this set silently
        rendering in a fallback serif until this check existed.
      </p>
      <p class="gp__coverage" id="gp-coverage">checking…</p>
    </section>
  </main>
</Base>

<script>
  /**
   * Per-glyph coverage test. If Inter has the glyph, its advance width is the
   * same whichever fallback follows it in the stack; if Inter lacks it, each
   * stack resolves to a different fallback and the widths diverge.
   */
  import { GLYPHS } from '../lib/glyphs';

  const out = document.getElementById('gp-coverage');
  if (out) {
    document.fonts.ready.then(() => {
      const ctx = document.createElement('canvas').getContext('2d')!;
      const width = (ch: string, stack: string) => {
        ctx.font = `500 40px ${stack}`;
        return ctx.measureText(ch).width;
      };
      const missing = [...GLYPHS].filter((ch) => {
        const a = width(ch, 'Inter, serif');
        const b = width(ch, 'Inter, monospace');
        const c = width(ch, 'Inter, cursive');
        return !(a === b && b === c);
      });
      if (missing.length) {
        out.dataset.state = 'fail';
        out.textContent =
          `${missing.length} glyph(s) NOT in Inter — falling back to another face: ` +
          missing.map((c) => `${c} (U+${c.codePointAt(0)!.toString(16).toUpperCase().padStart(4, '0')})`).join(', ');
      } else {
        out.dataset.state = 'ok';
        out.textContent = `All ${[...GLYPHS].length} glyphs render in Inter. No fallback, no tofu.`;
      }
    });
  }
</script>

<style>
  .gp {
    padding-block: 40px 120px;
    display: flex;
    flex-direction: column;
    gap: 56px;
  }
  .gp__head { display: flex; flex-direction: column; gap: 12px; }
  .gp__coverage {
    font-size: var(--_tokens---type--micro);
    margin: 0;
    padding: 10px 14px;
    border: 1px solid var(--_tokens---color--line-soft);
    border-radius: var(--_tokens---radius--small);
    color: var(--_tokens---color--muted);
  }
  .gp__coverage[data-state='ok']   { border-color: color-mix(in srgb, var(--_tokens---color--fg) 22%, transparent); }
  .gp__coverage[data-state='fail'] {
    border-color: var(--_tokens---color--fg);
    border-width: 2px;
    color: var(--_tokens---color--fg);
    font-weight: 500;
  }
  .gp__title { font-size: var(--_tokens---type--big); font-weight: 500; letter-spacing: -0.03em; margin: 0; }
  .gp__lede {
    font-size: var(--_tokens---type--micro);
    color: var(--_tokens---color--muted);
    max-width: 46rem;
    margin: 0;
    line-height: 1.6;
  }
  .gp__sub {
    font-size: var(--_tokens---type--micro);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--_tokens---color--muted);
    font-weight: 500;
    margin: 0 0 4px;
  }
  .gp__hint {
    font-size: var(--_tokens---type--ultrathin);
    color: var(--_tokens---color--muted);
    margin: 0 0 20px;
  }

  .gp__lines { display: flex; flex-direction: column; gap: 20px; }
  .gp__line { margin: 0; cursor: default; letter-spacing: -0.02em; }
  .gp__line--xl { font-size: var(--_tokens---type--big); font-weight: 500; }
  .gp__line--lg { font-size: var(--_tokens---type--medium); font-weight: 500; }
  .gp__line--md { font-size: var(--_tokens---type--small); }
  .gp__line--sm { font-size: var(--_tokens---type--micro); color: var(--_tokens---color--muted); }

  .gp__groups {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: 28px 32px;
  }
  .gp__group { display: flex; flex-direction: column; gap: 10px; min-width: 0; }
  .gp__group-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    padding-bottom: 6px;
    border-bottom: 1px solid var(--_tokens---color--line-soft);
  }
  .gp__group-name {
    font-size: var(--_tokens---type--ultrathin);
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--_tokens---color--fg);
  }
  .gp__group-meta {
    font-size: var(--_tokens---type--ultrathin);
    color: var(--_tokens---color--muted);
    white-space: nowrap;
  }
  .gp__cells { display: flex; flex-wrap: wrap; gap: 4px; }
  .gp__cell {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 34px;
    height: 34px;
    padding-inline: 4px;
    border: 1px solid var(--_tokens---color--line-soft);
    border-radius: var(--_tokens---radius--small);
    font-size: 17px;
    line-height: 1;
  }
</style>
