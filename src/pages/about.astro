<script>
  import { GLYPHS as SCRAMBLE_GLYPHS } from '../lib/glyphs';
  import { initBubbleRows } from '../lib/bubbleRows';
  import { shuffleWithinGroups } from '../lib/random';

  // --- Career Cards: click opens/closes ---
  document.querySelectorAll('.about-card').forEach((card) => {
    const el = card as HTMLElement;
    el.addEventListener('click', (e) => {
      // Prevent toggling if clicking a link or button inside the card
      if ((e.target as HTMLElement).closest('a, button')) return;
      el.classList.toggle('is-open');
    });
  });

  // --- Biography Read More Toggle ---
  const readMoreBtn = document.getElementById('bio-read-more-btn');
  const collapsedContent = document.getElementById('bio-collapsed-content');
  const portfolioStatus = document.getElementById('about-portfolio-status');

  portfolioStatus?.addEventListener('click', () => {
    const expanded = portfolioStatus.getAttribute('aria-expanded') !== 'true';
    portfolioStatus.setAttribute('aria-expanded', String(expanded));
    const status = portfolioStatus.querySelector<HTMLElement>('.about-link-row__status');
    if (status) status.hidden = !expanded;
  });
  
  const toggleBio = () => {
    if (collapsedContent && readMoreBtn) {
      const isHidden = collapsedContent.style.display === 'none';
      collapsedContent.style.display = isHidden ? 'block' : 'none';
      const span = readMoreBtn.querySelector('span');
      if (span) span.textContent = isHidden ? 'Read Less' : 'Read More';
    }
  };

  readMoreBtn?.addEventListener('click', toggleBio);
  collapsedContent?.addEventListener('click', toggleBio);

  // --- Tab Switching ---
  const tabs = document.querySelectorAll('.about-tab-btn');
  const panels = document.querySelectorAll('.about-tab-panel');
  const careerSection = document.getElementById('panel-career-section');

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const target = (tab as HTMLElement).dataset.tab;
      
      tabs.forEach((t) => {
        const isMatched = t === tab;
        t.classList.toggle('is-active', isMatched);
        t.setAttribute('aria-selected', String(isMatched));
      });

      panels.forEach((p) => {
        const isMatched = p.id === `panel-${target}`;
        const panelEl = p as HTMLElement;
        if (isMatched) {
          panelEl.style.display = 'flex';
          panelEl.offsetHeight; // Reflow
          panelEl.classList.add('is-active');
        } else {
          panelEl.classList.remove('is-active');
          panelEl.style.display = 'none';
        }
      });

      // A swipe can select a pill that is scrolled off the row, so bring it
      // back. `nearest` means a pill already in view does not move the page.
      if (window.matchMedia('(max-width: 699.98px)').matches) {
        (tab as HTMLElement).scrollIntoView({ block: 'nearest', inline: 'nearest' });
      }

      if (careerSection) {
        if (window.matchMedia('(max-width: 699.98px)').matches) {
          // Hold the scroll. The titles are docked, so switching sections
          // changes only what is between them — moving the page as well
          // costs you the place you were reading from, and swiping through
          // four sections would walk the page back to the top each time.
        } else if (window.matchMedia('(max-width: 1023.98px)').matches) {
          const y = careerSection.getBoundingClientRect().top + window.pageYOffset - 48;
          window.scrollTo({ top: y, behavior: 'smooth' });
        } else {
          careerSection.scrollTop = 0;
        }
      }
    });
  });

  // --- Journey: swipe between its four sections ----------------------
  // The pills are a row on the phone and the sections behind them are a
  // sequence, so the gesture the row already looks like should move through
  // it. Horizontal only: a swipe that is mostly vertical is the page being
  // scrolled, and a short one is a tap that wandered.
  const careerPanel = document.getElementById('about-career-panel');
  if (careerPanel && tabs.length > 1) {
    const MIN = 48;   // px of travel before it counts as a swipe
    let x0 = 0, y0 = 0, tracking = false;

    careerPanel.addEventListener('touchstart', (e) => {
      if (e.touches.length !== 1) { tracking = false; return; }
      x0 = e.touches[0].clientX;
      y0 = e.touches[0].clientY;
      tracking = true;
    }, { passive: true });

    careerPanel.addEventListener('touchend', (e) => {
      if (!tracking) return;
      tracking = false;
      const t = e.changedTouches[0];
      const dx = t.clientX - x0;
      const dy = t.clientY - y0;
      if (Math.abs(dx) < MIN || Math.abs(dx) <= Math.abs(dy)) return;
      // A sideways drag inside the pill row is that row scrolling, not a
      // section change.
      if ((t.target as HTMLElement)?.closest?.('.about-tabs-container')) return;
      const list = Array.from(tabs) as HTMLElement[];
      const at = list.findIndex((b) => b.classList.contains('is-active'));
      // Swipe left to go forward, the way a deck of cards reads.
      const next = at + (dx < 0 ? 1 : -1);
      if (next < 0 || next >= list.length) return;
      list[next].click();
    }, { passive: true });
  }

  // --- Skillset cloud: same row engine as the footer's project cloud ---
  const skillCloud = document.getElementById('skillset-cloud');
  if (skillCloud) {
    /* Reshuffle the skills inside each category on every load, the way the
       footer's project cloud reshuffles — the labels are the fixed points, so
       "Languages" always leads its own group but Hindi / Marathi / English
       arrive in a different order each time. Must run before the row engine
       measures, or it would pack the pre-shuffle order. */
    shuffleWithinGroups(skillCloud, (el) => el.hasAttribute('data-static'));

    const rows = initBubbleRows({ grid: skillCloud, pillSelector: '.skill-pill' });
    rows.build();

    /* Search REDUCES the cloud rather than dimming it. Typing "hindi" leaves
       "Languages / Hindi" and nothing else, so the answer is the only thing
       on screen instead of one lit pill among fifty greyed ones. The rows
       repack each keystroke, and because the cloud is column-reverse on the
       phone the stack collapses DOWNWARD, toward the field you are typing in.

       A group's label survives only if one of its skills matched, and it is
       never the match on its own — it is the heading that makes "Hindi" mean
       something. Each pill's data-keywords already carries its category, so
       typing a category name matches all of its skills and the whole group
       stays.

       The pills that drop out are MOVED to a detached holder, not hidden in
       place: the row engine ends its pass with `innerHTML = ''`, so anything
       still inside the cloud when it runs is destroyed, and a filtered pill
       has to come back when the query changes. */
    const allSkillPills = Array.from(skillCloud.querySelectorAll<HTMLElement>('.skill-pill'));
    const skillStash = document.createElement('div');
    skillStash.hidden = true;
    skillCloud.parentElement?.appendChild(skillStash);

    const skillSearch = document.getElementById('skill-search') as HTMLInputElement | null;
    const applySearch = (raw: string) => {
      const q = raw.trim().toLowerCase();
      skillCloud.classList.toggle('has-search', !!q);

      const keep = new Set<HTMLElement>();
      if (!q) {
        allSkillPills.forEach((p) => keep.add(p));
      } else {
        // Walk in DOM order: a label opens a group, the pills after it are
        // its members, and the next label closes it.
        let label: HTMLElement | null = null;
        let group: HTMLElement[] = [];
        const close = () => {
          const hits = group.filter((p) => (p.dataset.keywords ?? '').includes(q));
          hits.forEach((p) => keep.add(p));
          if (label && hits.length) keep.add(label);
        };
        allSkillPills.forEach((p) => {
          if (p.hasAttribute('data-static')) { close(); label = p; group = []; }
          else group.push(p);
        });
        close();
      }

      // Restore the full order first, so the engine packs the groups in the
      // order they are written rather than the order they last survived in.
      allSkillPills.forEach((p) => (keep.has(p) ? skillCloud : skillStash).appendChild(p));
      rows.rebuild();
    };
    /* The search lives in the header, outside the collapsible panel, so it
       stays usable when the section is shut. Typing therefore has to open it
       — otherwise you would be filtering a cloud you cannot see. The toggle
       in Base.astro owns the open/close animation, so ask it rather than
       setting max-height here and fighting it. */
    const skillToggle = document.querySelector<HTMLButtonElement>('[data-page-toggle="skillset-panel"]');
    const openSkillset = () => {
      if (skillToggle?.getAttribute('aria-expanded') === 'false') skillToggle.click();
    };

    skillSearch?.addEventListener('input', () => {
      if (skillSearch.value.trim()) openSkillset();
      applySearch(skillSearch.value);
    });

    /* Ask the toggle whether the section is open rather than inferring it
       from a measured width: a collapsed panel measures zero and the engine
       would pack every pill onto its own row. */
    const skillsetOpen = () => skillToggle?.getAttribute('aria-expanded') !== 'false';

    const skillPanel = document.getElementById('skillset-panel');
    skillPanel?.addEventListener('transitionend', (e) => {
      if ((e as TransitionEvent).propertyName !== 'max-height') return;
      if (skillsetOpen() && !skillCloud.querySelector('.qs-row')) rows.rebuild();
    });

    let skillResizeTimer: number | undefined;
    window.addEventListener('resize', () => {
      window.clearTimeout(skillResizeTimer);
      skillResizeTimer = window.setTimeout(() => {
        // Skip while collapsed; the transitionend above rebuilds on reopen.
        // applySearch repacks, so calling rebuild as well would do it twice.
        if (skillsetOpen()) applySearch(skillSearch?.value ?? '');
      }, 180);
    });
  }

  // (Removed: the JS "dynamic stack" pill row-builder that measured and
  // force-set pill widths — it was stretching every pill into a full-width
  // bar. The pills now flow naturally via flex-wrap, like the footer.)

  // --- Active Status Scramble Loop ---
  let activeStatusIntervals: number[] = [];
  let activeStatusFrames: number[] = [];

  function initActiveStatus() {
    activeStatusIntervals.forEach(clearTimeout);
    activeStatusFrames.forEach(cancelAnimationFrame);
    activeStatusIntervals = [];
    activeStatusFrames = [];

    const activeElements = document.querySelectorAll('.active-status-text');
    if (!activeElements.length) return;

    const GLYPHS = SCRAMBLE_GLYPHS;
    const targetText = 'ACTIVE';
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    activeElements.forEach((el, idx) => {
      const activeEl = el as HTMLElement;

      // Disable the looping scramble on mobile, or when the OS asks for reduced motion
      if (reduceMotion || window.matchMedia('(max-width: 699.98px)').matches) {
        activeEl.textContent = 'ACTIVE';
        return;
      }
      
      function scramble() {
        let frame = 0;
        const length = targetText.length;
        const queue: Array<{ from: string; to: string; start: number; end: number; char?: string }> = [];
        
        for (let i = 0; i < length; i++) {
          const start = Math.floor(Math.random() * 8);
          const end = start + Math.floor(Math.random() * 12) + 4;
          queue.push({ from: '', to: targetText[i], start, end });
        }
        
        function tick() {
          let output = '';
          let complete = 0;
          
          for (let i = 0; i < length; i++) {
            let { to, start, end, char } = queue[i];
            if (frame >= end) {
              complete++;
              output += to;
            } else if (frame >= start) {
              if (!char || Math.random() < 0.28) {
                char = GLYPHS[Math.floor(Math.random() * GLYPHS.length)];
                queue[i].char = char;
              }
              output += char;
            } else {
              output += ' ';
            }
          }
          
          activeEl.textContent = output;
          
          if (complete === length) {
            activeEl.textContent = targetText;
            activeStatusIntervals[idx] = window.setTimeout(scramble, 2000);
          } else {
            frame++;
            activeStatusFrames[idx] = requestAnimationFrame(tick);
          }
        }
        
        tick();
      }
      
      scramble();
    });
  }

  // (Name click-to-scroll-top removed — the name is now a collapse toggle;
  //  the arrow button collapses the about grid via the global page-toggle wiring.)

  document.addEventListener('astro:after-swap', () => {
      initActiveStatus();
    setupScrollToTop();
  });

  // ── Phone: three sections, one open, the closed ones docked ─────────
  // Education, Journey and Skillset. Exactly one is open; the closed rows
  // above it stack at the TOP of the screen and the closed rows below it
  // stack at the BOTTOM, above the nav bar. So all three titles are on
  // screen however far you scroll, and each one stays on the side of the
  // open section it lives on — the order never changes, and a title is
  // always where you last saw it.
  //
  // It is `position: sticky` doing the work, not a fixed bar: a docked row
  // occupies its own place in the flow and only pins once the scroll reaches
  // it, so nothing has to be reserved for it and the page reads normally
  // when it is short. The offsets ARE computed, because they are sums of
  // measured row heights and the bottom stack also clears the nav dock,
  // whose height moves with the device's safe area.
  function initAboutPhonePanels() {
    const page = document.querySelector('.about-page') as HTMLElement | null;
    if (!page) return;
    const phone = window.matchMedia('(max-width: 699.98px)');

    // The search filters the pills, so on the phone it belongs with them
    // rather than parked in the closed row — a closed section there is drawn
    // as a project row, and a field sitting in one reads as chrome. Above 700
    // it goes back to the header, where it stays reachable while the section
    // is shut. Moved, not duplicated: one input, one listener, one value.
    const search = document.getElementById('skill-search');
    const searchHome = search?.parentElement ?? null;
    const searchSlot = document.getElementById('skillset-panel-search');
    function placeSearch() {
      if (!search) return;
      const target = phone.matches ? searchSlot : searchHome;
      if (target && search.parentElement !== target) target.prepend(search);
    }

    function measure() {
      if (!phone.matches) {
        page!.style.removeProperty('--ab-dock-h');
        return;
      }
      // The nav bar's height moves with the device's safe area.
      const dock = document.querySelector('.page-breadcrumb');
      page!.style.setProperty('--ab-dock-h', Math.round(dock?.getBoundingClientRect().height ?? 66) + 'px');
    }

    // In page order. The index of the open one is what decides which rows
    // dock up and which dock down, so the order is the model here.
    const rows = ['about-top-grid', 'about-career-panel', 'skillset-panel']
      .map(id => {
        const btn = document.querySelector<HTMLElement>('[data-page-toggle="' + id + '"]');
        return { btn, hdr: btn?.closest('.page-toggle-header') as HTMLElement | null };
      })
      .filter(r => r.btn && r.hdr);
    const isOpen = (r: any) => r.btn.getAttribute('aria-expanded') !== 'false';

    // One at a time. Opening a section closes whichever was open, so the one
    // you want is never buried under two others you have to collapse first.
    // The clicks are synthetic, so re-entry is guarded rather than trusted.
    function solo(keep: number) {
      if ((page as any)._solo) return;
      (page as any)._solo = true;
      rows.forEach((r, i) => { if (i !== keep && isOpen(r)) r.btn!.click(); });
      (page as any)._solo = false;
    }

    // Rows up to and including the open one stick to the top, each below the
    // one before it; the rest stick to the bottom, above the nav dock. With
    // nothing open they all dock down, which is the page as a table of
    // contents.
    function dock() {
      if (!phone.matches) {
        rows.forEach(r => { r.hdr!.style.top = ''; r.hdr!.style.bottom = ''; });
        page!.style.removeProperty('--ab-bot-h');
        return;
      }
      const open = rows.findIndex(isOpen);
      const h = rows.map(r => r.hdr!.getBoundingClientRect().height);
      const dockH = parseFloat(getComputedStyle(page!).getPropertyValue('--ab-dock-h')) || 66;
      let up = 0;
      for (let i = 0; i <= open; i++) {
        rows[i].hdr!.style.bottom = '';
        rows[i].hdr!.style.top = Math.round(up) + 'px';
        up += h[i];
      }
      let down = 0;
      for (let i = rows.length - 1; i > open; i--) {
        rows[i].hdr!.style.top = '';
        rows[i].hdr!.style.bottom = Math.round(dockH + down) + 'px';
        down += h[i];
      }
      // What the page has to clear so the footer is not left under the stack.
      page!.style.setProperty('--ab-bot-h', Math.round(down) + 'px');
    }

    // Education is open; the other two start closed, so the page opens as the
    // person and their studies rather than as three screens of everything.
    function collapseOnce() {
      if ((page as any)._collapsed || !phone.matches) return;
      (page as any)._collapsed = true;
      solo(0);
    }

    function apply() {
      placeSearch();
      measure();
      if (phone.matches) collapseOnce();
      dock();
    }

    if (!(page as any)._phoneTabsWired) {
      (page as any)._phoneTabsWired = true;
      phone.addEventListener('change', apply);
      const remeasure = () => { measure(); dock(); };
      window.addEventListener('resize', remeasure, { passive: true });
      if ('ResizeObserver' in window) {
        const el = document.querySelector('.page-breadcrumb');
        if (el) new ResizeObserver(remeasure).observe(el);
      }
      // Above 700 the field sits outside the section, so focusing it opens
      // the pills it filters. On the phone it is inside, and reaching it
      // means the section is already open.
      search?.addEventListener('focus', () => {
        const btn = document.querySelector<HTMLElement>('[data-page-toggle="skillset-panel"]');
        if (!phone.matches && btn?.getAttribute('aria-expanded') === 'false') btn.click();
      });

      // The global toggle wiring has already flipped aria-expanded by the time
      // this runs, so the state read here is the new one, not the one being
      // replaced. The panel animates over --motion--slow; re-docking after it
      // settles catches the height the row ends up at.
      rows.forEach((r, i) => {
        r.hdr!.addEventListener('click', () => {
          if ((page as any)._solo || !phone.matches) return;
          if (isOpen(r)) solo(i);
          dock();
          setTimeout(dock, 450);
        });
      });
    }

    apply();
  }

  initAboutPhonePanels();
  document.addEventListener('astro:after-swap', initAboutPhonePanels);

</script>
