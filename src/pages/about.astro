---
import Icon from '../components/Icon.astro';
import { getEntry } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import Footer from '../components/Footer.astro';
import { publicFileExists } from '../lib/content';
import Arrow from '../components/Arrow.astro';

// PDF links only render once the files actually exist in public/
const hasCv = publicFileExists('/Adi-Advaita-Kelkar-CV-Sept-2026.pdf');

// Editable about-page prose (inline edit mode writes src/content/pages/about.yaml).
const about = await getEntry('pages', 'about');
const aboutRole = about?.data.role ?? 'Architectural Designer + Researcher';
const aboutDegree = about?.data.degree ?? 'Master of Architecture · SCAD ‘27 · Mumbai';
const aboutBioLead = about?.data.bioLead ?? '';
const aboutBioMore = about?.data.bioMore ?? [];
const aboutCareerTagline = about?.data.careerTagline ?? 'Dissolving roles and evolutions: Professional journey from Mumbai teams to SCAD fabrication, always fusing leadership with innovation.';

// Structured career experience data
const experience = [
  {
    title: "SCAD Fabrication Monitor",
    role: "On Campus Employment",
    company: "SCAD Foundation Studies",
    dates: "Nov 2024 - Present",
    location: "Savannah, United States",
    desc: "I help run the Foundation Studies fabrication studio: maintaining tools and equipment, keeping the shop safe, and building whatever it needs, from jigs and shop fixtures to signage, displays, and light repairs. (Part Time)"
  },
  {
    title: "F'KD Workshop",
    role: "Architect",
    company: "Faizan Khatri Design Workshop",
    dates: "2021 - 2023",
    location: "Mumbai, India",
    desc: "I helped build the studio from the ground up: hiring and leading teams, mentoring junior architects, and running projects from first proposal to onsite execution. My work covered design, visualization, and project management across hospitality, public, and residential projects, often several at once. (Full Time)"
  },
  {
    title: "Studio 823",
    role: "Architect",
    company: "Studio Eight Twentythree",
    dates: "2018 - 2021",
    location: "Mumbai, India",
    desc: "I joined as an intern in my final year of architecture school and stayed on full time after graduation. Mentored by Samir Raut and Faizan Khatri, I worked on hospitality, commercial, research, and residential interior projects. This studio laid the foundation for everything I've done since. (Full Time)"
  },
  {
    title: "ARCHV",
    role: "Founder, Architecture Collective",
    company: "ARCHV Collective",
    dates: "",
    location: "Savannah, United States",
    desc: "ARCHV is a collective I founded with friends, built on a simple idea: making things together matters more than money or timelines. I organize transdisciplinary projects with collaborators from across the design fields. (Part Time)"
  }
];

// Structured exhibitions data
const exhibitions = [
  {
    title: "Indian Art Fair",
    role: "Public Art Exhibition",
    company: "Nayan Mote Studio",
    dates: "Nov 2024",
    location: "Mumbai, India",
    desc: "Public art exhibition with Nayan Mote Studio, showing the CARLO and Urban Dichotomy artwork collections."
  },
  {
    title: "Raw Collaborative 4.0",
    role: "Public Art Exhibition",
    company: "ARCHV Collective",
    dates: "Feb 2021",
    location: "Ahmedabad, India",
    image: "/images/press/raw-collaborative.webp",
    desc: "Open Source Design Library installation and scaled models exhibited at the Mill Owners' Association, Ahmedabad."
  },
  {
    title: "Celebrate Bandra",
    role: "Public Art Exhibition",
    company: "ARCHV Collective",
    dates: "2019",
    location: "Mumbai, India",
    desc: "RFLCT, a mirrored tetrahedral light sculpture built by ARCHV for the Celebrate Bandra art festival."
  },
  {
    title: "Traces and Territory",
    role: "Public Art Exhibition",
    company: "ARCHV Collective",
    dates: "2019",
    location: "Ahmedabad, India",
    desc: "Site-specific dichroic acrylic installation by ARCHV inside Dhal Ni Pol, a historic quarter of Ahmedabad."
  }
];

// Press features. Same shape as `exhibitions` so the card markup is shared.
const publications = [
  {
    title: "Platform Magazine",
    role: "Print Feature",
    company: "Platform Magazine",
    dates: "Nov 2020",
    location: "India",
    image: "/images/press/platform-magazine.webp",
    desc: "ARCHV featured in the magazine's 50-year print edition."
  },
  {
    title: "Curator Magazine",
    role: "Online Feature",
    company: "Curator Magazine",
    dates: "2020",
    location: "India",
    image: "/images/press/curator-magazine.webp",
    desc: "\u201CVirtual Gods, India\u2019s First Virtual Art Exhibit\u201D by Rahul Manral."
  },
  {
    title: "Homegrown",
    role: "Online Feature",
    company: "Homegrown (HG Voices)",
    dates: "Jun 2021",
    location: "India",
    image: "/images/press/homegrown.webp",
    desc: "\u201CVirtual Gods: A 3D Art Collaboration Capturing Post-Lockdown Deja Vu\u201D, featured as part of HG Voices."
  },
  {
    title: "Mash India",
    role: "Online Feature",
    company: "Mash India",
    dates: "Aug 2020",
    location: "India",
    image: "/images/press/mash-india.webp",
    desc: "Virtual Gods featured as an online virtual group art exhibit on Mash India, a creative portal."
  },
  {
    title: "Paper Planes",
    role: "Online Feature",
    company: "Paper Planes",
    dates: "Aug 2020",
    location: "India",
    image: "/images/press/paper-planes.webp",
    desc: "\u201CVisual Media Meets Architecture in This Online Exhibit\u201D by Fabiola Monteiro."
  }
];

// Structured timeline data
const timeline = [
  {
    title: "(SCAD) Savannah College of Art & Design",
    role: "Master of Architecture (NAAB-accredited)",
    company: "Savannah College of Art & Design",
    dates: "2024 - 2027",
    location: "Savannah, United States",
    desc: "Deep in parametric and AI tools (Grasshopper, ComfyUI, Unreal Engine), working toward a thesis on cultural fusion."
  },
  {
    title: "ARCHV",
    role: "Founder, Architecture Collective",
    company: "ARCHV, Online",
    dates: "2018 - 2024",
    location: "Online",
    desc: "A collective built with friends purely for the love of making, running transdisciplinary projects across art, design, and fabrication."
  },
  {
    title: "F'KD Workshop, Mumbai",
    role: "Architect",
    company: "Faizan Khatri Design Workshop",
    dates: "2021 - 2023",
    location: "Mumbai, India",
    desc: "Helped establish the studio; led teams and managed hospitality, public, and residential projects from proposal to execution."
  },
  {
    title: "Raw Collaborative Exhibition",
    role: "On ground Exhibition",
    company: "ARCHV Collective",
    dates: "2021",
    location: "Mumbai, India",
    desc: "Group exhibition of collaborative works by the ARCHV collective."
  },
  {
    title: "Virtual Gods",
    role: "Founded ARCHV Collective",
    company: "ARCHV Collective",
    dates: "2020",
    location: "Online",
    desc: "Hosted India's first online group art exhibition (still live), bringing artists together during the lockdown."
  },
  {
    title: "Celebrate Bandra Exhibition",
    role: "Public Art by ARCHV collective",
    company: "ARCHV Collective",
    dates: "2019",
    location: "Mumbai, India",
    desc: "Installed RFLCT, a mirrored tetrahedral light sculpture, at the Celebrate Bandra art festival."
  },
  {
    title: "Dhal Ni Pol",
    role: "Public Art by ARCHV collective",
    company: "ARCHV Collective",
    dates: "2019",
    location: "Ahmedabad, India",
    desc: "Built Traces and Territory, a dichroic acrylic installation inside a historic Ahmedabad pol."
  },
  {
    title: "Studio 823",
    role: "Architect, Full-Time",
    company: "Studio Eight Twentythree",
    dates: "2018 - 2021",
    location: "Mumbai, India",
    desc: "Started as an intern in my final BArch year; worked on hospitality, commercial, research, and residential interiors under close mentorship."
  },
  {
    title: "Pragrup",
    role: "Bangalore Intern",
    company: "Pragrup",
    dates: "Jan 2016 - Jun 2016",
    location: "Bangalore, India",
    desc: "Six months of hands-on, full-scale building: wood houses, competitions, commercial spaces, and experimental graphics."
  },
  {
    title: "Hiray College of Architecture",
    role: "Bachelor of Architecture",
    company: "Hiray College of Architecture",
    dates: "2012 - 2019",
    location: "Mumbai, India",
    desc: "Learned the fundamentals the hands-on way: drafting, model-making, and testing theory against real projects."
  }
];

// Timeline grouped BY YEAR (an entry files under its start year), newest
// first — each year renders as one accordion card listing that year's
// events. Add entries above in any order; they self-organise.
const startYear = (d: string) => (d.match(/\d{4}/) ?? ['0'])[0];
const timelineByYear: Record<string, typeof timeline> = {};
timeline.forEach(t => {
  const y = startYear(t.dates);
  (timelineByYear[y] ??= []).push(t);
});
const timelineYears = Object.keys(timelineByYear)
  .sort((a, b) => Number(b) - Number(a))
  .map(y => ({ year: y, events: timelineByYear[y] }));

// The early years read better as one chapter: everything up to 2018 is
// folded into a single bottom card ("2012 – 2018"), events newest-first.
const EARLY_CUTOFF = 2018;
const timelineGroups = timelineYears.filter(g => Number(g.year) > EARLY_CUTOFF);
const early = timelineYears.filter(g => Number(g.year) <= EARLY_CUTOFF);
if (early.length) {
  const ys = early.map(g => Number(g.year));
  timelineGroups.push({
    year: `${Math.min(...ys)} – ${Math.max(...ys)}`,
    events: early.flatMap(g => g.events),
  });
}

// Structured skillset categories
const skillsets = [
  {
    category: "Languages",
    skills: [
      { name: "Hindi", level: "(Native)" },
      { name: "Marathi", level: "(Native)" },
      { name: "English", level: "(Fluent)" }
    ]
  },
  /* Grouped by discipline rather than one flat list: the profile spans
     architecture, graphics, web and AI, and a recruiter scanning for one
     competency should find it in a single block. Within each group the
     order is Expert -> Intermediate -> Basic, so the strongest tool leads. */
  {
    category: "BIM, Drafting & GIS",
    skills: [
      { name: "AutoCAD", level: "(Expert)" },
      { name: "Revit", level: "(Intermediate)" },
      { name: "Autodesk Forma", level: "(Intermediate)" },
      { name: "ArcGIS", level: "(Intermediate)" }
    ]
  },
  {
    category: "Modelling, Parametric & Fabrication",
    skills: [
      { name: "SketchUp", level: "(Expert)" },
      { name: "CNC Fabrication", level: "(Expert)" },
      { name: "3D Printing", level: "(Expert)" },
      { name: "Rhinoceros 3D", level: "(Intermediate)" },
      { name: "Fusion 360", level: "(Intermediate)" },
      { name: "Grasshopper", level: "(Basic)" },
      { name: "Blender", level: "(Basic)" },
      { name: "SolidWorks", level: "(Basic)" }
    ]
  },
  {
    category: "Visualisation & Real-Time",
    skills: [
      { name: "Lumion", level: "(Expert)" },
      { name: "Enscape", level: "(Expert)" },
      { name: "D5 Render", level: "(Expert)" },
      { name: "V-Ray", level: "(Intermediate)" },
      { name: "Unreal Engine", level: "(Basic)" }
    ]
  },
  {
    category: "Graphic & Web Design",
    skills: [
      { name: "Canva", level: "(Expert)" },
      { name: "Figma", level: "(Expert)" },
      { name: "Webflow", level: "(Expert)" },
      { name: "Adobe Illustrator", level: "(Intermediate)" },
      { name: "Adobe Photoshop", level: "(Intermediate)" },
      { name: "Adobe InDesign", level: "(Intermediate)" },
      { name: "Framer", level: "(Basic)" }
    ]
  },
  {
    category: "AI, Code & Workflow",
    skills: [
      { name: "Notion", level: "(Expert)" },
      { name: "Miro", level: "(Expert)" },
      { name: "Microsoft Office", level: "(Expert)" },
      { name: "Claude", level: "(Intermediate)" },
      { name: "ComfyUI", level: "(Intermediate)" },
      { name: "HTML & CSS", level: "(Basic)" },
      { name: "JavaScript", level: "(Basic)" },
      { name: "Python", level: "(Basic)" }
    ]
  }
];
---

<PageLayout
  title="About"
  label="About"
  crumbs={[
    { label: 'Home', href: '/' },
    { label: 'About' }
  ]}
  showFooter={false}
>
  <article class="about-page">
    
    <!-- Continuous scroll page — no section snapping -->
    <section class="about-section-snap about-section--intro">

      <!-- Full-width profile header: name, face, role. Not a disclosure. -->
      <header class="profile-header intro-header page-toggle-header">
        <h1 class="profile-name">
          <span data-scramble>Adi (Advaita) Kelkar</span>
        </h1>
        <div class="profile-photo-circle" aria-hidden="true"></div>
        <div class="profile-header__meta">
          <p class="profile-role" data-scramble data-edit="pages/about/role">{aboutRole}</p>
          <p class="profile-degree" data-edit="pages/about/degree">{aboutDegree}</p>
        </div>
      </header>

      {/* The bio and its three buttons describe the person, not the studies,
           so they sit with the name and outside every dropdown — always
           present, at every width. */}
      <div class="about-bio__text" id="bio-text-container">
        <p data-edit="pages/about/bioLead" data-edit-html set:html={aboutBioLead} />

        <div class="bio-collapsed-content" id="bio-collapsed-content" style="display: none;">
          {aboutBioMore.map((para, i) => (
            <p data-edit={`pages/about/bioMore.${i}`}>{para}</p>
          ))}
        </div>

        <div class="bio-buttons-row">
          <button class="bio-read-more-btn" id="bio-read-more-btn" type="button">
            <span>Read More</span>
            <Arrow class="bio-read-more-arrow" />
          </button>

          {hasCv && (
            <a href="/Adi-Advaita-Kelkar-CV-Sept-2026.pdf" class="about-link-row" target="_blank" rel="noopener">
              <span class="about-link-row__text">Resume</span>
              <span class="about-link-row__arrow" aria-hidden="true">
                <Arrow />
              </span>
            </a>
          )}

          <button class="about-link-row" id="about-portfolio-status" type="button" aria-expanded="false">
            <span class="about-link-row__text">
              Portfolio <span class="about-link-row__status" hidden>(Under progress)</span>
            </span>
            <span class="about-link-row__arrow" aria-hidden="true">
              <Arrow />
            </span>
          </button>
        </div>
      </div>

      <!-- Education: its own disclosure, a peer of Professional Journey and
           Skillset rather than the panel hanging off the identity header. -->
      <header class="profile-header education-header page-toggle-header">
        <h2 class="profile-name">Education</h2>
        <button class="page-toggle-btn" data-page-toggle="about-top-grid" aria-expanded="true" aria-label="Toggle education" type="button">
          <Arrow />
        </button>
      </header>

      <div class="about-top-grid page-toggle-panel" id="about-top-grid">

        <!-- RIGHT COLUMN: education pills (top is intentionally open) -->
        <div class="about-top-right">
          <div class="about-education__list">
            <!-- Education pill 1: SCAD -->
            <div class="education-pill is-open" data-pill="edu-scad">
              <div class="education-pill__header">
                <span class="education-pill__name">
                  Master of Architecture
                  <span class="active-status-text">ACTIVE</span>
                </span>
                <div class="education-pill__trigger-right">
                  <span class="education-pill__years">2024 – 2027</span>
                </div>
              </div>
              <div class="education-pill__content" id="edu-scad-content">
                <div class="education-pill__content-inner">
                  <p class="education-pill__degree">
                    MArch, Architecture - <a href="https://www.scad.edu/academics/programs/architecture/degrees/march" class="education-inline-link" data-no-scramble target="_blank" rel="noopener">Savannah College of Art and Design</a>
                  </p>
                </div>
              </div>
            </div>

            <!-- Education pill 2: University of Mumbai -->
            <div class="education-pill is-open" data-pill="edu-mumbai">
              <div class="education-pill__header">
                <span class="education-pill__name">Bachelor of Architecture</span>
                <div class="education-pill__trigger-right">
                  <span class="education-pill__years">2012 – 2019</span>
                </div>
              </div>
              <div class="education-pill__content" id="edu-mumbai-content">
                <div class="education-pill__content-inner">
                  <p class="education-pill__degree">
                    BArch, Architecture - <a href="https://hiray.edu.in/home" class="education-inline-link" data-no-scramble target="_blank" rel="noopener">DBHCOA</a>, University of Mumbai
                  </p>
                </div>
              </div>
            </div>

            <a href="https://linkedin.com/in/advaita-kelkar" class="education-more-link" target="_blank" rel="noopener">
              <span>+ LinkedIn / full resume</span>
              <Arrow class="bio-read-more-arrow" />
            </a>
          </div>
        </div>
      </div>
      <!-- Career Header (Dropdown toggle) -->
      <header class="profile-header career-header page-toggle-header">
        <h1 class="profile-name">
          <span data-scramble>Journey</span>
        </h1>
        <button class="page-toggle-btn" data-page-toggle="about-career-panel" aria-expanded="true" aria-label="Toggle career details" type="button">
          <Arrow />
        </button>
      </header>

      <!-- Collapsible Career Panel: contains Work EXP, Exhibitions, Timeline tabs + Skillset section -->
      <div class="about-career-panel page-toggle-panel" id="about-career-panel" data-swipe-own>
        <!-- Career Tabs + Card Deck -->
        <div class="about-career-container" id="panel-career-section">
          <!-- Tabs (Sticky 100% width, equally spaced) -->
          <div class="about-tabs-container" role="tablist" aria-label="Career sections">
            <button class="about-tab-btn is-active" role="tab" aria-selected="true" aria-controls="panel-about" data-tab="about">
              <span>
                <span class="tab-label-full">Work EXP</span>
                <span class="tab-label-short">EXP</span>
              </span>
              <Icon name="arrow" class="pill-arrow" />
            </button>
            <button class="about-tab-btn" role="tab" aria-selected="false" aria-controls="panel-exhibitions" data-tab="exhibitions">
              <span>
                <span class="tab-label-full">Exhibitions</span>
                <span class="tab-label-short">EXHIB</span>
              </span>
              <Icon name="arrow" class="pill-arrow" />
            </button>
            <button class="about-tab-btn" role="tab" aria-selected="false" aria-controls="panel-press" data-tab="press">
              <span>
                <span class="tab-label-full">Press</span>
                <span class="tab-label-short">PRESS</span>
              </span>
              <Icon name="arrow" class="pill-arrow" />
            </button>
            <button class="about-tab-btn" role="tab" aria-selected="false" aria-controls="panel-timeline" data-tab="timeline">
              <span>
                <span class="tab-label-full">Timeline</span>
                <span class="tab-label-short">TL</span>
              </span>
              <Icon name="arrow" class="pill-arrow" />
            </button>
          </div>

          <p class="about-career__tagline text-muted" data-edit="pages/about/careerTagline">{aboutCareerTagline}</p>

          <div class="about-tab-content">
            <!-- Panel 1: About (Experience) -->
            <div class="about-tab-panel is-active" id="panel-about" role="tabpanel" aria-labelledby="tab-about">
              {experience.map((item, idx) => (
                <div class="about-card" style={`--card-index: ${idx};`}>
                  <div class="about-card__header">
                    <h3 class="about-card__title">
                      {item.title}
                      {item.dates.includes("Present") && (
                        <span class="active-status-text">ACTIVE</span>
                      )}
                    </h3>
                    <div class="about-card__header-right">
                      {item.dates && <span class="about-card__dates">{item.dates}</span>}
                      <Icon name="arrow" class="about-card__chevron" />
                    </div>
                  </div>
                  <div class="about-card__body">
                    <div class="about-card__body-inner">
                      <p class="about-card__meta text-muted">{item.company} · {item.role} · {item.location}</p>
                      {item.desc && <p class="about-card__desc text-muted">{item.desc}</p>}
                      {item.image && (
                        <a href={item.image} class="about-card__shot" target="_blank" rel="noopener" aria-label={`Open the ${item.title} feature image`}>
                          <img src={item.image} alt={`${item.title} feature`} loading="lazy" />
                        </a>
                      )}
                    </div>
                  </div>
                </div>
              ))}
            </div>

            <!-- Panel 2: Exhibitions -->
            <div class="about-tab-panel" id="panel-exhibitions" role="tabpanel" aria-labelledby="tab-exhibitions" style="display: none;">
              {exhibitions.map((item, idx) => (
                <div class="about-card" style={`--card-index: ${idx};`}>
                  <div class="about-card__header">
                    <h3 class="about-card__title">{item.title}</h3>
                    <div class="about-card__header-right">
                      {item.dates && <span class="about-card__dates">{item.dates}</span>}
                      <Icon name="arrow" class="about-card__chevron" />
                    </div>
                  </div>
                  <div class="about-card__body">
                    <div class="about-card__body-inner">
                      <p class="about-card__meta text-muted">{item.company} · {item.role} · {item.location}</p>
                      {item.desc && <p class="about-card__desc text-muted">{item.desc}</p>}
                      {item.image && (
                        <a href={item.image} class="about-card__shot" target="_blank" rel="noopener" aria-label={`Open the ${item.title} feature image`}>
                          <img src={item.image} alt={`${item.title} feature`} loading="lazy" />
                        </a>
                      )}
                    </div>
                  </div>
                </div>
              ))}
            </div>

            <!-- Panel: Press — publications and features -->
            <div class="about-tab-panel" id="panel-press" role="tabpanel" aria-labelledby="tab-press" style="display: none;">
              {publications.map((item, idx) => (
                <div class="about-card" style={`--card-index: ${idx};`}>
                  <div class="about-card__header">
                    <h3 class="about-card__title">{item.title}</h3>
                    <div class="about-card__header-right">
                      {item.dates && <span class="about-card__dates">{item.dates}</span>}
                      <Icon name="arrow" class="about-card__chevron" />
                    </div>
                  </div>
                  <div class="about-card__body">
                    <div class="about-card__body-inner">
                      <p class="about-card__meta text-muted">{item.company} · {item.role} · {item.location}</p>
                      {item.desc && <p class="about-card__desc text-muted">{item.desc}</p>}
                      {item.image && (
                        <a href={item.image} class="about-card__shot" target="_blank" rel="noopener" aria-label={`Open the ${item.title} feature image`}>
                          <img src={item.image} alt={`${item.title} feature`} loading="lazy" />
                        </a>
                      )}
                    </div>
                  </div>
                </div>
              ))}
            </div>

            <!-- Panel 4: Timeline — one card per YEAR; open it to see the
                 events that started that year -->
            <div class="about-tab-panel" id="panel-timeline" role="tabpanel" aria-labelledby="tab-timeline" style="display: none;">
              {timelineGroups.map((g, idx) => (
                <div class="about-card" style={`--card-index: ${idx};`}>
                  <div class="about-card__header">
                    <h3 class="about-card__title">{g.year}</h3>
                    <div class="about-card__header-right">
                      <span class="about-card__dates">{g.events.length} {g.events.length === 1 ? 'entry' : 'entries'}</span>
                      <Icon name="arrow" class="about-card__chevron" />
                    </div>
                  </div>
                  <div class="about-card__body">
                    <div class="about-card__body-inner">
                      {g.events.map(item => (
                        <div class="timeline-event">
                          <p class="timeline-event__title">{item.title} <span class="timeline-event__dates">{item.dates}</span></p>
                          <p class="about-card__meta text-muted">{item.company} · {item.role} · {item.location}</p>
                          {item.desc && <p class="about-card__desc text-muted">{item.desc}</p>}
                        </div>
                      ))}
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>

      </div>

      <!-- Skillset — its own collapsible section, a peer of Professional
           Journey rather than a block nested inside its panel. Above 700 the
           search sits in the HEADER, so it stays usable while the section is
           closed; typing re-opens it (wired below). On the phone it moves
           into the panel under the pills, because a closed row there is a
           project row and a field parked in one is not. -->
      <header class="profile-header skillset-header page-toggle-header">
        <h1 class="profile-name">
          <span data-scramble>Skillset</span>
        </h1>
        <div class="skillset-header__right">
          <input
            type="search"
            id="skill-search"
            class="skillset-search-input"
            placeholder="Search"
            autocomplete="off"
            aria-label="Search skillset"
          />
          <button class="page-toggle-btn" data-page-toggle="skillset-panel" aria-expanded="true" aria-label="Toggle skillset" type="button">
            <Arrow />
          </button>
        </div>
      </header>

      <div class="skillset-panel page-toggle-panel" id="skillset-panel">
          <div class="skillset-cloud" id="skillset-cloud">
            {skillsets.flatMap((set) => [
              <span class="proj-bubble skill-pill skill-pill--label" data-static data-keywords={set.category.toLowerCase()}>
                <span class="proj-bubble__name" data-short={set.category} data-full={set.category}>{set.category}</span>
                <Arrow class="proj-bubble__arrow" />
              </span>,
              ...set.skills.map((skill) => (
                <a
                  href={`/projects?search=${encodeURIComponent(skill.name)}`}
                  class="proj-bubble skill-pill"
                  data-keywords={`${set.category} ${skill.name} ${skill.level}`.toLowerCase()}
                  title={`Click to view projects using ${skill.name}`}
                >
                  <span class="proj-bubble__name" data-short={skill.name} data-full={skill.name}>{skill.name}</span>
                  <span class="proj-bubble__tag">{skill.level}</span>
                  <Arrow class="proj-bubble__arrow" />
                </a>
              )),
            ])}
          </div>
          <!-- Phone: the search lands here, under the pills it filters. -->
          <div class="skillset-panel__search" id="skillset-panel-search"></div>
      </div>

      <!-- Project Quick Search & Footer -->
      <div class="skillset-footer-wrap" style="padding-top: clamp(2rem, 6vh, 4rem); padding-bottom: 80px; width: 100%;">
        <Footer isEmbedded={true} />
      </div>

    </section>
  </article>
</PageLayout>

