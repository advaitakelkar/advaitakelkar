  .ph__index > summary b { font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .ph__index-trigger-caret { display: inline-flex; font-style: normal; --icon-size: var(--_tokens---arrow--sm); transition: transform var(--_tokens---motion--base, .25s) ease; }
  .ph__index[open] .ph__index-trigger-caret { transform: rotate(180deg); }
