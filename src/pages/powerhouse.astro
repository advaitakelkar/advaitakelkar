  .ph__takeaway { margin: var(--_tokens---space--small) 0; padding: clamp(20px, 3vw, 36px); border-radius: 16px; background: var(--_tokens---color--fg); color: var(--_tokens---color--bg); }
  .ph .ph__takeaway h2 { color: inherit; font-size: var(--_tokens---type--small); font-weight: 600; margin: 0 0 12px; }
  .ph__takeaway p { color: inherit; font-size: var(--_tokens---type--small); line-height: 1.6; margin: 0 0 10px; max-width: 72ch; }
  .ph__takeaway p:last-child { margin-bottom: 0; opacity: .8; }
  @media (max-width: 1023.98px) { .ph__city-focus { grid-template-columns: 1fr; } }
