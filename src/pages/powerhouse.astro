    :global(:root:not(.mode-light)) .ph { --ph-red: #d9877a; --ph-orange: #dba275; --ph-yellow: #cdb36d; --ph-green: #7fb597; --ph-teal: #74a8b1; --ph-blue: #8a9fd1; --ph-grey: #7c7c84; --ph-light: #34343a; }
