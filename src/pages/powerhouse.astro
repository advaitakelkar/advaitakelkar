  .ph__city { max-height: 560px; }
  .ph__city circle { stroke: var(--_tokens---color--bg); stroke-width: .4; }
  .ph__timeline { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; border-top: 1px solid var(--_tokens---color--line); padding-top: 16px; }
  .ph__timeline span { display: grid; gap: 6px; font-size: var(--_tokens---type--micro); color: var(--_tokens---color--muted); }
  .ph__timeline b { font-size: var(--_tokens---type--medium); font-weight: 400; color: var(--_tokens---color--fg); }
  .ph__warning { font-size: var(--_tokens---type--micro); line-height: 1.6; border-left: 2px solid var(--ph-accent); padding-left: 12px; margin: 20px 0 0; max-width: 70rem; }
  .ph__growth td { text-align: left; min-width: 190px; }
  .ph__growth td > strong { display: block; font-size: var(--_tokens---type--medium); font-weight: 400; letter-spacing: -.03em; margin-bottom: 8px; }
  .ph__growth td > span, .ph__growth td > small { display: block; margin: 4px 0; }
  .ph__growth td > small { max-width: 20rem; white-space: normal; line-height: 1.5; color: var(--_tokens---color--muted); font-size: var(--_tokens---type--micro); }
  .ph__projection { background: color-mix(in srgb, var(--_tokens---color--fg) 3%, transparent); }
  .ph__mix { display: flex; height: 8px; margin-top: 12px; background: color-mix(in srgb, var(--_tokens---color--fg) 6%, transparent); }
  .ph__mix i { height: 100%; background: color-mix(in srgb, var(--_tokens---color--fg) 25%, transparent); }
  .ph__growth-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; margin: 24px 0; }
  .ph__growth-rate { font-size: var(--_tokens---type--medium); margin: 12px 0; }
  .ph__growth-rate span { display: block; font-size: var(--_tokens---type--micro); color: var(--_tokens---color--muted); margin-top: 4px; }
  .ph__history > div { display: grid; grid-template-columns: 34px 1fr 90px; align-items: center; gap: 8px; margin: 10px 0; font-size: var(--_tokens---type--micro); font-variant-numeric: tabular-nums; }
  .ph__history b { font-weight: 400; text-align: right; }
  .ph__track { height: 6px; background: color-mix(in srgb, var(--_tokens---color--fg) 8%, transparent); }
  .ph__track i { display: block; height: 100%; background: var(--ph-accent); }
  .ph__pager { display: flex; justify-content: space-between; align-items: center; gap: 16px; border-top: 1px solid var(--_tokens---color--line); padding-top: 20px; font-size: var(--_tokens---type--micro); }
  .ph__pager button:disabled { opacity: .35; cursor: default; }
  .ph :is(a, button, select, summary):focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }

  @media (max-width: 1023.98px) {
    .ph { padding-top: 24px; }
    .ph__split, .ph__ny-grid, .ph__viz-grid, .ph__metric-grid, .ph__shift-grid { grid-template-columns: 1fr; }
    .ph__summary { grid-template-columns: 1fr 1fr; }
    .ph__summary > .ph__viz-box, .ph__summary > .ph__energy { grid-column: 1 / -1; }
    .ph__definitions { grid-template-columns: 1fr; }
  }
  @media (max-width: 699.98px) {
    .ph__state-grid, .ph__growth-grid, .ph__gauge-grid, .ph__summary { grid-template-columns: 1fr; }
    .ph__state-map { max-height: 220px; }
    .ph__timeline { gap: 10px; }
    .ph__timeline span { font-size: 12px; }
    .ph__header { gap: 8px; }
    .ph__brand span { display: block; }
    .ph__nav { gap: 6px; }
    .ph__nav a { padding: 8px 10px; gap: 6px; }
    .ph th, .ph td { padding: 10px 8px; }
    .ph__growth td { min-width: 180px; }
  }
  @media print {
    .ph__nav, .ph__pager, .ph__filters, .ph__header { display: none !important; }
    .ph__slide[hidden] { display: block; }
    .ph__slide { break-after: page; margin: 0; }
    .ph { padding: 0; }
    .ph__heading { margin-bottom: 16px; }
    .ph__heading h1 { font-size: 30px; }
    .ph__split { grid-template-columns: 1.5fr 1fr; }
    .ph__state-grid, .ph__growth-grid { grid-template-columns: repeat(3, 1fr); }
    .ph__slide:last-of-type { break-after: auto; }
  }
</style>

<script>
  import { createMap, type PowerhouseMap } from '../lib/powerhouse-map';

  // Chapters (main tabs) and sections (the flow). Picking a chapter opens its first section.
  const book = document.querySelector<HTMLElement>('[data-analysis]');
  if (book) {
    const chapterBtns = [...book.querySelectorAll<HTMLButtonElement>('[data-chapter]')];
    const sectionBtns = [...book.querySelectorAll<HTMLButtonElement>('[data-section]')];
    const sectionPanels = [...book.querySelectorAll<HTMLElement>('[data-section-panel]')];

    const index = book.querySelector<HTMLDetailsElement>('.ph__index');
    document.addEventListener('click', (e) => {
      if (index?.open && !index.contains(e.target as Node)) index.open = false;
    });
    index?.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && index.open) { index.open = false; index.querySelector('summary')?.focus(); }
    });
    const indexChapters = [...book.querySelectorAll<HTMLElement>('[data-index-chapter]')];
    // The index is a toggle list: one chapter open at a time, the open one shows its sections.
    const openChapter = (ch: string | null) =>
      indexChapters.forEach((c) => {
        const open = c.dataset.indexChapter === ch;
        c.dataset.open = String(open);
        c.querySelector('[data-index-toggle]')?.setAttribute('aria-expanded', String(open));
      });
    book.querySelectorAll<HTMLButtonElement>('[data-index-toggle]').forEach((b) =>
      b.addEventListener('click', () => {
        const ch = b.dataset.indexToggle!;
        openChapter(b.closest<HTMLElement>('[data-index-chapter]')!.dataset.open === 'true' ? null : ch);
      })
    );
    const toc = book.querySelector<HTMLElement>('[data-toc]');
    const pinned = () => !!toc && getComputedStyle(toc).position === 'sticky';
    const syncTocHeight = () => toc && book.style.setProperty('--ph-toc-h', `${pinned() ? toc.offsetHeight : 0}px`);
    syncTocHeight();
    addEventListener('resize', syncTocHeight);

    // Mark a section as current everywhere it is named: tabs, sub-tabs, the index.
    let currentId = '';
    const setCurrent = (id: string) => {
      if (id === currentId) return;
      currentId = id;
      const ch = 'ch' + id.split('-')[0];
      sectionBtns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.section === id)));
      chapterBtns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.chapter === ch)));
      indexChapters.forEach((c) => (c.dataset.active = String(c.dataset.indexChapter === ch)));
      if (!index?.open) openChapter(ch);
      book.querySelectorAll<HTMLElement>('[data-subtabs]').forEach((n) => (n.hidden = n.dataset.subtabs !== ch));
      syncTocHeight();
      const btn = sectionBtns.find((b) => b.dataset.section === id);
      const current = book.querySelector('[data-index-current]');
      if (current && btn) current.textContent = btn.textContent!.replace(/\s+/g, ' ').trim();
    };

    // Jump: the document is continuous, so a tab scrolls to its section rather than swapping it in.
    // While a jump is travelling the tab rows must hold still: a row that changes height
    // under a smooth scroll cancels it halfway. Following resumes when the scroll ends.
    let jumping = false;
    let jumpTimer = 0;
    const jump = (target: Element | null) => {
      if (!target) return;
      jumping = true;
      const done = () => { jumping = false; clearTimeout(jumpTimer); spy(); };
      addEventListener('scrollend', done, { once: true });
      jumpTimer = window.setTimeout(done, 2500);
      target.scrollIntoView({ block: 'start', behavior: 'smooth' });
    };
    const goTo = (target: HTMLElement | null, id: string) => {
      index?.removeAttribute('open');
      setCurrent(id);
      jump(target);
    };
    // Note numbers and "Back" links jump the same way, keeping the address in step.
    book.addEventListener('click', (e) => {
      const a = (e.target as Element).closest<HTMLAnchorElement>('a[href^="#note-"], a[href^="#ref-"]');
      if (!a) return;
      e.preventDefault();
      const hash = a.getAttribute('href')!;
      history.replaceState(null, '', hash);
      jump(book.querySelector(hash));
    });
    chapterBtns.forEach((b) =>
      b.addEventListener('click', () => {
        const ch = b.dataset.chapter!;
        goTo(book.querySelector<HTMLElement>(`[data-chapter-head="${ch}"]`), ch.replace('ch', '') + '-1');
      })
    );
    sectionBtns.forEach((b) =>
      b.addEventListener('click', () => goTo(book.querySelector<HTMLElement>(`#s-${b.dataset.section}`), b.dataset.section!))
    );

    // Chapter openings count as their chapter's first section, in document order.
    const markers: [HTMLElement, string][] = [...book.querySelectorAll<HTMLElement>('[data-section-panel], [data-chapter-head]')].map((el) => [
      el,
      el.dataset.sectionPanel ?? el.dataset.chapterHead!.replace('ch', '') + '-1',
    ]);
    // Follow the scroll: the current section is the last one whose top has passed under the tabs.
    let ticking = false;
    const spy = () => {
      ticking = false;
      const line = (pinned() ? toc!.getBoundingClientRect().bottom : 0) + 120;
      let id = '1-1';
      for (const [el, sid] of markers) {
        if (el.getBoundingClientRect().top <= line) id = sid;
        else break;
      }
      setCurrent(id);
    };
    addEventListener('scroll', () => { if (!jumping && !ticking) { ticking = true; requestAnimationFrame(spy); } }, { passive: true });
    spy();
  }

  const root = document.querySelector<HTMLElement>('[data-analysis]');
  if (root) {
    const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
    const links = [...root.querySelectorAll<HTMLAnchorElement>('[data-slide-link]')];
    const prev = root.querySelector<HTMLButtonElement>('#ph-prev')!;
    const next = root.querySelector<HTMLButtonElement>('#ph-next')!;
    const ids = ['vehicles', 'usa', 'california', 'new-york', 'florida', 'comparison'];
    const maxIdx = ids.length - 1;
    let index = 0;

    const show = (n: number, focus = false) => {
      index = Math.max(0, Math.min(maxIdx, n));
      slides.forEach((s, i) => (s.hidden = i !== index));
      links.forEach((a, i) => {
        if (i === index) a.setAttribute('aria-current', 'step');
        else a.removeAttribute('aria-current');
      });
      prev.disabled = index === 0;
      next.disabled = index === maxIdx;
      root.querySelector('#ph-progress')!.textContent = `0${index + 1} / 0${ids.length}`;
      if (focus) {
        history.replaceState(null, '', '#' + ids[index]);
        root.querySelector<HTMLElement>(`#${ids[index]}-title`)?.focus({ preventScroll: true });
        root.querySelector<HTMLElement>('.ph__nav')?.scrollIntoView({ block: 'start' });
      }
    };

    const resolveHash = (hash: string) => {
      const h = hash.replace(/^#/, '');
      if (h === 'states') return 2;
      const idx = ids.indexOf(h);
      return idx >= 0 ? idx : 0;
    };

    links.forEach((a, i) =>
      a.addEventListener('click', (e) => {
        e.preventDefault();
        show(i, true);
      })
    );
    root.querySelectorAll<HTMLAnchorElement>('[data-jump-slide]').forEach((a) =>
      a.addEventListener('click', (e) => {
        e.preventDefault();
        show(Number(a.dataset.jumpSlide), true);
      })
    );
    prev.addEventListener('click', () => show(index - 1, true));
    next.addEventListener('click', () => show(index + 1, true));
    // Note links and section anchors also change the hash; only a slide id moves the slides.
    const isSlideHash = (h: string) => ['states', ...ids].includes(h.replace(/^#/, ''));
    window.addEventListener('hashchange', () => { if (isSlideHash(location.hash)) show(resolveHash(location.hash)); });
    show(resolveHash(location.hash));
    root.querySelector<HTMLElement>('.ph__pager')!.hidden = false;

    const d = JSON.parse(document.querySelector('#ph-data')!.textContent!);
    const number = (n: number) => n.toLocaleString('en-US');
    const netLabel = (n: string) => (n === 'all' ? 'all networks' : n === 'tesla' ? 'Tesla networks' : 'other networks');

    // Zoomable maps. Each is built the first time its slide is on screen (a hidden map has no
    // size to draw into) and resized whenever its slide comes back.
    const maps = new Map<string, PowerhouseMap>();
    const mapOptions: Record<string, Parameters<typeof createMap>[1]> = {
      usa: { fit: 'usa' },
      CA: { fit: 'CA', outline: 'state', focusState: 'CA' },
      NY: { fit: 'NY', outline: 'state', focusState: 'NY' },
      FL: { fit: 'FL', outline: 'state', focusState: 'FL' },
      NYC: { fit: 'NYC', outline: 'boroughs' },
    };
    const mapFor = (key: string) => maps.get(key);
    const wake = (slide: Element) =>
      slide.querySelectorAll<HTMLElement>('[data-map]').forEach((el) => {
        const key = el.dataset.map!;
        const existing = maps.get(key);
        if (existing) return existing.resize();
        const m = createMap(el, mapOptions[key]);
        maps.set(key, m);
        m.ready.then(() => key === 'usa' ? usaFilter() : key === 'NYC' ? cityFilter() : stateFilters.get(key)?.());
      });
    const io = new IntersectionObserver((entries) => entries.forEach((e) => e.isIntersecting && !(e.target as HTMLElement).hidden && wake(e.target)), { rootMargin: '400px 0px' });
    slides.forEach((sl) => io.observe(sl));
    // A slide being shown wakes its maps. Watch the slides themselves only: things inside a
    // map (its tooltip) also toggle hidden, and reacting to those would loop.
    const slideWatch = new MutationObserver((records) => {
      for (const r of records) {
        const sl = r.target as HTMLElement;
        if (!sl.hidden && sl.getBoundingClientRect().top < innerHeight + 400) wake(sl);
      }
    });
    slides.forEach((sl) => slideWatch.observe(sl, { attributes: true, attributeFilter: ['hidden'] }));

    // USA filters
    const access = root.querySelector<HTMLSelectElement>('#ph-access')!;
    const network = root.querySelector<HTMLSelectElement>('#ph-network')!;
    const usaFilter = () => {
      const a = access.value as 'public' | 'private' | 'all';
      const n = network.value as 'tesla' | 'other' | 'all';
      mapFor('usa')?.setFilter({ access: a, network: n });
      const count = d.groups[a][n];
      root.querySelector('#ph-map-ports')!.textContent = `${number(count.ports)} ports`;
      root.querySelector('#ph-map-stations')!.textContent = `${number(count.stations)} stations · ${a === 'all' ? 'public + private' : a} access · ${netLabel(n)}`;
    };
    access.addEventListener('change', usaFilter);
    network.addEventListener('change', usaFilter);

    // State filters (CA, NY, FL)
    const stateFilters = new Map<string, () => void>();
    (['CA', 'NY', 'FL'] as const).forEach((code) => {
      const stAccess = root.querySelector<HTMLSelectElement>(`[data-st-access="${code}"]`);
      const stNet = root.querySelector<HTMLSelectElement>(`[data-st-network="${code}"]`);
      const portsOut = root.querySelector<HTMLElement>(`[data-st-ports="${code}"]`);
      const stOut = root.querySelector<HTMLElement>(`[data-st-stations="${code}"]`);
      if (!stAccess || !stNet || !portsOut || !stOut) return;
      const update = () => {
        const a = stAccess.value as 'public' | 'private' | 'all';
        const n = stNet.value as 'tesla' | 'other' | 'all';
        mapFor(code)?.setFilter({ access: a, network: n });
        const count = d.stateGroups[code][a][n];
        portsOut.textContent = `${number(count.ports)} ports`;
        stOut.textContent = `${number(count.stations)} stations · ${a === 'all' ? 'public + private' : a} access · ${netLabel(n)}`;
      };
      stateFilters.set(code, update);
      stAccess.addEventListener('change', update);
      stNet.addEventListener('change', update);
    });

    // New York City: a borough zooms the map to it; charger type filters the dots
    const borough = root.querySelector<HTMLSelectElement>('#ph-borough')!;
    const kind = root.querySelector<HTMLSelectElement>('#ph-city-type')!;
    const cityFilter = () => {
      let count = 0;
      let ports = 0;
      d.city.forEach((s: { borough: string; dc: number; ports: number }) => {
        if ((borough.value === 'all' || s.borough === borough.value) && (kind.value === 'all' || (kind.value === 'dc' ? s.dc > 0 : s.dc === 0))) {
          count++;
          ports += s.ports;
        }
      });
      const city = mapFor('NYC');
      city?.setFilter({ access: 'public', speed: kind.value as 'dc' | 'ac' | 'all' });
      root.querySelectorAll<HTMLElement>('[data-borough-row]').forEach((r) =>
        r.classList.toggle('is-muted', borough.value !== 'all' && r.dataset.boroughRow !== borough.value)
      );
      root.querySelector('#ph-city-result')!.textContent = `${borough.value === 'all' ? 'NYC' : borough.value} · ${number(count)} public stations · ${number(ports)} ports at these stations`;
    };
    borough.addEventListener('change', () => { mapFor('NYC')?.fit(borough.value === 'all' ? 'NYC' : borough.value); cityFilter(); });
    kind.addEventListener('change', cityFilter);
    slides.forEach((sl) => !sl.hidden && wake(sl));
  }
</script>
