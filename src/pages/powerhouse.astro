<script>
 const root=document.querySelector<HTMLElement>('[data-analysis]');
 if(root){
  const slides=[...root.querySelectorAll<HTMLElement>('[data-slide]')];
  const links=[...root.querySelectorAll<HTMLAnchorElement>('[data-slide-link]')];
  const prev=root.querySelector<HTMLButtonElement>('#ph-prev')!,next=root.querySelector<HTMLButtonElement>('#ph-next')!;
  const ids=['usa','states','vehicles'];let index=0;
  const show=(n:number,focus=false)=>{index=Math.max(0,Math.min(2,n));slides.forEach((s,i)=>s.hidden=i!==index);links.forEach((a,i)=>{if(i===index)a.setAttribute('aria-current','step');else a.removeAttribute('aria-current');});prev.disabled=index===0;next.disabled=index===2;root.querySelector('#ph-progress')!.textContent=`0${index+1} / 03`;if(focus){history.replaceState(null,'','#'+ids[index]);root.querySelector<HTMLElement>(`#${ids[index]}-title`)?.focus({preventScroll:true});root.scrollIntoView({block:'start'});}};
  links.forEach((a,i)=>a.addEventListener('click',e=>{e.preventDefault();show(i,true);}));prev.addEventListener('click',()=>show(index-1,true));next.addEventListener('click',()=>show(index+1,true));window.addEventListener('hashchange',()=>show(Math.max(0,ids.indexOf(location.hash.slice(1)))));show(Math.max(0,ids.indexOf(location.hash.slice(1))));root.querySelector<HTMLElement>('.ph__pager')!.hidden=false;
  const d=JSON.parse(document.querySelector('#ph-data')!.textContent!);
  const access=root.querySelector<HTMLSelectElement>('#ph-access')!,network=root.querySelector<HTMLSelectElement>('#ph-network')!;
  const number=(n:number)=>n.toLocaleString('en-US');
  const filter=()=>{const a=access.value,n=network.value;root.querySelectorAll<SVGCircleElement>('.ph__dots circle').forEach(c=>c.classList.toggle('is-filtered',(a!=='all'&&c.dataset.access!==a)||(n!=='all'&&c.dataset.network!==n)));const count=d.groups[a][n];root.querySelector('#ph-map-ports')!.textContent=`${number(count.ports)} ports`;root.querySelector('#ph-map-stations')!.textContent=`${number(count.stations)} stations · ${a==='all'?'public + private':a} access`;root.querySelector('#us-map-label')!.textContent=`US charging ports: ${a} access, ${n==='all'?'all networks':n==='tesla'?'Tesla networks':'other networks'}, ${number(count.ports)} ports`;};access.addEventListener('change',filter);network.addEventListener('change',filter);
  const borough=root.querySelector<HTMLSelectElement>('#ph-borough')!,kind=root.querySelector<HTMLSelectElement>('#ph-city-type')!;
  const cityFilter=()=>{let count=0,ports=0;d.city.forEach((s:{borough:string;dc:number;ports:number})=>{if((borough.value==='all'||s.borough===borough.value)&&(kind.value==='all'||(kind.value==='dc'?s.dc>0:s.dc===0))){count++;ports+=s.ports;}});root.querySelectorAll<SVGCircleElement>('.ph__city circle').forEach(c=>c.classList.toggle('is-filtered',(borough.value!=='all'&&c.dataset.borough!==borough.value)||(kind.value==='dc'&&Number(c.dataset.dc)===0)||(kind.value==='ac'&&Number(c.dataset.dc)>0)));root.querySelectorAll<HTMLElement>('[data-borough-row]').forEach(r=>r.classList.toggle('is-muted',borough.value!=='all'&&r.dataset.boroughRow!==borough.value));root.querySelectorAll<SVGPathElement>('[data-borough-shape]').forEach(r=>r.classList.toggle('is-muted',borough.value!=='all'&&r.dataset.boroughShape!==borough.value));root.querySelector('#ph-city-result')!.textContent=`${borough.value==='all'?'NYC':borough.value} · ${number(count)} public stations · ${number(ports)} ports at these stations`;};borough.addEventListener('change',cityFilter);kind.addEventListener('change',cityFilter);
 }
</script>
