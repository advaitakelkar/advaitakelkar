  .ph__index-fold { display: grid; grid-template-rows: 1fr; transition: grid-template-rows var(--_tokens---motion--base, .25s) ease; }
  .ph__index-ch[data-open='false'] .ph__index-fold { grid-template-rows: 0fr; }
