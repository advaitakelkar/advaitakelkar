    .ph__fold-meta { display: none; }
  }
  .ph__fold-body { padding: 12px 0 18px; }

  /* The index: a dropdown pill at the bar's right end, opening a panel of chapters that fold */
  .ph__index { position: relative; flex: 0 1 auto; min-width: 0; margin-left: auto; font-size: var(--_tokens---type--micro); }
  .ph__index > summary { list-style: none; display: inline-flex; align-items: center; gap: 8px; min-height: 34px; max-width: 100%; white-space: nowrap; padding: var(--_tokens---pill-pad--sm); border: var(--_tokens---pill-border); border-radius: var(--_tokens---radius--pill); background-color: color-mix(in srgb, var(--_tokens---color--fg) 6%, transparent); font-size: var(--_tokens---type--micro); cursor: pointer; }
  .ph__index > summary::-webkit-details-marker { display: none; }
