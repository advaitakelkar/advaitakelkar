          <svg class="ph__svg" viewBox={`0 0 ${P.w} ${P.h}`} role="img" aria-label={`Plug-in vehicles grow from ${mil(fleetNow.ev)} in 2025 to ${mil(fleetEnd.ev)} in 2040`}>
