            {data.ranked.map((r, idx) => {
              const bw = 540 / data.ranked.length;
              const x = idx * bw + 1;
              const h = Math.max(2, (r.ports / maxRankPorts) * 165);
              const y = 190 - h;
              const isTop3 = idx < 3;
              return (
                <g>
                  <rect
                    x={x.toFixed(1)}
                    y={y.toFixed(1)}
                    width={Math.max(2, bw - 2).toFixed(1)}
                    height={h.toFixed(1)}
                    class={isTop3 ? 'is-tesla' : 'is-other'}
                  >
                    <title>#{idx + 1} {r.code}: {fmt(r.ports)} public ports ({fmt(r.stations)} stations, {fmt(r.dc)} DC fast)</title>
                  </rect>
                  {(idx < 10 || idx % 5 === 0) && (
                    <text x={(x + (bw - 2) / 2).toFixed(1)} y="206" text-anchor="middle" class="ph__svg-label">
                      {r.code}
                    </text>
                  )}
                  {idx < 3 && (
                    <text x={(x + (bw - 2) / 2).toFixed(1)} y={(y - 5).toFixed(1)} text-anchor="middle" class="ph__svg-val">
                      {kfmt(r.ports)}
                    </text>
                  )}
                </g>
              );
            })}
          </svg>
          <p class="ph__note">California ({fmt(data.ranked[0].ports)}), New York ({fmt(data.ranked[1].ports)}), and Florida ({fmt(data.ranked[2].ports)}) together hold <b>{fmt(states.reduce((n, s) => n + s.groups.public.all.ports, 0))} public ports</b> ({pct(states.reduce((n, s) => n + s.groups.public.all.ports, 0), pub.ports)} of the US total). Use tabs 02, 03, and 04 to inspect each state in detail.</p>
        </div>
      </div>

      <details class="ph__details">
        <summary>Exact tabular inventory: access, network &amp; connector definitions</summary>
        <div class="ph__table-wrap" tabindex="0" role="region" aria-label="Charging infrastructure by access and network">
          <table>
            <caption>Charging infrastructure by access and network</caption>
            <thead>
              <tr><th scope="col">Access / network</th><th scope="col">Stations</th><th scope="col">Level 1 ports</th><th scope="col">Level 2 ports</th><th scope="col">DC fast ports</th><th scope="col">All ports</th></tr>
            </thead>
            <tbody>
              {(['public', 'private'] as const).flatMap((access) =>
