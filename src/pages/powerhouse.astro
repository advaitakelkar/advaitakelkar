  .ph__toc { position: sticky; top: 0; z-index: 40; margin: var(--_tokens---space--small) calc(-1 * var(--_tokens---space--micro)) 0; padding: 8px var(--_tokens---space--micro) 0; background: var(--_tokens---color--bg); }
  @media (min-width: 700px) { .ph__toc { top: var(--_tokens---layout--bar, 52px); } }
