  .ph .ph__national-svg .ph__focus-labels text { fill: var(--_tokens---color--fg); font-size: 21px; font-weight: 600; text-anchor: middle; }
  .ph__top5 { list-style: none; margin: 0 0 24px; padding: 0; display: grid; gap: 6px; font-size: var(--_tokens---type--micro); font-variant-numeric: tabular-nums; }
  .ph__top5 li { display: grid; grid-template-columns: 1.6em 8.5em minmax(0, 1fr) auto; align-items: center; gap: 10px; color: var(--_tokens---color--muted); }
  .ph__top5 li > span { display: inline-grid; place-items: center; width: 1.6em; height: 1.6em; border-radius: 50%; border: 1px solid var(--_tokens---color--line); font-size: .85em; }
