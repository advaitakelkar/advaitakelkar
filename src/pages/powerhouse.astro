          <svg class="ph__svg" viewBox={`0 0 ${P.w} ${P.h}`} role="img" aria-label={`All light-duty vehicles grow from ${mil(fleetNow.total)} in 2025 to ${mil(fleetEnd.total)} in 2040`}>
