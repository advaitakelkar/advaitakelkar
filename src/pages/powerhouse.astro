            {bookText[c.id] && <BookText text={bookText[c.id]} chapter={c.num} />}
          </header>
        )}
        <section class="ph__section" id={`s-${sec.id}`} data-section-panel={sec.id}>
          <p class="ph__kicker">{sec.num} · {sec.planned ? 'In the framework, not yet written' : sec.page ? `Book page ${sec.page}` : 'From the thesis book'}</p>
          <h2>{sec.title}</h2>
          {notesSection[sec.id] ? (
            <ol class="ph__notes-list">
