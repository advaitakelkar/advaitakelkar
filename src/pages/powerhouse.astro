  .ph__index-caret { margin-left: auto; padding-left: 8px; display: inline-flex; font-style: normal; color: var(--_tokens---color--muted); --icon-size: var(--_tokens---arrow--sm); transition: transform var(--_tokens---motion--base, .25s) ease; }
  .ph__index-ch[data-open='true'] .ph__index-caret { transform: rotate(90deg); }
  .ph__index ol button span { color: var(--_tokens---color--muted); min-width: 2.2em; }
  .ph__index button[data-planned='true'] { color: var(--_tokens---color--muted); }
  .ph__index ol button[aria-pressed='true'] { font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }
  @media (hover: hover) { .ph__index-panel button:hover { text-decoration: underline; text-underline-offset: 3px; } }
  @media (max-width: 699.98px) {
    .ph__index { margin-left: 0; width: 100%; }
    .ph__index > summary { display: flex; max-width: none; }
