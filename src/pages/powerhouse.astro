              <g><line x1={P.l} x2={P.w - P.r} y1={py(v, panelMax.ev)} y2={py(v, panelMax.ev)} class="ph__grid" /><text x={P.l - 6} y={py(v, panelMax.ev) + 3} text-anchor="end" class="ph__svg-label">{v ? `${v / 1e6}m` : '0'}</text></g>
