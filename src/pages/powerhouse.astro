  .ph__toc .ph__subtabs { margin-bottom: 0; padding-bottom: 10px; border-bottom: 1px solid var(--_tokens---color--line); }
  /* Two-level collapsible outline, styled after the About page:
     1) Outer level (.ph__ch-group): Chapter 1 · Charging Anchor, Chapter 2 · The Stop, …
     2) Inner level (.ph__fold): 1.0, 1.1, 1.2, …
     Only one chapter and one subtab are open at a time; the open one is in full ink and every
     closed chapter and subtab is muted grey. */
  .ph__reader-main { display: flex; flex-direction: column; gap: 0; padding-top: 8px; }
  .ph__ch-group { scroll-margin-top: calc(var(--ph-toc-h, 140px) + 68px); }
  .ph__ch-group[open] + .ph__ch-group { margin-top: 24px; }
  .ph__ch-sum {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 8px 20px 10px;
    border-bottom: 1px solid var(--_tokens---color--line-soft);
    cursor: pointer;
    user-select: none;
  }
  .ph__ch-sum::-webkit-details-marker { display: none; }
