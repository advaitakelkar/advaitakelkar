  .ph__intro { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr)); gap: var(--_tokens---space--small); padding: var(--_tokens---space--small) 0; border-bottom: 1px solid var(--_tokens---color--line); }
  .ph__intro-col { display: flex; flex-direction: column; align-items: flex-start; gap: 12px; }
  .ph__intro p:not(.ph__kicker) { font-size: var(--_tokens---type--small); line-height: 1.5; margin: 0; max-width: 64ch; }
  .ph__intro p.ph__intro-claim { font-size: var(--_tokens---type--medium); line-height: 1.15; letter-spacing: -.03em; }
  /* Small pill button below Abstract (bottom-left) that opens the 90% screen Mindmap Lightbox */
  .ph__mm-trigger {
    display: inline-flex;
