  .ph h1 { font-size: clamp(2rem, 1.2rem + 3.2vw, 4.5rem); line-height: 1.05; letter-spacing: -.045em; font-weight: var(--_tokens---weight--base); margin: 0 0 16px; }
  .ph__heading > p:last-child { font-size: var(--_tokens---type--small); margin: 0; line-height: 1.45; }
  .ph h2 { font-size: var(--_tokens---type--small); font-weight: 500; line-height: 1.35; margin: 0; }
  .ph h3 { font-size: var(--_tokens---type--micro); font-weight: 600; margin: 0; }
  .ph__state-jump { color: inherit; text-decoration: none; border-bottom: 1px solid var(--_tokens---color--line); }
  .ph__split { display: grid; grid-template-columns: minmax(0, 1.65fr) minmax(0, 1.05fr); gap: var(--_tokens---space--small); align-items: start; }
  .ph__filters { display: flex; gap: 12px; flex-wrap: wrap; }
  .ph__filters label { display: grid; gap: 4px; font-size: var(--_tokens---type--micro); min-width: 0; max-width: 100%; }
  .ph select { font: inherit; color: inherit; background: var(--_tokens---color--bg); border: 1px solid var(--_tokens---color--line); border-radius: var(--_tokens---radius--small); min-height: 44px; padding: 8px 32px 8px 12px; max-width: 100%; }
  .ph__map { margin: 8px 0 0; }
  /* Zoomable maps (src/lib/powerhouse-map.ts): one canvas each, drawn in the page's own
     ink. The canvas, tip, hint and buttons are made in script, so their rules are global. */
  .ph__mapbox { position: relative; width: 100%; aspect-ratio: 16 / 10; min-height: 320px; border: 1px solid var(--_tokens---color--line); border-radius: var(--_tokens---radius--small); overflow: hidden; background: var(--_tokens---color--bg); touch-action: pan-y; }
  .ph__mapbox--city { aspect-ratio: 1 / 1; }
