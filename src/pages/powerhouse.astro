                  <rect x={x} y={py(f.ev, panelMax.ev)} width={bw} height={py(f.bev, panelMax.ev) - py(f.ev, panelMax.ev)} class="is-phev"><title>{f.year}: {fmt(f.phev)} plug-in hybrid</title></rect>
