  .ph__stub-note { color: var(--_tokens---color--muted); }
  .ph :global(.ph__book) { display: grid; gap: var(--_tokens---space--small); }
  .ph :global(.ph__book-body) { min-width: 0; font-size: var(--_tokens---type--micro); overflow-wrap: break-word; }
  .ph :global(.ph__book-body p) { font-size: inherit; line-height: 1.65; margin: 0 0 1em; max-width: none; orphans: 3; widows: 3; }
  .ph :global(.ph__book sup) { font-size: .65em; line-height: 0; color: var(--_tokens---color--muted); }
  .ph :global(.ph__book-body .ph__book-lead) { font-size: var(--_tokens---type--small); line-height: 1.5; letter-spacing: -.01em; max-width: none; margin-bottom: 1.5em; }
