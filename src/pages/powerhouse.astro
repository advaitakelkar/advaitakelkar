---
import PageLayout from '../layouts/PageLayout.astro';
import Icon from '../components/Icon.astro';
import BookText from '../components/PowerhouseBookText.astro';
import Glance from '../components/PowerhouseGlance.astro';
import type { StackBar, Card } from '../lib/powerhouse-glance';
import data from '../data/powerhouse-analysis.json';
import networks from '../data/powerhouse-networks.json';
import roads from '../data/powerhouse-roads.json';
import bookTextData from '../data/powerhouse-book.json';
import official from '../data/powerhouse-official.json';

const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
const kfmt = (n: number) => (n >= 1e6 ? (n / 1e6).toFixed(2) + 'm' : n >= 1e3 ? (n / 1e3).toFixed(1) + 'k' : String(Math.round(n)));
const million = (n: number) => (n / 1e6).toFixed(2) + 'm';
const mil = (n: number) => (n / 1e6).toFixed(1) + 'm';
const pct = (n: number, d: number) => ((n / d) * 100).toFixed(1) + '%';

const pub = data.usa.groups.public.all;
const priv = data.usa.groups.private.all;
const allUsa = data.usa.groups.all.all;
const tesla = data.usa.groups.public.tesla;
const otherPub = data.usa.groups.public.other;
const energy = data.energyUS['2025'];
const future = data.outlook['2040'];
const base = data.outlook['2025'];
const growth = future.total / base.total;

const stateMeta: Record<string, { slug: string; slideIdx: number; planUrl: string; planLabel: string }> = {
  CA: {
    slug: 'california',
    slideIdx: 1,
    planUrl: 'https://www.energy.ca.gov/publications/2025/2024-zero-emission-vehicle-infrastructure-plan-deployment-strategy-2025-2030',
    planLabel: 'CEC Zero-Emission Vehicle Infrastructure Plan (2025–2030)',
  },
  NY: {
    slug: 'new-york',
    slideIdx: 2,
    planUrl: 'https://www.nyc.gov/html/dot/html/pr2026/expansion-of-curbside-electric-vehicle-charging.shtml',
    planLabel: 'NYC DOT Curbside Charging Expansion Report (Aug 2026)',
  },
  FL: {
    slug: 'florida',
    slideIdx: 3,
    planUrl: 'https://www.fdot.gov/emergingtechnology/home/evprogram/ev-plan',
    planLabel: 'FDOT Electric Vehicle Master Plan & Evacuation Corridors',
  },
};

const states = data.states.map((s) => {
  const name = s.name as keyof typeof data.registrations['2025'];
  const code = s.code as 'CA' | 'NY' | 'FL';
  const now = data.registrations['2025'][name];
  const prior = data.registrations['2024'][name];
  const y2020 = data.registrations['2020'][name];
  const first = data.registrations['2016'][name];
  const total = now.total * growth;
  const pubPorts = s.groups.public.all.ports;
  const privPorts = s.groups.private.all.ports;
  const allPorts = s.groups.all.all.ports;
  const plugins = now.bev + now.phev;
  const yoyPct = ((now.bev - prior.bev) / prior.bev) * 100;
  const stateNets = networks.networks
    .map((n) => ({ name: n.name, ports: n[code], share: (n[code] / pubPorts) * 100 }))
    .filter((n) => n.ports > 0)
    .sort((a, b) => b.ports - a.ports)
    .slice(0, 7);
  const maxStateNet = Math.max(...stateNets.map((n) => n.ports));

  return {
    ...s,
    code,
    meta: stateMeta[code],
    roads: roads.states[code],
    now,
    prior,
    y2020,
    first,
    plugins,
    pubPorts,
    privPorts,
    allPorts,
    usPortShare: (pubPorts / pub.ports) * 100,
    evsPerPort: plugins / pubPorts,
    dcShare: (s.groups.public.all.dc / pubPorts) * 100,
    l2Share: (s.groups.public.all.l2 / pubPorts) * 100,
    teslaShare: (s.groups.public.tesla.ports / pubPorts) * 100,
    teslaDcShare: (s.groups.public.tesla.dc / Math.max(1, s.groups.public.all.dc)) * 100,
    yoyGain: now.bev - prior.bev,
    yoyPct,
    mult2025: now.bev / first.bev,
    energy: data.energy[name],
    historic: data.fhwa2015[name],
    stateNets,
    maxStateNet,
    scenario: {
      total,
      bev: (total * future.bev) / future.total,
      phev: (total * future.phev) / future.total,
      fuel: (total * (future.total - future.bev - future.phev - future.hydrogen)) / future.total,
    },
    cagr: ((now.bev / first.bev) ** (1 / 9) - 1) * 100,
  };
});

// What each state is in this section for. Each answers one sentence of the 1.1 text, and
// every number is computed from the same snapshot the maps draw.
const nycShare = (data.city.groups.public.all.ports / states.find((s) => s.code === 'NY')!.pubPorts) * 100;
const roleOf: Record<string, { claim: string; quote: string; why: string[] }> = Object.fromEntries(
  states.map((s) => [
    s.code,
    s.code === 'CA'
      ? {
          claim: 'Scale, and a cleaner grid',
          quote: '“An electric car is only as clean as the grid behind it.”',
          why: [
            `<b>The biggest market.</b> ${fmt(s.plugins)} plug-in vehicles and ${fmt(s.pubPorts)} public plugs, ${s.usPortShare.toFixed(1)}% of every public plug in the country.`,
            `<b>Where driving electric clearly pays off.</b> The study cited in the text found a clear environmental benefit in California, because its electricity is comparatively clean.`,
            `<b>Still under pressure.</b> Even here there are ${s.evsPerPort.toFixed(1)} plug-in vehicles for every public plug, so drivers who cannot charge at home still compete for a plug.`,
          ],
        }
      : s.code === 'NY'
        ? {
            claim: 'Where home charging is not an option',
            quote: '“Home charging … is not an option for people who live in apartments or park on the street.”',
            why: [
              `<b>Half of New York City’s car owners park on the street.</b> With no driveway or garage, they cannot charge at home, so public charging has to carry their load.`,
              `<b>The city is the test, not the state.</b> Statewide there are only ${s.evsPerPort.toFixed(1)} plug-in vehicles per public plug, the lowest of the three, but just ${nycShare.toFixed(1)}% of New York’s public plugs are in the five boroughs.`,
              `<b>The plugs that exist are busy.</b> The city’s curbside pilot chargers were occupied 70% of the time.`,
            ],
          }
        : {
            claim: 'The fastest shift',
            quote: '“The shift is happening fast.”',
            why: [
              `<b>Fastest growth of the three.</b> Battery-electric cars in Florida grew ${s.mult2025.toFixed(1)}× between 2016 and 2025, about ${s.cagr.toFixed(0)}% a year.`,
              `<b>The most pressure on each plug.</b> ${s.evsPerPort.toFixed(1)} plug-in vehicles for every public plug, the highest of the three states.`,
              `<b>Built for the highway.</b> ${s.dcShare.toFixed(1)}% of its public plugs are fast chargers, strung along I-95, I-75 and I-4: the corridors where freight and long trips, “next” in the text, will need to stop.`,
            ],
          },
  ])
);

// National light-duty vehicles, 2025–2040: EIA AEO2026 Table 39, Counterfactual Baseline.
const fleet = Object.entries(official.outlookSeries as Record<string, { total: number; bev: number; phev: number }>).map(([y, v]) => ({
  year: +y, total: v.total, bev: v.bev, phev: v.phev, ev: v.bev + v.phev, share: ((v.bev + v.phev) / v.total) * 100,
}));
const fleetNow = fleet[0];
const fleetEnd = fleet[fleet.length - 1];
const evPerPortUS = fleetNow.ev / pub.ports;
const portsAtSameRatio2040 = fleetEnd.ev / evPerPortUS;
// Three small panels share an x axis (2025–2040); each has its own y.
const P = { w: 300, h: 190, l: 44, r: 14, t: 16, b: 26 };
const px = (year: number) => P.l + ((year - 2025) / 15) * (P.w - P.l - P.r);
const py = (v: number, max: number) => P.t + (1 - v / max) * (P.h - P.t - P.b);
const linePath = (pick: (f: (typeof fleet)[number]) => number, max: number) =>
  fleet.map((f, i) => `${i ? 'L' : 'M'}${px(f.year).toFixed(1)},${py(pick(f), max).toFixed(1)}`).join('');
const panelMax = { total: 350e6, ev: 125e6, share: 40 };
const panelTicks = { total: [0, 100e6, 200e6, 300e6], ev: [0, 40e6, 80e6, 120e6], share: [0, 10, 20, 30, 40] };
const rankedMax = data.ranked[0].ports;

// "At a glance" for each place (components/PowerhouseGlance.astro). One builder for the US
// and every state, so the four summaries are made the same way from the same sources.
type RoadRow = { year: number; automobiles: number; buses: number; trucks: number; motorcycles: number; total: number; note?: string };
type FuelRow = { bev: number; phev: number; fuel: number; hydrogen: number; unknown: number; total: number };
const roadOf = (official as unknown as { fhwaRoad: Record<string, RoadRow> }).fhwaRoad;
const nat = (y: string) => (official.outlookSeries as Record<string, { total: number; bev: number; phev: number }>)[y];
const fuelMix = (title: string, r: FuelRow): StackBar => ({
  title, total: r.total,
  segs: [
    { label: 'Battery-electric', value: r.bev, c: 'green' },
    { label: 'Plug-in hybrid', value: r.phev, c: 'teal' },
    { label: 'Fuel, incl. hybrids', value: r.fuel, c: 'light' },
    { label: 'Other / unknown', value: r.hydrogen + r.unknown, c: 'grey' },
  ],
});
const share = (v: number, t: number) => { const p = (v / t) * 100; return p < 0.1 ? '<0.1%' : p < 10 ? p.toFixed(1) + '%' : Math.round(p) + '%'; };
const count = (v: number) => (v >= 1e6 ? (v / 1e6).toFixed(2) + 'm' : fmt(v));

function glanceOf(name: string) {
  const isUS = name === 'United States';
  const st = states.find((x) => x.name === name);
  const road = roadOf[name];
  const fuel: FuelRow = isUS
    ? { bev: nat('2025').bev, phev: nat('2025').phev, fuel: nat('2025').total - nat('2025').bev - nat('2025').phev, hydrogen: 0, unknown: 0, total: nat('2025').total }
    : data.registrations['2025'][name as 'California'];
  const plugBar = fuelMix('2025', fuel);
  const pubP = isUS ? pub.ports : st!.pubPorts, privP = isUS ? priv.ports : st!.privPorts;
  const where = (isUS ? 'the US' : name);
  const glance = {
    title: `${isUS ? 'The United States' : name} at a glance`,
    road: {
      bar: {
        title: 'road', total: road.total,
        segs: [
          { label: 'Trucks, incl. SUVs and pickups', value: road.trucks, c: 'red' },
          { label: 'Cars', value: road.automobiles, c: 'orange' },
          { label: 'Motorcycles', value: road.motorcycles, c: 'yellow' },
          { label: 'Buses', value: road.buses, c: 'blue' },
        ],
      } as StackBar,
      big: mil(road.total),
      bigLabel: `vehicles on ${isUS ? 'US' : name + '’s'} roads, ${road.year}`,
      why: `Every one of these will need energy, and the Powerhouse is meant for all road transport, not only cars. “Trucks” is the federal category, so it includes SUVs and pickups. E-bikes and scooters are not registered, so they are not counted. Source: FHWA Highway Statistics, Table MV-1.${road.note ? ' ' + road.note : ''}`,
    },
    cards: [
      {
        bar: plugBar,
        big: share(fuel.bev + fuel.phev, fuel.total),
        bigLabel: 'of cars and light trucks plug in, 2025',
        why: isUS
          ? 'Fewer than 3 in every 100 cars and light trucks on US roads plug in. National figure from EIA’s Annual Energy Outlook 2026 base year; electric trucks, buses and motorcycles are not included.'
          : `Today the stop is still rare in ${name}. State figures (AFDC registrations) cover cars and light trucks only; electric trucks, buses and motorcycles are not reported.`,
      },
      {
        bar: { title: 'where', total: 100, segs: [{ label: 'At home', value: 80, c: 'light' }, { label: 'Away from home: public and workplace', value: 20, c: 'red' }] } as StackBar,
        big: '20%',
        bigLabel: 'of charging happens away from home',
        why: 'The Powerhouse is for the one charge in five that happens away from home, and for everyone who cannot charge at home at all. National estimate from the US Department of Energy, not a figure for ' + where + '.',
        figures: false,
      },
      {
        bar: { title: 'plugs', total: pubP + privP, segs: [{ label: 'Public', value: pubP, c: 'red' }, { label: 'Private: workplace, fleet, apartments', value: privP, c: 'orange' }] } as StackBar,
        big: share(pubP, pubP + privP),
        bigLabel: `of ${isUS ? 'US' : name + '’s'} plugs away from home are public`,
        why: `What ${where} offers away from home, October 2026 (AFDC station inventory). Home chargers are not counted anywhere, so “private” means workplaces, fleets and apartment blocks that report their plugs.`,
      },
    ] as [Card, Card, Card],
  };
  const fuel2016: FuelRow = (data.registrations['2016'] as Record<string, FuelRow>)[name];
  const total2040 = isUS ? nat('2040').total : fuel.total * (nat('2040').total / nat('2025').total);
  return {
    ...glance,
    time: {
      bars: [
        fuelMix('2016', fuel2016),
        fuelMix('2025', fuel),
        {
          title: '2040', total: total2040, illustrative: true,
          segs: [
            { label: 'Battery-electric', value: total2040 * (nat('2040').bev / nat('2040').total), c: 'green' },
            { label: 'Plug-in hybrid', value: total2040 * (nat('2040').phev / nat('2040').total), c: 'teal' },
            { label: 'Fuel, incl. hybrids', value: total2040 * (1 - (nat('2040').bev + nat('2040').phev) / nat('2040').total), c: 'light' },
          ],
        } as StackBar,
      ],
      note: isUS
        ? '2016 is registered cars and light trucks (AFDC); 2025 and 2040 are EIA’s Annual Energy Outlook 2026 base year and Counterfactual Baseline outlook. As plug-in share rises from 0.2% in 2016 and 2.7% today to 38% by 2040, charging stops become an everyday civic routine.'
        : `2016 and 2025 are registered cars and light trucks (AFDC). 2040 is not a ${name} forecast: it applies the national 2040 outlook (EIA, Annual Energy Outlook 2026) to ${name}’s 2025 fleet. If it holds, the stop becomes an everyday event, which is when it is worth building for.`,
      sources: 'Sources: FHWA Highway Statistics, Table MV-1; AFDC vehicle registrations 2016 and 2025; US DOE, share of charging at home; AFDC station inventory, 18 Oct 2026; EIA AEO2026 Table 39.',
    },
  };
}
const glances: Record<string, ReturnType<typeof glanceOf>> = Object.fromEntries(['United States', 'California', 'New York', 'Florida'].map((n) => [n, glanceOf(n)]));
// Rings for the state dashboards: each segment is an arc on a circle of pathLength 100, so
// its dash length is its percentage and its offset where the previous ones ended (from 12
// o'clock, clockwise). A 1-unit gap separates segments; tiny ones keep a visible sliver.
const ring = (bar: StackBar) => {
  let at = 0;
  return bar.segs.map((g) => {
    const pct = (g.value / bar.total) * 100;
    const len = Math.max(0.6, pct - (bar.segs.length > 1 ? 1 : 0));
    const seg = { c: g.c, label: g.label, len: +len.toFixed(2), off: +(25 - at).toFixed(2) };
    at += pct;
    return seg;
  });
};

// The closing comparison: one row per measure, the three states as columns, the highest in
// each row marked. `hi` says whether the larger value is the notable one.
const compareRows = [
  { label: 'Vehicles on the road', note: 'FHWA; New York 2015, the others 2024', v: states.map((st) => roadOf[st.name].total), show: (n: number) => mil(n) },
  { label: 'Plug-in vehicles, 2025', note: 'battery-electric + plug-in hybrid', v: states.map((st) => st.plugins), show: (n: number) => fmt(n) },
  { label: 'Plug-in share of cars and light trucks, 2025', v: states.map((st) => (st.plugins / st.now.total) * 100), show: (n: number) => n.toFixed(1) + '%' },
  { label: 'Battery-electric growth, 2016–2025', v: states.map((st) => st.mult2025), show: (n: number) => n.toFixed(0) + '×' },
  { label: 'Public plugs, Oct 2026', note: 'share of all US public plugs', v: states.map((st) => st.pubPorts), show: (n: number) => fmt(n), extra: states.map((st) => st.usPortShare.toFixed(1) + '% of US') },
  { label: 'Fast chargers among public plugs', v: states.map((st) => st.dcShare), show: (n: number) => n.toFixed(0) + '%' },
  { label: 'Plug-in vehicles per public plug', note: `US average ${evPerPortUS.toFixed(0)}; higher means more drivers share each plug`, v: states.map((st) => st.evsPerPort), show: (n: number) => n.toFixed(0) },
].map((r) => ({ ...r, top: r.v.indexOf(Math.max(...r.v)) }));

// The same five bars under every state in the three-state comparison: vehicles on the road,
// plug-in share in 2016, 2025 and 2040, and today's plugs (public fast, public slow, private).
type StateBarRow = { label: string; big: string; bar: StackBar; key: StackBar['segs']; dashed?: boolean };
const stateBars: Record<string, StateBarRow[]> = Object.fromEntries(states.map((st) => {
  const g = glances[st.name] as unknown as { road: { bar: StackBar }; time: { bars: StackBar[] } };
  const pubDc = st.groups.public.all.dc, pubSlow = st.groups.public.all.l1 + st.groups.public.all.l2;
  const infra: StackBar = { title: 'infra', total: pubDc + pubSlow + st.privPorts, segs: [
    { label: 'Public fast', value: pubDc, c: 'red' },
    { label: 'Public slow', value: pubSlow, c: 'orange' },
    { label: 'Private', value: st.privPorts, c: 'blue' },
  ] };
  const rows: StateBarRow[] = [
    { label: `Vehicles on the road · ${roadOf[st.name].year}`, big: mil(g.road.bar.total), bar: g.road.bar, key: g.road.bar.segs },
    ...g.time.bars.map((b) => ({ label: b.illustrative ? `${b.title} · outlook` : `${b.title} · plug in`, big: share(b.segs[0].value + b.segs[1].value, b.total), bar: b, key: b.segs.slice(0, 2), dashed: b.illustrative })),
    { label: 'Plugs today · Oct 2026', big: fmt(infra.total), bar: infra, key: infra.segs },
  ];
  for (const r of rows) r.key = r.key.filter((x) => x.value / r.bar.total >= 0.002);
  return [st.name, rows];
}));

// The three states this section looks at, shaded on the US map and numbered by their rank in
// public plugs. Labels sit at each outline's box centre, nudged for Florida so the number
// lands on the peninsula rather than in the Gulf.
const stateName: Record<string, string> = Object.fromEntries(data.usa.states.map((st) => [
  ({ California: 'CA', Texas: 'TX', Florida: 'FL', 'New York': 'NY', Massachusetts: 'MA', Washington: 'WA', Colorado: 'CO', Georgia: 'GA', 'New Jersey': 'NJ', Illinois: 'IL' } as Record<string, string>)[st.name] ?? st.name,
  st.name,
]));
const boxOf = (d: string) => {
  const n = (d.match(/-?\d+(?:\.\d+)?/g) ?? []).map(Number);
  const xs = n.filter((_, i) => i % 2 === 0), ys = n.filter((_, i) => i % 2 === 1);
  return { x0: Math.min(...xs), x1: Math.max(...xs), y0: Math.min(...ys), y1: Math.max(...ys) };
};
const focusStates = ['CA', 'NY', 'FL'].map((code) => {
  const name = { CA: 'California', NY: 'New York', FL: 'Florida' }[code]!;
  const d = data.usa.states.find((st) => st.name === name)!.d;
  const b = boxOf(d);
  const w = b.x1 - b.x0, h = b.y1 - b.y0;
  // `to` is a point on the state's coast; `at` is the label, out in the water beside it:
  // California in the Pacific, New York in the Atlantic off Long Island, Florida off its east coast.
  const to = code === 'CA' ? { x: b.x0 + w * 0.18, y: b.y0 + h * 0.55 } : code === 'NY' ? { x: b.x1 - w * 0.06, y: b.y1 - h * 0.08 } : { x: b.x0 + w * 0.88, y: b.y0 + h * 0.55 };
  const at = code === 'CA' ? { x: b.x0 - 34, y: to.y + 6 } : code === 'NY' ? { x: b.x1 + 26, y: b.y1 + 22 } : { x: b.x1 + 36, y: to.y };
  const r1 = (n: number) => +n.toFixed(1);
  return { code, name, d, rank: data.ranked.findIndex((r) => r.code === code) + 1, x: r1(at.x), y: r1(at.y), tx: r1(to.x), ty: r1(to.y) };
});

const size = (n: number) => Math.min(4.5, 0.5 + Math.sqrt(n) * 0.3);
const topNetworks = networks.networks.slice(0, 8);
const maxNetPorts = Math.max(...topNetworks.map((n) => n.ports));
const maxRankPorts = data.ranked[0].ports;
const maxBoroPorts = Math.max(...data.city.boroughs.map((b) => b.groups.public.all.ports));

const stateColors: Record<string, string> = {
  California: 'var(--ph-red)',
  'New York': 'var(--ph-orange)',
  Florida: 'var(--ph-yellow)',
};
const stateDashes: Record<string, string | undefined> = {
  California: undefined,
  'New York': '5,3',
  Florida: '2,2.5',
};

const metricComparisons = [
  {
    label: 'Public plugs (Oct 2026)',
    values: states.map((s) => ({ name: s.name, code: s.code, val: s.groups.public.all.ports, text: fmt(s.groups.public.all.ports) })),
  },
  {
    label: 'Share of public plugs that are fast chargers',
    values: states.map((s) => ({ name: s.name, code: s.code, val: s.dcShare, text: s.dcShare.toFixed(1) + '%' })),
  },
  {
    label: 'Plug-in vehicles (2025)',
    values: states.map((s) => ({ name: s.name, code: s.code, val: s.plugins, text: kfmt(s.plugins) })),
  },
  {
    label: 'Plug-in vehicles per public plug',
    values: states.map((s) => ({ name: s.name, code: s.code, val: s.evsPerPort, text: s.evsPerPort.toFixed(1) + ' EVs/port' })),
  }
];

// Trajectory SVG coordinates (2016, 2020, 2024, 2025)
const years = [2016, 2020, 2024, 2025] as const;
const chartW = 520;
const chartH = 210;
const padL = 48;
const padR = 54;
const padT = 18;
const padB = 28;
const xForYear = (y: number) => padL + ((y - 2016) / (2025 - 2016)) * (chartW - padL - padR);
const maxBev = Math.max(...states.map((s) => s.now.bev));
const yForBev = (v: number) => padT + (1 - v / maxBev) * (chartH - padT - padB);
const maxMult = Math.max(...states.map((s) => s.now.bev / s.first.bev));
const yForMult = (m: number) => padT + (1 - (m - 1) / (maxMult - 1)) * (chartH - padT - padB);

const trajectories = states.map((s) => {
  const n = s.name as keyof typeof data.registrations['2025'];
  const pts = years.map((y) => {
    const bev = data.registrations[String(y) as keyof typeof data.registrations][n].bev;
    const phev = data.registrations[String(y) as keyof typeof data.registrations][n].phev;
    const mult = bev / s.first.bev;
    return { y, bev, phev, mult, x: xForYear(y), yAbs: yForBev(bev), yIdx: yForMult(mult) };
  });
  return {
    name: s.name,
    code: s.code,
    color: stateColors[s.name],
    dash: stateDashes[s.name],
    cagr: s.cagr,
    mult2025: s.now.bev / s.first.bev,
    pts,
    absPath: 'M' + pts.map((p) => `${p.x.toFixed(1)},${p.yAbs.toFixed(1)}`).join('L'),
    idxPath: 'M' + pts.map((p) => `${p.x.toFixed(1)},${p.yIdx.toFixed(1)}`).join('L'),
  };
});

const sources = {
  afdc: 'https://developer.nlr.gov/docs/transportation/alt-fuel-stations-v1/all/',
  regs: 'https://afdc.energy.gov/vehicle-registration',
  eia: 'https://www.eia.gov/electricity/monthly/epm_table_grapher.php?t=table_d_1',
  stateEnergy: 'https://www.eia.gov/state/seds/sep_fuel/html/fuel_eves.html',
  outlook: 'https://www.eia.gov/outlooks/aeo/supplement/excel/suptab_39.xlsx',
  fhwa: 'https://www.fhwa.dot.gov/policyinformation/statistics/2015/mv1.cfm',
  use: 'https://www.nyc.gov/mayors-office/news/2024/08/adams-administration-wins-15-million-federal-grant-build-nation-s-largest-municipal-curbside-ev',
};

// The thesis book's structure (The Powerhouse_Thesis Book_Ch1-2, contents p.5 and the
// framework flowchart p.6). Chapters are the main tabs; sections are the flow under each.
// `page` is the book page; `planned` marks sections that exist only in the framework so far.
type BookSection = { id: string; num: string; title: string; page?: number; planned?: boolean };
const book: { id: string; num: string; short: string; title: string; sections: BookSection[] }[] = [
  {
    id: 'ch1', num: '1', short: 'Charging Anchor', title: 'A Sustainable Charging Anchor',
    sections: [
      { id: '1-1', num: '1.1', title: 'Electrification and Speed', page: 9 },
      { id: '1-2', num: '1.2', title: 'The Architecture of the Stop', page: 9 },
      { id: '1-3', num: '1.3', title: 'Charge Time', page: 10 },
      { id: '1-4', num: '1.4', title: 'Public Space as Community', page: 10 },
      { id: '1-5', num: '1.5', title: 'The Anchor', page: 10 },
      { id: '1-6', num: '1.6', title: 'Argument, Objectives, and Scope', page: 11 },
      { id: '1-7', num: '1.7', title: 'Theoretical Framework', page: 11 },
      { id: '1-8', num: '1.8', title: 'Thesis Framework', page: 11 },
    ],
  },
  {
    id: 'ch2', num: '2', short: 'The Stop', title: 'The Stop: Parking, Travel and the Time to Charge',
    sections: [
      { id: '2-1', num: '2.1', title: 'A City Paved for Parking', page: 13 },
      { id: '2-2', num: '2.2', title: 'The Infrastructure of Vehicle Travel', page: 13 },
      { id: '2-3', num: '2.3', title: 'Stations, Airports and Service Areas', page: 14 },
      { id: '2-4', num: '2.4', title: 'Vehicle Size and Charging Time', page: 14 },
      { id: '2-5', num: '2.5', title: 'Regulation: Driving Breaks, Charger Standards and Zoning', page: 15 },
      { id: '2-6', num: '2.6', title: 'Faster Charging and the Future of the Stop', page: 15 },
    ],
  },
  {
    id: 'ch3', num: '3', short: 'The Public Space', title: 'The Public Space: What Each Neighbourhood Needs',
    sections: [
      { id: '3-1', num: '3.1', title: 'Human and Cultural Aspects' },
      { id: '3-2', num: '3.2', title: 'The Third Place' },
      { id: '3-3', num: '3.3', title: 'Dwelling and Spirit of Place' },
      { id: '3-4', num: '3.4', title: 'Leisure and Gathering' },
      { id: '3-5', num: '3.5', title: 'Open Without Purchase' },
      { id: '3-6', num: '3.6', title: 'From Forecourt to Plaza' },
    ],
  },
  {
    id: 'ch4', num: '4', short: 'The Programme', title: 'The Programme: Anchoring the Community Stop',
    sections: [
      { id: '4-1', num: '4.1', title: 'What Does It Need?' },
      { id: '4-2', num: '4.2', title: 'Right to the City' },
      { id: '4-3', num: '4.3', title: 'Who the Space Is For' },
      { id: '4-4', num: '4.4', title: 'Rent, Revenue, Running Costs' },
      { id: '4-5', num: '4.5', title: 'Programme by Length of Stay' },
      { id: '4-6', num: '4.6', title: 'Open to All' },
    ],
  },
  {
    id: 'ch5', num: '5', short: 'Notes', title: 'Notes and Bibliography',
    sections: [
      { id: '5-1', num: '5.1', title: 'Notes to Chapter 1' },
      { id: '5-2', num: '5.2', title: 'Notes to Chapter 2' },
      { id: '5-3', num: '5.3', title: 'Notes to Chapter 3' },
      { id: '5-4', num: '5.4', title: 'Notes to Chapter 4' },
      { id: '5-5', num: '5.5', title: 'Bibliography' },
    ],
  },
];
// The section that holds the five data slides below.
const dataSection = '1-1';

// Text transferred from the book, per section (src/data/powerhouse-book.json). `body` is HTML
// paragraphs with the book's note numbers as <sup>; `notes` keep the book's numbering from `notesStart`.
const { bibliography, ...textBlocks } = bookTextData;
const bookText: Record<string, { body: string[]; notesStart: number; notes: string[] }> = textBlocks;
// The notes leave the reading text and gather in their own chapter, numbered as in the book.
// Each <sup> in the text links to its note; each note links back to where it is cited.
const notesFor = (ch: string) =>
  Object.entries(bookText)
    .filter(([id]) => id === `ch${ch}` || id.startsWith(`${ch}-`))
    .flatMap(([id, t]) => t.notes.map((html, k) => ({ n: t.notesStart + k, html, from: id })));
const notesSection: Record<string, { ch: string; notes: ReturnType<typeof notesFor> }> = {
  '5-1': { ch: '1', notes: notesFor('1') },
  '5-2': { ch: '2', notes: notesFor('2') },
  '5-3': { ch: '3', notes: notesFor('3') },
  '5-4': { ch: '4', notes: notesFor('4') },
};

const stripHtml = (html: string) =>
  html
    .replace(/<figure[\s\S]*?<\/figure>/gi, '')
    .replace(/<sup[\s\S]*?<\/sup>/gi, '')
    .replace(/<[^>]+>/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();

const mindmapSections = book.flatMap((c) =>
  c.sections.map((s) => {
    const raw = bookText[s.id]?.body || [];
    const plain = raw.map(stripHtml).filter(Boolean).join(' ').slice(0, 380);
    return {
      id: s.id,
      num: s.num,
      title: s.title,
      chapterId: c.id,
      chapterNum: c.num,
      bodyPlain: plain ? (plain.length >= 380 ? plain + '…' : plain) : '',
      notesCount: bookText[s.id]?.notes.length || 0,
    };
  })
);

const STOP_WORDS = new Set([
  'press', 'university', 'united', 'states', 'department', 'national', 'washington',
  'london', 'cambridge', 'oxford', 'journal', 'review', 'report', 'energy', 'electric',
  'vehicle', 'vehicles', 'charging', 'new', 'york', 'public', 'space', 'spaces', 'urban',
]);

const rawBibs = bibliography.map((html, i) => {
  const plain = stripHtml(html);
  const firstChunk = plain.split(/\.\s/)[0] || plain.slice(0, 32);
  const surname = plain.split(/[,.]/)[0].trim();
  const shortAuthor = firstChunk.length > 34 ? firstChunk.slice(0, 32) + '…' : firstChunk;
  const tokens = plain
    .toLowerCase()
    .replace(/[^a-z0-9\s]/g, ' ')
    .split(/\s+/)
    .filter((w) => w.length >= 5 && !STOP_WORDS.has(w));
  return {
    id: `bib-${i + 1}`,
    idx: i + 1,
    shortAuthor,
    surname: surname.toLowerCase(),
    tokens: tokens.slice(0, 6),
    plain,
    chapters: new Set<string>(),
    sections: new Set<string>(),
  };
});

const mindmapNotes = (['1', '2', '3', '4'] as const).flatMap((ch) =>
  notesFor(ch).map((nt) => {
    const plain = stripHtml(nt.html);
    const lower = plain.toLowerCase();
    const matchedBibs = rawBibs.filter((b) => {
      if (b.surname.length >= 4 && lower.includes(b.surname)) return true;
      const hits = b.tokens.filter((t) => lower.includes(t)).length;
      return hits >= 2;
    });
    matchedBibs.forEach((b) => {
      b.chapters.add(ch);
      b.sections.add(nt.from);
    });
    const firstPart = plain.split(',')[0] || plain.slice(0, 28);
    const shortLabel = firstPart.length > 28 ? firstPart.slice(0, 26) + '…' : firstPart;
    return {
      id: `note-${ch}-${nt.n}`,
      ch,
      n: nt.n,
      fromSection: nt.from,
      notesSectionId: `5-${ch}`,
      shortLabel,
      plain,
      bibIds: matchedBibs.map((b) => b.id),
    };
  })
);

const mindmapBibs = rawBibs.map((b) => ({
  id: b.id,
  idx: b.idx,
  shortAuthor: b.shortAuthor,
  plain: b.plain,
  chapters: [...b.chapters],
  sections: [...b.sections],
}));
