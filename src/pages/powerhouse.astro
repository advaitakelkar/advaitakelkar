    font-weight: 600;
  }
  @media (hover: hover) {
    .ph__mm-trigger:hover {
      background-color: var(--_tokens---color--fg);
      border-color: var(--_tokens---color--fg);
      color: var(--_tokens---color--bg);
    }
  }
  /* Main tabs (chapters), then the chapter's sections as a flow */
  /* One pill family for every tab row, after the About page's Skillset cloud: tinted pills at
     their natural width flowing like a paragraph, each row led by a black label pill. Chapters
     take the full fill when chosen; sections and slides take a stronger tint and a hard edge. */
  .ph__chapters, .ph__subtabs, .ph__nav { display: flex; flex-wrap: wrap; align-items: center; gap: var(--_tokens---bubble-gap-y) var(--_tokens---bubble-gap-x); }
  .ph__chapters button, .ph__subtabs button, .ph__nav a, .ph__row-label { display: inline-flex; align-items: center; gap: var(--_tokens---pill-gap, 6px); min-height: 34px; padding: var(--_tokens---pill-pad--sm); border: var(--_tokens---pill-border); border-radius: var(--_tokens---radius--pill); font: inherit; font-size: var(--_tokens---type--micro); line-height: 1.2; white-space: nowrap; text-decoration: none; text-align: left; color: var(--_tokens---color--muted); background-color: color-mix(in srgb, var(--_tokens---color--fg) 6%, transparent); cursor: pointer; transition: background-color var(--_tokens---motion--base), color var(--_tokens---motion--base), border-color var(--_tokens---motion--base); }
  .ph__chapters button span, .ph__subtabs button span, .ph__nav a span { font-variant-numeric: tabular-nums; opacity: .6; }
  .ph__row-label { background-color: var(--_tokens---color--fg); border-color: var(--_tokens---color--fg); color: var(--_tokens---color--bg); letter-spacing: -0.03em; cursor: default; }
  @media (hover: hover) { .ph__chapters button:hover, .ph__subtabs button:hover, .ph__nav a:hover { background-color: color-mix(in srgb, var(--_tokens---color--fg) 12%, transparent); color: var(--_tokens---color--fg); } }
  .ph__chapters button[aria-pressed='true'], .ph__subtabs button[aria-pressed='true'], .ph__nav a[aria-current] { background-color: var(--_tokens---color--fg); border-color: var(--_tokens---color--fg); color: var(--_tokens---color--bg); }
  .ph__chapters button[aria-pressed='true'] span, .ph__subtabs button[aria-pressed='true'] span, .ph__nav a[aria-current] span { opacity: .75; }
  .ph__subtabs button[data-planned='true'] { border-style: dashed; }
  @media (pointer: coarse) { .ph__chapters button, .ph__subtabs button, .ph__nav a { min-height: 44px; } }
  .ph__tabbar { scroll-margin-top: 72px; display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin: var(--_tokens---space--small) 0 var(--_tokens---bubble-gap-y); }
  .ph__tabbar .ph__chapters { margin: 0; flex: 1 1 auto; min-width: 0; }
  @media (min-width: 1024px) { .ph__tabbar { flex-wrap: nowrap; align-items: flex-start; } .ph__tabbar .ph__chapters { flex: 1 1 auto; } .ph__index { flex: 0 1 26rem; } .ph__index > summary { display: flex; } }
  /* Section tabs: equal pills in two rows; the number leads, the name truncates */
  .ph__subtabs { margin: 0 0 var(--_tokens---space--small); }
