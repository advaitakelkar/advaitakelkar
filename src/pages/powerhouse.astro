---
import PageLayout from '../layouts/PageLayout.astro';
import Icon from '../components/Icon.astro';
import BookText from '../components/PowerhouseBookText.astro';
import data from '../data/powerhouse-analysis.json';
import networks from '../data/powerhouse-networks.json';
import roads from '../data/powerhouse-roads.json';
import bookTextData from '../data/powerhouse-book.json';
import official from '../data/powerhouse-official.json';

const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
const kfmt = (n: number) => (n >= 1e6 ? (n / 1e6).toFixed(2) + 'm' : n >= 1e3 ? (n / 1e3).toFixed(1) + 'k' : String(Math.round(n)));
const million = (n: number) => (n / 1e6).toFixed(2) + 'm';
const mil = (n: number) => (n / 1e6).toFixed(1) + 'm';
const pct = (n: number, d: number) => ((n / d) * 100).toFixed(1) + '%';

const pub = data.usa.groups.public.all;
const priv = data.usa.groups.private.all;
const allUsa = data.usa.groups.all.all;
const tesla = data.usa.groups.public.tesla;
const otherPub = data.usa.groups.public.other;
const energy = data.energyUS['2025'];
const future = data.outlook['2040'];
const base = data.outlook['2025'];
const growth = future.total / base.total;

const stateMeta: Record<string, { slug: string; slideIdx: number; kicker: string; headline: string; summary: string; contextTitle: string; contextBody: string; planUrl: string; planLabel: string }> = {
  CA: {
    slug: 'california',
    slideIdx: 2,
    kicker: '02 / California · Market scale & corridor saturation',
    headline: 'California: the national scale benchmark',
    summary: 'California holds 23.6% of all US public charging ports and over 2.08 million plug-in vehicles—the largest EV market and electricity footprint in the country.',
    contextTitle: 'Scale vs. neighborhood equity',
    contextBody: 'California leads on absolute plug-in fleet size and annual BEV additions. Yet with ~33.7 plug-in vehicles per public port, high aggregate supply still leaves dense multi-family neighborhoods underserved.',
    planUrl: 'https://www.energy.ca.gov/publications/2025/2024-zero-emission-vehicle-infrastructure-plan-deployment-strategy-2025-2030',
    planLabel: 'CEC Zero-Emission Vehicle Infrastructure Plan (2025–2030)',
  },
  NY: {
    slug: 'new-york',
    slideIdx: 3,
    kicker: '03 / New York State & NYC · Public access & street-parking dependence',
    headline: 'New York: statewide corridors vs. urban curbside reality',
    summary: 'New York ranks #2 nationally in public ports with 16.6 plug-in vehicles per port—yet in New York City, 50% of car-owning households rely on street parking without home chargers.',
    contextTitle: 'Why New York is an urban access test, not a statewide shortage',
    contextBody: 'Statewide, New York has a generous port-to-EV ratio driven by Level 2 deployments along the Thruway and Hudson Valley. Inside the five boroughs, however, only 15.9% of public ports are in NYC and half of drivers lack private garages.',
    planUrl: 'https://www.nyc.gov/html/dot/html/pr2026/expansion-of-curbside-electric-vehicle-charging.shtml',
    planLabel: 'NYC DOT Curbside Charging Expansion Report (Aug 2026)',
  },
  FL: {
    slug: 'florida',
    slideIdx: 4,
    kicker: '04 / Florida · Rapid fleet acceleration & DC fast corridors',
    headline: 'Florida: fastest relative growth & highest port pressure',
    summary: 'Florida has grown its battery-EV fleet 14.0× since 2016 (34.1% annual CAGR) and carries the highest ratio of plug-in vehicles per public port (35.0) among the top three states.',
    contextTitle: 'High-speed highway corridors & resilience demand',
    contextBody: 'Nearly 30% of Florida’s public ports are DC fast chargers—the highest share of the top three states—concentrated along I-95, I-75, and I-4. Rapid fleet growth is outpacing Level 2 neighborhood deployment.',
    planUrl: 'https://www.fdot.gov/emergingtechnology/home/evprogram/ev-plan',
    planLabel: 'FDOT Electric Vehicle Master Plan & Evacuation Corridors',
  },
};

const states = data.states.map((s) => {
  const name = s.name as keyof typeof data.registrations['2025'];
  const code = s.code as 'CA' | 'NY' | 'FL';
  const now = data.registrations['2025'][name];
  const prior = data.registrations['2024'][name];
  const y2020 = data.registrations['2020'][name];
  const first = data.registrations['2016'][name];
  const total = now.total * growth;
  const pubPorts = s.groups.public.all.ports;
  const privPorts = s.groups.private.all.ports;
  const allPorts = s.groups.all.all.ports;
  const plugins = now.bev + now.phev;
  const yoyPct = ((now.bev - prior.bev) / prior.bev) * 100;
  const stateNets = networks.networks
    .map((n) => ({ name: n.name, ports: n[code], share: (n[code] / pubPorts) * 100 }))
    .filter((n) => n.ports > 0)
    .sort((a, b) => b.ports - a.ports)
    .slice(0, 7);
  const maxStateNet = Math.max(...stateNets.map((n) => n.ports));

  return {
    ...s,
    code,
    meta: stateMeta[code],
    roads: roads.states[code],
    now,
    prior,
    y2020,
    first,
    plugins,
    pubPorts,
    privPorts,
    allPorts,
    usPortShare: (pubPorts / pub.ports) * 100,
    evsPerPort: plugins / pubPorts,
    dcShare: (s.groups.public.all.dc / pubPorts) * 100,
    l2Share: (s.groups.public.all.l2 / pubPorts) * 100,
    teslaShare: (s.groups.public.tesla.ports / pubPorts) * 100,
    teslaDcShare: (s.groups.public.tesla.dc / Math.max(1, s.groups.public.all.dc)) * 100,
    yoyGain: now.bev - prior.bev,
    yoyPct,
    mult2025: now.bev / first.bev,
    energy: data.energy[name],
    historic: data.fhwa2015[name],
    stateNets,
    maxStateNet,
    scenario: {
      total,
      bev: (total * future.bev) / future.total,
      phev: (total * future.phev) / future.total,
      fuel: (total * (future.total - future.bev - future.phev - future.hydrogen)) / future.total,
    },
    cagr: ((now.bev / first.bev) ** (1 / 9) - 1) * 100,
  };
});

// What each state is in this section for. Each answers one sentence of the 1.1 text, and
// every number is computed from the same snapshot the maps draw.
const nycShare = (data.city.groups.public.all.ports / states.find((s) => s.code === 'NY')!.pubPorts) * 100;
const roleOf: Record<string, { claim: string; quote: string; why: string[] }> = Object.fromEntries(
  states.map((s) => [
    s.code,
    s.code === 'CA'
      ? {
          claim: 'Scale, and a cleaner grid',
          quote: '“An electric car is only as clean as the grid behind it.”',
          why: [
            `<b>The biggest market.</b> ${fmt(s.plugins)} plug-in vehicles and ${fmt(s.pubPorts)} public ports, ${s.usPortShare.toFixed(1)}% of every public port in the country.`,
            `<b>Where driving electric clearly pays off.</b> The study cited in the text found a clear environmental benefit in California, because its electricity is comparatively clean.`,
            `<b>Still under pressure.</b> Even here there are ${s.evsPerPort.toFixed(1)} plug-in vehicles for every public port, so drivers who cannot charge at home still compete for a plug.`,
          ],
        }
      : s.code === 'NY'
        ? {
            claim: 'Where home charging is not an option',
            quote: '“Home charging … is not an option for people who live in apartments or park on the street.”',
            why: [
              `<b>Half of New York City’s car owners park on the street.</b> With no driveway or garage, they cannot charge at home, so public charging has to carry their load.`,
              `<b>The city is the test, not the state.</b> Statewide there are only ${s.evsPerPort.toFixed(1)} plug-in vehicles per public port, the lowest of the three, but just ${nycShare.toFixed(1)}% of New York’s public ports are in the five boroughs.`,
              `<b>The plugs that exist are busy.</b> The city’s curbside pilot chargers were occupied 70% of the time.`,
            ],
          }
        : {
            claim: 'The fastest shift',
            quote: '“The shift is happening fast.”',
            why: [
              `<b>Fastest growth of the three.</b> Battery-electric cars in Florida grew ${s.mult2025.toFixed(1)}× between 2016 and 2025, about ${s.cagr.toFixed(0)}% a year.`,
              `<b>The most pressure on each plug.</b> ${s.evsPerPort.toFixed(1)} plug-in vehicles for every public port, the highest of the three states.`,
              `<b>Built for the highway.</b> ${s.dcShare.toFixed(1)}% of its public ports are fast chargers, strung along I-95, I-75 and I-4: the corridors where freight and long trips, “next” in the text, will need to stop.`,
            ],
          },
  ])
);

// National light-duty vehicles, 2025–2040: EIA AEO2026 Table 39, Counterfactual Baseline.
const fleet = Object.entries(official.outlookSeries as Record<string, { total: number; bev: number; phev: number }>).map(([y, v]) => ({
  year: +y, total: v.total, bev: v.bev, phev: v.phev, ev: v.bev + v.phev, share: ((v.bev + v.phev) / v.total) * 100,
}));
const fleetNow = fleet[0];
const fleetEnd = fleet[fleet.length - 1];
const evPerPortUS = fleetNow.ev / pub.ports;
const portsAtSameRatio2040 = fleetEnd.ev / evPerPortUS;
// Three small panels share an x axis (2025–2040); each has its own y.
const P = { w: 300, h: 190, l: 44, r: 14, t: 16, b: 26 };
const px = (year: number) => P.l + ((year - 2025) / 15) * (P.w - P.l - P.r);
const py = (v: number, max: number) => P.t + (1 - v / max) * (P.h - P.t - P.b);
const linePath = (pick: (f: (typeof fleet)[number]) => number, max: number) =>
  fleet.map((f, i) => `${i ? 'L' : 'M'}${px(f.year).toFixed(1)},${py(pick(f), max).toFixed(1)}`).join('');
const panelMax = { total: 350e6, ev: 125e6, share: 40 };
const panelTicks = { total: [0, 100e6, 200e6, 300e6], ev: [0, 40e6, 80e6, 120e6], share: [0, 10, 20, 30, 40] };
const rankedMax = data.ranked[0].ports;

const size = (n: number) => Math.min(4.5, 0.5 + Math.sqrt(n) * 0.3);
const topNetworks = networks.networks.slice(0, 8);
const maxNetPorts = Math.max(...topNetworks.map((n) => n.ports));
const maxRankPorts = data.ranked[0].ports;
const maxBoroPorts = Math.max(...data.city.boroughs.map((b) => b.groups.public.all.ports));

const stateColors: Record<string, string> = {
  California: 'var(--_tokens---color--fg)',
  'New York': 'color-mix(in srgb, var(--_tokens---color--fg) 62%, var(--_tokens---color--bg))',
  Florida: 'color-mix(in srgb, var(--_tokens---color--fg) 38%, var(--_tokens---color--bg))',
};
const stateDashes: Record<string, string | undefined> = {
  California: undefined,
  'New York': '5,3',
  Florida: '2,2.5',
};

const metricComparisons = [
  {
    label: 'Public charging ports (Oct 2026)',
    values: states.map((s) => ({ name: s.name, code: s.code, val: s.groups.public.all.ports, text: fmt(s.groups.public.all.ports) })),
  },
  {
    label: 'DC fast share of public ports',
    values: states.map((s) => ({ name: s.name, code: s.code, val: s.dcShare, text: s.dcShare.toFixed(1) + '%' })),
  },
  {
    label: 'Registered plug-in fleet (BEV + PHEV · 2025)',
    values: states.map((s) => ({ name: s.name, code: s.code, val: s.plugins, text: kfmt(s.plugins) })),
  },
  {
    label: 'Fleet pressure: plug-in vehicles per public port¹',
    values: states.map((s) => ({ name: s.name, code: s.code, val: s.evsPerPort, text: s.evsPerPort.toFixed(1) + ' EVs/port' })),
  },
  {
    label: '1-year BEV fleet surge (2024 → 2025)',
    values: states.map((s) => ({ name: s.name, code: s.code, val: s.yoyPct, text: `+${s.yoyPct.toFixed(1)}% (+${kfmt(s.yoyGain)})` })),
  },
  {
    label: 'Modeled vehicle electricity use (2024 · GWh)²',
    values: states.map((s) => ({ name: s.name, code: s.code, val: s.energy.total, text: fmt(s.energy.total) + ' GWh' })),
  },
];

// Trajectory SVG coordinates (2016, 2020, 2024, 2025)
const years = [2016, 2020, 2024, 2025] as const;
const chartW = 520;
const chartH = 210;
const padL = 48;
const padR = 54;
const padT = 18;
const padB = 28;
const xForYear = (y: number) => padL + ((y - 2016) / (2025 - 2016)) * (chartW - padL - padR);
const maxBev = Math.max(...states.map((s) => s.now.bev));
const yForBev = (v: number) => padT + (1 - v / maxBev) * (chartH - padT - padB);
const maxMult = Math.max(...states.map((s) => s.now.bev / s.first.bev));
const yForMult = (m: number) => padT + (1 - (m - 1) / (maxMult - 1)) * (chartH - padT - padB);

const trajectories = states.map((s) => {
  const n = s.name as keyof typeof data.registrations['2025'];
  const pts = years.map((y) => {
    const bev = data.registrations[String(y) as keyof typeof data.registrations][n].bev;
    const phev = data.registrations[String(y) as keyof typeof data.registrations][n].phev;
    const mult = bev / s.first.bev;
    return { y, bev, phev, mult, x: xForYear(y), yAbs: yForBev(bev), yIdx: yForMult(mult) };
  });
  return {
    name: s.name,
    code: s.code,
    color: stateColors[s.name],
    dash: stateDashes[s.name],
    cagr: s.cagr,
    mult2025: s.now.bev / s.first.bev,
    pts,
    absPath: 'M' + pts.map((p) => `${p.x.toFixed(1)},${p.yAbs.toFixed(1)}`).join('L'),
    idxPath: 'M' + pts.map((p) => `${p.x.toFixed(1)},${p.yIdx.toFixed(1)}`).join('L'),
  };
});

const sources = {
  afdc: 'https://developer.nlr.gov/docs/transportation/alt-fuel-stations-v1/all/',
  regs: 'https://afdc.energy.gov/vehicle-registration',
  eia: 'https://www.eia.gov/electricity/monthly/epm_table_grapher.php?t=table_d_1',
  stateEnergy: 'https://www.eia.gov/state/seds/sep_fuel/html/fuel_eves.html',
  outlook: 'https://www.eia.gov/outlooks/aeo/supplement/excel/suptab_39.xlsx',
  fhwa: 'https://www.fhwa.dot.gov/policyinformation/statistics/2015/mv1.cfm',
  use: 'https://www.nyc.gov/mayors-office/news/2024/08/adams-administration-wins-15-million-federal-grant-build-nation-s-largest-municipal-curbside-ev',
};

// The thesis book's structure (The Powerhouse_Thesis Book_Ch1-2, contents p.5 and the
// framework flowchart p.6). Chapters are the main tabs; sections are the flow under each.
// `page` is the book page; `planned` marks sections that exist only in the framework so far.
type BookSection = { id: string; num: string; title: string; page?: number; planned?: boolean };
const book: { id: string; num: string; short: string; title: string; sections: BookSection[] }[] = [
  {
    id: 'ch1', num: '1', short: 'Charging Anchor', title: 'A Sustainable Charging Anchor',
    sections: [
      { id: '1-1', num: '1.1', title: 'Electrification and Speed', page: 9 },
      { id: '1-2', num: '1.2', title: 'The Architecture of the Stop', page: 9 },
      { id: '1-3', num: '1.3', title: 'Charge Time', page: 10 },
      { id: '1-4', num: '1.4', title: 'Public Space as Community', page: 10 },
      { id: '1-5', num: '1.5', title: 'The Anchor', page: 10 },
      { id: '1-6', num: '1.6', title: 'Argument, Objectives, and Scope', page: 11 },
      { id: '1-7', num: '1.7', title: 'Theoretical Framework', page: 11 },
      { id: '1-8', num: '1.8', title: 'Thesis Framework', page: 11 },
    ],
  },
  {
    id: 'ch2', num: '2', short: 'The Stop', title: 'The Stop: Parking, Travel and the Time to Charge',
    sections: [
      { id: '2-1', num: '2.1', title: 'A City Paved for Parking', page: 13 },
      { id: '2-2', num: '2.2', title: 'The Infrastructure of Vehicle Travel', page: 13 },
      { id: '2-3', num: '2.3', title: 'Stations, Airports and Service Areas', page: 14 },
      { id: '2-4', num: '2.4', title: 'Vehicle Size and Charging Time', page: 14 },
      { id: '2-5', num: '2.5', title: 'Regulation: Driving Breaks, Charger Standards and Zoning', page: 15 },
      { id: '2-6', num: '2.6', title: 'Faster Charging and the Future of the Stop', page: 15 },
    ],
  },
  {
    id: 'ch3', num: '3', short: 'The Public Space', title: 'The Public Space: What Each Neighbourhood Needs',
    sections: [
      { id: '3-1', num: '3.1', title: 'Human and Cultural Aspects', planned: true },
      { id: '3-2', num: '3.2', title: 'The Third Place', planned: true },
      { id: '3-3', num: '3.3', title: 'Dwelling and Spirit of Place', planned: true },
      { id: '3-4', num: '3.4', title: 'Leisure and Gathering', planned: true },
      { id: '3-5', num: '3.5', title: 'Open Without Purchase', planned: true },
      { id: '3-6', num: '3.6', title: 'From Forecourt to Plaza', planned: true },
    ],
  },
  {
    id: 'ch4', num: '4', short: 'The Programme', title: 'The Programme: Anchoring the Community Stop',
    sections: [
      { id: '4-1', num: '4.1', title: 'What Does It Need?', planned: true },
      { id: '4-2', num: '4.2', title: 'Right to the City', planned: true },
      { id: '4-3', num: '4.3', title: 'Who the Space Is For', planned: true },
      { id: '4-4', num: '4.4', title: 'Rent, Revenue, Running Costs', planned: true },
      { id: '4-5', num: '4.5', title: 'Programme by Length of Stay', planned: true },
      { id: '4-6', num: '4.6', title: 'Open to All', planned: true },
    ],
  },
  {
    id: 'ch5', num: '5', short: 'Notes', title: 'Notes and Bibliography',
    sections: [
      { id: '5-1', num: '5.1', title: 'Notes to Chapter 1' },
      { id: '5-2', num: '5.2', title: 'Notes to Chapter 2' },
      { id: '5-3', num: '5.3', title: 'Bibliography' },
    ],
  },
];
// The section that holds the five data slides below.
const dataSection = '1-1';

// Text transferred from the book, per section (src/data/powerhouse-book.json). `body` is HTML
// paragraphs with the book's note numbers as <sup>; `notes` keep the book's numbering from `notesStart`.
const { bibliography, ...textBlocks } = bookTextData;
const bookText: Record<string, { body: string[]; notesStart: number; notes: string[] }> = textBlocks;
// The notes leave the reading text and gather in their own chapter, numbered as in the book.
// Each <sup> in the text links to its note; each note links back to where it is cited.
const notesFor = (ch: string) =>
  Object.entries(bookText)
    .filter(([id]) => id === `ch${ch}` || id.startsWith(`${ch}-`))
    .flatMap(([id, t]) => t.notes.map((html, k) => ({ n: t.notesStart + k, html, from: id })));
const notesSection: Record<string, { ch: string; notes: ReturnType<typeof notesFor> }> = {
  '5-1': { ch: '1', notes: notesFor('1') },
  '5-2': { ch: '2', notes: notesFor('2') },
};
---

<PageLayout
  title="The Powerhouse · Charging infrastructure"
  description="Five-slide visual analysis: USA, California, New York, Florida, and Multi-State & Vehicle Comparison. Vector road networks and official federal and city sources."
  noindex
  showFooter={false}
>
  <article class="ph" data-analysis>
    <header class="ph__header">
      <a href="/powerhouse/" class="ph__brand">The Powerhouse <span>/ Infrastructure research &amp; data visualiser</span></a>
      <span class="ph__stamp">Official sources · Vector GIS + D3 SVG · 18 October 2026</span>
    </header>

    <!-- Introduction: sits above the slide nav and stays put whichever slide is open -->
    <section class="ph__intro" aria-labelledby="ph-intro-title">
      <div>
        <p class="ph__kicker" id="ph-intro-title">Abstract</p>
        <p>Road transport is going electric, and every electric vehicle has to stop to charge. Yet most charging sites are still car parks with a row of plugs, used by drivers and by no one else. This thesis proposes the Powerhouse, a new type of stop built on ground that parking already covers: chargers alongside a programme chosen for the neighbourhood, and public space open to everyone.</p>
      </div>
      <div>
        <p class="ph__kicker">Hypothesis</p>
        <p class="ph__intro-claim">An Electric Vehicle Powerhouse complex will turn charging activities into an opportunity for enhanced civic / community engagements.</p>
      </div>
    </section>

    <!-- Main tabs (the book's chapters) with the contents index as a dropdown at the right end -->
    <div class="ph__toc" data-toc>
    <div class="ph__tabbar">
    <nav class="ph__chapters" aria-label="Chapters">
      <span class="ph__row-label" aria-hidden="true">Chapters</span>
      {book.map((c, i) => (
        <button type="button" data-chapter={c.id} aria-pressed={i === 0 ? 'true' : 'false'}>
          <span>{c.num.padStart(2, '0')}</span> {c.short}
        </button>
      ))}
    </nav>
    <details class="ph__index">
      <summary><span class="ph__index-label">Index</span> <b data-index-current></b><i class="ph__index-trigger-caret" aria-hidden="true"><Icon name="chevron" dir="s" /></i></summary>
      <div class="ph__index-panel">
      {book.map((c, i) => (
        <div class="ph__index-ch" data-index-chapter={c.id} data-active={i === 0 ? 'true' : 'false'} data-open={i === 0 ? 'true' : 'false'}>
          <button type="button" class="ph__index-chtitle" data-index-toggle={c.id} aria-expanded={i === 0 ? 'true' : 'false'}><span>{c.num}</span> {c.title}<i class="ph__index-caret" aria-hidden="true"><Icon name="chevron" dir="e" /></i></button>
          <div class="ph__index-fold"><ol>
            {c.sections.map((s, j) => (
              <li>
                <button type="button" data-section={s.id} aria-pressed={i === 0 && j === 0 ? 'true' : 'false'} data-planned={s.planned ? 'true' : undefined}>
                  <span>{s.num}</span> {s.title}
                </button>
              </li>
            ))}
          </ol></div>
        </div>
      ))}
      </div>
    </details>
    </div>

    <!-- Secondary tabs: the open chapter's sections -->
    {book.map((c, i) => (
      <nav class="ph__subtabs" data-subtabs={c.id} aria-label={`Chapter ${c.num} sections`} hidden={i !== 0}>
        <span class="ph__row-label" aria-hidden="true">Chapter {c.num}</span>
        {c.sections.map((s, j) => (
          <button type="button" data-section={s.id} aria-pressed={i === 0 && j === 0 ? 'true' : 'false'} data-planned={s.planned ? 'true' : undefined} title={`${s.num} ${s.title}`}>
            <span>{s.num}</span> {s.title}
          </button>
        ))}
      </nav>
    ))}
    </div>

    <div class="ph__reader">
    <div class="ph__reader-main">

    <!-- One continuous document: each chapter's opening, then its sections in book order.
         1.1 carries the five data slides; the tabs above jump to each section. -->
    <header class="ph__chapter-head" id="ch1" data-chapter-head="ch1">
      <p class="ph__kicker">Chapter {book[0].num}</p>
      <h2>{book[0].title}</h2>
      {bookText.ch1 && <BookText text={bookText.ch1} chapter="1" />}
    </header>

    <section class="ph__section" id={`s-${dataSection}`} data-section-panel={dataSection}>
      <p class="ph__kicker">{book[0].sections[0].num} · Book page {book[0].sections[0].page}</p>
      <h2>{book[0].sections[0].title}</h2>
      {bookText[dataSection] && <BookText text={bookText[dataSection]} chapter="1" />}
    </section>

    <!-- How the five slides below answer the text above -->
    <div class="ph__evidence-intro">
      <p class="ph__kicker">The evidence for 1.1</p>
      <p>The text makes three claims: the shift to electric is happening fast, its benefit depends on the grid, and home charging cannot serve everyone, so public charging will carry more of the load. The maps test them. They start with the whole country, where every public charger is today, then look closely at the three states that hold {pct(states.reduce((n, s) => n + s.groups.public.all.ports, 0), pub.ports)} of them. Each state answers one claim: <b>California</b> the grid, <b>New York</b> charging away from home, <b>Florida</b> speed. The comparison sets the three side by side.</p>
    </div>

