  .ph__panels figcaption { grid-column: 1 / -1; font-size: var(--_tokens---type--micro); color: var(--_tokens---color--muted); line-height: 1.5; }
  .ph__grid { stroke: var(--_tokens---color--line); stroke-width: .6; stroke-dasharray: 2 3; }
  .ph__area { fill: color-mix(in srgb, var(--ph-red) 12%, transparent); }
  .ph__line { fill: none; stroke: var(--ph-red); stroke-width: 1.8; }
  .ph__pt { fill: var(--ph-red); }
  .ph__next { font-size: var(--_tokens---type--small); margin: var(--_tokens---space--micro) 0; }
  .ph__why-line { font-size: var(--_tokens---type--small); line-height: 1.55; max-width: 72ch; margin: var(--_tokens---space--small) 0 0; padding-top: 10px; border-top: 1px solid var(--_tokens---color--fg); }
  .ph__glossary { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr)); gap: 10px var(--_tokens---space--micro); margin: 0 0 var(--_tokens---space--small); font-size: var(--_tokens---type--micro); line-height: 1.45; }
  .ph__glossary div { padding-top: 6px; border-top: 1px solid var(--_tokens---color--line); }
  .ph__glossary dt { font-weight: 600; }
  .ph__glossary dd { margin: 2px 0 0; color: var(--_tokens---color--muted); }

  /* Every state, largest first, absolute numbers */
  .ph__rank { list-style: none; margin: 0; padding: 0; columns: 2; column-gap: 20px; font-size: 11px; font-variant-numeric: tabular-nums; }
  .ph__rank li { display: grid; grid-template-columns: 4.2em 1fr 4.4em; white-space: nowrap; align-items: center; gap: 6px; padding: 1px 0; break-inside: avoid; color: var(--_tokens---color--muted); }
  .ph__rank li b { font-weight: 400; text-align: right; }
  .ph__rank-track { height: 6px; background: color-mix(in srgb, var(--_tokens---color--fg) 6%, transparent); }
  .ph__rank-track i { display: block; height: 100%; min-width: 1px; background: var(--ph-light); }
  .ph__rank li.is-top { color: var(--_tokens---color--fg); }
  .ph__rank li.is-top b { font-weight: 600; }
  .ph__rank li.is-top .ph__rank-track i { background: var(--ph-red); }

  /* The bridge from the text to the evidence, and each state's role in the argument */
  .ph__evidence-intro { margin: var(--_tokens---space--small) 0; padding: var(--_tokens---space--micro) 0; border-top: 1px solid var(--_tokens---color--line); }
  .ph__evidence-intro p:not(.ph__kicker) { font-size: var(--_tokens---type--small); line-height: 1.6; margin: 0; max-width: 72ch; }
  .ph .ph__quote { font-size: var(--_tokens---type--small); font-style: italic; color: var(--_tokens---color--muted); margin: 0; }
  .ph .ph__quote span { font-style: normal; font-size: var(--_tokens---type--micro); }
  .ph__why { list-style: none; counter-reset: why; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr)); gap: var(--_tokens---space--micro); margin: 0 0 var(--_tokens---space--small); padding: 0; }
  .ph__why li { counter-increment: why; padding-top: 10px; border-top: 1px solid var(--_tokens---color--fg); font-size: var(--_tokens---type--micro); line-height: 1.55; }
  .ph__why li::before { content: counter(why, decimal-leading-zero); display: block; font-variant-numeric: tabular-nums; color: var(--_tokens---color--muted); margin-bottom: 4px; }
  .ph__why :global(b) { display: block; font-size: var(--_tokens---type--small); font-weight: 500; margin-bottom: 4px; }
  .ph__state-role { font-size: var(--_tokens---type--small); margin: 8px 0 12px; }
  .ph__conclusion { margin-top: var(--_tokens---space--small); padding-top: var(--_tokens---space--micro); border-top: 1px solid var(--_tokens---color--fg); }
  .ph__conclusion ol { margin: 12px 0 0; padding-left: 1.4em; display: grid; gap: 10px; font-size: var(--_tokens---type--small); line-height: 1.55; max-width: 80ch; }
  .ph__svg { display: block; width: 100%; height: auto; }
  .ph__land, .ph__land path { fill: color-mix(in srgb, var(--_tokens---color--fg) 5%, var(--_tokens---color--bg)); stroke: var(--_tokens---color--line); stroke-width: .6; }
  .ph__county path { fill: none; stroke: var(--_tokens---color--line); stroke-width: .28; }

  /* Vector road network styles */
  .ph__roads { pointer-events: none; }
  .ph__road-hwy { fill: none; stroke: var(--_tokens---color--fg); stroke-width: .38; opacity: .16; }
  .ph__road-int { fill: none; stroke: var(--_tokens---color--fg); stroke-width: .65; opacity: .32; }
  .ph__city .ph__road-hwy { stroke-width: .45; opacity: .20; }
  .ph__city .ph__road-int { stroke-width: .85; opacity: .36; }

  .ph .is-tesla { fill: var(--ph-accent); background: var(--ph-accent); opacity: .92; }
  .ph .is-other { fill: var(--ph-other); background: var(--ph-other); }
  .ph .is-phev { fill: var(--ph-phev); background: var(--ph-phev); }
  .ph .is-fuel { fill: var(--ph-fuel); background: var(--ph-fuel); }
  .ph__dots circle, .ph__state-dots circle { pointer-events: none; }
  .ph .is-filtered { display: none; }
  .ph .is-muted { opacity: .16; }

  .ph__map figcaption, .ph__legend { display: flex; gap: 8px 16px; flex-wrap: wrap; font-size: var(--_tokens---type--micro); color: var(--_tokens---color--muted); line-height: 1.5; margin-top: 8px; }
  .ph__key::before { content: ''; display: inline-block; width: 8px; height: 8px; margin-right: 6px; border-radius: 50%; background: var(--_tokens---color--fg); vertical-align: middle; }
  .ph__key--tesla::before { background: var(--ph-accent); }
  .ph__key--green::before { background: var(--ph-green); }
  .ph__key--teal::before { background: var(--ph-teal); }
  .ph .c-teal-fill { fill: var(--ph-teal); }
  .ph__key--other::before { background: var(--ph-other); }
  .ph__key--fuel::before { background: var(--ph-fuel); }
  .ph__key--phev::before { background: var(--ph-phev); }
  .ph__key--int::before { width: 14px; height: 2px; border-radius: 0; opacity: .55; }
  .ph__key--hwy::before { width: 14px; height: 1px; border-radius: 0; opacity: .3; }

  .ph__selection { display: flex; flex-wrap: wrap; gap: 8px 20px; justify-content: space-between; border-top: 1px solid var(--_tokens---color--line); padding-top: 12px; margin-top: 12px; font-size: var(--_tokens---type--micro); }
  .ph__summary { display: grid; gap: 16px; }
  .ph__metric { display: grid; gap: 4px; padding-bottom: 12px; border-bottom: 1px solid var(--_tokens---color--line); }
  .ph__metric > span, .ph__metric small, .ph__energy > span { font-size: var(--_tokens---type--micro); color: var(--_tokens---color--muted); }
  .ph__metric strong { font-size: clamp(1.8rem, 1rem + 2.6vw, 3.4rem); font-weight: 400; letter-spacing: -.04em; line-height: 1.08; font-variant-numeric: tabular-nums; }

  /* Visualizer cards & bars */
  .ph__viz-box { display: grid; gap: 10px; padding: 14px; border: 1px solid var(--_tokens---color--line); background: color-mix(in srgb, var(--_tokens---color--fg) 2%, transparent); }
  .ph__viz-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 24px; }
  .ph__viz-grid--one { grid-template-columns: minmax(0, 1fr); }
  .ph__viz-card { padding: 18px; border: 1px solid var(--_tokens---color--line); background: color-mix(in srgb, var(--_tokens---color--fg) 1.5%, transparent); min-width: 0; }
  .ph__viz-head { display: grid; gap: 4px; margin-bottom: 14px; }
  .ph__viz-head b { font-size: var(--_tokens---type--micro); font-weight: 600; }
  .ph__viz-head span { font-size: var(--_tokens---type--micro); color: var(--_tokens---color--muted); }
  .ph__stack-row { display: grid; gap: 5px; }
  .ph__stack-meta { display: flex; justify-content: space-between; gap: 8px; font-size: var(--_tokens---type--micro); font-variant-numeric: tabular-nums; }
  .ph__stack-meta b { font-weight: 500; }
  .ph__stack-bar { display: flex; height: 10px; overflow: hidden; background: color-mix(in srgb, var(--_tokens---color--fg) 8%, transparent); }
  .ph__stack-bar i { display: block; height: 100%; }

  /* Network & Borough horizontal bars */
  .ph__net-chart { display: grid; gap: 10px; }
  .ph__net-row { display: grid; gap: 4px; }
  .ph__net-label { display: flex; justify-content: space-between; font-size: var(--_tokens---type--micro); font-variant-numeric: tabular-nums; }
  .ph__net-label b { font-weight: 500; }
  .ph__net-label span { color: var(--_tokens---color--muted); }
  .ph__net-bar-track { display: flex; height: 9px; background: color-mix(in srgb, var(--_tokens---color--fg) 7%, transparent); overflow: hidden; }
  .ph__net-bar-track i { display: block; height: 100%; }
  .ph__net-states { display: flex; gap: 12px; font-size: 11px; color: var(--_tokens---color--muted); font-variant-numeric: tabular-nums; }

  .ph__svg-label { font-size: 9px; fill: var(--_tokens---color--muted); font-variant-numeric: tabular-nums; }
  .ph__svg-val { font-size: 9.5px; font-weight: 600; fill: var(--_tokens---color--fg); font-variant-numeric: tabular-nums; }

  /* 6-Metric State Dashboard */
  .ph__metric-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
  .ph__mcard { display: grid; gap: 8px; padding: 12px; border: 1px solid var(--_tokens---color--line); background: var(--_tokens---color--bg); }
  .ph__mcard-title { font-size: var(--_tokens---type--micro); font-weight: 500; padding-bottom: 6px; border-bottom: 1px solid var(--_tokens---color--line); }
  .ph__mrow { display: grid; grid-template-columns: 26px 1fr auto; align-items: center; gap: 8px; font-size: var(--_tokens---type--micro); font-variant-numeric: tabular-nums; }
  .ph__mcode { color: var(--_tokens---color--muted); font-weight: 500; }
  .ph__mtrack { height: 8px; background: color-mix(in srgb, var(--_tokens---color--fg) 8%, transparent); overflow: hidden; }
  .ph__mtrack i { display: block; height: 100%; }
  .ph__mval { font-weight: 400; text-align: right; }

  .ph__boro-row { display: grid; gap: 5px; padding: 4px 0; }
  .ph__boro-meta { display: flex; justify-content: space-between; gap: 8px; font-size: var(--_tokens---type--micro); font-variant-numeric: tabular-nums; }
  .ph__boro-meta b { font-weight: 500; }
  .ph__boro-meta span { color: var(--_tokens---color--muted); }
  .ph__gauge-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }

  /* Slide 05 Shift Chart */
  .ph__shift-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
  .ph__shift-card { display: grid; gap: 12px; padding: 12px; border: 1px solid var(--_tokens---color--line); background: var(--_tokens---color--bg); }
  .ph__shift-head { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; padding-bottom: 6px; border-bottom: 1px solid var(--_tokens---color--line); }
  .ph__shift-head span { font-size: 11px; color: var(--_tokens---color--muted); }
  .ph__shift-row { display: grid; gap: 5px; }
  .ph__shift-track { height: 14px; background: color-mix(in srgb, var(--_tokens---color--fg) 5%, transparent); }
  .ph__shift-bar { display: flex; height: 100%; overflow: hidden; }
  .ph__shift-bar i { display: block; height: 100%; }

  .ph__bar-label { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; font-size: var(--_tokens---type--micro); }
  .ph__bar-label b { font-weight: 400; }
  .ph__bar-label strong { font-size: var(--_tokens---type--small); font-weight: 500; }
  .ph__bar { height: 8px; overflow: hidden; background: color-mix(in srgb, var(--_tokens---color--fg) 12%, transparent); }
  .ph__fill { display: block; height: 100%; background: var(--_tokens---color--fg); }
  .ph__fill--tesla { background: var(--ph-accent); }
  .ph__note { font-size: var(--_tokens---type--micro); color: var(--_tokens---color--muted); line-height: 1.55; margin: 8px 0 0; }
  .ph__energy { display: grid; gap: 6px; border-left: 2px solid var(--ph-accent); padding: 0 0 0 14px; }
  .ph__energy strong { font-size: var(--_tokens---type--medium); font-weight: 400; letter-spacing: -.03em; font-variant-numeric: tabular-nums; }
  .ph__energy p { font-size: var(--_tokens---type--micro); line-height: 1.55; margin: 0; }
  .ph__table-wrap { overflow-x: auto; max-width: 100%; margin-top: 20px; }
  .ph table { border-collapse: collapse; width: 100%; font-size: var(--_tokens---type--micro); font-variant-numeric: tabular-nums; }
  .ph caption { text-align: left; font-weight: 500; padding-bottom: 10px; }
  .ph th, .ph td { text-align: right; padding: 10px 12px; border-bottom: 1px solid var(--_tokens---color--line); white-space: nowrap; vertical-align: top; }
  .ph th { font-weight: 500; }
  .ph thead th { color: var(--_tokens---color--muted); font-weight: 400; }
  .ph tr > :first-child { text-align: left; padding-left: 0; }
  .ph__details { margin: 20px 0; border-top: 1px solid var(--_tokens---color--line); border-bottom: 1px solid var(--_tokens---color--line); }
  .ph__details summary { padding: 16px 0; min-height: 44px; font-size: var(--_tokens---type--micro); font-weight: 500; cursor: pointer; }
  .ph__details[open] { padding-bottom: 20px; }
  .ph__definitions { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
  .ph__definitions p { font-size: var(--_tokens---type--micro); line-height: 1.6; margin: 0; }
  .ph__sources { font-size: var(--_tokens---type--micro); line-height: 1.7; color: var(--_tokens---color--muted); margin-top: 20px; }
  .ph__sources a { text-decoration: underline; text-underline-offset: 3px; }
  .ph__state-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  .ph__state-title { display: flex; align-items: baseline; gap: 12px; }
  .ph__state-title > span { font-size: var(--_tokens---type--micro); color: var(--_tokens---color--muted); }
  .ph__state-card { border-top: 1px solid var(--_tokens---color--line); padding-top: 12px; min-width: 0; }
  .ph__state-map { margin: 12px 0; }
  .ph__state-number { font-size: var(--_tokens---type--medium); letter-spacing: -.03em; font-variant-numeric: tabular-nums; margin-bottom: 12px; }
  .ph__state-number span { font-size: var(--_tokens---type--micro); letter-spacing: 0; margin-left: 8px; color: var(--_tokens---color--muted); }
  .ph__ny-grid { display: grid; grid-template-columns: 1fr 1.1fr; gap: 24px; }
  .ph__ny-copy { display: grid; align-content: start; gap: 18px; }
  .ph__ny-copy .ph__table-wrap { margin: 0; }
  .ph__city { max-height: 560px; }
  .ph__city circle { stroke: var(--_tokens---color--bg); stroke-width: .4; }
  .ph__timeline { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; border-top: 1px solid var(--_tokens---color--line); padding-top: 16px; }
  .ph__timeline span { display: grid; gap: 6px; font-size: var(--_tokens---type--micro); color: var(--_tokens---color--muted); }
  .ph__timeline b { font-size: var(--_tokens---type--medium); font-weight: 400; color: var(--_tokens---color--fg); }
  .ph__warning { font-size: var(--_tokens---type--micro); line-height: 1.6; border-left: 2px solid var(--ph-accent); padding-left: 12px; margin: 20px 0 0; max-width: 70rem; }
  .ph__growth td { text-align: left; min-width: 190px; }
  .ph__growth td > strong { display: block; font-size: var(--_tokens---type--medium); font-weight: 400; letter-spacing: -.03em; margin-bottom: 8px; }
  .ph__growth td > span, .ph__growth td > small { display: block; margin: 4px 0; }
  .ph__growth td > small { max-width: 20rem; white-space: normal; line-height: 1.5; color: var(--_tokens---color--muted); font-size: var(--_tokens---type--micro); }
  .ph__projection { background: color-mix(in srgb, var(--_tokens---color--fg) 3%, transparent); }
  .ph__mix { display: flex; height: 8px; margin-top: 12px; background: color-mix(in srgb, var(--_tokens---color--fg) 6%, transparent); }
  .ph__mix i { height: 100%; background: color-mix(in srgb, var(--_tokens---color--fg) 25%, transparent); }
  .ph__growth-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; margin: 24px 0; }
  .ph__growth-rate { font-size: var(--_tokens---type--medium); margin: 12px 0; }
  .ph__growth-rate span { display: block; font-size: var(--_tokens---type--micro); color: var(--_tokens---color--muted); margin-top: 4px; }
  .ph__history > div { display: grid; grid-template-columns: 34px 1fr 90px; align-items: center; gap: 8px; margin: 10px 0; font-size: var(--_tokens---type--micro); font-variant-numeric: tabular-nums; }
  .ph__history b { font-weight: 400; text-align: right; }
  .ph__track { height: 6px; background: color-mix(in srgb, var(--_tokens---color--fg) 8%, transparent); }
  .ph__track i { display: block; height: 100%; background: var(--ph-accent); }
  .ph__pager { display: flex; justify-content: space-between; align-items: center; gap: 16px; border-top: 1px solid var(--_tokens---color--line); padding-top: 20px; font-size: var(--_tokens---type--micro); }
  .ph__pager button:disabled { opacity: .35; cursor: default; }
  .ph :is(a, button, select, summary):focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }

  @media (max-width: 1023.98px) {
    .ph { padding-top: 24px; }
    .ph__split, .ph__ny-grid, .ph__viz-grid, .ph__metric-grid, .ph__shift-grid { grid-template-columns: 1fr; }
    .ph__summary { grid-template-columns: 1fr 1fr; }
    .ph__summary > .ph__viz-box, .ph__summary > .ph__energy { grid-column: 1 / -1; }
    .ph__definitions { grid-template-columns: 1fr; }
  }
  @media (max-width: 699.98px) {
    .ph__state-grid, .ph__growth-grid, .ph__gauge-grid, .ph__summary { grid-template-columns: 1fr; }
    .ph__state-map { max-height: 220px; }
    .ph__timeline { gap: 10px; }
    .ph__timeline span { font-size: 12px; }
    .ph__header { gap: 8px; }
    .ph__brand span { display: block; }
    .ph__nav { gap: 6px; }
    .ph__nav a { padding: 8px 10px; gap: 6px; }
    .ph th, .ph td { padding: 10px 8px; }
    .ph__growth td { min-width: 180px; }
  }

  /* 90% Screen Lightbox Modal for the Obsidian-style Citation, Notes & Bibliography Mindmap */
  .ph__mm-lightbox {
    position: fixed;
    inset: 0;
    z-index: 120;
    display: grid;
    place-items: center;
    padding: 4dvh 4vw;
    box-sizing: border-box;
  }
  .ph__mm-lightbox[hidden] {
    display: none;
  }
  .ph__mm-backdrop {
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--_tokens---color--bg) 82%, transparent);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
  }
  .ph__mm-dialog {
    position: relative;
    z-index: 1;
    width: min(90vw, 1620px);
    height: 90dvh;
    display: grid;
    grid-template-rows: auto auto minmax(0, 1fr);
    gap: 10px;
    padding: 16px 20px;
    box-sizing: border-box;
    background: var(--_tokens---color--bg);
    border: 1px solid var(--_tokens---color--line);
    box-shadow: 0 28px 80px -20px color-mix(in srgb, var(--_tokens---color--fg) 28%, transparent);
    overflow: hidden;
  }
  .ph__mm-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--_tokens---color--line);
    font-size: var(--_tokens---type--micro);
  }
  .ph__mm-head-left {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }
  .ph__mm-head-left strong {
    font-size: var(--_tokens---type--small);
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .ph__mm-stats {
    color: var(--_tokens---color--muted);
    font-variant-numeric: tabular-nums;
  }
  .ph__mm-close {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 32px;
    padding: 4px 12px;
    border: var(--_tokens---pill-border);
    border-radius: var(--_tokens---radius--pill);
    background-color: color-mix(in srgb, var(--_tokens---color--fg) 6%, transparent);
    color: var(--_tokens---color--fg);
    font: inherit;
    font-size: var(--_tokens---type--micro);
    cursor: pointer;
  }
  .ph__mm-close span {
    color: var(--_tokens---color--muted);
  }
  .ph__mm-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
    padding: 8px 12px;
    background-color: color-mix(in srgb, var(--_tokens---color--fg) 2.5%, var(--_tokens---color--bg));
    border: 1px solid var(--_tokens---color--line);
  }
  .ph__mm-search-wrap {
    flex: 1 1 16rem;
    min-width: 0;
  }
  .ph__mm-search {
    width: 100%;
    min-height: 32px;
    padding: 5px 12px;
    border: 1px solid var(--_tokens---color--line);
    border-radius: var(--_tokens---radius--pill);
    background: var(--_tokens---color--bg);
    color: var(--_tokens---color--fg);
    font: inherit;
    font-size: var(--_tokens---type--micro);
  }
  .ph__mm-search::placeholder {
    color: var(--_tokens---color--muted);
  }
  .ph__mm-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .ph__mm-pills button,
  .ph__mm-sidetabs button,
  .ph__mm-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-height: 30px;
    padding: 4px 11px;
    border: var(--_tokens---pill-border);
    border-radius: var(--_tokens---radius--pill);
    background-color: color-mix(in srgb, var(--_tokens---color--fg) 6%, transparent);
    color: var(--_tokens---color--muted);
    font: inherit;
    font-size: var(--_tokens---type--micro);
    line-height: 1.2;
    cursor: pointer;
    transition: background-color var(--_tokens---motion--base), color var(--_tokens---motion--base), border-color var(--_tokens---motion--base);
  }
  .ph__mm-pills button[aria-pressed='true'],
  .ph__mm-sidetabs button[aria-pressed='true'],
  .ph__mm-btn--primary {
    background-color: var(--_tokens---color--fg);
    border-color: var(--_tokens---color--fg);
    color: var(--_tokens---color--bg);
  }
  @media (hover: hover) {
    .ph__mm-pills button:hover,
    .ph__mm-sidetabs button:hover,
    .ph__mm-btn:hover,
    .ph__mm-close:hover {
      background-color: color-mix(in srgb, var(--_tokens---color--fg) 14%, transparent);
      color: var(--_tokens---color--fg);
    }
    .ph__mm-pills button[aria-pressed='true']:hover,
    .ph__mm-sidetabs button[aria-pressed='true']:hover,
    .ph__mm-btn--primary:hover {
      background-color: var(--_tokens---color--fg);
      color: var(--_tokens---color--bg);
    }
  }
  .ph__mm-workspace {
    display: grid;
    grid-template-columns: minmax(0, 1.95fr) minmax(19rem, 0.9fr);
    gap: 12px;
    min-height: 0;
    height: 100%;
  }
  .ph__mm-stage {
    position: relative;
    min-height: 0;
    height: 100%;
    border: 1px solid var(--_tokens---color--line);
    background-color: color-mix(in srgb, var(--_tokens---color--fg) 1.5%, var(--_tokens---color--bg));
    overflow: hidden;
  }
  .ph__mm-canvas {
    display: block;
    width: 100%;
    height: 100%;
    touch-action: none;
  }
  .ph__mm-controls {
    position: absolute;
    top: 12px;
    right: 12px;
