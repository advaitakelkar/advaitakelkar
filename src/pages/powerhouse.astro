    align-items: center;
    justify-content: space-between;
    gap: 16px;
    width: 100%;
    padding-block: 6px;
    cursor: pointer;
    user-select: none;
  }
  .ph__fold[open] > .ph__fold-sum { padding-bottom: 4px; }
  .ph__fold-sum::-webkit-details-marker { display: none; }
  .ph__fold-title {
    font-size: var(--row-name);
    font-weight: var(--_tokens---weight--base);
    line-height: 1.15;
    letter-spacing: -0.015em;
    color: var(--_tokens---color--muted);
    font-variant-numeric: tabular-nums;
    flex: 1;
    min-width: 0;
    transition: color var(--_tokens---motion--base) ease;
  }
  .ph__fold[open] > .ph__fold-sum .ph__fold-title {
    color: var(--_tokens---color--fg);
  }
  .ph__fold-right { display: flex; align-items: center; gap: 12px; flex-shrink: 0; }
  .ph__fold-meta { font-size: var(--_tokens---type--micro); font-weight: var(--_tokens---weight--light); color: var(--_tokens---color--muted); white-space: nowrap; }
  .ph__fold-ring {
    font-size: var(--row-name);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 1.1em;
    height: 1.1em;
    border: 1px solid color-mix(in srgb, var(--_tokens---color--fg) 18%, transparent);
    border-radius: 50%;
    color: var(--_tokens---color--muted);
    transition: background-color var(--_tokens---motion--base) ease, border-color var(--_tokens---motion--base) ease, color var(--_tokens---motion--base) ease;
  }
