  /* Vector map (Florida): the file's print colours are overridden by layer, in site ink */
  .ph__mapbox :global(.ph-map--svg svg), .ph__mapbox:global(.ph-map--svg) :global(svg) { display: block; width: 100%; height: 100%; cursor: grab; }
  .ph__mapbox :global(svg path) { vector-effect: non-scaling-stroke; }
  .ph__mapbox :global(#land path) { fill: color-mix(in srgb, var(--_tokens---color--fg) 6%, var(--_tokens---color--bg)); }
  .ph__mapbox :global(#counties path) { stroke: color-mix(in srgb, var(--_tokens---color--fg) 18%, var(--_tokens---color--bg)); stroke-width: .5px; }
  .ph__mapbox :global(#roads-primary path) { stroke: color-mix(in srgb, var(--_tokens---color--fg) 30%, var(--_tokens---color--bg)); stroke-width: .6px; }
  .ph__mapbox :global(#roads-trunk path) { stroke: color-mix(in srgb, var(--_tokens---color--fg) 50%, var(--_tokens---color--bg)); stroke-width: .9px; }
  .ph__mapbox :global(#roads-motorway path) { stroke: color-mix(in srgb, var(--_tokens---color--fg) 78%, var(--_tokens---color--bg)); stroke-width: 1.4px; }
  .ph__mapbox :global(#outline path) { stroke: var(--_tokens---color--fg); stroke-width: 1px; }
  .ph__mapbox :global(#stations-other circle) { fill: var(--ph-orange); }
  .ph__mapbox :global(#stations-tesla circle) { fill: var(--ph-red); }
  .ph__mapbox :global(#stations-private circle) { stroke: var(--ph-blue); }
  .ph__mapbox :global(canvas) { display: block; cursor: grab; }
  .ph__mapbox :global(canvas:active) { cursor: grabbing; }
  .ph__mapbox :global(.ph-map__controls) { position: absolute; top: 10px; right: 10px; display: flex; gap: 4px; }
  .ph__mapbox :global(.ph-map__controls button) { min-width: 32px; height: 32px; padding: 0 10px; border: var(--_tokens---pill-border); border-radius: var(--_tokens---radius--pill); background: color-mix(in srgb, var(--_tokens---color--bg) 88%, transparent); color: var(--_tokens---color--fg); font: inherit; font-size: var(--_tokens---type--micro); cursor: pointer; }
  @media (hover: hover) { .ph__mapbox :global(.ph-map__controls button:hover) { background: color-mix(in srgb, var(--_tokens---color--fg) 12%, var(--_tokens---color--bg)); } }
  .ph__mapbox :global(.ph-map__tip) { position: absolute; z-index: 2; max-width: 220px; padding: 8px 10px; border: 1px solid var(--_tokens---color--line); border-radius: var(--_tokens---radius--small); background: var(--_tokens---color--bg); font-size: var(--_tokens---type--micro); line-height: 1.5; pointer-events: none; }
  .ph__mapbox :global(.ph-map__tip span) { color: var(--_tokens---color--muted); }
  .ph__mapbox :global(.ph-map__hint) { position: absolute; inset: 0; display: grid; place-items: center; background: color-mix(in srgb, var(--_tokens---color--bg) 72%, transparent); font-size: var(--_tokens---type--small); opacity: 0; pointer-events: none; transition: opacity var(--_tokens---motion--base); }
  .ph__mapbox :global(.ph-map__hint.is-on) { opacity: 1; }

  .ph__time-row { display: grid; grid-template-columns: 3.5em 1fr 13em; align-items: center; gap: 12px; font-size: var(--_tokens---type--micro); font-variant-numeric: tabular-nums; }
  .ph__time-row b { font-weight: 500; }

  /* Absolute numbers first: three steps read left to right */
  .ph__steps { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr)); gap: var(--_tokens---space--micro); margin: 0 0 var(--_tokens---space--small); }
  .ph__step { display: grid; gap: 4px; align-content: start; padding-top: 10px; border-top: 1px solid var(--_tokens---color--fg); }
  .ph__step span, .ph__step small { font-size: var(--_tokens---type--micro); color: var(--_tokens---color--muted); line-height: 1.45; }
  .ph__step small b { color: var(--_tokens---color--fg); font-weight: 600; }
  .ph__step strong { font-size: clamp(1.8rem, 1rem + 2.6vw, 3.4rem); font-weight: 400; letter-spacing: -.04em; line-height: 1.05; font-variant-numeric: tabular-nums; }

  /* The 2025–2040 chart: three panels, one shared time axis */
  .ph__panels { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr)); gap: var(--_tokens---space--micro); margin: 0 0 var(--_tokens---space--micro); }
