  :global(html.mode-dark) .ph { --ph-red: #d9877a; --ph-orange: #dba275; --ph-yellow: #cdb36d; --ph-green: #7fb597; --ph-teal: #74a8b1; --ph-blue: #8a9fd1; --ph-grey: #7c7c84; --ph-light: #34343a; }
  .ph__header { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; flex-wrap: wrap; padding-bottom: var(--_tokens---space--micro); border-bottom: 1px solid var(--_tokens---color--line); font-size: var(--_tokens---type--micro); }
