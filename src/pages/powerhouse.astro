  .ph .r-teal { stroke: var(--ph-teal); } .ph .r-blue { stroke: var(--ph-blue); } .ph .r-grey { stroke: var(--ph-grey); } .ph .r-light { stroke: var(--ph-light); }
  .ph__dash-center { position: absolute; inset: 0; display: grid; place-content: center; text-align: center; line-height: 1.1; }
