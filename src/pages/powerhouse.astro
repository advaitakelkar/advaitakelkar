            </ol>
          ) : sec.id === '5-3' ? (
            <ul class="ph__bib-list">{bibliography.map((b) => <li set:html={b} />)}</ul>
          ) : bookText[sec.id] ? (
            <BookText text={bookText[sec.id]} chapter={c.num} />
          ) : (
            <p class="ph__stub-note">To be transferred from the thesis book.</p>
          )}
        </section>
      </Fragment>
    ))}
    </div>
    </div>
  </article>

