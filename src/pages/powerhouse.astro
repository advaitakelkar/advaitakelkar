  .ph__index[open] > summary .ph__index-label { color: inherit; opacity: .65; }
  .ph__index-panel { position: absolute; right: 0; top: calc(100% + 8px); z-index: 60; width: min(26rem, calc(100vw - 32px)); max-height: min(70dvh, 36rem); overflow-y: auto; padding: 16px; border: 1px solid var(--_tokens---color--line); border-radius: var(--_tokens---radius--medium); background-color: color-mix(in srgb, var(--_tokens---color--bg) 85%, transparent); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); }
  .ph__index-ch + .ph__index-ch { margin-top: 8px; padding-top: 8px; border-top: 1px solid var(--_tokens---color--line); }
  .ph__index button { display: flex; gap: 8px; width: 100%; min-height: 36px; padding: 6px 0; border: 0; background: none; font: inherit; color: inherit; text-align: left; cursor: pointer; }
  .ph__index button span { font-variant-numeric: tabular-nums; flex: 0 0 auto; }
