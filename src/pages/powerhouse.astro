  .ph :global(.ph__book-body .ph__book-tscroll) { overflow-x: auto; }
  .ph :global(.ph__book-body .ph__book-table table) { width: 100%; min-width: 36rem; border-collapse: collapse; font-size: var(--_tokens---type--micro); font-variant-numeric: tabular-nums; }
  .ph :global(.ph__book-body .ph__book-table th), .ph :global(.ph__book-body .ph__book-table td) { text-align: left; vertical-align: top; padding: 8px 12px 8px 0; border-bottom: 1px solid var(--_tokens---color--line); }
  .ph :global(.ph__book-body .ph__book-table thead th) { font-weight: 600; border-bottom-color: var(--_tokens---color--fg); }
  .ph :global(.ph__book-body .ph__book-table tbody th) { font-weight: 500; }
  .ph :global(.ph__book-body .ph__book-tnote) { font-size: var(--_tokens---type--micro); color: var(--_tokens---color--muted); line-height: 1.5; margin: 8px 0 0; max-width: none; }
