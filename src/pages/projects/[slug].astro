---
import { projectThumbnail } from '../../lib/projectImages';
import { projectTemplate } from "../../lib/projectTemplates";
import Icon from '../../components/Icon.astro';
import fs from 'node:fs';
import path from 'node:path';
import { getCollection, getEntry } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import VGScrollExhibition from '../../components/VGScrollExhibition.astro';
import RenderRooms from '../../components/RenderRooms.astro';
import { isPlaceholder, realText, publicFileExists } from '../../lib/content';
import Arrow from '../../components/Arrow.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map(p => ({
    params: { slug: p.id },
    props: { project: p },
  }));
}

const { project } = Astro.props;
const { data } = project;

// Resolve tag and category references
const tags = await Promise.all((data.tags ?? []).map(t => getEntry(t)));
const category = data.category ? await getEntry(data.category) : null;

/* A project with `views` is renders, not photographs: the deck shows the one
   chosen image per view, and the alternates hang off it as variations rather
   than padding the count. See the note on the schema. */
const views = (data.views ?? []).filter((v: any) => v?.image);
const gallery = views.length
  ? views.map((v: any) => v.image)
  : (data.multiImage ?? []).filter(Boolean);
let allImages = views.length ? gallery : [data.coverImage, ...gallery].filter(Boolean);
let hasImages = allImages.length > 0;
/* Keyed by the image the deck shows, so the client can find a view's
   alternates from whatever is on screen without carrying an index around. */
const variationsByImage: Record<string, string[]> = {};
views.forEach((v: any) => { if (v.variations?.length) variationsByImage[v.image] = v.variations; });

const firstTag = tags.find(t => t);
const yearLoc = [data.year, data.location].filter(Boolean).join(', ');

// ── The filter pills an AIworks page carries ──────────────────────────────
// The same row a project card shows in a listing: the facts that place the
// project, then the three axes — bucket, studio, discipline. A free-text field
// that merely restates an axis is dropped rather than printed again, the same
// dedupe ProjectStackCard does, so "SCAD" never appears as both a Client and a
// studio. Each pill hands its value to the projects page.
const studioEntry = data.studio ? await getEntry(data.studio) : null;
const pillKey = (v: string) => v.toLowerCase().replace(/[^a-z0-9]/g, '');
const categoryLabel = category?.data.displayName ?? '';
const studioLabel = studioEntry?.data.displayName ?? '';
const tagNames = tags.filter(Boolean).map((t: any) => t.data.name);
const axisLabels = new Set(
  [categoryLabel, studioLabel, ...tagNames].filter(Boolean).map(v => pillKey(String(v)))
);
// People registry — avatar portrait per collaborator (files in /images/people/)
const PEOPLE: Record<string, string> = {
  'Advaita Kelkar':  '/images/people/advaita-kelkar.jpg',
  'Nayan Mote':      '/images/people/nayan-mote.png',
  'Varun Mehta':     '/images/people/varun-mehta.jpeg',
  'Sneha Desai':     '/images/people/sneha-desai.jpeg',
  'Casimir Esbach':  '/images/people/casimir-esbach.jpeg',
  'Nicole Hammond':  '/images/people/nicole-hammond.png',
  'Ben Cho':         '/images/people/ben-cho.jpeg',
  'Pankti Thakkar':  '/images/people/pankti-thakkar.jpeg',
  'Faizan Khatri':   '/images/people/faizan-khatri.jpeg',
  'Samir Raut':      '/images/people/samir-raut.jpeg',
  'Siddhesh Kadam':  '/images/people/Siddhesh Kadam_823.jpeg',
  'Aaron Wilner':    '/images/people/Aaron-Wilner.webp',
  'Michael Hill':    '/images/people/Architecture-Michael-Hill-Fall-2019-HS_003_JJ_v1.webp',
  'Catalina Pesea-Ogletree': '/images/people/Catalina-Pesea-Ogletree.webp',
  'Devarsh Deth':    '/images/people/devarsh-deth.jpeg',
  'Dhruv Chavan':    '/images/people/dhruv-chavan.png',
};
// Samir Raut is Studio 823-only; Faizan Khatri appears on both his own tab and
// Studio 823's — never default Samir onto an FKD-tagged (or untagged) work page.
const isStudio823Tag = tags.some(t => t?.id === 'studio-823');
const isFkdTag = tags.some(t => t?.id === 'faizan-khatri');
const rawPeople: string[] = data.people?.length
  ? data.people
  : isStudio823Tag
    ? ['Samir Raut', 'Faizan Khatri', 'Advaita Kelkar']
    : isFkdTag
      ? ['Faizan Khatri', 'Advaita Kelkar']
      : ['Advaita Kelkar'];

// People row rule (same on project + category pages): professors/mentors
// first, one divider, then students/collaborators. No professor → no divider.
// The global list = always-professors; a project's own `professors:` field
// adds per-project mentors (e.g. Nayan on SHELF, Varun on Tilak Nagar).
const PROFESSOR_NAMES = ['Samir Raut', 'Faizan Khatri', 'Siddhesh Kadam', 'Casimir Esbach', 'Aaron Wilner', 'Michael Hill', 'Catalina Pesea-Ogletree'];
const projectProfessors: string[] = data.professors ?? [];
const isProfessor = (p: string) => PROFESSOR_NAMES.includes(p) || projectProfessors.includes(p);
const people: string[] = [...rawPeople.filter(isProfessor), ...rawPeople.filter(p => !isProfessor(p))];
const professorCount = people.filter(isProfessor).length;
// Index after which the single divider renders; -1 = no divider
const peopleDividerAfter = professorCount > 0 && professorCount < people.length ? professorCount - 1 : -1;

/* ── The collaboration, said in words ─────────────────────────────────────
   Every Project Template 01 project so far was made inside somebody else's
   practice — CARLO, SHLF and CONCRT with Nayan Mote Studio, XBKC with Studio
   Stumbles — and the page never said so. Two faces and a studio pill in a
   filter row is not a credit; it leaves a reader to infer the relationship
   from an avatar.

   The studio is the credit. Naming the person as well and then the studio
   "under" them read as a chain of command rather than as working together,
   which is not what these were. The person is already there — their face is
   on the same line.

   Spelled out, not the pill's abbreviation: `displayName` is "NMS" because
   that is what fits a filter chip, and this is a sentence. The studios
   collection carries the long form on `name`, which nothing else renders.
   Falls back to the collaborators' own names for a project with people but
   no studio behind them. */
const collaborators = people.filter(isProfessor);
const studioFullName = studioEntry?.data.name ?? studioLabel;
const collabNames =
  collaborators.length <= 1
    ? collaborators.join('')
    : `${collaborators.slice(0, -1).join(', ')} and ${collaborators[collaborators.length - 1]}`;
/* Only when somebody else actually worked on it. The studio is what gets
   named, but a collaborator is what makes it a collaboration: Deleuze and
   Guattari is self-initiated under Adi's own ADVT, and with the studio alone
   driving this it read "In collaboration with ADVT" — the page crediting him
   to himself. `professors:` is the test because that is the field that names
   who else was on the project. */
const collabWith = collaborators.length ? (studioFullName || collabNames) : '';
const collabCredit = collabWith ? `In collaboration with ${collabWith}` : '';

// Build dynamic breadcrumbs based on category structure
const dynamicCrumbs = [ { label: 'Home', href: '/' } ];

if (category) {
  dynamicCrumbs.push({ label: category.data.displayName, href: `/${category.id}` });
  
  // Studio is the second level under a category, so it sits between the
  // category and the project in the trail. Read from the studio field and
  // named by the studios collection, not hard-coded per studio.
  if (category.id === 'work' && data.studio) {
    const studio = await getEntry(data.studio);
    if (studio) {
      dynamicCrumbs.push({ label: studio.data.displayName, href: `/work/${studio.id}` });
    }
  }
} else {
  dynamicCrumbs.push({ label: 'Projects', href: '/projects' });
}

dynamicCrumbs.push({ label: data.name });

const template = projectTemplate(project.id, category?.id, data.template);
const isOriginalCardPage = template.cards;
const isTabChapterPage = template.chapters;
const isTabLayout = template.tabs;
/* A visualisation project draws its own middle — rooms, one image, the
   variations behind it. See RenderRooms.astro. */
const isRenders = template.renders;
/* The fixed picture beside the copy. Only where it has room to exist without
   taking any from the work — see the CSS, which confines it to 1024 and up. */
const sideImage = isRenders ? (data.sideImage ?? null) : null;
// The same slot, moving. `sideImage` is its poster when both are set.
const sideVideo = isRenders ? ((data as any).sideVideo ?? null) : null;
/* The chapters mode of Template 01. It reads as an argument rather than as a
   set of rooms, and the phone card follows from that: the description is a
   passage you choose to read, not a caption, so it goes back behind Read more
   and the subtitle is the only prose the card shows by default. */
const isChapters = isRenders && (data as any).groups === 'chapters';

// Each model stays paired with its documented production settings.
const pipeline = ((data as any).pipeline ?? []) as { model: string; caption?: string }[];

/* The phone hides the Design / Making panels — they are display-scale
   headings over label/value grids, which on a 390px column collide with
   everything around them. So the facts they carried join the pills, which is
   where every other page already puts them. Deduped against the three axis
   labels, and against each other: "Freelancer" as both category and
   collaborator is one pill, not two. */
const tabFacts = (template.tabs || template.renders) ? [data.program, data.collaborator, data.client] : [];
const seenPill = new Set<string>();
const filterPills = [
  ...[data.year, data.location, data.status]
    .filter(Boolean)
    .filter(v => !axisLabels.has(pillKey(String(v)))),
  categoryLabel,
  studioLabel,
  ...tagNames,
  ...tabFacts.filter(Boolean).filter(v => !axisLabels.has(pillKey(String(v)))),
].filter(Boolean).map(String).filter(v => {
  const k = pillKey(v);
  if (seenPill.has(k)) return false;
  seenPill.add(k);
  return true;
});
const isCardPage = template.cardLayout;
const isScarpinPage = project.id === 'scarpin';

// Levenshtein distance — used to tolerate small folder-name typos when
// matching a scarpin credit against the PEOPLE registry.
function editDistance(a: string, b: string): number {
  const dp: number[][] = Array.from({ length: a.length + 1 }, () => new Array(b.length + 1).fill(0));
  for (let i = 0; i <= a.length; i++) dp[i][0] = i;
  for (let j = 0; j <= b.length; j++) dp[0][j] = j;
  for (let i = 1; i <= a.length; i++) {
    for (let j = 1; j <= b.length; j++) {
      dp[i][j] = a[i - 1] === b[j - 1]
        ? dp[i - 1][j - 1]
        : 1 + Math.min(dp[i - 1][j - 1], dp[i - 1][j], dp[i][j - 1]);
    }
  }
  return dp[a.length][b.length];
}

// Load Scarpin image data if this is the Scarpin page
let scarpinSliders: { folder: string; cleanName: string; personName: string; avatar: string | null; urls: string[] }[] = [];
if (isScarpinPage) {
  const scarpinDir = path.join(process.cwd(), 'public', 'images', 'scarpin');
  if (fs.existsSync(scarpinDir)) {
    const entries = fs.readdirSync(scarpinDir);
    for (const folder of entries) {
      if (folder.startsWith('.')) continue; // skip .DS_Store, .gitkeep
      const folderPath = path.join(scarpinDir, folder);
      if (fs.statSync(folderPath).isDirectory()) {
        let files = fs.readdirSync(folderPath).filter(f => /\.(jpe?g|png|webp|gif|mp4)$/i.test(f));
        if (files.length > 0) {
          files.sort();
          // Ensure a file named 'cover' (any extension) is always first
          const coverIdx = files.findIndex(f => f.toLowerCase().startsWith('cover.'));
          if (coverIdx > 0) {
            const coverFile = files.splice(coverIdx, 1)[0];
            files.unshift(coverFile);
          }
          
          const urls = files.map(f => `/images/scarpin/${folder}/${f}`);
          
          let cleanName = folder.replace(/^\d+\s*/, '').trim();
          let personName = '';
          const dashIdx = cleanName.lastIndexOf('-');
          if (dashIdx !== -1) {
            personName = cleanName.substring(dashIdx + 1).trim();
            cleanName = cleanName.substring(0, dashIdx).trim();
          }

          let avatar = null;
          if (personName) {
            const searchName = personName.toLowerCase().replace(/[^a-z]/g, '');
            // Exact match first; fall back to a small edit-distance so a folder
            // typo (e.g. "kelakar" vs "kelkar") doesn't silently drop the avatar.
            let bestKey: string | null = null;
            let bestDist = Infinity;
            for (const key of Object.keys(PEOPLE)) {
              const keyNorm = key.toLowerCase().replace(/[^a-z]/g, '');
              const dist = editDistance(keyNorm, searchName);
              if (dist < bestDist) { bestDist = dist; bestKey = key; }
            }
            const threshold = Math.max(2, Math.floor(searchName.length * 0.2));
            if (bestKey && bestDist <= threshold) {
              avatar = PEOPLE[bestKey];
              personName = bestKey;
            } else {
              personName = personName.split(' ').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
            }
          }

          scarpinSliders.push({ folder, cleanName, personName, avatar, urls });
        }
      }
    }
  }
  // Sort folders alphabetically (e.g., "01 Scarpa...", "02 Roberto...")
  scarpinSliders.sort((a, b) => a.folder.localeCompare(b.folder));
}

// For Scarpin, synthesize allImages from the person folder covers so the
// tab-layout slider has something to show.
if (isScarpinPage && !hasImages && scarpinSliders.length > 0) {
  allImages = scarpinSliders.map(s => s.urls[0]).filter(Boolean);
  hasImages = allImages.length > 0;
}

/* Template 01's views. A project that lists `views` keeps them; one that
   does not gets a roomless view per image — cover first, then the gallery —
   which is the same page CARLO and SHLF were built with. A project with no
   images at all gets the copy alone and no stage. */
const renderViews = views.length ? views : allImages.map((image: string) => ({ image }));
// Chapters read as tabs once there are two or more of them.
const chapterTabs = (data.chapters?.length ?? 0) > 1;

// Derive a display name from an image filename (same rules as the client script)
const isPortraits = template.namedSeries;
const frameShape = template.frame;

/* The name under a frame, derived from its filename — so the filenames are the
   contract. Three copies of this exist (here, the deck markup below, and the
   client script); keep them in step.

   The prefix strip takes ADVT_<CODE>_ one code segment at a time. It was
   `^ADVT_[A-Z_]+_`, which is greedy across underscores and therefore ate any
   single-letter segment following the code: ADVT_SP_X_23_01 came back as "23".
   Requiring 2–4 letters a segment still clears ADVT_SP_, ADVT_HF_, ADVT_SIH_,
   ADVT_RP_, ADVT_FOD_ and the two-segment ADVT_AV_GF_, and leaves a
   one-letter name part alone. */
const cardNameFromUrl = (url: string): string => {
  let filename = url.substring(url.lastIndexOf('/') + 1);
  try { filename = decodeURIComponent(filename); } catch {}
  const ext = filename.substring(filename.lastIndexOf('.'));
  let name = filename.slice(0, filename.length - ext.length);
  name = name.replace(/^ADVT_(?:[A-Z]{2,4}_)+/, '').replace(/^ADVT_SP_\s*/, '').trim();
  name = name.replace(/\s+\d+\s*$/, '').replace(/\s*\d+$/, '').trim();
  if (name.includes(' - ') || name.includes(' — ')) {
    const parts = name.split(/\s*[-—]\s*/);
    const movie = parts[0].trim().toUpperCase();
    let char = parts.slice(1).join(' - ').trim();
    if (char.toLowerCase() === 'the t 800' || char.toLowerCase() === 'the t') char = 'The T-800';
    if (char.toLowerCase() === 'o ren ishii') char = 'O-Ren Ishii';
    if (char.toLowerCase() === 'dr king schultz') char = 'Dr. King Schultz';
    return `${movie} - ${char}`;
  }
  name = name.replace(/([a-z0-9])([A-Z])/g, '$1 $2').replace(/([A-Z]+)([A-Z][a-z])/g, '$1 $2').replace(/[_-]+/g, ' ').trim();
  if (name.toLowerCase() === 'the t 800' || name.toLowerCase() === 'the t') name = 'The T-800';
  if (name.toLowerCase() === 'o ren ishii') name = 'O-Ren Ishii';
  if (name.toLowerCase() === 'dr king schultz') name = 'Dr. King Schultz';
  const raw = name || data.name;
  return isPortraits ? raw.toUpperCase() : raw;
};
const firstCardName = hasImages ? cardNameFromUrl(allImages[0]) : '';

// Download pills (Summary / Book, …) — only surface the ones whose PDF exists.
const downloads = (data.downloads ?? []).filter(d => publicFileExists(d.href));

// ── Superhero logos (sups-cards / sups-in-the-hinterland) ──
// DC + Marvel publisher logos keep their color; character/team logos render
// monochrome via CSS filter. Matched by character name in the filename.
/* Matched against the name derived from the filename, so the filenames are
   the contract. They carried six misspellings — Cygborg, Scalet Witch, Winter
   Soildier, Strom, Wonder Women, and Dr Freeze for Mr. Freeze — and these
   rules had grown alternates to tolerate them, which is how a typo becomes
   permanent. The files are spelled correctly now and the alternates are gone;
   a future misspelling should show as a missing logo rather than be absorbed. */
const LOGO_RULES: Array<{ match: RegExp; src: string; mono: boolean }> = [
  // Character logos first — publisher marks (DC/Marvel) only as a last resort
  { match: /spider/i,                                            src: '/images/logos/spiderman.png',       mono: true },
  { match: /deadpool/i,                                          src: '/images/logos/deadpool.png',        mono: true },
  { match: /captain america/i,                                   src: '/images/logos/captain-america.png', mono: true },
  { match: /wonder wom/i,                                        src: '/images/logos/wonder-women.png',    mono: true },
  { match: /batman|joker|penguin|freeze|poison ivy|harley/i,     src: '/images/logos/batman.png',          mono: true },
  { match: /superman/i,                                          src: '/images/logos/superman.png',        mono: true },
  { match: /flash/i,                                             src: '/images/logos/flash.png',           mono: true },
  { match: /green lantern/i,                                     src: '/images/logos/green-lantern.png',   mono: true },
  { match: /winter so|hulk|loki|scarlet/i,                       src: '/images/logos/avengers.png',        mono: true },
  { match: /wolverine|cyclops|storm|jean grey|professor|nightcrawler|gambit|emma frost|magneto|juggernaut/i,
                                                                 src: '/images/logos/xmen.png',            mono: true },
  { match: /martian|cyborg/i,                                    src: '/images/logos/dc.png',              mono: true },
  { match: /corleone|hagen|clemenza/i,                           src: '/images/logos/godfather.png',       mono: true },
];
/* sups-cards is deliberately NOT here. Its frames are studio portraits on
   black, and a publisher mark laid over one covers the picture it is
   describing — the character is already the subject, so the logo says
   nothing the face has not. The Hinterland and Alt-Verse frames are wide
   scenes with room in the corner for it. */
const logoProjects = ['sups-in-the-hinterland', 'alt-verse'];
const logoFor = (url: string): { src: string; mono: boolean } | null => {
  if (!logoProjects.includes(project.id)) return null;
  const name = cardNameFromUrl(url);
  return LOGO_RULES.find(r => r.match.test(name)) ?? null;
};
---

<PageLayout
  title={data.name}
  description={realText(data.smallIntro) ?? `${data.name}${data.year ? ` (${data.year})` : ''} — a project by Advaita Kelkar.`}
  ogImage={data.coverImage}
  label={data.name}
  crumbs={dynamicCrumbs}
  showFooter={true}
  activeIds={[project.id]}
>
    <article class="project-detail"
      data-project-id={project.id}
      data-project-name={data.name}
      data-is-card={isCardPage ? "true" : "false"}
      data-renders={isRenders ? "true" : "false"}
      data-is-scarpin={isScarpinPage ? "true" : "false"}
      data-category={category ? category.id : ''}
      data-tab-layout={isTabLayout ? "true" : "false"}
      data-original-card={isOriginalCardPage ? "true" : "false"}
      data-portraits={isPortraits ? "true" : "false"}
      data-frame={frameShape}
      data-template={template.name}
      data-chapters={isChapters ? "true" : "false"}
    >
      
      {isCardPage ? (
        /* CARD PAGES: Wrapped in Sticky Dashboard wrapper */
        <div class:list={["project-dashboard-wrap", (isTabLayout || isOriginalCardPage) && "is-expanded"]} id="project-dashboard">
          <header class="project-top-header" id="project-top-header">
            <div class="project-header-title-row" id="project-name-header">
              <h1 class="project-name-title" id="project-name-click">
                <span class="project-name-main">{data.name}</span>
              </h1>
              {isRenders && (
                /* Phone: the faces land here, on the name's line. Above 700
                   they go to the slot beside the subtitle instead — see
                   initRendersPeople. */
                <div class="renders-people renders-people--title" id="renders-people-title"></div>
              )}
              {(isTabLayout || isOriginalCardPage) && !isPortraits && (
                <button class="page-toggle-btn project-detail-collapse-btn" id="project-name-toggle" type="button" aria-expanded="true" aria-label="Toggle project details">
                  <Arrow />
                </button>
              )}
            </div>

            {/* Cancels whichever section the card has grown to show. Rendered
                here rather than built in script so it carries this file's
                scope attribute and uses the icon family; the phone card moves
                it in like every other piece. */}
            <button class="project-phone-close" type="button" aria-label="Close this section" hidden>
              <Icon name="close" />
            </button>

            <div class="project-card__metaline">
              {(isOriginalCardPage || isTabLayout || isRenders) ? (
                <div class="project-meta-row project-meta-row--pills">
                  {filterPills.map(v => (
                    <a
                      class="project-card__filter-pill"
                      href={`/projects?q=${encodeURIComponent(v)}`}
                      title={`Show only ${v}`}
                    >
                      <span>{v}</span>
                      <Icon name="arrow" />
                    </a>
                  ))}
                </div>
              ) : (
                <div class="project-meta-row">
                  <span class="project-card__meta-val">
                    {[yearLoc, data.status].filter(Boolean).join(', ')}
                  </span>
                  {category && (
                    <a href={`/${category.id}/`} class="project-card__meta-cat-link">
                      {category.data.displayName}
                    </a>
                  )}
                </div>
              )}
            </div>

            {pipeline.length > 0 && (
              <p class="project-pipeline" data-pipeline>
                {pipeline.map((run, i) => (
                  <>
                    {i > 0 && '; '}
                    <strong>{run.model}</strong>
                    {run.caption && <span> · {run.caption}</span>}
                  </>
                ))}
              </p>
            )}
          </header>

          <div class="project-content-grid project-content-grid--card">
            <!-- Left Column: Description Text & Name/Pagination Alignment Row -->
            <div class="project-col-left">
              <div class="project-card-info">
                {isRenders && (
                  /* A line of its own above the subtitle: the faces, then who
                     they are and whose studio this was made in. The panel is
                     moved in here by initRendersPeople; the credit is markup,
                     so it renders even before that script runs. */
                  <div class="renders-people" id="renders-people-slot">
                    {collabCredit && <p class="renders-credit">{collabCredit}</p>}
                  </div>
                )}
                <div class="project-card__row project-card__row2">
                  <div class="project-card__text-block">
                    {data.smallIntro && <p class="project-card__intro">{data.smallIntro}</p>}
                    {data.description && (
                      <div class="project-desc-readmore" id="project-desc-readmore">
                        <div class="project-card__desc project-desc-clip" id="project-desc-clip" set:html={data.description} />
                        <button
                          class="project-readmore-btn"
                          id="project-readmore-btn"
                          type="button"
                          aria-expanded="false"
                        >
                          <span class="project-readmore-label">Read more</span>
                          <Icon name="arrow" class="project-readmore-arrow" />
                        </button>
                      </div>
                    )}
                    {/* Phone only, and only where there is a reel to show. It
                        sits beside Read more in the card's actions row, and
                        the panel it opens holds the SAME video element that is
                        fixed beside the copy on a wide page — moved into the
                        card, not a second copy of a 5.3MB file. */}
                    {sideVideo && (
                      <button
                        class="project-video-btn"
                        id="project-video-btn"
                        type="button"
                        aria-expanded="false"
                      >
                        <span>Video</span>
                        <Icon name="arrow" class="project-readmore-arrow" />
                      </button>
                    )}
                    {/* "Prompt" pill / dropdown tab — reveals the Midjourney prompt box
                        (hidden behind the pill on small screens and portrait deck pages; JS hides the pill
                        when the description has no prompt box). */}
                    {!isRenders && data.description?.includes('prompt-box') && (
                      <div class="project-prompt-wrap" id="project-prompt-wrap">
                        <button class="project-prompt-btn" id="project-prompt-btn" type="button" aria-expanded="false">
                          <span>Prompt</span>
                          <Arrow class="project-prompt-arrow" />
                        </button>
                        <button class="project-prompt-close-btn" id="project-prompt-close-btn" type="button" aria-label="Close prompt" hidden>
                          <Icon name="close" />
                        </button>
                      </div>
                    )}

                    {/* Virtual Gods keeps the standard ARCHV page; the one-page
                        scroll exhibition lives further down this same page. */}
                    {project.id === 'virtual-gods' && (
                      <a class="project-exhibition-pill" href="#exhibition">
                        <span>Enter the exhibition</span>
                        <Arrow />
                      </a>
                    )}
                  </div>

                </div>

                {/* One fixed picture to read the text against, in the second
                    column beside the WHOLE copy block — the faces and credit,
                    the subtitle and the description — not just beside the
                    paragraph. A sibling of the copy rows, not a child of one.
                    Decorative: it is one of the frames already in the rail
                    below, so an empty alt keeps it out of the way. */}
                {(sideVideo || sideImage) && (
                  <figure class="renders-aside">
                    {sideVideo ? (
                      /* The video and its control are one object. The figure
                         spans the whole copy block and the picture centres
                         inside it, so a control hung off the figure would sit
                         at the bottom of the column, nowhere near the reel.

                         The source is attached in script rather than in
                         markup: the figure is display:none below 1024, but a
                         hidden muted video is still a video and downloads
                         anyway — 5.3MB a phone can never see. */
                      <div class="renders-aside__media">
                        <video
                          data-side-video={sideVideo}
                          poster={sideImage ?? undefined}
                          autoplay
                          muted
                          loop
                          playsinline
                          preload="none"
                        ></video>
                        {/* Muted is the only way a video may start on its own,
                            and the only way it should: sound you did not ask
                            for is an ambush. The control says which state you
                            are in and hands the other one over. */}
                        <button
                          class="renders-aside__sound tap-44"
                          type="button"
                          data-sound="off"
                          aria-pressed="false"
                          aria-label="Turn sound on"
                        >
                          <Icon name="sound" state="off" class="rs-off" />
                          <Icon name="sound" state="on" class="rs-on" />
                        </button>
                      </div>
                    ) : (
                      <img src={sideImage} alt="" loading="lazy" decoding="async" />
                    )}
                  </figure>
                )}
                {sideVideo && (
                  <script is:inline set:html={`(function(){
  var v = document.querySelector('.renders-aside video[data-side-video]');
  if (!v) return;
  var mq = window.matchMedia('(min-width: 1024px)');
  function sync(){
    if (mq.matches) { if (!v.src) { v.src = v.dataset.sideVideo; v.play().catch(function(){}); } }
    else if (v.src) { v.pause(); v.removeAttribute('src'); v.load(); }
  }
  sync();
  mq.addEventListener('change', sync);

  var btn = document.querySelector('.renders-aside__sound');
  if (!btn) return;
  btn.addEventListener('click', function(){
    var on = v.muted;
    v.muted = !on;
    if (on) v.play().catch(function(){});
    btn.dataset.sound = on ? 'on' : 'off';
    btn.setAttribute('aria-pressed', on ? 'true' : 'false');
    btn.setAttribute('aria-label', on ? 'Turn sound off' : 'Turn sound on');
  });
})();`} />
                )}

                {/* People row — shown for freelancer/work (non-original) card pages.
                    Work pages hide it behind a "Credits" pill instead of always showing it. */}
                {!isOriginalCardPage && (
                  <>
                    {isTabLayout && (
                      <button class="project-credits-btn" id="project-credits-btn" type="button" aria-expanded="false">
                        <span>Credits</span>
                        <Arrow class="project-credits-arrow" />
                      </button>
                    )}
                    <div class:list={["project-people", isTabLayout && "project-people--collapsible"]} id="project-people-panel" style="margin-top: 40px;">
                    {people.map((person, idx) => {
                      const isScadProf = ['Casimir Esbach', 'Aaron Wilner', 'Michael Hill', 'Catalina Pesea-Ogletree'].includes(person);
                      const isDhruv = person === 'Dhruv Chavan';
                      const displayName = isScadProf ? `${person} (Professor)` : isDhruv ? `${person} (Mumbai Workshop)` : person;
                      const showDivider = idx === peopleDividerAfter;
                      return (
                        <>
                          <div class="project-people__person">
                            <div class="project-people__avatar">
                              <img src={PEOPLE[person] ?? PEOPLE['Advaita Kelkar']} alt={person} loading="lazy" />
                            </div>
                            <span class="project-people__name">{displayName}</span>
                          </div>
                          {showDivider && <div class="project-people__divider" aria-hidden="true" />}
                        </>
                      );
                    })}
                    </div>
                  </>
                )}


                <!-- In-column scrub. On tab (work/ARCHV) pages it IS the deck
                     (#deck-grid); on other card pages the bottom deck section
                     keeps #deck-grid and this becomes the parallel-wired
                     #deck-grid-mobile-scrub (desktop column layout). -->
                {hasImages && !isRenders && (
                  <div class="deck-grid deck-grid--mobile-scrub" id={(isTabLayout || isPortraits) ? "deck-grid" : "deck-grid-mobile-scrub"} data-images={JSON.stringify(allImages)} data-variations={Object.keys(variationsByImage).length ? JSON.stringify(variationsByImage) : undefined}>
                    {allImages.map((img, idx) => (
                      <button
                        type="button"
                        class:list={["deck-card-item", idx === 0 && "is-active"]}
                        data-index={idx}
                        aria-label={`Jump to image ${idx + 1}`}
                      >
                        <div class="deck-card-inner">
                          <img src={projectThumbnail(img)} alt={`${data.name} thumbnail ${idx + 1}`} loading="lazy" decoding="async" />
                        </div>
                      </button>
                    ))}
                  </div>
                )}

                <!-- Card Name & Pagination in left column (horizontally aligned with image bottom) -->
                {!isRenders && <div class="project-card-name-pagination-row">
                  <div class="page-active-logo" id="page-active-logo" aria-hidden="true"></div>
                  {/* The sitter's name, at the left end of the meta row. On a
                      portrait series the frame IS a named person, so the name
                      belongs with the other facts about the frame — not set
                      across the picture, which covers the face it names. It
                      sits outside the counter wrap because that wrap carries
                      `margin-left: auto` and rides the right edge; the name
                      holds the left. Same element at every width. */}
                  {isPortraits && <div class="page-card-name" id="page-card-name">{firstCardName}</div>}
                  <div class="project-detail__pagination-wrap">
                    <div class="project-detail__pagination" id="page-pagination">
                      1 / {allImages.length}
                    </div>
                    <div class="autoplay-timer-ring autoplay-timer-ring--mini" aria-hidden="true">
                      <svg width="20" height="20" viewBox="0 0 24 24">
                        <circle cx="12" cy="12" r="10" class="timer-ring-bg" />
                        <circle cx="12" cy="12" r="10" class="timer-ring-progress" id="page-timer-progress-mini" />
                        <circle cx="12" cy="2" r="2" class="timer-ring-dot" />
                      </svg>
                    </div>
                  </div>
                </div>
                }
                <!-- Bottom border + Gallery View Button -->
                {hasImages && !isRenders && !isPortraits && (
                  <div class="gallery-view-row">
                    <button class="gallery-view-btn" id="gallery-view-btn" type="button" aria-label="Open gallery view modal">
                      <span class="gallery-view-text">Gallery View</span>
                      <Arrow />
                    </button>
                  </div>
                )}
              </div>
            </div>

            <!-- Right Column: Active Card Slider (Clean, image-only) -->
            {hasImages && !isRenders && (
            <div class="project-col-right" id="project-slider-col">
              <div class="project-slider-wrapper" id="page-slider-wrapper" data-images={JSON.stringify(allImages)}>
                <div class="project-detail__active-wrap" id="page-active-wrap" role="button" tabindex="0" aria-label={`Open ${data.name} image gallery`} style="cursor: pointer;" title="Click to open fullscreen modal">
                  <img class="project-detail__active-img" id="page-active-img" src={allImages[0]} alt={data.name} fetchpriority="high" decoding="async" />

                  <!-- Active card name on the image — only for original curated
                       card sets, and not on the portrait series, which puts the
                       name in the meta row beside the counter instead. -->
                  {isOriginalCardPage && !isPortraits && <h2 class="project-card__overlay-name" id="page-overlay-name">{firstCardName}</h2>}

                  <!-- Active card's team/publisher logo — top-right (desktop) -->
                  <span class="page-active-card-logo" id="page-active-card-logo" aria-hidden="true"></span>

                  <!-- Autoplay Timer Ring (top-left on desktop) -->
                  <div class="autoplay-timer-ring">
                    <svg width="24" height="24" viewBox="0 0 24 24">
                      <circle cx="12" cy="12" r="10" class="timer-ring-bg" />
                      <circle cx="12" cy="12" r="10" class="timer-ring-progress" id="page-timer-progress" />
                      <circle cx="12" cy="2" r="2" class="timer-ring-dot" />
                    </svg>
                  </div>
                </div>
              </div>
            </div>
            )}
          </div>

          <!-- CARD DECK SECTION: INSIDE the dropdown container so when closed it collapses completely inside -->
          {hasImages && isCardPage && !isTabLayout && !isRenders && !isPortraits && (
            <section class="card-deck-section">
              <div class="deck-grid" id="deck-grid" data-images={JSON.stringify(allImages)} data-variations={Object.keys(variationsByImage).length ? JSON.stringify(variationsByImage) : undefined}>
                {allImages.map((img, idx) => {
                  const filename = img.substring(img.lastIndexOf('/') + 1);
                  const ext = filename.substring(filename.lastIndexOf('.'));
                  let name = filename.slice(0, filename.length - ext.length);
                  name = name.replace(/^ADVT_(?:[A-Z]{2,4}_)+/, '').replace(/^ADVT_SP_\s*/, '').trim();
                  name = name.replace(/\s+\d+\s*$/, '').replace(/\s*\d+$/, '').trim();
                  name = name.replace(/([a-z0-9])([A-Z])/g, '$1 $2').replace(/([A-Z]+)([A-Z][a-z])/g, '$1 $2').replace(/[_-]+/g, ' ').trim();
                  
                  const logo = logoFor(img);
                  return (
                    <button
                      type="button"
                      class:list={["deck-card-item", idx === 0 && "is-active"]}
                      data-index={idx}
                      data-logo={logo?.src}
                      aria-label={`Open card ${name}`}
                    >
                      <div class="deck-card-inner">
                        <img src={projectThumbnail(img)} alt={name} loading="lazy" decoding="async" />
                        {logo && <span class="deck-card-logo" style={`--logo: url('${logo.src}')`} aria-hidden="true"></span>}
                        <div class="deck-card-glow"></div>
                        <div class="deck-card-label">{name}</div>
                      </div>
                    </button>
                  );
                })}
              </div>
            </section>
          )}
        </div>
      ) : (
        /* STANDARD PROJECTS: Normal Stacked Flow */
        <>
          <header class="project-top-header" id="project-top-header">
            <div class="project-header-title-row">
              <h1 class="project-name-title" id="project-name-click">
                <span class="project-name-main">{data.name}</span>
              </h1>
            </div>

            {/* Cancels whichever section the card has grown to show. Rendered
                here rather than built in script so it carries this file's
                scope attribute and uses the icon family; the phone card moves
                it in like every other piece. */}
            <button class="project-phone-close" type="button" aria-label="Close this section" hidden>
              <Icon name="close" />
            </button>

            <div class="project-card__metaline">
              {(isOriginalCardPage || isTabLayout || isRenders) ? (
                <div class="project-meta-row project-meta-row--pills">
                  {filterPills.map(v => (
                    <a
                      class="project-card__filter-pill"
                      href={`/projects?q=${encodeURIComponent(v)}`}
                      title={`Show only ${v}`}
                    >
                      <span>{v}</span>
                      <Icon name="arrow" />
                    </a>
                  ))}
                </div>
              ) : (
                <div class="project-meta-row">
                  <span class="project-card__meta-val">
                    {[yearLoc, data.status].filter(Boolean).join(', ')}
                  </span>
                  {category && (
                    <a href={`/${category.id}/`} class="project-card__meta-cat-link">
                      {category.data.displayName}
                    </a>
                  )}
                </div>
              )}
            </div>
          </header>

          <div class="project-content-grid">
            <div class="project-col-left">
              <div class="project-card-info">
                <!-- Subtitle (Intro) & Description (aim/narrative) at the top of left column -->
                <div class="project-card__row project-card__row2">
                  <div class="project-card__text-block">
                    {data.smallIntro && <p class="project-card__intro">{data.smallIntro}</p>}
                    {data.description && (
                      <div class="project-desc-readmore" id="project-desc-readmore">
                        <div class="project-card__desc project-desc-clip" id="project-desc-clip" set:html={data.description} />
                        <button
                          class="project-readmore-btn"
                          id="project-readmore-btn"
                          type="button"
                          aria-expanded="false"
                        >
                          <span class="project-readmore-label">Read more</span>
                          <Icon name="arrow" class="project-readmore-arrow" />
                        </button>
                      </div>
                    )}
                    {downloads.length > 0 && (
                      <div class="project-downloads">
                        {downloads.map(d => (
                          <a class="project-download-pill" href={d.href} download target="_blank" rel="noopener">
                            <span>{d.label}</span>
                            <Arrow />
                          </a>
                        ))}
                      </div>
                    )}
                  </div>
                </div>

                <!-- Collaborator circles (people) below the description -->
                <div class="project-people" style="margin-top: 40px;">
                  {people.map((person, idx) => {
                    const isScadProf = ['Casimir Esbach', 'Aaron Wilner', 'Michael Hill', 'Catalina Pesea-Ogletree'].includes(person);
                    const isDhruv = person === 'Dhruv Chavan';
                    const displayName = isScadProf ? `${person} (Professor)` : isDhruv ? `${person} (Mumbai Workshop)` : person;
                    const showDivider = idx === peopleDividerAfter;
                    return (
                      <>
                        <div class="project-people__person">
                          <div class="project-people__avatar">
                            <img src={PEOPLE[person] ?? PEOPLE['Advaita Kelkar']} alt={person} loading="lazy" />
                          </div>
                          <span class="project-people__name">{displayName}</span>
                        </div>
                        {showDivider && <div class="project-people__divider" aria-hidden="true" />}
                      </>
                    );
                  })}
                </div>

                <!-- Thumbnail scrub below the people -->
                {hasImages && !isRenders && (
                  <div class="project-detail__thumbs" id="standard-thumbs" style="margin-top: 24px; margin-bottom: 24px;">
                    {allImages.map((img, idx) => (
                      <button
                        type="button"
                        class:list={[
                          "project-detail__thumb-item",
                          idx === 0 && "is-active"
                        ]}
                        data-index={idx}
                      >
                        <img src={img} alt={`${data.name} thumbnail ${idx + 1}`} />
                      </button>
                    ))}
                  </div>
                )}
              </div>
            </div>

            {hasImages && !isRenders && (
            <div class="project-col-right" id="project-slider-col">
              <div class="project-slider-wrapper project-slider-wrapper--standard" id="standard-slider-wrapper" data-images={JSON.stringify(allImages)}>
                <div class="project-detail__active-wrap" id="standard-active-wrap" style="cursor: pointer;" title="Click to open image">
                  <button class="project-detail__nav-arrow project-detail__nav-arrow--prev" id="standard-prev" type="button" aria-label="Previous image">
                    <Icon name="chevron" dir="w" />
                  </button>
                  <img class="project-detail__active-img" id="standard-active-img" src={allImages[0]} alt={data.name} fetchpriority="high" decoding="async" />
                  <button class="project-detail__nav-arrow project-detail__nav-arrow--next" id="standard-next" type="button" aria-label="Next image">
                    <Icon name="chevron" dir="e" />
                  </button>
                </div>

                <div class="project-detail__pagination-row" style="margin-top: 12px;">
                  <div class="project-detail__pagination" id="standard-pagination">
                    1 / {allImages.length}
                  </div>
                  <div class="autoplay-timer-ring autoplay-timer-ring--mini" aria-hidden="true">
                    <svg width="20" height="20" viewBox="0 0 24 24">
                      <circle cx="12" cy="12" r="10" class="timer-ring-bg" />
                      <circle cx="12" cy="12" r="10" class="timer-ring-progress" id="page-timer-progress-mini" />
                      <circle cx="12" cy="2" r="2" class="timer-ring-dot" />
                    </svg>
                  </div>
                </div>
              </div>
            </div>
            )}
          </div>
        </>
      )}

      <!-- NON-ORIGINAL-CARD PAGES: chapter dropdowns (when defined) or Design & Making -->
      {!isOriginalCardPage && !isScarpinPage && (data.chapters?.length ?? 0) > 0 && (
        <div class:list={["project-chapters", chapterTabs && "project-chapters--tabs is-all"]}>
          {/* Two or more chapters read as tabs: a numbered row, one chapter
              on screen. A single chapter keeps its dropdown. */}
          {chapterTabs && (
            <div class="project-chapter-tabs">
              <div class="project-chapter-tabs__list" role="tablist" aria-label="Chapters">
                {/* All comes first and is where the page opens: every chapter,
                    one after another. */}
                <button class="project-chapter-tab project-chapter-tab--all" type="button" role="tab" data-ch="all" aria-selected="true" aria-label="All" title="All">
                  <Icon name="arrow" />
                </button>
                {data.chapters.map((ch: { title: string }, i: number) => (
                  <button class="project-chapter-tab" type="button" role="tab" data-ch={i}
                          aria-selected="false">
                    <span>{ch.title}</span>
                    <span class="project-chapter-tab__n">{i + 1}</span>
                  </button>
                ))}
              </div>
              <div class="project-chapter-tabs__nav">
                <button class="project-chapter-tabs__step" type="button" data-ch-step="-1" aria-label="Previous chapter">
                  <Icon name="chevron" dir="w" />
                </button>
                <button class="project-chapter-tabs__step" type="button" data-ch-step="1" aria-label="Next chapter">
                  <Icon name="chevron" dir="e" />
                </button>
              </div>
            </div>
          )}
          {data.chapters.map((ch: { title: string; subtitle?: string; body: string }, chIdx: number) => {
            const words = (ch.subtitle || ch.title).split(' ');
            // Only peel off a small "lead" line (e.g. "Living with") when
            // there's more than two words — otherwise a short subtitle like
            // "Chrysalis Unveil" would have nothing left for the big line.
            const hasLead = words.length > 2;
            const lead = hasLead ? words.slice(0, 2).join(' ') : '';
            const rest = hasLead ? words.slice(2).join(' ') : words.join(' ');
            return (
            <section class:list={["project-chapter", chapterTabs && "is-active is-expanded"]} data-ch={chIdx} role={chapterTabs ? 'tabpanel' : undefined}>
              <div class="project-header-title-row project-chapter__header">
                <h3 class="project-chapter__title">
                  {lead && <span class="project-chapter__title-lead">{lead}</span>}
                  {rest && <span class="project-chapter__title-rest">{rest}</span>}
                </h3>
                <button class="project-detail-collapse-btn" type="button" aria-expanded="false" aria-label={`Toggle ${ch.title}`}>
                  {isTabLayout ? (
                    <>
                      <Arrow class="toggle-icon-minus" style="display: none;" />
                      <Arrow class="toggle-icon-plus" />
                    </>
                  ) : (
                    <Arrow />
                  )}
                </button>
              </div>
              <div class="project-chapter__content">
                <div class="project-chapter__body" set:html={ch.body} />
              </div>
            </section>
            );
          })}
        </div>
      )}

      {/* The Design and Making panels are gone. They were two display-scale
          headings over label/value grids restating what the pills already
          say, and on a phone they ran straight through their own rows.
          Their facts live in the pills; the section is to be redesigned. */}

      {/* SCARPIN: Person-based accordion tabs (replace Design/Making) */}
      {isScarpinPage && scarpinSliders.length > 0 && (
        <div class="project-chapters">
          {scarpinSliders.map((slider) => (
            <section class="project-chapter">
              <div class="project-header-title-row project-chapter__header">
                <h3 class="project-chapter__title">
                  <span class="project-chapter__title-rest">{slider.cleanName}</span>
                </h3>
                <button class="project-detail-collapse-btn" type="button" aria-expanded="false" aria-label={`Toggle ${slider.cleanName}`}>
                  <Arrow class="toggle-icon-minus" style="display: none;" />
                  <Arrow class="toggle-icon-plus" />
                </button>
              </div>
              <div class="project-chapter__content">
                <div class="project-chapter__body">
                  <div class="scarpin-person-header" style="display: flex; align-items: center; gap: 10px; margin-bottom: 16px;">
                    {slider.avatar ? (
                      <img style="width: 32px; height: 32px; border-radius: 50%; object-fit: cover;" src={slider.avatar} alt={slider.personName} loading="lazy" />
                    ) : (
                      <div style="width: 32px; height: 32px; border-radius: 50%; background: #e0e0e0;"></div>
                    )}
                    <span style="font-size: 14px; opacity: 0.7;">{slider.personName}</span>
                  </div>
                  <div class="scarpin-person-images" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 8px;">
                    {slider.urls.map((u) => (
                      u.endsWith('.mp4') ? (
                        <video src={u} autoplay loop muted playsinline style="width: 100%; border-radius: 4px;"></video>
                      ) : (
                        <img src={projectThumbnail(u)} alt={slider.cleanName} loading="lazy" decoding="async" style="width: 100%; border-radius: 4px;" />
                      )
                    ))}
                  </div>
                </div>
              </div>
            </section>
          ))}
        </div>
      )}




      {/* The rooms sit OUTSIDE the dashboard grid. Inside it they landed in
          the same cell as the text column, which places its own grid-row on
          the wide band, and the two drew over each other. This is the page's
          middle; it does not belong in a layout built to stand text beside
          one image. */}
      {isRenders && renderViews.length > 0 && (
        <section class="renders-section">
          <RenderRooms views={renderViews} name={data.name} groups={data.groups ?? "tabs"} />
        </section>
      )}

      {/* Where the rest of the collection lives — the person's face, one
          line set as the subtitle is, and the link. */}
      {isRenders && (data as any).collectionCredit && (() => {
        const cc = (data as any).collectionCredit;
        return (
          <p class="renders-collection">
            <img class="renders-collection__face" src={PEOPLE[cc.person] ?? PEOPLE['Advaita Kelkar']} alt={cc.person} loading="lazy" />
            <span>
              {cc.text}{' '}
              <a href={cc.href} target="_blank" rel="noopener">{cc.label}<Arrow class="renders-collection__arrow" /></a>
            </span>
          </p>
        );
      })()}

      <!-- Fullscreen Lightbox: card pages get a horizontally scrolling deck -->
      {isCardPage && !isRenders && (
        <div id="card-lightbox" role="dialog" aria-modal="true" aria-label={`${data.name} image gallery`} tabindex="-1" class="card-lightbox card-lightbox--deck" aria-hidden="true" style="display: none;">
          <img class="lightbox-bg-ambient" id="lightbox-ambient-img" src="" alt="" />
          <div class="lightbox-backdrop"></div>

          <!-- Top row: timer ring left, pagination centered, close right -->
          <div class="lightbox-header lightbox-header--deck">
            <span class="lightbox-pagination lightbox-pagination--deck" id="lightbox-counter">1 / {allImages.length}</span>
            <div class="lightbox-scrubber" id="lightbox-scrubber" role="slider" aria-label="Scrub through cards">
              <div class="lightbox-scrubber__fill" id="lightbox-scrubber-fill"></div>
            </div>
            <div class="autoplay-timer-ring lightbox-header__ring" aria-hidden="true">
              <svg width="100%" height="100%" viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="10" class="timer-ring-bg" />
                <circle cx="12" cy="12" r="10" class="timer-ring-progress" id="lightbox-timer-progress" />
                <circle cx="12" cy="2" r="2" class="timer-ring-dot" />
              </svg>
            </div>
            <button class="lightbox-close-btn" id="lightbox-close" type="button" aria-label="Close lightbox">
              <Icon name="close" />
            </button>
          </div>

          <!-- Scroll-snap deck: one card at a time, neighbours peeking -->
          <div class="lightbox-deck" id="lightbox-deck">
            {allImages.map((img, idx) => {
              const logo = logoFor(img);
              return (
              <div class="lightbox-deck__item" data-index={idx}>
                <img src={img} alt={cardNameFromUrl(img)} loading="lazy" />
                {logo && <span class="lightbox-card-logo" style={`--logo: url('${logo.src}')`} aria-hidden="true"></span>}
              </div>
              );
            })}
          </div>

          <!-- Card name: bottom-left at page padding, one word per row -->
          <h2 class="lightbox-name" id="lightbox-card-label">
            {firstCardName.split(' ').map((word) => <span>{word}<br/></span>)}
          </h2>
        </div>
      )}

      {!isCardPage && (
      <div id="card-lightbox" role="dialog" aria-modal="true" aria-label={`${data.name} image gallery`} tabindex="-1" class="card-lightbox" aria-hidden="true" style="display: none;">
        <!-- Dynamic Blurred Background Ambient Image -->
        <img class="lightbox-bg-ambient" id="lightbox-ambient-img" src="" alt="" />
        <div class="lightbox-backdrop"></div>
        
        <!-- Redesigned Top Action Bar: ring timer left, pagination center, close right -->
        <!-- Redesigned Top Action Bar: card deck style header -->
        <div class="lightbox-header lightbox-header--deck">
          <span class="lightbox-pagination lightbox-pagination--deck" id="lightbox-counter">1 / 35</span>
          <div class="lightbox-scrubber" id="lightbox-scrubber" role="slider" aria-label="Scrub through cards">
            <div class="lightbox-scrubber__fill" id="lightbox-scrubber-fill"></div>
          </div>
          <div class="autoplay-timer-ring lightbox-header__ring" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="10" class="timer-ring-bg" />
              <circle cx="12" cy="12" r="10" class="timer-ring-progress" id="lightbox-timer-progress" />
              <circle cx="12" cy="2" r="2" class="timer-ring-dot" />
            </svg>
          </div>
          <button class="lightbox-close-btn" id="lightbox-close" type="button" aria-label="Close lightbox">
            <Icon name="close" />
          </button>
        </div>
        
        <!-- Centered Card Container (with 3D perspective wrapper) -->
        <div class="lightbox-perspective-wrap">
          <div class="lightbox-card-container" id="lightbox-card-container">
            <!-- Left/Right navigation inputs overlaid directly on image container -->
            <button class="lightbox-nav-arrow lightbox-nav-arrow--prev" id="lightbox-prev" type="button" aria-label="Previous card">
              <Icon name="chevron" dir="w" />
            </button>

            <img class="lightbox-card-img" id="lightbox-card-img" src="" alt="Active Playing Card" />

            <div class="lightbox-card-shadow"></div>
            <div class="lightbox-card-shine"></div>

            <button class="lightbox-nav-arrow lightbox-nav-arrow--next" id="lightbox-next" type="button" aria-label="Next card">
              <Icon name="chevron" dir="e" />
            </button>
          </div>
        </div>

        <!-- Name Label below the Lightbox card container (bottom-left, one word per line) -->
        <h2 class="lightbox-name" id="lightbox-card-label">CARD NAME</h2>

        <div class="lightbox-hint">Tap card to flip to next</div>
      </div>
      )}

      {project.id === 'virtual-gods' && <VGScrollExhibition />}

    </article>
</PageLayout>

