  /* ══ Phone: two columns up top, the words underneath ════════════════
     The two columns stay and the image stays on the right — but on a 375px
     screen that left column is 170px wide, and the description was living in
     it, clipped to 12vh with its own internal scroll and no Read more pill.
     A paragraph does not belong in a 170px column.

     So the row keeps the short stuff — the tagline beside the image — and the
     description drops below both columns at full width, where it reads. The
     Read more pill comes back with it, because at full width the text clips
     rather than scrolling inside itself.

     .project-col-left and .project-card-info are already display:contents on
     this band; row2 and the text block join them, which is what lets these
     three children be placed in the outer grid directly. */
  @media (max-width: 699.98px) {
    /* Qualified by the grid they are placed in. These rules position pieces
       INSIDE .project-content-grid--card, and the same pieces are moved into
       the bottom card on this band — unqualified they followed them there and
       spanned both of its columns, putting the counter behind the image. */
    .project-detail[data-is-card="true"]:not([data-tab-layout="true"]) .project-card__row2,
    .project-detail[data-is-card="true"]:not([data-tab-layout="true"]) .project-card__text-block {
      display: contents;
    }
    .project-detail[data-is-card="true"]:not([data-tab-layout="true"]) .project-content-grid--card .project-card__intro {
      grid-column: 1;
      grid-row: 1;
      margin: 0;
    }
    .project-detail[data-is-card="true"]:not([data-tab-layout="true"]) .project-content-grid--card .project-col-right {
      grid-column: 2;
      grid-row: 1;
    }
    .project-detail[data-is-card="true"]:not([data-tab-layout="true"]) .project-content-grid--card .project-desc-readmore {
      grid-column: 1 / -1;
      grid-row: 2;
    }
    .project-detail[data-is-card="true"]:not([data-tab-layout="true"]) .project-content-grid--card .project-prompt-wrap,
    .project-detail[data-is-card="true"]:not([data-tab-layout="true"]) .project-content-grid--card .project-prompt-btn {
      grid-column: 1 / -1;
      grid-row: 3;
      justify-self: start;
    }
    /* Everything that used to sit at rows 2 and 3 moves down by the two rows
       the description and the pill now occupy. */
    .project-detail[data-is-card="true"]:not([data-tab-layout="true"]) .project-card-info :global(.prompt-box.is-open) {
      grid-row: 4;
    }
    .project-detail[data-is-card="true"]:not([data-tab-layout="true"]) .project-content-grid--card .project-card-name-pagination-row {
      grid-row: 5;
    }
  }

  /* ══ Phone: no tabs, and the facts sit at the bottom ════════════════
     Design and Making were two full-width headings that folded their own
     content away, so on a phone the page ended in two big words and nothing
     under them. They are plain sections here: the content is always open and
     the fold controls are gone, so everything on the page is reached by
     scrolling rather than by pressing.

     The meta row — year, location, status — leaves the header and docks at
     the bottom above the nav bar, which is where the other phone pages keep
     the row you read last. Heights are measured, not written down: the nav
     dock moves with the device's safe area. */
  @media (max-width: 699.98px) {
    /* ── Tab-layout pages get the card page's phone shape ───────────────
       These ten were left behind when the project pages were rebuilt: the
       deck stayed a single 72px filmstrip across the top and the Design /
       Making panels stayed at display scale, so "Design" and "Making" ran
       straight through the label/value rows beneath them.

       The deck element is shared — on a tab page `#deck-grid` IS the scrub —
       and the scrub rules make it a flex row, so the grid columns the phone
       block sets were being declared at something that is not a grid.
       Forcing display and clearing the fixed item height hands these pages
       the same full-height three-across deck every other project has. */
    .project-detail[data-tab-layout="true"] :global(#deck-grid) {
      display: grid !important;
      order: 0 !important;
      margin: 0 !important;
    }
    .project-detail[data-tab-layout="true"] :global(#deck-grid .deck-card-item) {
      height: auto !important;
      aspect-ratio: 2/3 !important;
    }
    /* The panels' facts are pills now (see filterPills), so the panels
       themselves are a second copy at display scale. */
    .project-detail[data-tab-layout="true"] .project-metadata-sections {
      display: none !important;
    }

    .project-design-content,
    .project-making-content {
      max-height: none !important;
      opacity: 1 !important;
      overflow: visible !important;
      padding-top: 12px;
    }
    /* Nothing folds, so there is no control for it and no state to remember. */
    .project-design-header .project-detail-collapse-btn,
    .project-making-header .project-detail-collapse-btn {
      display: none !important;
    }
    .project-design-header,
    .project-making-header {
      cursor: default;
    }

    /* The name is the category name: same size, same weight. A project page
       is one project's category page, so its title is set the way that title
       is set rather than at display scale. */
    .project-detail .project-name-title {
      font-size: var(--_tokens---type--small);
      font-weight: var(--_tokens---weight--strong);
      line-height: 1.2;
      letter-spacing: 0.01em;
    }

    /* ── The same bottom card a category page has ──────────────────
       A project page is a category page with one project in it: the name is
       the top card, the work fills the middle, and the words dock at the
       bottom within thumb reach. People on top of that card, then the short
       line, then the description behind a Read More — the same order, so the
       two pages read as one design.

       The facts take the slot the studio tabs take on a category page: the
       row directly above the card. */
    /* One column of words. The image used to sit beside them; the deck above
       shows it instead, scrolled so the active card stays on the top row. */
    .project-detail .project-phone-card {
      position: fixed;
      left: 0;
      right: 0;
      bottom: var(--pp-dock-h, 66px);
      z-index: 95;
      display: grid;
      grid-template-columns: 1fr;
      row-gap: 5px;
      align-items: start;
      margin: 0;
      padding: 6px 12px 8px;
      /* Not opaque. The deck runs on underneath and you can see it through
         this — the blur is what keeps 10px of text readable over a moving
         image. Full-bleed and sat directly on the nav bar, so there is no
         strip of page between the two for the deck to peer through. */
      background-color: color-mix(in srgb, var(--_tokens---color--bg) 90%, transparent);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
    }
    /* Auto-placed in DOM order, which is already the reading order: counter,
       facts, short line, description, prompt, buttons. The rows used to be
       assigned by hand, which reserved one for the description even while it
       was closed — an empty track contributes no height but still takes a gap
       either side of it, so the collapsed card carried 6px of nothing. */
    .project-detail .project-phone-card > * {
      grid-column: 1;
      min-width: 0;
    }
    /* The facts sit in the card, under the pagination. */
    .project-detail .project-phone-card .project-card__metaline {
      position: static;
      margin: 0;
      padding: 0;
      width: 100%;
    }

    /* The cover leads the card, the way the people row leads a category's.
       It is a band here, not a portrait: the slider's 2/3 ratio is 527px tall
       at full width, which is most of the screen for one image on a page whose
       whole deck is three across above it. Cropped to a strip instead. */
    /* The single large image is gone from this band. The deck is showing the
       same picture at the same moment, and two copies of it on one screen is
       one too many. */
    .project-detail .project-content-grid--card .project-col-right {
      display: none !important;
    }

    /* Logo, counter and timer ring, directly above the facts. */
    .project-detail .project-phone-card .project-card-name-pagination-row {
      margin: 0;
      padding: 4px 0 0;
      width: 100%;
    }

    /* ── One rule above the card, and nothing between its parts ────────
       The card carried three hairlines: one over the counter row, one over
       the pills and one under the subtitle. Two of them were dividing things
       that already read as separate, so only the top one survives — it is the
       edge of the card, not a divider inside it. */
    .project-detail .project-phone-card .project-card__metaline {
      border-top: none;
    }
    .project-detail .project-phone-card .project-card__intro {
      border-bottom: none;
      margin: 0;
      /* It carried 16px of padding under it, which put 6px of air above its
         line and 22px below — the subtitle sat against the pills instead of
         between them and the buttons. Padding off, so the row gap either side
         is the only spacing and the two are equal. */
      padding: 0;
    }

    /* ── Collapsed, the card is four rows ──────────────────────────────
       Counter, pills, subtitle, buttons. The description and the prompt are
       behind their buttons: the card grows UP to show one of them, and the ✕
       in the corner cancels it. Only the subtitle stays open, because it is
       the one line that says what the project is. */
    .project-detail .project-phone-card .project-desc-readmore {
      display: none;
    }
    .project-detail .project-phone-card.is-reading .project-desc-readmore {
      display: block;
    }
    .project-detail .project-phone-card .project-card__desc {
      max-height: 34dvh;
      overflow-y: auto;
      scrollbar-width: none;
      font-size: var(--_tokens---type--ultrathin);
      line-height: 1.5;
    }
    .project-detail .project-phone-card :global(.prompt-box) {
      display: none !important;
    }
    .project-detail .project-phone-card.is-prompting :global(.prompt-box) {
      display: flex !important;
      width: 100% !important;
      max-width: none !important;
      max-height: 34dvh;
      overflow-y: auto;
      margin: 0 !important;
    }

    /* The ✕ closes whichever section is open, so it sits on the row that
       opened it, pushed to the far right of it. */
    .project-detail .project-phone-close {
      margin-left: auto;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 28px;
      height: 28px;
      padding: 0;
      border: 0;
      background: none;
      color: var(--_tokens---color--fg);
      cursor: pointer;
      --icon-size: 16px;
    }
    .project-detail .project-phone-close[hidden] {
      display: none;
    }

    /* ── The prompt is the prompt ──────────────────────────────────────
       It arrived as a titled, bordered panel with a labelled Copy button —
       three pieces of chrome around one paragraph, inside a card that is
       already labelled by the button that opened it. What is left is the
       text and a small copy mark after it. */
    /* Every declaration in the prompt block carries !important — see the
       :global(.prompt-box) rules further up — so overriding any of it here
       has to as well. Without that the box kept its column order, its divider
       and its labelled button, and only the pieces nothing else claimed moved. */
    .project-detail .project-phone-card :global(.prompt-box) {
      gap: 0 !important;
      margin: 0 !important;
      border: 0 !important;
      padding: 0 !important;
      background: none !important;
    }
    /* The header held a title and the copy button. The title is the name of
       the button that opened this, and the button now sits at the end of the
       paragraph, so the row itself has nothing left to hold. */
    .project-detail .project-phone-card :global(.prompt-header) {
      display: none !important;
    }
    /* One run of text ending in a small copy mark. */
    .project-detail .project-phone-card :global(.prompt-body) {
      display: block !important;
    }
    .project-detail .project-phone-card :global(.prompt-text) {
      display: inline !important;
    }
    .project-detail .project-phone-card :global(.copy-prompt-btn) {
      /* The label is a bare text node on the button, so it goes by sizing it
         to nothing; the icon keeps its own size. */
      display: inline-flex !important;
      vertical-align: -3px;
      margin-left: 6px !important;
      font-size: 0 !important;
      gap: 0 !important;
      padding: 0 !important;
      border: 0 !important;
      background: none !important;
      --icon-size: 13px;
    }
    .project-detail .project-phone-card :global(.prompt-text) {
      font-size: var(--_tokens---type--ultrathin) !important;
      line-height: 1.5 !important;
    }

    /* Every paragraph of the description at one size. The second one — the
       italic list of characters — was resolving a step larger than the first,
       so the block read as two different texts rather than one. The em keeps
       its italic; only the size is levelled. */
    .project-detail .project-phone-card .project-card__desc :global(p),
    .project-detail .project-phone-card .project-card__desc :global(em) {
      font-size: var(--_tokens---type--ultrathin) !important;
      line-height: 1.5 !important;
    }
    .project-detail .project-phone-card .project-card__desc :global(p) {
      margin: 0 0 8px !important;
    }
    .project-detail .project-phone-card .project-card__desc :global(p:last-child) {
      margin-bottom: 0 !important;
    }

    /* Read more and Prompt share a row. */
    .project-detail .project-phone-actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--_tokens---bubble-gap-x);
      margin: 0;
    }

    /* Read more and Prompt are pills like the ones above them — same size,
       fill, hairline and small arrow. They were the page's own display-scale
       buttons, which on this card read as a different kind of control from
       the row of filters two lines up. !important because their own rules
       carry it. */
    .project-detail .project-phone-actions .project-readmore-btn,
    .project-detail .project-phone-actions .project-video-btn,
    .project-detail .project-phone-actions .project-prompt-btn {
      display: inline-flex !important;
      align-items: center !important;
      gap: var(--_tokens---pill-gap--xs) !important;
      margin: 0 !important;
      padding: var(--_tokens---pill-pad--xs) !important;
      border: var(--_tokens---pill-border--mid) !important;
      border-radius: var(--_tokens---radius--pill) !important;
      background: color-mix(in srgb, var(--_tokens---color--fg) 5%, transparent) !important;
      color: var(--_tokens---color--muted) !important;
      font-family: inherit !important;
      font-size: var(--_tokens---type--ultrathin) !important;
      font-weight: var(--_tokens---weight--light) !important;
      line-height: 1.1 !important;
      letter-spacing: 0 !important;
      white-space: nowrap !important;
      text-transform: none !important;
      --icon-size: var(--_tokens---arrow--sm);
    }
    .project-detail .project-phone-actions .project-readmore-btn svg,
    .project-detail .project-phone-actions .project-video-btn svg,
    .project-detail .project-phone-actions .project-prompt-btn svg {
      flex-shrink: 0;
      opacity: 0.55;
    }
    @media (hover: hover) {
      .project-detail .project-phone-actions .project-readmore-btn:hover,
      .project-detail .project-phone-actions .project-video-btn:hover,
      .project-detail .project-phone-actions .project-prompt-btn:hover {
        color: var(--_tokens---color--fg) !important;
        border-color: color-mix(in srgb, var(--_tokens---color--fg) 32%, transparent) !important;
        background: color-mix(in srgb, var(--_tokens---color--fg) 9%, transparent) !important;
      }
    }
    /* The one that is open is inverted, the way an active tab is everywhere
       else on the site — you can see which section you are in without reading
       the button label. */
    .project-detail .project-phone-card.is-reading .project-phone-actions .project-readmore-btn,
    .project-detail .project-phone-card.is-watching .project-phone-actions .project-video-btn,
    .project-detail .project-phone-card.is-prompting .project-phone-actions .project-prompt-btn {
      background: var(--_tokens---color--fg) !important;
      border-color: var(--_tokens---color--fg) !important;
      color: var(--_tokens---color--bg) !important;
    }
    .project-detail .project-phone-card.is-reading .project-phone-actions .project-readmore-btn svg,
    .project-detail .project-phone-card.is-watching .project-phone-actions .project-video-btn svg,
    .project-detail .project-phone-card.is-prompting .project-phone-actions .project-prompt-btn svg {
      opacity: 1;
    }

    /* The reel's panel, the third thing the card can grow to. Closed it takes
       no height at all, so the two shut sections stack with nothing between
       them, exactly as the description does. 42vh rather than a pixel number
       because the card also carries the name row, the meta line, the subtitle
       and the actions, and what is left over is a fraction of the screen
       rather than a constant. */
    .project-detail .project-video-panel {
      display: none;
      margin-top: var(--_tokens---space--micro);
    }
    .project-detail .project-phone-card.is-watching .project-video-panel {
      display: block;
    }
    .project-detail .project-video-panel .renders-aside__media {
      position: relative;
      margin: 0 auto;
      max-height: 42vh;
      width: fit-content;
    }
    .project-detail .project-video-panel video {
      display: block;
      width: auto;
      height: auto;
      max-width: 100%;
      max-height: 42vh;
      border-radius: var(--_tokens---radius--small);
    }
    /* Big enough to hit with a thumb. The desktop control is 0.8em in a
       hover surface; this one is a target on glass. */
    .project-detail .project-video-panel .renders-aside__sound {
      position: absolute;
      left: 8px;
      bottom: 8px;
      display: grid;
      place-items: center;
      padding: 8px;
      border: 1px solid var(--_tokens---color--line);
      border-radius: 999px;
      background: var(--_tokens---color--bg-overlay);
      color: var(--_tokens---color--fg);
      --icon-size: var(--_tokens---arrow--md);
    }
    .project-detail .project-video-panel .rs-off,
    .project-detail .project-video-panel .rs-on { grid-area: 1 / 1; }
    .project-detail .project-video-panel .renders-aside__sound[data-sound="off"] .rs-on,
    .project-detail .project-video-panel .renders-aside__sound[data-sound="on"] .rs-off {
      display: none;
    }

    /* The ✕ stays a bare mark — it cancels, it is not a third filter. */
    .project-detail .project-phone-close {
      --icon-size: 14px;
      width: 22px;
      height: 22px;
    }
    .project-detail .project-phone-actions .project-prompt-btn {
      margin: 0;
    }

    /* The deck is the middle of the page: four across, filling everything
       between the name and the card, and scrolling there rather than running
       the page down 1500px. The script keeps the active card on the top row.

       Three across with 2px between them: the images are the content on this
       band and the gaps were spending width on nothing. */
    .project-detail :global(#deck-grid) {
      grid-template-columns: repeat(3, 1fr) !important;
      gap: 2px !important;
      margin: 0 !important;
      /* The full height under the name, not just the gap above the card: the
         deck runs on behind the card so the roll never stops at a hard edge.
         The padding is what lets the last rows scroll clear of it. */
      max-height: calc(100dvh - var(--pp-head-h, 40px) - 8px);
      padding-bottom: calc(var(--pp-card-h, 220px) + var(--pp-dock-h, 66px));
      overflow-y: auto;
      scrollbar-width: none;
      scroll-behavior: smooth;
      overscroll-behavior: contain;
    }
    .project-detail :global(#deck-grid::-webkit-scrollbar) {
      display: none;
    }
    /* The name under each image goes; the symbol on it stays. At four across
       a caption is a few clipped characters, and the mark already says which
       character it is. */
    .project-detail :global(.deck-card-label) {
      display: none !important;
    }
    /* Nothing above the deck but the name. */
    .project-detail :global(.card-deck-section) {
      margin-top: 0 !important;
      padding-top: 0 !important;
    }
    /* "Gallery View" opened a view of the deck that is now the page itself. */
    .project-detail .gallery-view-row {
      display: none !important;
    }

    /* People on top, one scrolling row — the grid wraps on four names and
       every extra row is height taken off the work above. */
    .project-detail .project-phone-card .project-people {
      order: -1;
      display: flex !important;
      flex-wrap: nowrap;
      overflow-x: auto;
      scrollbar-width: none;
      gap: 8px;
      margin: 0;
      max-height: none !important;
      opacity: 1 !important;
    }
    .project-detail .project-phone-card .project-people::-webkit-scrollbar { display: none; }
    .project-detail .project-phone-card .project-people__person { flex: 0 0 auto; }
    .project-detail .project-phone-card .project-people__avatar { width: 44px; height: 44px; }
    /* The row is on the page now, so the pill that used to reveal it is not. */
    .project-detail .project-credits-btn { display: none !important; }

    .project-detail .project-phone-card .project-card__intro {
      margin: 0;
      font-size: var(--_tokens---type--micro);
      font-weight: var(--_tokens---weight--strong);
      line-height: 1.35;
    }
    /* The description is a section the card opens, not two clamped lines
       under the subtitle — the clamp and its is-open wrapper belonged to the
       earlier design and set display:block here, which kept the section open
       whatever the card said. Its visibility now comes from the card's own
       state, below. */
    .project-detail .project-phone-card .project-desc-readmore {
      margin: 0;
    }
    .project-detail .project-phone-card .project-readmore-btn {
      display: inline-flex !important;
      margin: 0;
    }

    /* No seal. It was an opaque surface behind the whole bottom stack, which
       is exactly what the card is now deliberately not — the deck has to show
       through it. The card carries its own background and the nav bar carries
       its own; between them nothing is left uncovered. */
    .project-detail {
      padding-bottom: 0;
    }
  }

  /* ── AIworks: the facts are filters ────────────────────────────────────
     The meta line on these pages is the same pill row a project card shows in
     a listing — year, location, status, then bucket, studio, discipline — and
     every one of them is a link into the projects page filtered to that value.
     Shown at every width: the row IS the metadata here, not an extra. */
  .project-meta-row--pills {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    /* Packed left and stacking like the footer's pill cloud, on the same two
       gap tokens — the vertical rhythm is deliberately 75% of the horizontal
       one, which is why they are not a single value.

       .project-meta-row spaces its two halves apart; a wrapped row of pills
       wants them packed instead, or the gaps land wherever the wrap happens
       to fall. And they never grow: each pill rests at its own width. */
    justify-content: flex-start;
    gap: var(--_tokens---bubble-gap-y) var(--_tokens---bubble-gap-x);
    width: 100%;
  }
  /* The pill's own look. It lives in ProjectStackCard's global block, which
     is only emitted on pages that render a card — and this page does not, so
     without these the row came out as plain 16px text with arrows after it.
     Same tokens as the card, so the two stay one object. */
  .project-meta-row--pills .project-card__filter-pill {
    display: inline-flex;
    align-items: center;
    gap: var(--_tokens---pill-gap--xs);
    flex: 0 0 auto;
    color: var(--_tokens---color--muted);
    background: color-mix(in srgb, var(--_tokens---color--fg) 5%, transparent);
    border: var(--_tokens---pill-border--mid);
    border-radius: var(--_tokens---radius--pill);
    padding: var(--_tokens---pill-pad--xs);
    font-family: inherit;
    font-size: var(--_tokens---type--ultrathin);
    font-weight: var(--_tokens---weight--light);
    line-height: 1.1;
    white-space: nowrap;
    text-decoration: none;
    /* Ultrathin label, so the small step on the arrow scale. */
    --icon-size: var(--_tokens---arrow--sm);
    transition: background-color var(--_tokens---motion--base) ease,
                border-color var(--_tokens---motion--base) ease,
                color var(--_tokens---motion--base) ease;
  }
  .project-meta-row--pills .project-card__filter-pill svg {
    flex-shrink: 0;
    opacity: 0.55;
    transition: opacity var(--_tokens---motion--base) ease;
  }
  @media (hover: hover) {
    .project-meta-row--pills .project-card__filter-pill:hover {
      color: var(--_tokens---color--fg);
      border-color: color-mix(in srgb, var(--_tokens---color--fg) 32%, transparent);
      background: color-mix(in srgb, var(--_tokens---color--fg) 9%, transparent);
    }
    .project-meta-row--pills .project-card__filter-pill:hover svg {
      opacity: 1;
    }
  }
  .project-meta-row--pills .project-card__filter-pill:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }
  /* ══ The renders template ════════════════════════════════════════════
     Deliberately the LAST block in this stylesheet. A renders page borrows
     the card-page chassis for its header, pills, copy and people, and that
     chassis is built to stand text beside one image — fixed heights, its own
     grid rows, and several `display: … !important` rules on the picture
     parts. Equal specificity and !important on both sides means source order
     decides, so these have to come after all of them.

     What the template needs from the page is the words. The pictures are
     RenderRooms.astro's job, so every other picture surface stands down. */
  .project-detail[data-renders="true"] .project-prompt-wrap,
  .project-detail[data-renders="true"] .project-prompt-btn,
  .project-detail[data-renders="true"] .project-col-right,
  .project-detail[data-renders="true"] .project-slider-wrapper,
  .project-detail[data-renders="true"] .card-deck-section,
  .project-detail[data-renders="true"] .gallery-view-row,
  .project-detail[data-renders="true"] .project-card-name-pagination-row {
    display: none !important;
  }
  /* By id, because the card-page rule that shows the scrub carries an extra
     :not() and therefore outranks an attribute-plus-class selector however
     late it comes. An id ends the argument. */
  .project-detail[data-renders="true"] #deck-grid-mobile-scrub,
  .project-detail[data-renders="true"] #deck-grid {
    display: none !important;
  }

  /* Stack. The grid's columns exist to put text next to a picture that is
     not here, and its text column places its own grid-row, so an auto-placed
     child landed in the same row and drew over it. */
  .project-detail[data-renders="true"] {
    display: flex !important;
    flex-direction: column;
    /* `gap` is a grid AND a flex property, so the grid's row gap carried over
       and opened 145px between the copy and the rooms. */
    gap: 0 !important;
    height: auto !important;
    max-height: none !important;
    overflow: visible !important;
  }
  .project-detail[data-renders="true"] .project-content-grid,
  .project-detail[data-renders="true"] .project-col-left,
  .project-detail[data-renders="true"] .project-card-info,
  .project-detail[data-renders="true"] .project-card__row2,
  .project-detail[data-renders="true"] .project-card__text-block {
    display: block !important;
    grid-row: auto !important;
    height: auto !important;
    min-height: 0 !important;
    max-height: none !important;
    overflow: visible !important;
  }
  .project-detail[data-renders="true"] .project-card__desc {
    max-height: none !important;
    overflow: visible !important;
  }
  .project-detail[data-renders="true"] .project-people {
    margin-top: 16px !important;
  }

  .renders-section {
    width: 100%;
    min-width: 0;
    padding-top: 8px;
    padding-bottom: 24px;
  }

  .renders-collection {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 8px 0 32px;
    padding-top: 16px;
    border-top: 1px solid var(--_tokens---color--line-soft);
    font-size: var(--_tokens---type--small);
    line-height: 1.4;
    color: var(--_tokens---color--fg);
  }
  .renders-collection__face {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
    filter: grayscale(1);
  }
  /* From 700 up the credit sticks just above whatever is fixed at the
     bottom of the window — the Quick Search bar, or the tablet's nav dock —
     so it stays in view while the work scrolls past, and settles into its
     own place at the end. The script measures that bar into --rc-bottom.
     It steps aside while suggestions are open, which rise into the same
     space. */
  @media (min-width: 700px) {
    .renders-collection {
      position: sticky;
      bottom: var(--rc-bottom, 68px);
      z-index: 4;
      margin-bottom: 0;
      padding-bottom: 12px;
      width: 100%;
      max-width: none;
      box-sizing: border-box;
      background-color: var(--_tokens---color--bg);
      /* The work scrolls under it; a short fade in the page colour instead
         of a hard edge, the same as the suggestions panel. */
      box-shadow: 0 -24px 16px -8px var(--_tokens---color--bg);
      transition: opacity var(--_tokens---motion--fast) ease, visibility var(--_tokens---motion--fast) ease;
    }
    :global(body:has(#qs-sug:not([hidden]))) .renders-collection {
      opacity: 0;
      visibility: hidden;
    }
  }
  .renders-collection a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, currentColor 35%, transparent);
    white-space: nowrap;
    --arrow-size: var(--_tokens---arrow--sm);
  }

  /* By id: the phone card moves this button into itself and styles it there,
     and those rules outrank an attribute-plus-class selector. There is no
     prompt behind a visualisation — the renders are the work, not a text
     that produced them. */
  .project-detail[data-renders="true"] #project-prompt-wrap,
  .project-detail[data-renders="true"] #project-prompt-btn {
    display: none !important;
  }

  /* The faces, once moved: a tight row at the top right of the copy, on the
     subtitle's line. Absolute, so they take no height from a column whose
     measure is already set, and right:0 is the page's edge because only the
     text block carries the 80ch cap. */
  .project-detail[data-renders="true"] .project-card-info {
    position: relative;
  }
  /* ── The people, in the filter row ─────────────────────────────────────
     The panel is moved into `.project-meta-row--pills` by script, so these
     rules key off that row rather than off the old `.renders-people` slot —
     the slot is no longer the parent, and styling it left the avatars at
     their 72px default, which wrapped them onto a line of their own.

     The slot rules stay below for the fallback case: a project with no pill
     row still has somewhere to put its credits. */
  /* A line of its own above the subtitle: faces, then the credit beside
     them. Static and full width — it is a row in the copy column now, not an
     overlay pinned to a corner of it. */
  /* No `width: 100%`. It is block-level, so it already fills the column — and
     stated explicitly it stops the picture's clearance margin from shrinking
     it, which pushed the credit's box out under the picture. */
  .renders-people {
    position: static;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    margin: 0 0 14px;
  }
  .renders-people--title {
    position: static;
    width: auto;
    margin: 0;
    flex: 0 0 auto;
  }
  /* Who they are and whose studio it was. Set in the same micro the pills use
     so it reads as a fact about the project rather than as a sentence of the
     description, and muted so the subtitle under it still leads. */
  .renders-credit {
    margin: 0;
    font-size: var(--_tokens---type--micro);
    line-height: 1.3;
    color: var(--_tokens---color--muted);
    flex: 1 1 12ch;
    min-width: 0;
  }

  /* ── The fixed picture beside the copy (wide band only) ────────────────
     Two columns: the whole copy block on the left — faces and credit,
     subtitle, description — and one still on the right.

     Absolutely positioned, not a grid cell. As a grid item the picture is
     345px tall against about 200px of copy, so whichever row it sits in grows
     to its height: in row one it pushed the subtitle 334px clear of the
     credit above it, and spanning every row handed the same extra height back
     to all of them. Out of flow it cannot do either. The copy is given a
     right margin to keep clear of it, which is the only thing the picture
     costs the text.

     The standing rule for this template is one column at every width, and the
     reason is on the record: a two-column band once halved a render to 647px
     so a paragraph could sit beside it. That reason is about the RENDER, and
     nothing here touches it — the stage and the rail are still the full page
     width, below. What sits beside the text is a still at a fixed 260px.

     1024 and up only. Below that the column is already the width of the page
     and there is nothing to spare. */
  .renders-aside { display: none; }

  @media (min-width: 1024px) {
    .project-detail[data-renders="true"] .project-card-info {
      position: relative;
      /* One number for the still's width — the copy's clearance is derived
         from it, so the two can never drift apart. 360 rather than the 260
         it started at: at 260 against a 1035px stage it read as a thumbnail
         that had wandered up the page. */
      --rr-aside-w: 360px;
      /* …and one for the height it is allowed. The still is out of flow, so
         it cannot push anything down: CARLO's is 480px tall against about
         330px of copy and hung straight over the slider below, and SHLF's
         overran by 50. Giving the copy block a floor reserves the room
         instead, and the still is capped to it, so nothing can collide
         however long or short the writing is. 420 keeps every one of the
         four larger than the 260 they started at.

         !important because the renders reset sets `min-height: 0 !important`
         on this column; without it the floor never applied and the still was
         capped to the copy instead — 216px wide on CARLO, smaller than the
         260 this started at. */
      min-height: var(--rr-aside-h) !important;
      --rr-aside-h: 420px;
    }
    /* Room for the picture, so a long line of copy never runs under it. The
       gap is a fixed 32px rather than --space--medium, which clamps up to
       6rem: at 1440 that put 86px of nothing between the text and the
       picture, and the two stopped reading as one block. */
    .project-detail[data-renders="true"] .project-card-info:has(> .renders-aside) > *:not(.renders-aside) {
      margin-right: calc(var(--rr-aside-w) + 32px);
    }
    /* Centred against the copy, not pinned to its top. The box spans the
       full height of the copy block (top and bottom both 0) and the picture
       centres inside it.

       `safe center` and not plain `center`: CARLO's still is 480px tall
       against about 330px of copy, and centring something taller than its
       container pushes it out of BOTH ends — the top one being the filter
       pills. The safe keyword falls back to start alignment exactly when the
       item would overflow, so a short still centres and a tall one hangs
       from the top as before. */
    .project-detail[data-renders="true"] .project-card-info > .renders-aside {
      display: flex;
      align-items: safe center;
      justify-content: center;
      position: absolute;
      top: 0;
      bottom: 0;
      right: 0;
      width: var(--rr-aside-w);
      margin: 0;
    }
    /* Fits inside the box rather than filling its width, so a tall still is
       scaled down whole instead of cropped or spilling. CARLO lands at 315
       wide, SHLF and the two landscape ones at the full 360. */
    /* The media wrapper takes the picture's own size, so the control can be
       hung off its corner rather than the column's. */
    .renders-aside__media {
      position: relative;
      display: block;
      max-width: 100%;
      max-height: 100%;
      min-height: 0;
    }
    .renders-aside img,
    .renders-aside video {
      width: auto;
      height: auto;
      max-width: 100%;
      max-height: 100%;
      display: block;
      border-radius: var(--_tokens---radius--small);
      /* Sits with the dimmed thumbnails rather than competing with the stage:
         it is there to be read against, not looked at. */
      opacity: 0.85;
    }
    /* Inside the picture's bottom-left, not floating beside it: it belongs to
       the reel and nothing else on the page has sound. The figure is already
       absolute, so this positions against it. */
    .renders-aside__sound {
      position: absolute;
      left: 8px;
      bottom: 8px;
      display: grid;
      place-items: center;
      padding: 6px;
      border: 1px solid var(--_tokens---color--line);
      border-radius: 999px;
      background: var(--_tokens---color--bg-overlay);
      color: var(--_tokens---color--fg);
      cursor: pointer;
      --icon-size: var(--_tokens---arrow--sm);
      opacity: 0.55;
      transition: opacity var(--motion--base) ease;
    }
    @media (hover: hover) {
      .renders-aside__sound:hover { opacity: 1; }
    }
    .renders-aside__sound:focus-visible { opacity: 1; }
    /* One button, two glyphs, stacked in the same cell — the state decides
       which is drawn, so the control never changes size as it flips. */
    .renders-aside__sound .rs-off,
    .renders-aside__sound .rs-on { grid-area: 1 / 1; }
    .renders-aside__sound[data-sound="off"] .rs-on,
    .renders-aside__sound[data-sound="on"] .rs-off { display: none; }
  }
  .renders-people:empty { display: none; }

  /* Sized to be read, not to disappear. These were one line tall — 16-20px —
     the right measure for something sitting inside a sentence and the wrong
     one for a face: at that size two people are two grey dots.

     In the row the constraint is different. A pill is 21px and the row
     centres its children, so a taller face just makes that line of the row
     taller and still belongs to it. 28px is the smallest size at which these
     crops read as people; 32px from 700 up, where the row has the width to
     carry it. Still a credit, not a cast list — the names stay hidden and
     the group is one item at the end of the row. */
  /* `.project-detail` on the front to outrank
     `.project-detail .project-phone-card .project-people`, which styles the
     standalone people row on a phone as a horizontal scroller and pulls it to
     the head of its flex parent with order:-1. Inside the filter row that
     rule would put the faces in front of the pills on a phone and behind them
     on a desktop — the same element in two places depending on the width. */
  .project-detail .project-meta-row--pills .project-people,
  .project-detail .renders-people .project-people {
    --rp-face: 32px;
    order: 0 !important;
    overflow: visible !important;
    gap: 4px !important;
    display: flex !important;
    flex-direction: row !important;
    flex-wrap: nowrap;
    align-items: center;
    gap: 4px;
    margin: 0 !important;
    flex: 0 0 auto;
    /* The base rule is `width: 100%`, for the full cast list standing in a
       column of its own. In the filter row that makes the group claim the
       whole line and wrap onto one by itself, which is the opposite of
       sitting with the pills. */
    width: auto !important;
    max-width: none !important;
  }

  @media (min-width: 700px) {
    .project-detail .project-meta-row--pills .project-people,
    .project-detail .renders-people .project-people { --rp-face: 40px; }
  }

  .project-detail .project-meta-row--pills .project-people__name,
  .project-detail .renders-people .project-people__name { display: none; }

  .project-detail .project-meta-row--pills .project-people__person,
  .project-detail .renders-people .project-people__person {
    width: auto !important;
    flex: 0 0 auto;
  }

  .project-detail .project-meta-row--pills .project-people__avatar,
  .project-detail .renders-people .project-people__avatar {
    width: var(--rp-face) !important;
    height: var(--rp-face) !important;
    min-width: var(--rp-face) !important;
    aspect-ratio: 1;
  }

  .project-detail .project-meta-row--pills .project-people__divider,
  .project-detail .renders-people .project-people__divider {
    width: 1px !important;
    height: var(--rp-face) !important;
    align-self: center;
  }

  /* One column at every width: the copy, then the work under it. It was two
     on the wide band for a moment — copy left, pictures right — which halved
     a render to 647px so a paragraph could sit beside it. The pictures are
     the project; they get the page.

     The passage still stops at 80ch. Set across 1440px it ran past 140
     characters a line, twice what anyone reads comfortably. */
  @media (min-width: 1024px) {
    .project-detail[data-renders="true"] .project-card__text-block,
    .project-detail[data-renders="true"] .project-card__intro {
      max-width: 80ch;
    }
  }

  /* The Video pill is a phone control only. Above 700 the reel is the fixed
     picture beside the copy and there is nothing to unfold. */
  .project-video-btn { display: none; }

  /* On a phone the description sits in the bottom card, under the subtitle,
     open — no Read more. The pill exists to keep a paragraph out of a fixed
     strip; here the paragraph is the point, so the strip grows for it and
     scrolls if the writing is long. The card measures its own height, so
     everything above it moves up on its own.

     `chapters` is the exception, and the reason is what the card holds. On a
     rooms project the card is the subtitle and the passage, and the passage
     is short. A study's card also has to carry the reel, and three things
     open at once in a fixed strip is most of the screen — so there the
     description goes back behind Read more, the subtitle is the only prose
     the card shows by default, and the reel sits behind a Video pill on the
     same row. Written as `:not([data-chapters])` rather than as a later
     override because these rules are `!important` and a second !important
     rule of equal specificity would win on source order alone — which is the
     kind of thing that silently swaps when a block is moved. */
  @media (max-width: 699.98px) {
    .project-detail[data-renders="true"]:not([data-chapters="true"]) #project-readmore-btn {
      display: none !important;
    }
    .project-detail[data-renders="true"]:not([data-chapters="true"]) .project-phone-card .project-desc-readmore {
      display: block !important;
      max-height: none !important;
      overflow: visible !important;
    }
    .project-detail[data-renders="true"]:not([data-chapters="true"]) .project-phone-card .project-card__desc {
      display: block !important;
      max-height: 32vh !important;
      overflow-y: auto !important;
      scrollbar-width: none;
    }
    .project-detail[data-renders="true"] .project-phone-card .project-card__desc::-webkit-scrollbar {
      display: none;
    }
    /* Chapters: the pill is the control, so it has to be visible and the
       description has to start shut. The renders reset above sets this column
       to `display: block !important`, which the card's own collapsed rule
       cannot beat, so the closed state is restated here. Open, it scrolls at
       32vh like the others. */
    .project-detail[data-chapters="true"] .project-phone-actions .project-video-btn,
    .project-detail[data-chapters="true"] .project-phone-actions #project-readmore-btn {
      display: inline-flex !important;
    }
    .project-detail[data-chapters="true"] .project-phone-card .project-desc-readmore {
      display: none !important;
    }
    .project-detail[data-chapters="true"] .project-phone-card.is-reading .project-desc-readmore {
      display: block !important;
      max-height: none !important;
      overflow: visible !important;
    }
    .project-detail[data-chapters="true"] .project-phone-card.is-reading .project-card__desc {
      display: block !important;
      max-height: 32vh !important;
      overflow-y: auto !important;
      scrollbar-width: none;
    }
  }

  @media (max-width: 699.98px) {
    /* The header is fixed on this band, and the page pads itself by a number
       measured for the deck layout's header rather than this one — which left
       145px of nothing, and then hid the room tabs under it when the padding
       was cut. The header is fixed so a full-height deck can roll under it;
       nothing rolls under anything here, so it simply scrolls with the page
       and the clearance stops being a number anyone has to keep right. */
    .project-detail[data-renders="true"] .project-dashboard-wrap {
      position: static !important;
    }
    .project-detail[data-renders="true"] {
      padding-top: 0 !important;
    }
    /* Clearance for the fixed bottom card, and it has to stay. Cutting it to
       16px looked right at 375x812 — the visible gap is the same either way,
       because that gap is unused viewport rather than padding — but at
       375x667 and 320x568 XBKC's last line then sat 51px and 182px BEHIND
       the card with the document no taller than the screen, so there was no
       scroll available to bring it back. Unreachable content, on the two
       smallest phones, to save space that was never the thing taking up the
       room. The gap is closed by the stage taking the slack instead. */
    .renders-section {
      padding-bottom: calc(var(--pp-card-h, 80px) + var(--pp-dock-h, 66px) + 16px);
    }
    /* The stage's own height lives in RenderRooms.astro. A rule for it
       cannot be written here: this file's <style> is scoped, so every
       selector gets this page's data-astro-cid-*, and .rr__stage carries the
       component's instead — the rule is emitted and never matches. */
  }

  /* One compact caption, with model names carrying the emphasis. */
  .project-pipeline {
    grid-column: 1 / -1;
    display: block;
    width: 100%;
    min-width: 0;
    max-width: 80ch;
    margin: var(--_tokens---space--micro) 0 0;
    font-size: var(--_tokens---type--ultrathin);
    line-height: 1.5;
    font-style: normal;
    color: var(--_tokens---color--muted);
    overflow-wrap: anywhere;
  }
  .project-pipeline strong {
    color: var(--_tokens---color--fg);
    font-weight: 600;
  }

  /* On a phone it sits directly under the title, above the pills: the pills
     are a row of links you might follow, and this is a caption on the work
     you are looking at. The metaline is a flex column on this band, so one
     `order` moves it without touching the markup. */
  @media (max-width: 699.98px) {
    .project-detail .project-top-header { display: flex; flex-direction: column; }
    .project-detail .project-header-title-row { order: 1; }
    /* Only the ORDER changes here. The paragraph itself is the same object
       at every width — it used to be a one-line scroller above 700 and a
       wrapped block below, which is two layouts to keep in step for one
       piece of text. */
    .project-detail .project-pipeline {
      order: 2;
      margin-top: 6px;
      /* The 80ch cap is the desktop measure; the column is narrower than
         that here and the cap would only ever be the smaller of the two. */
      max-width: none;
    }
    .project-detail .project-card__metaline { order: 3; }
  }

  /* ── A landscape series ───────────────────────────────────────────────
     Every frame box on this page is portrait by default — the deck card is
     2:3 "the aspect ratio of playing cards", the filmstrip is 3:4, and the
     active frame is 2:3 — which is right for a face and wrong for a
     photograph of a house: a 1.46:1 render in a 2:3 box is cropped to the
     middle third of itself, and on the desktop page that was a 408x613
     slice of a building 2432 wide.

     One ratio, stated once, on every box that holds one of these frames.
     3:2 rather than the renders' own 1.462:1, because 3:2 is a real camera
     frame and the 2% left over is taken off the sky by `object-fit: cover`.

     Last in the file on purpose, and the attribute is DOUBLED — the same
     trick `.tap-44.tap-44` uses in tokens.css. Being last and `!important`
     was not enough: the rule that actually held the deck thumbnail at 2:3 is
     `.project-detail[data-is-card="true"]:not([data-tab-layout="true"])
     .deck-grid--mobile-scrub .deck-card-item`, and its `:not()` counts, so
     it outranked a single `[data-frame]` by one. The thumbnails stayed
     portrait while the active frame — which had no such competitor — went
     landscape, which is the confusing half-applied state this avoids. */
  .project-detail[data-frame="landscape"][data-frame="landscape"] .deck-card-item,
  .project-detail[data-frame="landscape"][data-frame="landscape"] .deck-grid--mobile-scrub .deck-card-item,
  .project-detail[data-frame="landscape"][data-frame="landscape"] .deck-grid--mobile-scrub .deck-card-inner,
  .project-detail[data-frame="landscape"][data-frame="landscape"] .deck-grid--mobile-scrub .deck-card-inner img,
  .project-detail[data-frame="landscape"][data-frame="landscape"] .project-detail__active-wrap {
    aspect-ratio: 3 / 2 !important;
  }
  /* Out of the left column and under the whole page — the script above does
     the move; this sizes what lands there.

     `grid-column: 1 / -1` is the load-bearing line. `.project-dashboard-wrap`
     is `display: contents`, so a deck moved out of the content grid does not
     become a block in the page: it becomes a direct item of
     `.project-detail`'s own two-column grid, and it sat in column one at
     571px — the same width it was trying to escape.

     Five a row, fixed rather than `auto-fill`: 1078 across gives a 211x140
     thumbnail, which is a photograph of a house you can actually read, and a
     fixed count keeps the rows square with each other at every width in the
     band instead of reflowing from seven to five as the window narrows. */
  @media (min-width: 1024px) {
    /* ── The series page lays out its own grid ────────────────────────────
       Everything below used to be an override of the card chassis, and each
       one was fought by the next: the chassis declares `auto auto 1fr` and
       places the two columns across rows 2-3, so the row actually holding
       the picture is a share of free space rather than a size that fits its
       contents. A picture taller than that row overflowed it, `min-height: 0`
       on the spanning column removed its contribution to sizing, a margin on
       the deck lost to `.project-detail #deck-grid { margin: 0 !important }`,
       and the copy column collapsed to 24px on the way through.

       So this states the whole grid instead of correcting it. Four items,
       three rows, every one of them `auto` and every placement explicit:

         row 1   the header, both columns
         row 2   the copy | the picture
         row 3   the scrub, both columns

       Nothing here depends on what the chassis put where, and row 2 grows to
       whichever of the two columns is taller — which is what makes the scrub
       clear the picture with no measuring and no margin.

       It goes on `.project-detail`, not on `.project-content-grid--card`:
       that element and `.project-dashboard-wrap` are both `display: contents`,
       so their own grid properties are inert and the real grid is the article
       around them. That is also why the deck becomes a grid item at all when
       the script moves it out of the left column. */
    .project-detail[data-frame="landscape"][data-frame="landscape"] {
      grid-template-columns: minmax(0, 4fr) minmax(0, 6fr) !important;
      grid-template-rows: auto auto auto !important;
      align-items: start !important;
    }
    .project-detail[data-frame="landscape"][data-frame="landscape"] > .project-top-header,
    .project-detail[data-frame="landscape"][data-frame="landscape"] .project-top-header {
      grid-row: 1 !important;
      grid-column: 1 / -1 !important;
    }
    .project-detail[data-frame="landscape"][data-frame="landscape"] .project-col-left {
      grid-row: 2 !important;
      grid-column: 1 !important;
    }
    .project-detail[data-frame="landscape"][data-frame="landscape"] .project-col-right {
      grid-row: 2 !important;
      grid-column: 2 !important;
    }

    /* The picture is sized by its COLUMN'S WIDTH, not by the copy's height.

       Matching the copy read well at one viewport and was the wrong rule:
       the frame took the row's height and the ratio turned that into width,
       so a long description made a tall row and a tall row made a picture
       wider than its track, which spilled left across the words. Width first
       removes the failure mode rather than capping it — the picture is one
       column wide whatever the writing does.

       It sits at the TOP of its column, so when the copy runs longer the
       blank space falls under the picture instead of the picture growing to
       meet it.

       `max-height: 70vh` is the one cap, and it is there for the portrait
       series: a 2:3 frame at the full 628 of its column is 941px tall, which
       is a page of its own. A 3:2 one is 419 and never reaches the cap, so
       the landscape pages are unaffected by it. */
    /* The picture, then the row that names it. `column` because the script
       appends the name/counter/timer row into this column on this band, and
       the chassis lays it out as a row — the caption would sit beside the
       photograph rather than under it. */
    .project-detail[data-frame="landscape"][data-frame="landscape"] .project-col-right {
      flex-direction: column !important;
      gap: var(--_tokens---space--micro) !important;
    }
    .project-detail[data-frame="landscape"][data-frame="landscape"] .project-col-right > .project-card-name-pagination-row {
      width: 100% !important;
      margin: 0 !important;
    }
    .project-detail[data-frame="landscape"][data-frame="landscape"] .project-col-right,
    .project-detail[data-frame="landscape"][data-frame="landscape"] .project-slider-wrapper {
      align-items: flex-start !important;
      justify-content: flex-start !important;
      height: auto !important;
      max-height: none !important;
      /* Back to `auto`, deliberately. The chassis sets `min-height: 0` on
         this column, and a grid item's automatic minimum is exactly what
         tells an `auto` row how tall to be — zeroed, row two sized to the
         COPY alone (302) while the picture beside it was 418, and the scrub
         ran 83px through the photograph. */
      min-height: auto !important;
    }
    .project-detail[data-frame="landscape"][data-frame="landscape"] .project-detail__active-wrap {
      width: 100% !important;
      height: auto !important;
      max-width: 100% !important;
      max-height: 70vh !important;
      /* `min-width: auto` is a flex item's automatic minimum size and it
         beats `max-width`, so the caps above are only real with it at zero. */
      min-width: 0 !important;
      min-height: 0 !important;
      margin: 0 !important;
      align-self: flex-start !important;
    }
    .project-detail[data-frame="landscape"][data-frame="landscape"] .deck-grid--mobile-scrub {
      /* Row three of the grid stated above — the page's own third row, not
         an implicit one past the end of somebody else's template. Row two
         grows to whichever column is taller, so this clears the picture by
         construction rather than by a measured margin. */
      grid-row: 3 !important;
      grid-column: 1 / -1 !important;
      /* Six across, three rows deep, and it SCROLLS rather than running the
         page down: twenty-four houses at four rows is most of a second
         screen. The height is written by script, because three rows of a
         ratio-sized cell is a number CSS cannot reach — it needs the deck's
         own width, which is only knowable as `100%` of a box whose height
         this would be setting. */
      grid-template-columns: repeat(6, 1fr) !important;
      gap: 6px !important;
      overflow-y: hidden !important;
      scroll-behavior: smooth;
      margin-top: var(--_tokens---space--small);
    }
    /* Only the row the active frame is in is lit. The deck is scrolled so
       that row is the top one, so what you read is: this row is where you
       are, the two under it are what comes next. Same brightness step as the
       phone window, for the same reason — the page behind is a pale scheme
       colour and dropping opacity washes frames out towards it instead of
       settling them back. */
    .project-detail[data-frame="landscape"][data-frame="landscape"] .deck-card-item img {
      filter: brightness(0.55);
      transition: filter var(--_tokens---motion--base) ease;
    }
    .project-detail[data-frame="landscape"][data-frame="landscape"] .deck-card-item.is-live img {
      filter: none;
    }
  }
  /* The fullscreen deck too. Its cards are `24vw x 62dvh` — a playing card,
     which is what the portrait series is — and a landscape render inside one
     is `object-fit: cover`d down to the middle third of itself. Here the card
     takes the renders' OWN ratio, 2432x1664, which reduces to 19:13, so cover
     crops nothing at all and the whole house is in the frame.

     Everything else about the deck is untouched: the same scale, the same
     grayscale and blur on the neighbours, the same snap. Only the card is a
     different shape. */
  /* ── The fullscreen deck, for a series ────────────────────────────────
     The cards were sized in viewport units — `24vw x 62dvh` — which left a
     760px band with a 395px picture sitting in the middle of it and empty
     screen above and below. They are sized by the BAND now: as tall as the
     space between the header and the name allows, width following the
     ratio. Nothing else about the deck changes — same snap, same scale on
     the centre, same grayscale and blur on the neighbours.

     92% rather than 100% because the centre card is scaled 1.08: at full
     height it would be cropped top and bottom by the band it lives in, and
     0.92 x 1.08 lands at 0.994. */
  .project-detail[data-portraits="true"] .lightbox-deck {
    align-items: flex-start !important;
  }
  .project-detail[data-portraits="true"] .lightbox-deck__item {
    height: 92% !important;
    width: auto !important;
    aspect-ratio: 2 / 3 !important;
    /* The centre card is scaled 1.08, and a scale about the middle grows in
       BOTH directions: top-anchored at 92% it still reached 28px above the
       band and slid under the header. From the top edge it can only grow
       down, into the space 92% left for it. */
    transform-origin: top center;
  }
  /* The landscape series takes the renders' OWN ratio — 2432x1664 reduces to
     19:13 — so `object-fit: cover` crops nothing and the whole house is in
     the frame. A 1.46:1 render in the 2:3 card above is the middle third of
     itself. The padding follows the card's width so the neighbours still
     peek by the same amount. */
  .project-detail[data-frame="landscape"][data-frame="landscape"] .lightbox-deck__item {
    aspect-ratio: 19 / 13 !important;
  }
  .project-detail[data-frame="landscape"][data-frame="landscape"] .lightbox-deck {
    padding-inline: calc(50% - 34vw) !important;
  }

  /* The phone window sets its own row heights, so the cells there must NOT
     hold a ratio — they fill the row they were given, exactly as the
     portrait grid's do. This undoes the line above for those three only. */
  @media (max-width: 699.98px) {
    .project-detail[data-frame="landscape"][data-frame="landscape"] #deck-grid .deck-card-item[data-win],
    .project-detail[data-frame="landscape"][data-frame="landscape"] #deck-grid .deck-card-item[data-win] .deck-card-inner,
    .project-detail[data-frame="landscape"][data-frame="landscape"] #deck-grid .deck-card-item[data-win] .deck-card-inner img {
      aspect-ratio: auto !important;
      height: 100% !important;
      min-height: 0 !important;
    }
  }
</style>

<script>
  import { wireAccordion } from "../../lib/accordion";
  import { dialogFocus } from "../../lib/dialogFocus";
  import { shuffle, reorderChildrenByIndex } from '../../lib/random';
  import { GLYPHS } from '../../lib/glyphs';

  /* The collection credit sticks above the lowest bar fixed to the bottom
     of the window. That bar is the Quick Search from 1024 up and the nav
     dock below it, and both change height with the band and the safe
     area, so it is measured rather than written down. */
  function initCollectionCredit() {
    const credit = document.querySelector<HTMLElement>('.renders-collection');
    if (!credit) return;
    const measure = () => {
      let clear = 0;
      document.querySelectorAll<HTMLElement>('.home-search__bar, .breadcrumb').forEach(el => {
        const r = el.getBoundingClientRect();
        if (!r.height || getComputedStyle(el).display === 'none') return;
        // Only something parked low in the window counts: the dock on a
        // tablet floats a few pixels clear of the edge.
        if (r.bottom <= window.innerHeight + 2 && r.top > window.innerHeight / 2) {
          clear = Math.max(clear, window.innerHeight - r.top);
        }
      });
      credit.style.setProperty('--rc-bottom', `${Math.ceil(clear)}px`);
    };
    measure();
    window.addEventListener('resize', measure, { passive: true });
  }

  function initProjectPage() {
    const article = document.querySelector('.project-detail');
    if (!article) return;
    initCollectionCredit();

    const isCardPage = article.getAttribute('data-is-card') === 'true';
    const isScarpinPage = article.getAttribute('data-is-scarpin') === 'true';

    // Wire the collapsible tabs FIRST and unconditionally. This used to live
    // inside initCardDeck(), which bails early on projects that have no images
    // (`if (!deck || !lightbox) return`) — so image-less pages (ARCHV: Dhal Ni
    // Pol, VANDLS, T4D, ARCHV itself) shipped tabs that could never open.
    initSectionTabs();
    initChapters();

    if (isScarpinPage) {
      initScarpinSliders();
    } else if (isCardPage) {
      initCardDeck();
      initDescReadMore();
    } else {
      initStandardSlider();
      initDescReadMore();
    }
  }

  // Collapsible section tabs. Tab-layout pages (work + ARCHV + academic +
  // chapter pages) get the single-open accordion: name tab + Design/Making, or
  // name tab + one tab per chapter. Other card pages (freelancer, original card
  // sets) keep Design/Making independent; original card sets additionally get
  // the standalone name tab.
  function initSectionTabs() {
    const article = document.querySelector('.project-detail');
    if (!article || (article as any)._tabsWired) return;
    (article as any)._tabsWired = true;

    const isTabLayoutPage = article.getAttribute('data-tab-layout') === 'true';
    const isOriginalCardSet = article.getAttribute('data-original-card') === 'true';
    const isPortraitsPage = article.getAttribute('data-portraits') === 'true';

    if (isTabLayoutPage) {
      wireWorkAccordion();
      return;
    }
    wireCollapse(document.querySelector('.project-design-section'), 'project-design-click', 'project-design-toggle', 'project-design-panel');
    wireCollapse(document.querySelector('.project-making-section'), 'project-making-click', 'project-making-toggle', 'project-making-panel');
    // Original card sets (Alt Verse, Indian Royals, Sups…): the project name is
    // a standalone collapsible tab like the work pages — closing it folds the
    // description and the big active card away; the scrubber stays out
    // (CSS keeps .deck-grid--mobile-scrub / the bottom deck visible).
    if (isOriginalCardSet && !isPortraitsPage) {
      wireCollapse(document.getElementById('project-dashboard'), 'project-name-header', 'project-name-toggle', 'project-dashboard');
    }
  }

  /* ── Description Read-More pill (height-clip, no DOM split) ── */
  function initDescReadMore() {
    const clip = document.getElementById('project-desc-clip') as HTMLElement | null;
    const btn  = document.getElementById('project-readmore-btn') as HTMLButtonElement | null;

    if (!clip || !btn) return;

    // Measure height of just the first child block (first <p> or first child)
    const firstChild = clip.firstElementChild as HTMLElement | null;
    if (!firstChild) { btn.style.display = 'none'; return; }

    // If there's only one child block, no need for the button
    if (clip.children.length < 2) { btn.style.display = 'none'; return; }

    // Collapsed height = height of the first block + its margins
    const collapsedHeight = firstChild.offsetHeight +
      parseInt(getComputedStyle(firstChild).marginTop) +
      parseInt(getComputedStyle(firstChild).marginBottom);

    // Full scrollHeight
    const fullHeight = clip.scrollHeight;

    // A pill that expands the text by a few pixels is a pill that lies. The
    // child count alone is not enough of a test: a description whose second
    // block is an empty paragraph passes it, and the button then toggled
    // between 205px and 206px. fullHeight was already being measured here and
    // then thrown away — this is what it was for.
    if (fullHeight - collapsedHeight < 8) { btn.style.display = 'none'; return; }

    // Set collapsed
    clip.style.maxHeight = collapsedHeight + 'px';

    btn.addEventListener('click', () => {
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      if (expanded) {
        // Collapse
        btn.setAttribute('aria-expanded', 'false');
        btn.querySelector('.project-readmore-label')!.textContent = 'Read more';
        clip.style.maxHeight = collapsedHeight + 'px';
      } else {
        // Expand
        btn.setAttribute('aria-expanded', 'true');
        btn.querySelector('.project-readmore-label')!.textContent = 'Read less';
        clip.style.maxHeight = clip.scrollHeight + 'px';
      }
    });
  }

  function initCardDeck() {
    const deck = document.getElementById('deck-grid');
    // Work-category pages only: the mobile one-row scrub right under the
    // pagination. Its .deck-card-item buttons share the same click/active
    // wiring as the main #deck-grid below the image (see updateScrubActiveState
    // and cardButtons below).
    const mobileScrub = document.getElementById('deck-grid-mobile-scrub') || (deck?.classList.contains('deck-grid--mobile-scrub') ? deck : null);
    const lightbox = document.getElementById('card-lightbox');
    const ambientImg = document.getElementById('lightbox-ambient-img') as HTMLImageElement | null;
    const closeBtn = document.getElementById('lightbox-close');
    const counter = document.getElementById('lightbox-counter');

    const pageActiveImg = document.getElementById('page-active-img') as HTMLImageElement | null;
    const pageOverlayName = document.getElementById('page-overlay-name');
    // Portrait series: the name sits beside the counter instead of over the
    // picture. Only one of the two exists on any given page.
    const pageCardName = document.getElementById('page-card-name');
    const pagePagination = document.getElementById('page-pagination');
    const pageActiveWrap = document.getElementById('page-active-wrap');

    // Glitch/scramble a name element into new text.
    const scrambleTo = (el: HTMLElement, text: string) => {
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) { el.textContent = text; return; }
      const prev = (el as any)._scrRaf;
      if (prev) cancelAnimationFrame(prev);
      const totalFrames = Math.min(Math.max(text.length * 1.5, 18), 40);
      let frame = 0;
      const step = () => {
        const progress = frame / totalFrames;
        el.textContent = text
          .split('')
          .map((ch, i) => {
            if (ch === ' ') return ' ';
            if (i < progress * text.length) return ch;
            return GLYPHS[Math.floor(Math.random() * GLYPHS.length)];
          })
          .join('');
        frame++;
        if (frame <= totalFrames) {
          (el as any)._scrRaf = requestAnimationFrame(step);
        } else {
          el.textContent = text;
          (el as any)._scrRaf = null;
        }
      };
      step();
    };

    const timerRings = ['page-timer-progress', 'page-timer-progress-mini']
      .map(id => document.getElementById(id))
      .filter((el): el is HTMLElement => el !== null);
    const detailEl = document.querySelector('.project-detail');

    if (!deck || !lightbox) return;

    // Keep the fixed mobile dashboard's height mirrored into --dash-h so the
    // card deck starts below it (the dashboard is out of the page flow).
    const dashboard = document.getElementById('project-dashboard');
    if (dashboard && detailEl) {
      const setDashHeight = () => {
        (detailEl as HTMLElement).style.setProperty('--dash-h', `${dashboard.offsetHeight}px`);
      };
      setDashHeight();
      if ('ResizeObserver' in window) new ResizeObserver(setDashHeight).observe(dashboard);
      window.addEventListener('resize', setDashHeight, { passive: true });
    }

    const images = JSON.parse(deck.getAttribute('data-images') || '[]');
    const projectName = document.querySelector('.project-detail')?.getAttribute('data-project-name') || '';

    // Randomise the navigation sequence once per load; the scrub grid and the
    // fullscreen deck are both reordered to match it, so next/prev always
    // lands on the visually-adjacent card, and it stays fixed until reload.
    const order = shuffle(Array.from({ length: images.length }, (_, i) => i));
    let currentPos = 0;
    let currentIdx = order[0] ?? 0;
    let isOpen = false;
    let autoplayInterval: number | null = null;

    reorderChildrenByIndex(deck, order);

    const goToPos = (pos: number) => {
      const count = images.length;
      currentPos = ((pos % count) + count) % count;
      currentIdx = order[currentPos];
    };

    const getCardName = (url: string): string => {
      let filename = url.substring(url.lastIndexOf('/') + 1);
      try { filename = decodeURIComponent(filename); } catch {}
      const ext = filename.substring(filename.lastIndexOf('.'));
      let name = filename.slice(0, filename.length - ext.length);
      name = name.replace(/^ADVT_(?:[A-Z]{2,4}_)+/, '').replace(/^ADVT_SP_\s*/, '').trim();
      name = name.replace(/\s+\d+\s*$/, '').replace(/\s*\d+$/, '').trim();
      if (name.includes(' - ') || name.includes(' — ')) {
        const parts = name.split(/\s*[-—]\s*/);
        const movie = parts[0].trim().toUpperCase();
        let char = parts.slice(1).join(' - ').trim();
        if (char.toLowerCase() === 'the t 800' || char.toLowerCase() === 'the t') char = 'The T-800';
        if (char.toLowerCase() === 'o ren ishii') char = 'O-Ren Ishii';
        if (char.toLowerCase() === 'dr king schultz') char = 'Dr. King Schultz';
        return `${movie} - ${char}`;
      }
      name = name.replace(/([a-z0-9])([A-Z])/g, '$1 $2').replace(/([A-Z]+)([A-Z][a-z])/g, '$1 $2').replace(/[_-]+/g, ' ').trim();
      if (!name || /^\d+$/.test(name) || name.length <= 1) return projectName;
      if (name.toLowerCase() === 'winter soildier') return 'Winter Soldier';
      if (name.toLowerCase() === 'wonder women') return 'Wonder Woman';
      if (name.toLowerCase() === 'cygborg') return 'Cyborg';
      if (name.toLowerCase() === 'scalet witch') return 'Scarlet Witch';
      if (name.toLowerCase() === 'the t 800' || name.toLowerCase() === 'the t') name = 'The T-800';
      if (name.toLowerCase() === 'o ren ishii') name = 'O-Ren Ishii';
      if (name.toLowerCase() === 'dr king schultz') name = 'Dr. King Schultz';
      const isPortraitsPage = detailEl?.getAttribute('data-portraits') === 'true';
      return isPortraitsPage ? name.toUpperCase() : name;
    };

    // ── Lightbox deck elements (reordered to match the shuffled sequence) ──
    const lightboxDeck = document.getElementById('lightbox-deck') as HTMLElement | null;
    if (lightboxDeck) reorderChildrenByIndex(lightboxDeck, order);
    let deckItems = lightboxDeck
      ? Array.from(lightboxDeck.querySelectorAll('.lightbox-deck__item')) as HTMLElement[]
      : [];

    /** Update scale/opacity of every deck item based on scroll position */
    const updateDeckTransforms = (): number | undefined => {
      if (!lightboxDeck || !deckItems.length) return undefined;
      const deckRect = lightboxDeck.getBoundingClientRect();
      const deckCenterX = deckRect.left + deckRect.width / 2;
      let closestDist = Infinity;
      let closestIdx = 0;
      deckItems.forEach((item, i) => {
        const rect = item.getBoundingClientRect();
        const itemCenterX = rect.left + rect.width / 2;
        const dist = Math.abs(itemCenterX - deckCenterX);
        const maxDist = deckRect.width * 0.6;
        const t = Math.min(dist / maxDist, 1);
        const sc = 1 - 0.18 * t;
        const op = 1 - 0.8 * t;
        item.style.transform = `scale(${sc.toFixed(3)})`;
        item.style.opacity = `${op.toFixed(3)}`;
        if (dist < closestDist) { closestDist = dist; closestIdx = i; }
      });
      deckItems.forEach((item, i) => item.classList.toggle('is-center', i === closestIdx));
      return closestIdx;
    };

    /** Smoothly scroll the deck so item at idx is centred */
    const scrollDeckTo = (idx: number, behavior: ScrollBehavior = 'smooth') => {
      if (!lightboxDeck || !deckItems[idx]) return;
      const item = deckItems[idx];
      const deckRect = lightboxDeck.getBoundingClientRect();
      const itemRect = item.getBoundingClientRect();
      const itemCenterInDeck = (itemRect.left - deckRect.left) + itemRect.width / 2;
      const targetScrollLeft = lightboxDeck.scrollLeft + itemCenterInDeck - deckRect.width / 2;
      lightboxDeck.scrollTo({ left: targetScrollLeft, behavior });
    };

    // ── Timer ring ─────────────────────────────────────────────────────────
    const resetTimerRing = () => {
      timerRings.forEach(ring => {
        const wrap = ring.closest('.autoplay-timer-ring');
        if (wrap) {
          wrap.classList.remove('is-animating');
          void (wrap as HTMLElement).offsetWidth;
          wrap.classList.add('is-animating');
        }
      });
      const lightboxProgress = document.getElementById('lightbox-timer-progress');
      if (lightboxProgress) {
        const wrap = lightboxProgress.closest('.autoplay-timer-ring');
        if (wrap) {
          wrap.classList.remove('is-animating');
          void (wrap as HTMLElement).offsetWidth;
          if (isOpen) wrap.classList.add('is-animating');
        }
      }
    };

    const updateScrubActiveState = () => {
      deck.querySelectorAll('.deck-card-item').forEach(btn => {
        btn.classList.toggle('is-active', parseInt(btn.getAttribute('data-index') || '-1', 10) === currentIdx);
      });
      mobileScrub?.querySelectorAll('.deck-card-item').forEach(btn => {
        btn.classList.toggle('is-active', parseInt(btn.getAttribute('data-index') || '-1', 10) === currentIdx);
      });
      /* A portrait page re-centres its 3x3 window on the new active frame.
         Installed by initPortraitWindow; absent everywhere else. */
      (deck as any)._paintWindow?.();
    };

    // ── Name label: set word-by-word spans ─────────────────────────────────
    const nameLabel = document.getElementById('lightbox-card-label') as HTMLElement | null;
    const setNameLabel = (name: string) => {
      if (!nameLabel) return;
      nameLabel.innerHTML = name.split(' ').filter(Boolean).map(w => `<span>${w}</span>`).join(' ');
    };

    // ── updateDisplay ───────────────────────────────────────────────────────
    const updateDisplay = (scrollDeck = true) => {
      const activeUrl = images[currentIdx];
      const activeName = getCardName(activeUrl);

      if (ambientImg) ambientImg.src = activeUrl;
      if (counter) counter.textContent = `${currentPos + 1} / ${images.length}`;
      setNameLabel(activeName);

      if (pageActiveImg) pageActiveImg.src = activeUrl;
      if (pageOverlayName) scrambleTo(pageOverlayName, activeName);
      if (pageCardName) scrambleTo(pageCardName, activeName);
      if (pagePagination) pagePagination.textContent = `${currentPos + 1} / ${images.length}`;

      // Active card's logo — beside the pagination (fg-tinted) and on the big
      // card's top-right corner (bg-tinted, desktop); both pop on change
      const logoSrc = deck.querySelector(`.deck-card-item[data-index="${currentIdx}"]`)?.getAttribute('data-logo');
      const logoEl = document.getElementById('page-active-logo');
      if (logoEl) {
        if (logoSrc) {
          logoEl.style.setProperty('--logo', `url("${logoSrc}")`);
          logoEl.style.display = 'block';
          logoEl.classList.remove('is-swap');
          void (logoEl as HTMLElement).offsetWidth;
          logoEl.classList.add('is-swap');
        } else {
          logoEl.style.display = 'none';
        }
      }
      const cardLogoEl = document.getElementById('page-active-card-logo');
      if (cardLogoEl) {
        if (logoSrc) {
          cardLogoEl.style.setProperty('--logo', `url("${logoSrc}")`);
          cardLogoEl.classList.add('is-on');
          cardLogoEl.classList.remove('is-swap');
          void (cardLogoEl as HTMLElement).offsetWidth;
          cardLogoEl.classList.add('is-swap');
        } else {
          cardLogoEl.classList.remove('is-on');
        }
      }

      resetTimerRing();
      updateScrubActiveState();

      const scrubFill = document.getElementById('lightbox-scrubber-fill');
      if (scrubFill) scrubFill.style.width = `${(currentPos / Math.max(order.length - 1, 1)) * 100}%`;

      if (scrollDeck && isOpen) scrollDeckTo(currentPos);
    };

    // ── Autoplay ────────────────────────────────────────────────────────────
    const stopAutoplay = () => {
      if (autoplayInterval) { clearInterval(autoplayInterval); autoplayInterval = null; }
      timerRings.forEach(ring => {
        const wrap = ring.closest('.autoplay-timer-ring');
        if (wrap) wrap.classList.remove('is-animating');
      });
      const lp = document.getElementById('lightbox-timer-progress');
      if (lp) {
        const wrap = lp.closest('.autoplay-timer-ring');
        if (wrap) wrap.classList.remove('is-animating');
      }
    };

    const startAutoplay = () => {
      stopAutoplay();
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      resetTimerRing();
      autoplayInterval = window.setInterval(() => {
        goToPos(currentPos + 1);
        updateDisplay(true);
      }, 2000);
    };

    // ── Open / close ────────────────────────────────────────────────────────
    const focus = dialogFocus(lightbox);
    pageActiveWrap?.addEventListener("keydown", (event) => { if (event.key === "Enter" || event.key === " ") { event.preventDefault(); pageActiveWrap.click(); } });
    const openLightbox = (index: number) => {
      goToPos(order.indexOf(index));
      isOpen = true;
      lightbox.style.display = 'flex';
      lightbox.setAttribute('aria-hidden', 'false');
      focus.open();
      document.body.style.overflow = 'hidden';
      updateDisplay(false);
      requestAnimationFrame(() => {
        scrollDeckTo(currentPos, 'instant' as ScrollBehavior);
        updateDeckTransforms();
        startAutoplay();
      });
    };

    const closeLightbox = () => {
      isOpen = false;
      lightbox.style.display = 'none';
      lightbox.setAttribute('aria-hidden', 'true');
      focus.close();
      document.body.style.overflow = '';
      startAutoplay();
    };

    // ── Deck scroll listener ─────────────────────────────────────────────────
    if (lightboxDeck) {
      lightboxDeck.addEventListener('scroll', () => {
        const centerPos = updateDeckTransforms();
        if (centerPos !== undefined && centerPos !== currentPos) {
          goToPos(centerPos);
          const activeUrl = images[currentIdx];
          const activeName = getCardName(activeUrl);
          if (ambientImg) ambientImg.src = activeUrl;
          if (counter) counter.textContent = `${currentPos + 1} / ${images.length}`;
          setNameLabel(activeName);
          if (pageActiveImg) pageActiveImg.src = activeUrl;
          if (pageOverlayName) scrambleTo(pageOverlayName, activeName);
          if (pageCardName) scrambleTo(pageCardName, activeName);
          if (pagePagination) pagePagination.textContent = `${currentPos + 1} / ${images.length}`;
          updateScrubActiveState();
          stopAutoplay();
          startAutoplay();
        }
      }, { passive: true });
    }

    // ── Scrub grid listeners ─────────────────────────────────────────────────
    const cardButtons = Array.from(deck.querySelectorAll('.deck-card-item'))
      .concat((mobileScrub && mobileScrub !== deck) ? Array.from(mobileScrub.querySelectorAll('.deck-card-item')) : []);
    cardButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const idx = parseInt(btn.getAttribute('data-index') || '0', 10);
        // On a phone the deck IS the page's image: the large one beside it is
        // not rendered on that band, so a tap that only re-pointed it would
        // change a picture the reader cannot see. Open it instead.
        // openLightbox takes the image index and does its own goToPos.
        if (window.matchMedia('(max-width: 699.98px)').matches) {
          openLightbox(idx);
          return;
        }
        goToPos(order.indexOf(idx));
        updateDisplay(true);
        startAutoplay();
      });
      btn.addEventListener('dblclick', (e) => {
        e.preventDefault();
        const idx = parseInt(btn.getAttribute('data-index') || '0', 10);
        openLightbox(idx);
      });
    });

    // Mobile scrub: dragging a finger across the strip live-previews each
    // image under it (same "hover scrub" feel as the category-page thumb
    // strips), instead of needing a separate tap per image.
    if (mobileScrub) {
      const thumbIndexAtX = (clientX: number): number | null => {
        const items = Array.from(mobileScrub.querySelectorAll<HTMLElement>('.deck-card-item'));
        if (!items.length) return null;
        for (const item of items) {
          const r = item.getBoundingClientRect();
          if (clientX >= r.left && clientX <= r.right) {
            return parseInt(item.getAttribute('data-index') || '-1', 10);
          }
        }
        const firstRect = items[0].getBoundingClientRect();
        if (clientX < firstRect.left) return parseInt(items[0].getAttribute('data-index') || '-1', 10);
        const lastRect = items[items.length - 1].getBoundingClientRect();
        if (clientX > lastRect.right) return parseInt(items[items.length - 1].getAttribute('data-index') || '-1', 10);
        return null;
      };
      const scrubTo = (clientX: number) => {
        const idx = thumbIndexAtX(clientX);
        if (idx !== null && idx !== currentIdx) {
          goToPos(order.indexOf(idx));
          updateDisplay(true);
        }
      };
      mobileScrub.addEventListener('pointerdown', (e) => {
        if (e.pointerType === 'touch') {
          mobileScrub.setPointerCapture(e.pointerId);
          stopAutoplay();
          scrubTo(e.clientX);
        }
      });
      mobileScrub.addEventListener('pointermove', (e) => {
        if (mobileScrub.hasPointerCapture && mobileScrub.hasPointerCapture(e.pointerId)) scrubTo(e.clientX);
      });
      mobileScrub.addEventListener('pointerup', () => startAutoplay());
      mobileScrub.addEventListener('pointercancel', () => startAutoplay());
    }

    closeBtn?.addEventListener('click', closeLightbox);
    lightbox.querySelector('.lightbox-backdrop')?.addEventListener('click', closeLightbox);

    pageActiveWrap?.addEventListener('click', () => {
      openLightbox(currentIdx);
    });

    // Hover pauses autoplay on the page-view image and inside the lightbox;
    // it resumes as soon as the pointer leaves.
    pageActiveWrap?.addEventListener('mouseenter', stopAutoplay);
    pageActiveWrap?.addEventListener('mouseleave', startAutoplay);
    if (lightboxDeck) {
      lightboxDeck.addEventListener('mouseenter', stopAutoplay);
      lightboxDeck.addEventListener('mouseleave', () => { if (isOpen) startAutoplay(); });
    }

    document.addEventListener('keydown', (e) => {
      if (!isOpen) return;
      // While the lightbox is open the arrows drive it exclusively — stop the
      // event before the site-wide prev/next-project handler can also fire.
      if (e.key === 'ArrowRight') { e.preventDefault(); e.stopImmediatePropagation(); goToPos(currentPos + 1); updateDisplay(true); startAutoplay(); }
      if (e.key === 'ArrowLeft')  { e.preventDefault(); e.stopImmediatePropagation(); goToPos(currentPos - 1); updateDisplay(true); startAutoplay(); }
      if (e.key === 'Escape') { e.preventDefault(); e.stopImmediatePropagation(); closeLightbox(); }
    });

    // ── Broken images never render as empty/alt-text cards: drop the card
    // from the scrub, the lightbox, and the rotation entirely. ──
    const dropCard = (idx: number) => {
      deck.querySelector(`.deck-card-item[data-index="${idx}"]`)?.remove();
      mobileScrub?.querySelector(`.deck-card-item[data-index="${idx}"]`)?.remove();
      lightboxDeck?.querySelector(`.lightbox-deck__item[data-index="${idx}"]`)?.remove();
      deckItems = lightboxDeck
        ? Array.from(lightboxDeck.querySelectorAll('.lightbox-deck__item')) as HTMLElement[]
        : [];
      const pos = order.indexOf(idx);
      if (pos >= 0) order.splice(pos, 1);
      if (!order.length) return;
      if (currentIdx === idx || currentPos >= order.length) {
        goToPos(Math.min(currentPos, order.length - 1));
        updateDisplay(false);
      }
      fitDeckGrid();
    };
    deck.querySelectorAll('.deck-card-item img:not(.deck-card-logo)').forEach(im => {
      const img = im as HTMLImageElement;
      const idx = parseInt(img.closest('.deck-card-item')?.getAttribute('data-index') ?? '-1', 10);
      if (idx < 0) return;
      if (img.complete && img.naturalWidth === 0) { requestAnimationFrame(() => dropCard(idx)); return; }
      img.addEventListener('error', () => dropCard(idx));
    });

    // ── Header scrubber: click/drag jumps through the deck instantly ──
    const scrubberEl = document.getElementById('lightbox-scrubber');
    if (scrubberEl) {
      const scrubTo = (clientX: number) => {
        const rect = scrubberEl.getBoundingClientRect();
        const t = Math.min(Math.max((clientX - rect.left) / rect.width, 0), 1);
        const pos = Math.round(t * (order.length - 1));
        if (pos !== currentPos) {
          goToPos(pos);
          updateDisplay(false);
          scrollDeckTo(currentPos, 'instant' as ScrollBehavior);
        }
      };
      scrubberEl.addEventListener('pointerdown', (e) => {
        e.preventDefault();
        scrubberEl.setPointerCapture(e.pointerId);
        stopAutoplay();
        scrubTo(e.clientX);
      });
      scrubberEl.addEventListener('pointermove', (e) => {
        if (scrubberEl.hasPointerCapture && scrubberEl.hasPointerCapture(e.pointerId)) scrubTo(e.clientX);
      });
      scrubberEl.addEventListener('pointerup', () => startAutoplay());
    }

    updateDisplay(false);
    startAutoplay();
    updateScrubActiveState();

    // ── Fit the scrub grid's columns so its total height matches the
    // right-hand image exactly (grid-row: 3 already reserves that height —
    // we just need enough columns that the rows fill it, not scroll it) ──
    const deckSection = deck.closest('.card-deck-section') as HTMLElement | null;
    const fitDeckGrid = () => {
      if (!deckSection || window.matchMedia('(max-width: 1023.98px)').matches) {
        deck.style.removeProperty('grid-template-columns');
        return;
      }
      const targetHeight = deckSection.clientHeight;
      const containerWidth = deck.clientWidth;
      const count = deck.children.length;
      const gap = 6; // matches desktop .deck-grid gap
      if (!targetHeight || !containerWidth || !count) return;

      // Fewest columns (= biggest cards) whose full grid still fits the
      // reserved height — the scrub grows to meet the image's bottom edge.
      let bestCols = 24;
      for (let cols = 2; cols <= 24; cols++) {
        const cardWidth = (containerWidth - gap * (cols - 1)) / cols;
        if (cardWidth <= 0) continue;
        const rows = Math.ceil(count / cols);
        const totalHeight = rows * cardWidth * 1.5 + (rows - 1) * gap;
        if (totalHeight <= targetHeight) { bestCols = cols; break; }
      }
      // 'important' — the stylesheet's fallback rules also use !important
      deck.style.setProperty('grid-template-columns', `repeat(${bestCols}, 1fr)`, 'important');
    };

    fitDeckGrid();
    window.addEventListener('resize', fitDeckGrid, { passive: true });
    if ('ResizeObserver' in window && deckSection) {
      new ResizeObserver(fitDeckGrid).observe(deckSection);
    }

    // "Prompt" pill/tab reveals the prompt box (hidden when the page has no
    // prompt box). On portrait pages it sits right under the description as a
    // dropdown tab closed on load; on mobile it relocates below the pagination row.
    const promptBtn = document.getElementById('project-prompt-btn');
    const promptWrap = document.getElementById('project-prompt-wrap') || promptBtn;
    const promptCloseBtn = document.getElementById('project-prompt-close-btn');
    const promptBox = (document.querySelector('.project-card__desc .prompt-box') || document.querySelector('.prompt-box')) as HTMLElement | null;
    if (promptBtn) {
      if (!promptBox) {
        if (promptWrap) promptWrap.style.display = 'none';
        else promptBtn.style.display = 'none';
      } else {
        const isPortraitsPage = detailEl?.getAttribute('data-portraits') === 'true';
        if (isPortraitsPage && promptWrap) {
          promptWrap.after(promptBox);
        }

        const closePrompt = () => {
          promptBtn.setAttribute('aria-expanded', 'false');
          promptBox.classList.remove('is-open');
          if (promptCloseBtn) promptCloseBtn.hidden = true;
        };

        promptCloseBtn?.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          closePrompt();
        });

        promptBtn.addEventListener('click', () => {
          const open = promptBtn.getAttribute('aria-expanded') === 'true';
          const nextOpen = !open;
          promptBtn.setAttribute('aria-expanded', String(nextOpen));
          promptBox.classList.toggle('is-open', nextOpen);
          if (promptCloseBtn) promptCloseBtn.hidden = !nextOpen;
          if (nextOpen && isPortraitsPage) {
            requestAnimationFrame(() => {
              const descScroll = document.querySelector('.project-detail[data-portraits="true"] .desc-scroll');
              if (descScroll) {
                descScroll.scrollTo({ top: descScroll.scrollHeight, behavior: 'smooth' });
              }
            });
          }
        });

        if (!isPortraitsPage) {
          const promptHome = document.createElement('span');
          promptHome.style.display = 'none';
          promptBox.before(promptHome);
          const pagRow = document.querySelector('.project-card-name-pagination-row');
          const placePrompt = () => {
            const mobile = window.matchMedia('(max-width: 1023.98px)').matches;
            if (mobile && pagRow) {
              if (promptBox.previousElementSibling !== pagRow) pagRow.after(promptBox);
            } else if (promptHome.parentElement && promptBox.previousSibling !== promptHome) {
              promptHome.after(promptBox);
            }
          };
          placePrompt();
          window.addEventListener('resize', placePrompt, { passive: true });
        }
      }
    }

    // Work-category mobile: "Credits" pill reveals the people row
    const creditsBtn = document.getElementById('project-credits-btn');
    const peoplePanel = document.getElementById('project-people-panel');
    creditsBtn?.addEventListener('click', () => {
      const isExpanded = peoplePanel?.classList.toggle('is-expanded') ?? false;
      creditsBtn.setAttribute('aria-expanded', String(isExpanded));
    });
  }


  /* Chapters (data.chapters): tabs when there are two or more, otherwise a
     dropdown. Its own function — it used to live inside initStandardSlider,
     which returns early on every project-01 page, so it never ran there. */
  function initChapters() {
    // Chapter dropdowns (data.chapters) — accordion: only one open at a time
    const chapterSections = Array.from(document.querySelectorAll('.project-chapter'));
    const collapseChapter = (sect: Element) => {
      const toggleBtn = sect.querySelector('.project-detail-collapse-btn');
      if (!toggleBtn) return;
      sect.classList.remove('is-expanded');
      toggleBtn.setAttribute('aria-expanded', 'false');
    };

    // Chapters as tabs: the row picks the one chapter on screen.
    document.querySelectorAll<HTMLElement>('.project-chapters--tabs').forEach(wrap => {
      const tabs = Array.from(wrap.querySelectorAll<HTMLButtonElement>('.project-chapter-tab'));
      const panels = Array.from(wrap.querySelectorAll<HTMLElement>('.project-chapter'));
      const select = (tab: HTMLButtonElement) => {
        const n = tab.dataset.ch;
        tabs.forEach(t => t.setAttribute('aria-selected', String(t === tab)));
        panels.forEach(p => p.classList.toggle('is-active', n === 'all' || p.dataset.ch === n));
        wrap.classList.toggle('is-all', n === 'all');
        // Into view inside the tab row only — scrollIntoView moves the page.
        const row = tab.parentElement;
        if (row) {
          const l = tab.offsetLeft - row.offsetLeft, r = l + tab.offsetWidth;
          if (l < row.scrollLeft) row.scrollLeft = l;
          else if (r > row.scrollLeft + row.clientWidth) row.scrollLeft = r - row.clientWidth;
        }
        refreshFixedHead();
      };
      tabs.forEach(tab => tab.addEventListener('click', () => select(tab)));
      // Previous / next step through the chapters, wrapping at the ends.
      wrap.querySelectorAll<HTMLButtonElement>('[data-ch-step]').forEach(btn => btn.addEventListener('click', () => {
        const cur = tabs.findIndex(t => t.getAttribute('aria-selected') === 'true');
        const next = (cur + Number(btn.dataset.chStep) + tabs.length) % tabs.length;
        select(tabs[next]);
      }));
    });

    chapterSections.forEach(sect => {
      const header = sect.querySelector('.project-chapter__header');
      const toggleBtn = sect.querySelector('.project-detail-collapse-btn');
      if (!header || !toggleBtn) return;
      if (sect.closest('.project-chapters--tabs')) return;
      header.addEventListener('click', () => {
        const willExpand = !sect.classList.contains('is-expanded');

        // Collapse every other chapter before opening this one
        chapterSections.forEach(other => {
          if (other !== sect) collapseChapter(other);
        });

        sect.classList.toggle('is-expanded', willExpand);
        toggleBtn.setAttribute('aria-expanded', String(willExpand));
        toggleBtn.querySelectorAll('.link-arrow').forEach((a) => {
          (a as HTMLElement).style.transform = `rotate(${Math.floor(Math.random() * 360)}deg)`;
        });
        // Opening/closing a chapter changes whether the mobile head is fixed
        // and whether the intro is collapsed.
        refreshFixedHead();
      });
    });
  }

  function initStandardSlider() {
    const slider = document.getElementById('standard-slider-wrapper');
    const lightbox = document.getElementById('card-lightbox');
    const lightboxImg = document.getElementById('lightbox-card-img') as HTMLImageElement | null;
    const ambientImg = document.getElementById('lightbox-ambient-img') as HTMLImageElement | null;
    const cardContainer = document.getElementById('lightbox-card-container');
    const closeBtn = document.getElementById('lightbox-close');
    const prevBtn = document.getElementById('lightbox-prev');
    const nextBtn = document.getElementById('lightbox-next');

    const headerTitle = document.getElementById('lightbox-card-title');
    const counter = document.getElementById('lightbox-counter');

    const activeImg = document.getElementById('standard-active-img') as HTMLImageElement | null;
    const activeWrap = document.getElementById('standard-active-wrap');
    const pagination = document.getElementById('standard-pagination');
    const prevArrow = document.getElementById('standard-prev');
    const nextArrow = document.getElementById('standard-next');
    const strip = document.getElementById('standard-thumbs');

    const designSection = document.querySelector('.project-design-section');
    const makingSection = document.querySelector('.project-making-section');

    if (!slider || !activeImg) return;

    const images = JSON.parse(slider.getAttribute('data-images') || '[]');
    const projectName = document.querySelector('.project-detail')?.getAttribute('data-project-name') || '';

    // Each load: pick 5 random images (random order) — that set IS the scrub,
    // the slider, and the lightbox until the next reload. Thumbs outside the
    // pick are removed so the strip never scrolls.
    const order = shuffle(Array.from({ length: images.length }, (_, i) => i)).slice(0, 5);
    if (strip) {
      Array.from(strip.querySelectorAll('.project-detail__thumb-item')).forEach(t => {
        const idx = parseInt(t.getAttribute('data-index') || '-1', 10);
        if (!order.includes(idx)) t.remove();
      });
      reorderChildrenByIndex(strip, order);
    }
    const thumbs = strip ? Array.from(strip.querySelectorAll('.project-detail__thumb-item')) : [];

    let currentPos = 0;
    let currentIdx = order[0] ?? 0;
    let isOpen = false;

    const timerRings = ['page-timer-progress', 'page-timer-progress-mini']
      .map(id => document.getElementById(id))
      .filter((el): el is HTMLElement => el !== null);

    const resetTimerRing = () => {
      timerRings.forEach(ring => {
        const wrap = ring.closest('.autoplay-timer-ring');
        if (wrap) {
          wrap.classList.remove('is-animating');
          void (wrap as HTMLElement).offsetWidth;
          wrap.classList.add('is-animating');
        }
      });
      const lightboxProgress = document.getElementById('lightbox-timer-progress');
      if (lightboxProgress) {
        const wrap = lightboxProgress.closest('.autoplay-timer-ring');
        if (wrap) {
          wrap.classList.remove('is-animating');
          void (wrap as HTMLElement).offsetWidth;
          if (isOpen) wrap.classList.add('is-animating');
        }
      }
    };

    const goToPos = (pos: number) => {
      const count = order.length;
      currentPos = ((pos % count) + count) % count;
      currentIdx = order[currentPos];
    };

    function thumbIndexAtX(clientX: number): number {
      if (!thumbs.length) return -1;
      for (let i = 0; i < thumbs.length; i++) {
        const r = thumbs[i].getBoundingClientRect();
        if (clientX >= r.left && clientX <= r.right) return i;
      }
      return clientX < thumbs[0].getBoundingClientRect().left ? 0 : thumbs.length - 1;
    }

    const openLightbox = (index: number) => {
      goToPos(order.indexOf(index));
      isOpen = true;
      updateDisplay();

      if (lightbox) {
        lightbox.style.display = 'flex';
        lightbox.setAttribute('aria-hidden', 'false');
      }
      document.body.style.overflow = 'hidden';
      resetTimerRing();
    };

    const closeLightbox = () => {
      isOpen = false;
      if (lightbox) {
        lightbox.style.display = 'none';
        lightbox.setAttribute('aria-hidden', 'true');
      }
      document.body.style.overflow = '';
      if (cardContainer) {
        cardContainer.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg) scale(1)';
      }
      resetTimerRing();
      restartAutoplay();
    };

    const updateDisplay = () => {
      const activeUrl = images[currentIdx];

      // Lightbox elements
      if (lightboxImg) lightboxImg.src = activeUrl;
      if (ambientImg) ambientImg.src = activeUrl;
      if (headerTitle) headerTitle.textContent = `${projectName} — Photo`;
      if (counter) counter.textContent = `${currentPos + 1} / ${order.length}`;

      // Update scrubber fill
      const scrubFill = document.getElementById('lightbox-scrubber-fill');
      if (scrubFill) {
        const percentage = (currentPos / (order.length - 1)) * 100;
        scrubFill.style.width = `${percentage}%`;
      }

      // Lightbox name label: word-by-word spans
      const lbName = document.getElementById('lightbox-card-label');
      if (lbName) {
        lbName.innerHTML = `${projectName}`.split(' ').map(w => `<span>${w}</span>`).join('');
      }

      // Page active elements
      if (activeImg) activeImg.src = activeUrl;
      if (pagination) pagination.textContent = `${currentPos + 1} / ${order.length}`;

      thumbs.forEach((t, i) => t.classList.toggle('is-active', i === currentPos));

      // Scroll thumbnail
      const activeThumb = thumbs[currentPos];
      if (activeThumb && strip) {
        const stripRect = strip.getBoundingClientRect();
        const thumbRect = activeThumb.getBoundingClientRect();
        if (thumbRect.left < stripRect.left || thumbRect.right > stripRect.right) {
          activeThumb.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'nearest' });
        }
      }

      resetTimerRing();
    };

    const applyPos = (pos: number) => {
      goToPos(pos);

      if (isOpen && cardContainer) {
        cardContainer.classList.add('is-transitioning');
        setTimeout(() => {
          updateDisplay();
          cardContainer.classList.remove('is-transitioning');
        }, 180);
      } else {
        updateDisplay();
      }
      restartAutoplay();
    };

    // ── Autoplay: advance every 2s; any manual interaction resets the clock ──
    let autoplayInterval: number | null = null;
    const stopAutoplay = () => {
      if (autoplayInterval) { clearInterval(autoplayInterval); autoplayInterval = null; }
    };
    const restartAutoplay = () => {
      stopAutoplay();
      autoplayInterval = window.setInterval(() => {
        goToPos(currentPos + 1);
        updateDisplay();
      }, 2000);
    };
    updateDisplay();
    restartAutoplay();

    // Thumb strip listeners
    if (strip) {
      const isHoverDevice = window.matchMedia('(hover: hover)').matches;
      if (isHoverDevice) {
        thumbs.forEach(btn => {
          btn.addEventListener('click', (e) => {
            e.preventDefault();
            const idx = parseInt(btn.getAttribute('data-index') || '0', 10);
            applyPos(order.indexOf(idx));
          });
        });

        strip.addEventListener('pointerenter', () => {
          slider.classList.add('is-previewing');
        });
        strip.addEventListener('pointermove', (e) => {
          const idx = thumbIndexAtX(e.clientX);
          if (idx >= 0 && idx !== currentPos) {
            applyPos(idx);
          }
        });
        strip.addEventListener('pointerleave', () => {
          slider.classList.remove('is-previewing');
        });
      } else {
        thumbs.forEach(btn => {
          btn.addEventListener('click', (e) => {
            e.preventDefault();
            const idx = parseInt(btn.getAttribute('data-index') || '0', 10);
            applyPos(order.indexOf(idx));
          });
        });

        strip.addEventListener('pointermove', (e) => {
          const idx = thumbIndexAtX(e.clientX);
          if (idx >= 0 && idx !== currentPos) {
            applyPos(idx);
          }
        });
      }
    }

    activeWrap?.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target.closest('.project-detail__nav-arrow')) return;
      openLightbox(currentIdx);
    });

    // Hover pauses autoplay on the page-view image and inside the lightbox;
    // it resumes as soon as the pointer leaves.
    activeWrap?.addEventListener('mouseenter', stopAutoplay);
    activeWrap?.addEventListener('mouseleave', restartAutoplay);
    cardContainer?.addEventListener('mouseenter', stopAutoplay);
    cardContainer?.addEventListener('mouseleave', () => { if (isOpen) restartAutoplay(); });

    prevArrow?.addEventListener('click', (e) => {
      e.stopPropagation();
      applyPos(currentPos - 1);
    });

    nextArrow?.addEventListener('click', (e) => {
      e.stopPropagation();
      applyPos(currentPos + 1);
    });

    closeBtn?.addEventListener('click', closeLightbox);
    lightbox?.querySelector('.lightbox-backdrop')?.addEventListener('click', closeLightbox);

    // Header scrubber: click/drag jumps through the deck instantly
    const scrubberEl = document.getElementById('lightbox-scrubber');
    if (scrubberEl) {
      const scrubTo = (clientX: number) => {
        const rect = scrubberEl.getBoundingClientRect();
        const t = Math.min(Math.max((clientX - rect.left) / rect.width, 0), 1);
        const pos = Math.round(t * (order.length - 1));
        if (pos !== currentPos) {
          applyPos(pos);
        }
      };
      scrubberEl.addEventListener('pointerdown', (e) => {
        e.preventDefault();
        scrubberEl.setPointerCapture(e.pointerId);
        scrubTo(e.clientX);
      });
      scrubberEl.addEventListener('pointermove', (e) => {
        if (scrubberEl.hasPointerCapture && scrubberEl.hasPointerCapture(e.pointerId)) scrubTo(e.clientX);
      });
    }

    if (lightboxImg) {
      lightboxImg.addEventListener('click', (e) => {
        e.stopPropagation();
        applyPos(currentPos + 1);
      });
    }

    prevBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      applyPos(currentPos - 1);
    });

    nextBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      applyPos(currentPos + 1);
    });



    document.addEventListener('keydown', (e) => {
      if (!isOpen) return;
      // While the lightbox is open the arrows drive it exclusively — stop the
      // event before the site-wide prev/next-project handler can also fire.
      if (e.key === 'ArrowRight') { e.preventDefault(); e.stopImmediatePropagation(); applyPos(currentPos + 1); }
      if (e.key === 'ArrowLeft')  { e.preventDefault(); e.stopImmediatePropagation(); applyPos(currentPos - 1); }
      if (e.key === 'Escape') { e.preventDefault(); e.stopImmediatePropagation(); closeLightbox(); }
    });

    wireCollapse(designSection, 'project-design-click', 'project-design-toggle', 'project-design-panel');
    wireCollapse(makingSection, 'project-making-click', 'project-making-toggle', 'project-making-panel');

  }

  function initScarpinSliders() {
    const isScarpin = document.querySelector('.project-detail')?.getAttribute('data-is-scarpin') === 'true';
    if (!isScarpin) return;

    const items = document.querySelectorAll('.scarpin-grid-item');
    const scarpinLb = document.getElementById('scarpin-lightbox');
    if (!scarpinLb) return;

    const lbImg = document.getElementById('scarpin-lightbox-img');
    const lbVid = document.getElementById('scarpin-lightbox-vid');
    const lbAmbient = document.getElementById('scarpin-lightbox-ambient');
    const lbCounter = document.getElementById('scarpin-lightbox-counter');
    const lbLabel = document.getElementById('scarpin-lightbox-label');
    const lbPrev = document.getElementById('scarpin-lightbox-prev');
    const lbNext = document.getElementById('scarpin-lightbox-next');
    const lbClose = document.getElementById('scarpin-lightbox-close');

    let lbImages = [];
    let lbPos = 0;
    let lbTitle = '';
    let isLbOpen = false;

    const updateLightbox = () => {
      if (lbImages.length === 0) return;
      const url = lbImages[lbPos];
      if (url.endsWith('.mp4')) {
        lbImg.style.display = 'none';
        lbVid.style.display = 'block';
        lbVid.src = url;
        lbAmbient.src = '';
      } else {
        lbVid.style.display = 'none';
        lbVid.src = '';
        lbImg.style.display = 'block';
        lbImg.src = url;
        lbAmbient.src = url;
      }
      lbCounter.textContent = `${lbPos + 1} / ${lbImages.length}`;
    };

    const openScarpinLightbox = (images, pos, title) => {
      lbImages = images;
      lbPos = pos;
      lbTitle = title;
      lbLabel.textContent = title;
      updateLightbox();
      scarpinLb.style.display = 'block';
      setTimeout(() => {
        scarpinLb.classList.add('is-open');
        scarpinLb.setAttribute('aria-hidden', 'false');
        isLbOpen = true;
      }, 10);
    };

    const closeScarpinLightbox = () => {
      if (!isLbOpen) return;
      scarpinLb.classList.remove('is-open');
      scarpinLb.setAttribute('aria-hidden', 'true');
      isLbOpen = false;
      setTimeout(() => {
        scarpinLb.style.display = 'none';
        lbVid.src = ''; // stop video playback
      }, 400);
    };

    lbClose?.addEventListener('click', closeScarpinLightbox);
    scarpinLb?.querySelector('.lightbox-backdrop')?.addEventListener('click', closeScarpinLightbox);

    lbPrev?.addEventListener('click', (e) => {
      e.stopPropagation();
      lbPos = (lbPos - 1 + lbImages.length) % lbImages.length;
      updateLightbox();
    });

    lbNext?.addEventListener('click', (e) => {
      e.stopPropagation();
      lbPos = (lbPos + 1) % lbImages.length;
      updateLightbox();
    });

    document.addEventListener('keydown', (e) => {
      if (isLbOpen) {
        if (e.key === 'ArrowRight') { e.preventDefault(); e.stopImmediatePropagation(); lbNext.click(); }
        if (e.key === 'ArrowLeft') { e.preventDefault(); e.stopImmediatePropagation(); lbPrev.click(); }
        if (e.key === 'Escape') { e.preventDefault(); e.stopImmediatePropagation(); closeScarpinLightbox(); }
      }
    });

    // Submission tabs — one pill per person; clicking swaps the visible panel
    const scarpinTabs = document.querySelectorAll('.scarpin-tab-btn');
    scarpinTabs.forEach((btn) => {
      btn.addEventListener('click', () => {
        const target = btn.getAttribute('data-scarpin-tab');
        scarpinTabs.forEach((b) => {
          const m = b === btn;
          b.classList.toggle('is-active', m);
          b.setAttribute('aria-selected', String(m));
        });
        items.forEach((it) => {
          it.classList.toggle('is-active', it.getAttribute('data-index') === target);
        });
      });
    });

    items.forEach(item => {
      const urls = JSON.parse(item.getAttribute('data-images') || '[]');
      if (urls.length === 0) return;

      let pos = 0;
      let timer = null;
      let isHovered = false;
      const AUTOPLAY_DELAY = 4000;

      const counter = item.querySelector('.scarpin-item-counter');
      const mediaWrap = item.querySelector('.scarpin-item-media-wrap');
      const thumbs = item.querySelectorAll('.scarpin-thumb');
      const title = item.querySelector('.scarpin-item-title').textContent;
      const progressRing = item.querySelector('.scarpin-timer-ring');

      const updateMedia = () => {
        const url = urls[pos];
        const existingMedia = mediaWrap.querySelector('.scarpin-media');

        let newMedia;
        if (url.endsWith('.mp4')) {
          newMedia = document.createElement('video');
          newMedia.className = 'scarpin-media scarpin-media--active';
          newMedia.src = url;
          newMedia.autoplay = true;
          newMedia.loop = true;
          newMedia.muted = true;
          newMedia.playsInline = true;
        } else {
          newMedia = document.createElement('img');
          newMedia.className = 'scarpin-media scarpin-media--active';
          newMedia.src = url;
          newMedia.loading = 'lazy';
          newMedia.alt = title;
        }

        existingMedia.replaceWith(newMedia);
        counter.textContent = `${pos + 1} / ${urls.length}`;

        thumbs.forEach((thumb, idx) => {
          thumb.classList.toggle('is-active', idx === pos);
          if (idx === pos) {
            thumb.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
          }
        });

        resetTimer();
      };

      const resetTimer = () => {
        clearInterval(timer);
        const wrap = progressRing ? progressRing.closest('.autoplay-timer-ring') as HTMLElement | null : null;
        if (wrap) {
          // Restart the keyframe sweep: drop the class, set this slider's
          // duration, force a reflow, then (below) re-add to run it fresh.
          wrap.classList.remove('is-animating');
          wrap.style.setProperty('--timer-dur', `${AUTOPLAY_DELAY}ms`);
          void wrap.offsetWidth; // reflow so the re-added class restarts the animation
        }

        const hasHoverCapability = window.matchMedia('(hover: hover)').matches;
        // Mobile (no hover): always auto-play
        // Desktop (has hover): auto-play ONLY when hovering
        const shouldPlay = !isLbOpen && urls.length > 1 && (!hasHoverCapability || isHovered);

        if (shouldPlay) {
          if (wrap) wrap.classList.add('is-animating');
          timer = setInterval(() => {
            pos = (pos + 1) % urls.length;
            updateMedia();
          }, AUTOPLAY_DELAY);
        }
      };

      item.addEventListener('mouseenter', () => {
        isHovered = true;
        resetTimer();
      });

      item.addEventListener('mouseleave', () => {
        isHovered = false;
        resetTimer();
      });

      thumbs.forEach((thumb, idx) => {
        thumb.addEventListener('click', (e) => {
          e.stopPropagation();
          pos = idx;
          updateMedia();
        });
      });

      mediaWrap?.addEventListener('click', () => {
        openScarpinLightbox(urls, pos, title);
      });

      resetTimer();
    });
  }

  function initHeadingScrollTop() {
    // Card pages: header is always on screen, so tap-to-scroll-top is pointless
    const article = document.querySelector('.project-detail');
    if (article?.getAttribute('data-is-card') === 'true') return;
    const h = document.getElementById('project-top-header');
    if (h && !(h as any)._topWired) {
      (h as any)._topWired = true;
      h.addEventListener('click', (e) => {
        // Don't hijack taps on links inside the header (e.g. the category link)
        if ((e.target as HTMLElement).closest('a')) return;
        // Tapping the head closes any open chapter → the fixed intro returns
        collapseAllChapters();
        refreshFixedHead();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }
  }

  // Generic header+arrow collapse toggle (module-level so both initStandardSlider
  // and initCardDeck can wire Design/Making — and, on card pages, the project
  // name's own toggle — to the same is-expanded/aria-expanded/icon-swap behavior).
  function wireCollapse(sect: Element | null, headerId: string, toggleId: string, panelId: string) {
    if (!sect) return;
    const header = sect.querySelector(`#${headerId}`);
    const toggleBtn = sect.querySelector(`#${toggleId}`);

    if (!header || !toggleBtn) return;
    const iconMinus = toggleBtn.querySelector('.toggle-icon-minus') as HTMLElement | null;
    const iconPlus = toggleBtn.querySelector('.toggle-icon-plus') as HTMLElement | null;

    const toggleSection = () => {
      const isExpanded = sect.classList.toggle('is-expanded');
      toggleBtn.setAttribute('aria-expanded', String(isExpanded));

      toggleBtn.querySelectorAll('.link-arrow').forEach((a) => {
        (a as HTMLElement).style.transform = `rotate(${Math.floor(Math.random() * 360)}deg)`;
      });

      if (iconMinus && iconPlus) {
        if (isExpanded) {
          iconMinus.style.display = 'block';
          iconPlus.style.display = 'none';
        } else {
          iconMinus.style.display = 'none';
          iconPlus.style.display = 'block';
        }
      }
    };

    header.addEventListener('click', (e) => {
      e.stopPropagation();
      toggleSection();
    });
    toggleBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      toggleSection();
    });
  }

  // Tab-layout pages: the project name tab plus its section tabs act as one
  // accordion — only one open at a time (opening one closes the others), a
  // single click toggles just that tab, and a double click opens or closes
  // all of them together. Each tab's own header sticks to the top of the
  // viewport (CSS: position:sticky) while its content is being scrolled. The
  // section tabs are EITHER the generic Design / Making pair (work pages
  // without chapters) OR one tab per chapter (the academic chapter pages) —
  // whichever the page actually rendered.
  function wireWorkAccordion() {
    type Entry = { sect: Element; header: Element; toggle: Element };
    const entries: Entry[] = [];
    const add = (sect: Element | null, headerSel: string, toggleSel: string) => {
      if (!sect) return;
      const header = sect.querySelector(headerSel);
      const toggle = sect.querySelector(toggleSel);
      if (header && toggle) entries.push({ sect, header, toggle });
    };
    add(document.getElementById('project-dashboard'), '#project-name-header', '#project-name-toggle');
    add(document.querySelector('.project-design-section'), '#project-design-click', '#project-design-toggle');
    add(document.querySelector('.project-making-section'), '#project-making-click', '#project-making-toggle');
    document.querySelectorAll('.project-chapter').forEach(ch =>
      add(ch, '.project-chapter__header', '.project-detail-collapse-btn'));

    wireAccordion(entries);
  }

  // Collapse every chapter accordion (module-level so the header tap can call it)
  function collapseAllChapters() {
    document.querySelectorAll('.project-chapter.is-expanded').forEach(sect => {
      sect.classList.remove('is-expanded');
      const btn = sect.querySelector('.project-detail-collapse-btn');
      btn?.setAttribute('aria-expanded', 'false');
    });
  }

  // Recompute the mobile head: it is FIXED only while no chapter is open; when a
  // chapter opens, the head un-fixes and the intro (grid) collapses.
  function refreshFixedHead() {
    const article = document.querySelector('.project-detail') as HTMLElement | null;
    if (!article || article.getAttribute('data-is-card') === 'true') return;
    const header = document.getElementById('project-top-header');
    if (!header) return;
    const isMobile = window.matchMedia('(max-width: 1023.98px)').matches;
    const anyChapterOpen = !!document.querySelector('.project-chapter.is-expanded');
    const fixed = isMobile && !anyChapterOpen;
    header.classList.toggle('is-fixed-head', fixed);
    article.classList.toggle('has-fixed-head', fixed);
    article.classList.toggle('intro-collapsed', isMobile && anyChapterOpen);
    if (fixed) {
      article.style.setProperty('--head-h', `${header.offsetHeight}px`);
    } else {
      article.style.removeProperty('--head-h');
    }
  }

  // ── Mobile (standard pages): the project name + metaline + people become a
  // fixed opaque head; everything else scrolls beneath it. The metaline and
  // people nodes are relocated into the header on mobile and restored to the
  // left column on desktop. ──
  function initMobileFixedHead() {
    const article = document.querySelector('.project-detail') as HTMLElement | null;
    if (!article || article.getAttribute('data-is-card') === 'true') return;
    const header = document.getElementById('project-top-header');
    const metaline = document.querySelector('.project-card__metaline--incol') as HTMLElement | null;
    const people = document.querySelector('.project-people') as HTMLElement | null;
    const info = document.querySelector('.project-card-info') as HTMLElement | null;
    if (!header) return;

    const mq = window.matchMedia('(max-width: 1023.98px)');
    const apply = () => {
      if (mq.matches) {
        // Mobile: metaline + people live inside the (fixed) head
        if (metaline) header.appendChild(metaline);
        if (people) header.appendChild(people);
      } else {
        // Desktop: restore them to the left column, drop all mobile-head state
        if (info) {
          const textRow = info.querySelector('.project-card__row2');
          if (metaline) info.insertBefore(metaline, textRow);
          if (people) info.insertBefore(people, textRow);
        }
        article.classList.remove('intro-collapsed');
      }
      refreshFixedHead();
    };
    apply();
    if (!(header as any)._mqWired) {
      (header as any)._mqWired = true;
      mq.addEventListener('change', apply);
    }
    if (!(header as any)._headRO && 'ResizeObserver' in window) {
      (header as any)._headRO = new ResizeObserver(() => refreshFixedHead());
      (header as any)._headRO.observe(header);
    }
  }

  // People avatars: tapping one opens its name pill, tapping it again closes
  // it, and an open pill auto-closes after 10s. Only one is open at a time.
  // (Same behavior as the category page's people row.)
  const PEOPLE_PILL_TIMEOUT = 10000;
  function initProjectPeople() {
    const peopleEls = document.querySelectorAll('.project-people__person');
    let hideTimer: number | null = null;
    const closeAll = () => {
      if (hideTimer) { clearTimeout(hideTimer); hideTimer = null; }
      peopleEls.forEach(p => p.classList.remove('is-active'));
    };

    peopleEls.forEach(el => {
      el.addEventListener('click', (e) => {
        e.stopPropagation();
        const wasActive = el.classList.contains('is-active');
        closeAll();
        if (wasActive) return; // second tap on the open one → just close
        el.classList.add('is-active');
        hideTimer = window.setTimeout(() => {
          el.classList.remove('is-active');
          hideTimer = null;
        }, PEOPLE_PILL_TIMEOUT);
      });
    });

    document.addEventListener('click', closeAll);
  }

  function initCopyPrompt() {
    document.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('.copy-prompt-btn') as HTMLElement | null;
      if (!btn) return;
      const box = btn.closest('.prompt-box');
      const textEl = box?.querySelector('.prompt-text');
      if (textEl) {
        navigator.clipboard.writeText(textEl.textContent || '');
        const btnText = btn.querySelector('.copy-btn-text');
        const oldHtml = btn.innerHTML;
        if (btnText) {
          btnText.textContent = 'Copied!';
          btn.style.color = 'var(--_tokens---color--fg)';
        } else {
          btn.innerHTML = '<span class="copied-indicator">Copied!</span>';
        }
        setTimeout(() => {
          btn.innerHTML = oldHtml;
          btn.style.color = '';
        }, 1500);
      }
    });
  }

  document.addEventListener('astro:page-load', () => {
    initProjectPage();
    initHeadingScrollTop();
    initMobileFixedHead();
    initProjectPeople();
    initCopyPrompt();
  });
  if (document.readyState !== 'loading') {
    initProjectPage();
    initHeadingScrollTop();
    initMobileFixedHead();
    initProjectPeople();
    initCopyPrompt();
  }

  // ── Phone: a project page is a category page with one project ───────
  // The name is the top card, the deck fills the middle three across, and
  // everything you read docks at the bottom: the cover, the pagination, the
  // facts, the short line, then the description with Read more and Prompt
  // beside it.
  //
  // Every piece already exists somewhere in this page's own layout, so they
  // are MOVED into one card rather than duplicated — and moved back exactly
  // where they came from above 700px. Each element remembers its own origin
  // rather than the restore hard-coding a guess at it.
  const PHONE_CARD_PARTS = [
    '.project-card-name-pagination-row',   // logo, counter, timer ring
    '.project-card__metaline',             // year, location, status
    '.project-card__intro',                // the short line
    '.project-desc-readmore',              // description + Read more
    '.project-prompt-btn',                 // sits beside Read more
  ];

  function rememberHome(el: HTMLElement) {
    if ((el as any)._home) return;
    (el as any)._home = { parent: el.parentElement, next: el.nextElementSibling };
  }

  function sendHome(el: HTMLElement) {
    const home = (el as any)._home;
    if (!home || !home.parent) return;
    if (home.next && home.next.parentElement === home.parent) home.parent.insertBefore(el, home.next);
    else home.parent.appendChild(el);
  }

  function buildProjectPhoneCard() {
    const detail = document.querySelector('.project-detail') as HTMLElement | null;
    if (!detail) return;
    const phone = window.matchMedia('(max-width: 699.98px)').matches;
    let card = detail.querySelector('.project-phone-card') as HTMLElement | null;

    if (!phone) {
      if (card) {
        [...PHONE_CARD_PARTS, '.prompt-box', '.copy-prompt-btn', '.project-readmore-btn',
         '.project-phone-close', '.renders-aside__media', '.project-video-btn'].forEach(sel => {
          const el = detail.querySelector(sel) as HTMLElement | null;
          if (el) sendHome(el);
        });
        card.remove();
      }
      detail.style.removeProperty('--pp-dock-h');
      detail.style.removeProperty('--pp-card-h');
      return;
    }

    if (!card) {
      card = document.createElement('div');
      card.className = 'project-phone-card';
      // Astro scopes every selector in this file to a data-astro-cid-* attribute
      // that only elements from the template carry. A div built here has none,
      // so every rule written for it silently fails to match. Borrow the page's.
      const cid = Array.from(detail.attributes).find(a => a.name.startsWith('data-astro-cid-'));
      if (cid) card.setAttribute(cid.name, '');
      detail.appendChild(card);
    }

    // Read more and Prompt share a row, so they get a wrapper of their own.
    let actions = card.querySelector('.project-phone-actions') as HTMLElement | null;
    if (!actions) {
      actions = document.createElement('div');
      actions.className = 'project-phone-actions';
      const cid = Array.from(detail.attributes).find(a => a.name.startsWith('data-astro-cid-'));
      if (cid) actions.setAttribute(cid.name, '');
    }

    PHONE_CARD_PARTS.forEach(sel => {
      const el = detail.querySelector(sel) as HTMLElement | null;
      if (!el) return;
      rememberHome(el);
      if (sel === '.project-prompt-btn') return;   // placed in the actions row
      if (el.parentElement !== card) card!.appendChild(el);
    });

    const promptBox = detail.querySelector('.prompt-box') as HTMLElement | null;
    if (promptBox) { rememberHome(promptBox); if (promptBox.parentElement !== card) card.appendChild(promptBox); }
    // The copy mark belongs at the end of the prompt, in the same run of text,
    // rather than on a row of its own above it.
    const promptText = detail.querySelector('.prompt-text') as HTMLElement | null;
    const copyBtn = detail.querySelector('.copy-prompt-btn') as HTMLElement | null;
    if (promptText && copyBtn && copyBtn.previousElementSibling !== promptText) {
      rememberHome(copyBtn);
      promptText.after(copyBtn);
    }
    const readmore = detail.querySelector('.project-readmore-btn') as HTMLElement | null;
    const prompt = detail.querySelector('.project-prompt-btn') as HTMLElement | null;
    if (readmore) { rememberHome(readmore); actions.appendChild(readmore); }
    if (prompt) actions.appendChild(prompt);

    /* The reel, where there is one. The video that sits fixed beside the copy
       above 1024 is MOVED into the card here rather than duplicated — one
       element, one 5.3MB file, and the sound control comes with it because it
       is that video's own child. `.renders-aside` is display:none on this
       band, so the media has to leave the figure to be seen at all. */
    const media = detail.querySelector('.renders-aside__media') as HTMLElement | null;
    const videoBtn = detail.querySelector('.project-video-btn') as HTMLElement | null;
    if (media && videoBtn) {
      let panel = card.querySelector('.project-video-panel') as HTMLElement | null;
      if (!panel) {
        panel = document.createElement('div');
        panel.className = 'project-video-panel';
        const cid = Array.from(detail.attributes).find(a => a.name.startsWith('data-astro-cid-'));
        if (cid) panel.setAttribute(cid.name, '');
        card.appendChild(panel);
      }
      rememberHome(media);
      if (media.parentElement !== panel) panel.appendChild(media);
      rememberHome(videoBtn);
      actions.appendChild(videoBtn);
    }
    // The ✕ closes whichever section is open, so it belongs on the row that
    // opened it — at the far right of it, not floating over the card's corner.
    const close = detail.querySelector('.project-phone-close') as HTMLElement | null;
    if (close) { rememberHome(close); actions.appendChild(close); }
    if (actions.children.length && actions.parentElement !== card) card.appendChild(actions);

    measureProjectPhoneCard();
  }

  // Heights are measured, never written down: the nav dock moves with the
  // device's safe area, parts of the card are absent on some projects, and
  // Read more grows it.
  function measureProjectPhoneCard() {
    const detail = document.querySelector('.project-detail') as HTMLElement | null;
    if (!detail || !window.matchMedia('(max-width: 699.98px)').matches) return;
    const h = (sel: string, fallback: number) => {
      const el = document.querySelector(sel);
      return Math.round(el?.getBoundingClientRect().height ?? fallback);
    };
    detail.style.setProperty('--pp-dock-h', h('.page-breadcrumb', 66) + 'px');
    detail.style.setProperty('--pp-card-h', h('.project-detail .project-phone-card', 220) + 'px');
    detail.style.setProperty('--pp-head-h', h('.project-detail .project-top-header', 40) + 'px');
  }

  function initProjectPhoneCard() {
    buildProjectPhoneCard();
    window.addEventListener('resize', buildProjectPhoneCard, { passive: true });
    if ('ResizeObserver' in window) {
      const ro = new ResizeObserver(() => measureProjectPhoneCard());
      ['.page-breadcrumb', '.project-detail .project-phone-card']
        .forEach(sel => { const el = document.querySelector(sel); if (el) ro.observe(el); });
    }
    initDeckLoop();
    initDeckAutoScroll();
    initPhoneCardSections();
  }


  // ── The deck loops ───────────────────────────────────────────────────
  // Three copies of the set live in the grid and the scroll position is
  // wrapped by one copy's height whenever it leaves the middle one, so the
  // roll has no beginning and no end.
  //
  // The copy has to be a whole number of ROWS or the wrap is visible: with 26
  // cards in a 3-column grid, cell 26 lands mid-row, so jumping by 26 cells
  // slides every image one column sideways. Each copy is padded out to the
  // next multiple of the column count — one extra cell here — which costs one
  // repeated image per cycle and buys a seam you cannot see.
  //
  // Clones carry no listeners. A click on one is forwarded to the original
  // with the same data-index, so every existing behaviour still runs; and the
  // active class is mirrored onto every copy of that index.
  function initDeckLoop() {
    const deck = document.getElementById('deck-grid');
    if (!deck || (deck as any)._looped) return;
    /* A portrait page draws a fixed 3x3 window instead — nine cells taken
       modulo the set, which wraps on its own and needs no cloned copies of
       the deck to scroll through. See initPortraitWindow. */
    if (document.querySelector('.project-detail[data-portraits="true"]')) return;
    const phone = () => window.matchMedia('(max-width: 699.98px)').matches;

    const originals = () =>
      Array.from(deck.querySelectorAll<HTMLElement>('.deck-card-item:not([data-clone])'));

    const columnCount = () =>
      getComputedStyle(deck).gridTemplateColumns.split(' ').filter(Boolean).length || 1;

    function buildUnit(src: HTMLElement[], cols: number) {
      const pad = (cols - (src.length % cols)) % cols;
      return src.concat(src.slice(0, pad));
    }

    function unitHeight() {
      const items = Array.from(deck.children) as HTMLElement[];
      if (items.length < 2) return 0;
      const rowTops = [...new Set(items.map(i => Math.round(i.offsetTop)))].sort((a, b) => a - b);
      if (rowTops.length < 2) return 0;
      const pitch = rowTops[1] - rowTops[0];
      const cols = columnCount();
      const src = originals();
      const unitCells = buildUnit(src, cols).length;
      return (unitCells / cols) * pitch;
    }

    function clearClones() {
      deck.querySelectorAll('[data-clone]').forEach(n => n.remove());
    }

    function build() {
      if (!phone()) { clearClones(); return; }
      if (deck.querySelector('[data-clone]')) return;
      const src = originals();
      if (src.length < 6) return;           // too few for a loop to read as one
      const cols = columnCount();
      const unit = buildUnit(src, cols);
      const copy = () => unit.map(n => {
        const c = n.cloneNode(true) as HTMLElement;
        c.setAttribute('data-clone', '');
        c.removeAttribute('id');
        c.classList.remove('is-active');
        return c;
      });
      // The pad cells of the middle copy are clones too — the originals stay
      // exactly as they were so nothing that queries them changes.
      const tail = unit.slice(src.length).map(n => {
        const c = n.cloneNode(true) as HTMLElement;
        c.setAttribute('data-clone', '');
        c.removeAttribute('id');
        return c;
      });
      const before = copy();
      const after = copy();
      src[src.length - 1].after(...tail);
      deck.prepend(...before);
      deck.append(...after);
      requestAnimationFrame(() => { deck.scrollTop = unitHeight(); });
    }

    // Wrap silently whenever the scroll leaves the middle copy.
    //
    // By modulo, not by a single step of one copy. A tall deck can end up
    // more than one copy outside the band — Sups' Profiles has 51 cards, so
    // scrolling to the very bottom sat two copies past the middle and a single
    // -h step left it still outside, which is why it would not wrap downward.
    // Content at t and t + h is identical, so any t can be mapped straight
    // back into [h, 2h) and the jump stays invisible.
    let wrapping = false;
    deck.addEventListener('scroll', () => {
      if (!phone() || wrapping) return;
      const h = unitHeight();
      if (!h) return;
      const t = deck.scrollTop;
      if (t >= h && t < h * 2) return;
      const next = h + (((t % h) + h) % h);
      if (Math.abs(next - t) < 1) return;
      wrapping = true;
      const prev = deck.style.scrollBehavior;
      deck.style.scrollBehavior = 'auto';
      deck.scrollTop = next;
      deck.style.scrollBehavior = prev;
      requestAnimationFrame(() => { wrapping = false; });
    }, { passive: true });

    // A clone hands its click to the original it was copied from.
    deck.addEventListener('click', (e: Event) => {
      const item = (e.target as HTMLElement)?.closest('.deck-card-item') as HTMLElement | null;
      if (!item || !item.hasAttribute('data-clone')) return;
      e.stopPropagation();
      const idx = item.getAttribute('data-index');
      deck.querySelector<HTMLElement>('.deck-card-item:not([data-clone])[data-index="' + idx + '"]')?.click();
    }, true);

    (deck as any)._looped = true;
    build();
    window.addEventListener('resize', build, { passive: true });
  }

  // The deck advances on its own and on tap. Whichever card is active is
  // scrolled to the deck's top row, so the picture you are being shown is
  // never below the fold. Watching the class rather than hooking the several
  // places that set it — the timer, a tap and the arrow keys all land here.
  function initDeckAutoScroll() {
    const deck = document.getElementById('deck-grid');
    if (!deck || (deck as any)._autoScroll) return;
    (deck as any)._autoScroll = true;

    const showActive = () => {
      if (!window.matchMedia('(max-width: 699.98px)').matches) return;
      const source = deck.querySelector('.deck-card-item:not([data-clone]).is-active') as HTMLElement | null;
      if (!source) return;
      // Every copy of that card carries the active look, not just the original.
      const idx = source.getAttribute('data-index');
      deck.querySelectorAll<HTMLElement>('.deck-card-item').forEach(el => {
        el.classList.toggle('is-active', el.getAttribute('data-index') === idx);
      });
      // Scroll to whichever copy is already nearest, so a step to the next
      // card never travels a whole list to reach it.
      const copies = Array.from(deck.querySelectorAll<HTMLElement>('.deck-card-item.is-active'));
      const active = copies.reduce((best, el) =>
        Math.abs(el.offsetTop - deck.scrollTop) < Math.abs(best.offsetTop - deck.scrollTop) ? el : best,
      copies[0]);
      if (!active) return;
      // Offset within the deck, not the viewport: the deck is the scroller.
      const top = active.offsetTop - deck.offsetTop;
      const move = Math.abs(deck.scrollTop - top);
      if (move <= 4) return;
      // A step to the next row glides. The wrap from the last card back to the
      // first is a whole list's worth of travel, and gliding it reads as the
      // deck rewinding rather than rolling on — that one cuts.
      const isWrap = move > deck.clientHeight;
      if (isWrap) deck.style.scrollBehavior = 'auto';
      deck.scrollTop = top;
      if (isWrap) requestAnimationFrame(() => { deck.style.scrollBehavior = ''; });
    };

    new MutationObserver(showActive).observe(deck, {
      subtree: true,
      attributes: true,
      attributeFilter: ['class'],
    });
    showActive();
  }

  // ── The card grows up to show one section at a time ──────────────────
  // Collapsed it is the counter, the pills, the subtitle and two buttons.
  // Read more grows it to the description, Prompt to the prompt box, and a ✕
  // in the corner cancels whichever is open. One at a time: opening the second
  // closes the first, so the card never stacks two panels into the screen.
  function initPhoneCardSections() {
    const detail = document.querySelector('.project-detail') as HTMLElement | null;
    if (!detail || (detail as any)._sectionsWired) return;
    (detail as any)._sectionsWired = true;
    const phone = () => window.matchMedia('(max-width: 699.98px)').matches;

    const setSection = (name: 'reading' | 'prompting' | 'watching' | null) => {
      const card = detail.querySelector('.project-phone-card') as HTMLElement | null;
      if (!card) return;
      card.classList.toggle('is-reading', name === 'reading');
      card.classList.toggle('is-prompting', name === 'prompting');
      card.classList.toggle('is-watching', name === 'watching');
      card.classList.toggle('is-open', name !== null);
      /* The source is attached on the first open and never before it. Above
         1024 the reel loads with the page because it is the fixed picture
         there; on a phone it is a panel behind a pill, so nobody pays 5.3MB
         for a video they did not ask to see. It pauses when the panel shuts —
         audio playing under a closed panel is a sound with no source on
         screen. */
      const vid = detail.querySelector('video[data-side-video]') as HTMLVideoElement | null;
      if (vid) {
        if (name === 'watching') {
          if (!vid.getAttribute('src')) vid.src = vid.dataset.sideVideo!;
          vid.play().catch(() => {});
        } else if (!window.matchMedia('(min-width: 1024px)').matches) {
          vid.pause();
        }
      }
      const close = card.querySelector('.project-phone-close') as HTMLElement | null;
      if (close) close.hidden = name === null;
      // The buttons' own handlers never run on this band (the click is stopped
      // in capture), so their labels and arrows are set from here instead —
      // otherwise a collapsed card sat under a button reading "Read less".
      const label = detail.querySelector('.project-readmore-label');
      if (label) label.textContent = name === 'reading' ? 'Read less' : 'Read more';
      detail.querySelector('.project-readmore-btn')
        ?.setAttribute('aria-expanded', String(name === 'reading'));
      detail.querySelector('.project-prompt-btn')
        ?.setAttribute('aria-expanded', String(name === 'prompting'));
      detail.querySelector('.project-video-btn')
        ?.setAttribute('aria-expanded', String(name === 'watching'));
      requestAnimationFrame(measureProjectPhoneCard);
    };

    const current = () => {
      const card = detail.querySelector('.project-phone-card');
      if (!card) return null;
      if (card.classList.contains('is-reading')) return 'reading';
      if (card.classList.contains('is-prompting')) return 'prompting';
      if (card.classList.contains('is-watching')) return 'watching';
      return null;
    };

    detail.addEventListener('click', (e: Event) => {
      if (!phone()) return;
      const el = e.target as HTMLElement;
      if (el.closest('.project-phone-close')) { e.stopPropagation(); setSection(null); return; }
      if (el.closest('.project-readmore-btn')) {
        e.preventDefault();
        e.stopPropagation();
        setSection(current() === 'reading' ? null : 'reading');
        return;
      }
      if (el.closest('.project-prompt-btn')) {
        e.preventDefault();
        e.stopPropagation();
        setSection(current() === 'prompting' ? null : 'prompting');
        return;
      }
      /* The sound control lives inside the panel, so a tap on it must not be
         read as a tap on the panel and close what it is toggling. */
      if (el.closest('.renders-aside__sound')) return;
      if (el.closest('.project-video-btn')) {
        e.preventDefault();
        e.stopPropagation();
        setSection(current() === 'watching' ? null : 'watching');
      }
    }, true);
  }

  // The pills arrive in a different order on every load, the way the footer's
  // cloud reshuffles — the row is a set of filters, not a ranking.
  function shuffleMetaPills() {
    const row = document.querySelector('.project-meta-row--pills');
    if (!row || (row as any)._shuffled) return;
    (row as any)._shuffled = true;
    /* Only the pills shuffle. On a renders page the people panel is moved
       into this row and must stay at its end — a face dealt into the middle
       of the filters reads as one of them, and it is a credit, not a filter.
       Filtering by class rather than trusting call order, because this also
       runs again on astro:after-swap. */
    const pills = Array.from(row.children).filter(c => c.classList.contains('project-card__filter-pill'));
    for (let i = pills.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      row.insertBefore(pills[i], pills[j]);
    }
  }

  shuffleMetaPills();
  initProjectPhoneCard();
  document.addEventListener('astro:after-swap', initProjectPhoneCard);

  /* ── Renders: the people sit above the subtitle, with the credit ───────
     They were briefly in the filter row. That row is a set of filters — every
     other thing in it is a link that runs a search — and a face is not one,
     so the group now has the line above the subtitle to itself, beside the
     words saying who these people are. Bigger there, because nothing is
     competing with them for the line. Moved, not duplicated. */
  function initRendersPeople() {
    const detail = document.querySelector<HTMLElement>('.project-detail[data-renders="true"]');
    const slot = document.getElementById('renders-people-slot');
    const titleSlot = document.getElementById('renders-people-title');
    const people = document.getElementById('project-people-panel');
    if (!detail || !slot || !people) return;
    const wide = window.matchMedia('(min-width: 700px)');
    /* Above the subtitle on a wide page, on the name's own line on a phone —
       where the subtitle has moved into the fixed bottom card and the name is
       the only thing left at the top to sit with.

       Inserted first, not appended: the credit line is already in the slot as
       markup, and the faces belong in front of the words that name them. */
    const place = () => {
      const target = wide.matches ? slot : (titleSlot ?? slot);
      if (target && people.parentElement !== target) target.insertBefore(people, target.firstChild);
    };
    if (!detail.dataset.rpWired) {
      detail.dataset.rpWired = '1';
      wide.addEventListener('change', place);
    }
    place();
  }
  initRendersPeople();
  document.addEventListener('astro:after-swap', initRendersPeople);

  /* ── The portrait deck's 3x3 window ─────────────────────────────────────
     Nine cells around the active frame, which always sits in the middle. The
     set is walked modulo its length, so the window wraps at either end and
     there is no first or last cell to run out of.

     Nothing is added to or removed from the DOM: every item stays where it
     is, carrying the click wiring and the active class the rest of the page
     reads, and the nine in view are marked with data-win (0-8, also their
     flex order) while the others are hidden by CSS. */
  function initPortraitWindow() {
    const detail = document.querySelector('.project-detail[data-portraits="true"]');
    const deck = document.getElementById('deck-grid');
    if (!detail || !deck) return;
    const phone = () => window.matchMedia('(max-width: 699.98px)').matches;
    /* Nine cells for a grid of portraits, three for a stack of landscapes —
       the same window, sized to the shape of the frame. Odd either way,
       because the whole idea is that the middle one is the active one. */
    const SIZE = detail.getAttribute('data-frame') === 'landscape' ? 3 : 9;
    const MID = (SIZE - 1) / 2;

    const paint = () => {
      const items = Array.from(deck.querySelectorAll<HTMLElement>('.deck-card-item'));
      const n = items.length;
      if (!n) return;
      if (!phone() || n < SIZE) {
        items.forEach(it => { it.removeAttribute('data-win'); it.style.order = ''; });
        return;
      }
      const active = items.findIndex(it => it.classList.contains('is-active'));
      const centre = active < 0 ? 0 : active;
      const win = new Map<HTMLElement, number>();
      for (let k = 0; k < SIZE; k++) win.set(items[(centre - MID + k + n * SIZE) % n], k);
      items.forEach(it => {
        const k = win.get(it);
        if (k === undefined) { it.removeAttribute('data-win'); it.style.order = ''; }
        else { it.setAttribute('data-win', String(k)); it.style.order = String(k); }
      });
    };

    /* Repainted from wherever the active frame changes — a tap, an arrow key,
       the autoplay tick. updateScrubActiveState is the one place all of those
       pass through, so it calls this rather than each of them remembering to. */
    (deck as any)._paintWindow = paint;
    if (!(deck as any)._winWired) {
      (deck as any)._winWired = true;
      window.matchMedia('(max-width: 699.98px)').addEventListener('change', paint);
    }
    paint();
  }
  initPortraitWindow();
  document.addEventListener('astro:after-swap', initPortraitWindow);

  /* ── A landscape series puts its index under the page, not beside it ──
     The card chassis keeps the deck inside the left column, which is 123px
     wide on this layout — fine for a column of portrait thumbnails, useless
     for wide ones: two across at 59px is a photograph of a house 40px tall.
     Below the two columns it has the full 1078 instead, and it reads as the
     contact sheet it is rather than as furniture in the margin.

     Moved in script rather than restructured in CSS. Standing it up as a
     full-width grid item means `display: contents` on the two wrappers and
     an explicit column for every remaining child — the tab layout does that
     and it is a lot of rules to keep in step with a chassis shared by
     fourteen projects. Out of the grid entirely, the deck is simply the next
     block on the page, and `sendHome()` puts it back below 1024. */
  function initLandscapeScrub() {
    const detail = document.querySelector<HTMLElement>('.project-detail[data-frame="landscape"]');
    const deck = document.getElementById('deck-grid');
    if (!detail || !deck) return;
    /* `--card` explicitly. There is more than one `.project-content-grid` in
       this file — the card chassis and the standard one — and only the card
       grid is the one this page renders; querying the base class picked up a
       zero-height sibling, and the deck was appended after THAT, inside a
       narrower wrapper, 571px wide instead of the page's 1078. */
    const grid = detail.querySelector<HTMLElement>('.project-content-grid--card')
      ?? detail.querySelector<HTMLElement>('.project-content-grid');
    if (!grid) return;
    const mq = window.matchMedia('(min-width: 1024px)');
    /* The phone band builds its own card out of these same parts, so nothing
       here may touch them below 700 — `buildProjectPhoneCard` runs first and
       this would undo it. */
    const phone = window.matchMedia('(max-width: 699.98px)');
    /* The name, the counter and the timer ring belong to the PICTURE, not to
       the writing. They sat at the foot of the copy column, which put "16/48"
       and a running timer under a paragraph about architects while the frame
       they describe was in the other column. Moved under the image instead. */
    const nameRow = detail.querySelector<HTMLElement>('.project-card-name-pagination-row');
    const right = detail.querySelector<HTMLElement>('.project-col-right');
    const place = () => {
      if (mq.matches) {
        rememberHome(deck);
        if (deck.parentElement !== grid.parentElement || deck.previousElementSibling !== grid) {
          grid.after(deck);
        }
        if (nameRow && right) {
          rememberHome(nameRow);
          if (nameRow.parentElement !== right) right.appendChild(nameRow);
        }
      } else {
        sendHome(deck);
        if (nameRow && !phone.matches) sendHome(nameRow);
      }
    };
    /* Six across, three rows showing, and the active row pinned to the top.
       The deck does not loop and does not re-order: every frame stays where
       it is and the gallery scrolls under the window, so the grid is a fixed
       thing you move through rather than a belt that moves past you.
       `initDeckLoop` is already skipped on these pages, so there are no
       clones to confuse the arithmetic. */
    const COLS = 6, ROWS = 3;
    const syncRows = () => {
      const items = Array.from(deck.querySelectorAll<HTMLElement>('.deck-card-item'));
      if (!items.length) return;
      if (!mq.matches) {
        deck.style.removeProperty('max-height');
        deck.scrollTop = 0;
        items.forEach(it => it.classList.remove('is-live'));
        return;
      }
      /* Row pitch measured from two real cells rather than computed from the
         ratio: the cell is sized by `aspect-ratio` off a fractional column
         width, and the rounding difference over three rows is enough to show
         a sliver of the fourth. */
      const a = items[0].getBoundingClientRect();
      const b = items[COLS]?.getBoundingClientRect();
      const pitch = b ? (b.top - a.top) : a.height;
      if (!pitch) return;
      deck.style.maxHeight = `${Math.round(pitch * ROWS - (pitch - a.height))}px`;
      const active = items.findIndex(it => it.classList.contains('is-active'));
      const row = Math.floor(Math.max(active, 0) / COLS);
      /* Clamped, because the last rows cannot come to the top without
         leaving blank space under them. */
      const maxRow = Math.max(0, Math.ceil(items.length / COLS) - ROWS);
      deck.scrollTop = Math.min(row, maxRow) * pitch;
      items.forEach((it, i) => it.classList.toggle('is-live', Math.floor(i / COLS) === row));
    };

    if (!(deck as any)._lsWired) {
      (deck as any)._lsWired = true;
      mq.addEventListener('change', () => { place(); syncRows(); });
      /* Chained onto the window painter rather than wired to each of the tap,
         the arrow key and the autoplay tick — `updateScrubActiveState` is the
         one place all three already pass through. */
      const prev = (deck as any)._paintWindow;
      (deck as any)._paintWindow = () => { prev?.(); syncRows(); };
      window.addEventListener('resize', syncRows, { passive: true });
    }
    place();
    requestAnimationFrame(syncRows);
  }
  initLandscapeScrub();
  document.addEventListener('astro:after-swap', initLandscapeScrub);



</script>
