    [data-chapter-group="ch1"] .ph__infig:not(#usa).ph__infig--civic .ph__fig > :is(figcaption,.ph__fig-chips,.ph__fig-key,.ph__fig-src) { grid-column:1;grid-row:auto; }
    .ph__references :is(.ph__notes-list,.ph__bib-list) { columns:1; }
