</style>

<script>
  import { createMap, createSvgMap, type PowerhouseMap } from '../../lib/powerhouse-map';
  import { initPowerhouseMindmap } from '../../lib/powerhouse-mindmap';
  import { select } from 'd3-selection';
  import { zoom, zoomIdentity } from 'd3-zoom';

  // Chapters (main tabs) and sections (the flow). Picking a chapter opens its first section.
  const book = document.querySelector<HTMLElement>('[data-analysis]');
  if (book) {
    const chapterBtns = [...book.querySelectorAll<HTMLButtonElement>('[data-chapter]')];
    const sectionBtns = [...book.querySelectorAll<HTMLButtonElement>('[data-section]')];
    const sectionPanels = [...book.querySelectorAll<HTMLElement>('[data-section-panel]')];

    const index = book.querySelector<HTMLDetailsElement>('.ph__index');
    document.addEventListener('click', (e) => {
      if (index?.open && !index.contains(e.target as Node)) index.open = false;
    });
    index?.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && index.open) { index.open = false; index.querySelector('summary')?.focus(); }
    });
    const indexChapters = [...book.querySelectorAll<HTMLElement>('[data-index-chapter]')];
    // The index is a toggle list: one chapter open at a time, the open one shows its sections.
    const openChapter = (ch: string | null) =>
      indexChapters.forEach((c) => {
        const open = c.dataset.indexChapter === ch;
        c.dataset.open = String(open);
        c.querySelector('[data-index-toggle]')?.setAttribute('aria-expanded', String(open));
      });
    book.querySelectorAll<HTMLButtonElement>('[data-index-toggle]').forEach((b) =>
      b.addEventListener('click', () => {
        const ch = b.dataset.indexToggle!;
        openChapter(b.closest<HTMLElement>('[data-index-chapter]')!.dataset.open === 'true' ? null : ch);
      })
    );
    const toc = book.querySelector<HTMLElement>('[data-toc]');
    const pinned = () => !!toc && getComputedStyle(toc).position === 'sticky';
    const syncTocHeight = () => toc && book.style.setProperty('--ph-toc-h', `${pinned() ? toc.offsetHeight : 0}px`);
    syncTocHeight();
    addEventListener('resize', syncTocHeight);

    // Mark a section as current everywhere it is named: tabs, sub-tabs, the index.
    let currentId = '';
    const setCurrent = (id: string) => {
      if (id === currentId) return;
      currentId = id;
      const ch = 'ch' + id.split('-')[0];
      sectionBtns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.section === id)));
      chapterBtns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.chapter === ch)));
      indexChapters.forEach((c) => (c.dataset.active = String(c.dataset.indexChapter === ch)));
      if (!index?.open) openChapter(ch === 'ch5' ? null : ch);
      book.querySelectorAll<HTMLElement>('[data-subtabs]').forEach((n) => (n.hidden = n.dataset.subtabs !== ch));
      syncTocHeight();
      const btn = sectionBtns.find((b) => b.dataset.section === id);
      const current = book.querySelector('[data-index-current]');
      if (current && btn) current.textContent = btn.textContent!.replace(/\s+/g, ' ').trim();
    };

    // Jump: the document is continuous, so a tab scrolls to its section rather than swapping it in.
    // While a jump is travelling the tab rows must hold still: a row that changes height
    // under a smooth scroll cancels it halfway. Following resumes when the scroll ends.
    let jumping = false;
    let jumpTimer = 0;
    const jump = (target: Element | null) => {
      if (!target) return;
      jumping = true;
      const done = () => { jumping = false; clearTimeout(jumpTimer); spy(); };
      addEventListener('scrollend', done, { once: true });
      jumpTimer = window.setTimeout(done, 2500);
      target.scrollIntoView({ block: 'start', behavior: 'smooth' });
    };
    const chGroups = [...book.querySelectorAll<HTMLDetailsElement>('details.ph__ch-group')];
    const onlyChapter = (active: HTMLDetailsElement | null | undefined) => {
      if (!active) return;
      active.open = true;
      chGroups.forEach((g) => {
        if (g !== active && g.open) g.open = false;
      });
    };
    const onlySection = (active: HTMLDetailsElement | null | undefined) => {
      if (!active) return;
      active.open = true;
      sectionPanels.forEach((el) => {
        const fold = el as HTMLDetailsElement;
        if (fold instanceof HTMLDetailsElement && fold !== active && fold.open) fold.open = false;
      });
    };
    const goTo = (target: HTMLElement | null, id: string) => {
      index?.removeAttribute('open');
      onlyChapter(target?.closest<HTMLDetailsElement>('details.ph__ch-group'));
      if (target instanceof HTMLDetailsElement) onlySection(target);
      setCurrent(id);
      jump(target);
    };
    const jumpToHashInBook = (hash: string) => {
      history.replaceState(null, '', hash);
      const targetEl = book.querySelector<HTMLElement>(hash);
      onlyChapter(targetEl?.closest<HTMLDetailsElement>('details.ph__ch-group'));
      const fold = targetEl?.closest<HTMLDetailsElement>('details.ph__fold');
      if (fold) onlySection(fold);
      const panel = targetEl?.closest<HTMLElement>('[data-section-panel]');
      if (panel?.dataset.sectionPanel) setCurrent(panel.dataset.sectionPanel);
      let ancestor = targetEl?.parentElement;
      while (ancestor && ancestor !== book) {
        if (ancestor instanceof HTMLDetailsElement) ancestor.open = true;
        ancestor = ancestor.parentElement;
      }
      jump(targetEl);
    };
    // All chapter and figure note links show their full reference in place.
    const citation = book.querySelector<HTMLElement>('#ph-citation')!;
    const citationBody = citation.querySelector<HTMLElement>('[data-citation-body]')!;
    const citationTitle = citation.querySelector<HTMLElement>('#ph-citation-title')!;
    const citationBib = citation.querySelector<HTMLAnchorElement>('[data-citation-bib]')!;
    let citationTrigger: HTMLAnchorElement | null = null;
    const normaliseCitation = (text: string) => text.toLowerCase().replace(/[^a-z0-9]+/g, ' ').trim();
    const bibliographyTarget = (reference: HTMLElement) => {
      const urls = [...reference.querySelectorAll<HTMLAnchorElement>('a[href^="http"]')].map(a => a.href);
      const titles = [...reference.querySelectorAll('i, em')].map(el => normaliseCitation(el.textContent || '')).filter(t => t.length > 12);
      const entries = [...book.querySelectorAll<HTMLElement>('.ph__bib-list > li')];
      // Exact source URLs or publication titles; an uncertain match opens the full list.
      const entry = entries.find(el => urls.length && [...el.querySelectorAll<HTMLAnchorElement>('a[href^="http"]')].some(a => urls.includes(a.href)))
        || entries.find(el => titles.some(title => normaliseCitation(el.textContent || '').includes(title)));
      return entry ? `#${entry.id}` : '#s-5-5';
    };
    const positionCitation = () => {
      if (!citation.matches(':popover-open') || !citationTrigger) return;
      const anchor = citationTrigger.getBoundingClientRect();
      const box = citation.getBoundingClientRect();
      const left = Math.max(16, Math.min(anchor.left, innerWidth - box.width - 16));
      let top = anchor.bottom + 10;
      if (top + box.height > innerHeight - 16) top = anchor.top - box.height - 10;
      citation.style.left = `${left}px`;
      citation.style.top = `${Math.max(16, Math.min(top, innerHeight - box.height - 16))}px`;
    };
    const closeCitation = (restoreFocus = false) => {
      if (citation.matches(':popover-open')) citation.hidePopover();
      if (restoreFocus) citationTrigger?.focus({ preventScroll: true });
    };
    const showCitation = (trigger: HTMLAnchorElement, href = trigger.getAttribute('href') || '') => {
      const note = book.querySelector<HTMLElement>(href);
      const reference = note?.querySelector<HTMLElement>(':scope > span');
      if (!reference) return false;
      const match = href.match(/^#note-(\d+)-(\d+)$/);
      if (!match) return false;
      citationTrigger?.setAttribute('aria-expanded', 'false');
      citationTrigger = trigger;
      trigger.setAttribute('aria-haspopup', 'dialog');
      trigger.setAttribute('aria-controls', 'ph-citation');
      trigger.setAttribute('aria-expanded', 'true');
      citationTitle.textContent = `Chapter ${match[1]} · Note ${match[2]}`;
      citationBody.replaceChildren(...[...reference.childNodes].map(node => node.cloneNode(true)));
      citationBib.href = bibliographyTarget(reference);
      if (!citation.matches(':popover-open')) citation.showPopover();
      positionCitation();
      citationTitle.focus({ preventScroll: true });
      return true;
    };
    book.querySelectorAll<HTMLAnchorElement>('a[href^="#note-"]').forEach(link => {
      link.setAttribute('aria-haspopup', 'dialog');
      link.setAttribute('aria-controls', 'ph-citation');
      link.setAttribute('aria-expanded', 'false');
    });
    citation.querySelector('[data-citation-close]')?.addEventListener('click', () => closeCitation(true));
    citation.addEventListener('toggle', () => {
      if (!citation.matches(':popover-open')) citationTrigger?.setAttribute('aria-expanded', 'false');
    });
    citationBib.addEventListener('click', e => {
      e.preventDefault();
      e.stopPropagation();
      const href = citationBib.getAttribute('href')!;
      closeCitation();
      jumpToHashInBook(href);
      const target = book.querySelector<HTMLElement>(href);
      if (target) { target.tabIndex = -1; target.focus({ preventScroll: true }); }
    });
    addEventListener('resize', positionCitation);
    addEventListener('scroll', positionCitation, { passive: true });
    chapterBtns.forEach(button => button.addEventListener('click', () => closeCitation()));
    sectionBtns.forEach(button => button.addEventListener('click', () => closeCitation()));

    // Back links and section anchors keep their existing navigation.
    book.addEventListener('click', (e) => {
      const a = (e.target as Element).closest<HTMLAnchorElement>('a[href^="#note-"], a[href^="#ref-"], a[href^="#s-"], .ph2-source a[href^="http"], .ph__fig-src a[href^="http"]');
      if (!a) return;
      const href = a.getAttribute('href');
      if (!href) return;
      if (!href.startsWith('#')) {
        const matchingNote = [...book.querySelectorAll<HTMLElement>('.ph__notes-list > li')].find(note => [...note.querySelectorAll<HTMLAnchorElement>('a[href^="http"]')].some(link => link.href === a.href));
        if (matchingNote && showCitation(a, `#${matchingNote.id}`)) e.preventDefault();
        return;
      }
      e.preventDefault();
      if (href.startsWith('#note-') && showCitation(a)) return;
      closeCitation();
      jumpToHashInBook(href);
    });
    chapterBtns.forEach((b) =>
      b.addEventListener('click', () => {
        const ch = b.dataset.chapter!;
        onlyChapter(book.querySelector<HTMLDetailsElement>(`[data-chapter-group="${ch}"]`));
        goTo(book.querySelector<HTMLElement>(`[data-chapter-head="${ch}"]`), ch.replace('ch', '') + '-0');
      })
    );
    sectionBtns.forEach((b) =>
      b.addEventListener('click', () => {
        const sid = b.dataset.section!;
        const target = book.querySelector<HTMLElement>(`[data-section-panel="${sid}"]`);
        goTo(target, sid);
      })
    );
    chGroups.forEach((group) =>
      group.addEventListener('toggle', () => {
        if (group.open && group.dataset.chapterGroup) {
          onlyChapter(group);
          const chNum = group.dataset.chapterGroup.replace('ch', '');
          const openFoldInGroup = group.querySelector<HTMLDetailsElement>('details.ph__fold[open]');
          if (!openFoldInGroup) {
            const firstFold = group.querySelector<HTMLDetailsElement>('details.ph__fold');
            if (firstFold) onlySection(firstFold);
          } else {
            onlySection(openFoldInGroup);
          }
          const activeFold = group.querySelector<HTMLDetailsElement>('details.ph__fold[open]');
          setCurrent(activeFold?.dataset.sectionPanel || `${chNum}-0`);
          if (!jumping) {
            const topBarBottom = pinned() ? toc!.getBoundingClientRect().bottom : 0;
            if (group.getBoundingClientRect().top < topBarBottom) jump(group);
          }
        }
      })
    );
    sectionPanels.forEach((el) =>
      el.addEventListener('toggle', () => {
        const fold = el as HTMLDetailsElement;
        if (fold.open && fold.dataset.sectionPanel) {
          onlySection(fold);
          setCurrent(fold.dataset.sectionPanel);
          if (!jumping) {
            const topBarBottom = pinned() ? toc!.getBoundingClientRect().bottom : 0;
            if (fold.getBoundingClientRect().top < topBarBottom) jump(fold);
          }
        }
      })
    );

    // Chapter openings and sections in document order.
    const markers: [HTMLElement, string][] = sectionPanels.map((el) => [
      el,
      el.dataset.sectionPanel!,
    ]);
    // Follow the scroll: the current section is the last open one whose top has passed under the tabs.
    let ticking = false;
    const spy = () => {
      ticking = false;
      const line = (pinned() ? toc!.getBoundingClientRect().bottom : 0) + 120;
      let id = currentId || '1-1';
      for (const [el, sid] of markers) {
        const group = el.closest<HTMLDetailsElement>('details.ph__ch-group');
        if ((!group || group.open) && (el as HTMLDetailsElement).open && el.getBoundingClientRect().top <= line) id = sid;
      }
      setCurrent(id);
    };
    addEventListener('scroll', () => { if (!jumping && !ticking) { ticking = true; requestAnimationFrame(spy); } }, { passive: true });
    spy();
    // Restore a linked chapter or section on refresh.
    if (/^#(?:ch[1-5]|s-[1-5]-\d+|note-[1-4]-\d+|bib-\d+)$/.test(location.hash)) requestAnimationFrame(() => jumpToHashInBook(location.hash));

    // 90% Screen Mindmap Lightbox wiring
    const mmLightbox = book.querySelector<HTMLElement>('[data-mm-lightbox]');
    const mmRoot = book.querySelector<HTMLElement>('[data-mindmap-root]');
    const mmOpenBtn = book.querySelector<HTMLButtonElement>('[data-mm-open]');
    const mmCloseEls = [...book.querySelectorAll<HTMLElement>('[data-mm-close]')];
    let mmInstance: ReturnType<typeof initPowerhouseMindmap> | null = null;
    const dPayload = JSON.parse(document.querySelector('#ph-data')!.textContent!);

    const openMindmap = () => {
      if (!mmLightbox || !mmRoot) return;
      mmLightbox.hidden = false;
      document.body.style.overflow = 'hidden';
      if (!mmInstance) {
        mmInstance = initPowerhouseMindmap({
          root: mmRoot,
          payload: {
            sections: dPayload.mindmapSections || [],
            notes: dPayload.mindmapNotes || [],
            bibs: dPayload.mindmapBibs || [],
          },
          onJumpToSection: (sectionId: string) => {
            closeMindmap();
            const btn = book.querySelector<HTMLButtonElement>(`[data-section="${sectionId}"]`);
            btn?.click();
          },
          onJumpToHash: (hash: string) => {
            closeMindmap();
            jumpToHashInBook(hash);
          },
        });
      } else {
        requestAnimationFrame(() => {
          mmInstance?.resize();
          mmInstance?.reheat();
        });
      }
    };

    const closeMindmap = () => {
      if (!mmLightbox) return;
      mmLightbox.hidden = true;
      document.body.style.overflow = '';
    };

    mmOpenBtn?.addEventListener('click', openMindmap);
    mmCloseEls.forEach((el) => el.addEventListener('click', closeMindmap));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && mmLightbox && !mmLightbox.hidden) {
        closeMindmap();
        mmOpenBtn?.focus();
      }
    });
  }

  // Each comparison map opens as a close-up; the full outline remains one action away.
  document.querySelectorAll<HTMLElement>('[data-overview-map]').forEach(frame => {
    const svg = frame.querySelector<SVGSVGElement>('svg')!;
    const layer = svg.querySelector<SVGGElement>('[data-overview-layer]')!;
    let initialized = false;
    const init = () => {
      if (initialized || !svg.getBoundingClientRect().width) return;
      const bounds = layer.getBBox();
      if (!bounds.width || !bounds.height) return;
      initialized = true;
      const width = 420, height = 420;
      const fit = Math.min(width / bounds.width, height / bounds.height) * .94;
      const cover = Math.max(width / bounds.width, height / bounds.height) * 1.05;
      const centered = (scale: number) => zoomIdentity.translate(width / 2, height / 2).scale(scale).translate(-bounds.x - bounds.width / 2, -bounds.y - bounds.height / 2);
      const behavior = zoom<SVGSVGElement, unknown>().extent([[0, 0], [width, height]]).scaleExtent([fit, Math.max(cover * 8, fit * 12)]).filter((event: Event) => {
        if (event.type === 'wheel') return (event as WheelEvent).ctrlKey || (event as WheelEvent).metaKey;
        if (event.type.startsWith('touch')) return (event as TouchEvent).touches.length > 1;
        return !(event as MouseEvent).button;
      }).on('zoom', event => { layer.setAttribute('transform', event.transform.toString()); frame.dataset.zoom = event.transform.k.toFixed(3); });
      const selection = select(svg).call(behavior).on('dblclick.zoom', null);
      selection.call(behavior.transform, centered(cover));
      frame.querySelectorAll<HTMLButtonElement>('[data-overview-zoom]').forEach(button => button.addEventListener('click', () => {
        if (button.dataset.overviewZoom === 'full') selection.call(behavior.transform, centered(fit));
        else selection.call(behavior.scaleBy, button.dataset.overviewZoom === 'in' ? 1.5 : 1 / 1.5, [width / 2, height / 2]);
      }));
      svg.addEventListener('keydown', event => {
        if (event.key === '+' || event.key === '=') { event.preventDefault(); selection.call(behavior.scaleBy, 1.5); }
        else if (event.key === '-') { event.preventDefault(); selection.call(behavior.scaleBy, 1 / 1.5); }
        else if (event.key === '0') { event.preventDefault(); selection.call(behavior.transform, centered(fit)); }
        else if (['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown'].includes(event.key)) {
          event.preventDefault(); selection.call(behavior.translateBy, event.key === 'ArrowLeft' ? 20 : event.key === 'ArrowRight' ? -20 : 0, event.key === 'ArrowUp' ? 20 : event.key === 'ArrowDown' ? -20 : 0);
        }
      });
    };
    new ResizeObserver(init).observe(frame);
    init();
  });

  const root = document.querySelector<HTMLElement>('[data-analysis]');
  if (root) {
    const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
    const evidenceIds = ['usa', 'comparison', 'ny-detail', 'comparison-data', 'california', 'new-york', 'florida'];
    const revealEvidence = (hash: string, scroll = true) => {
      const id = hash.replace(/^#/, '');
      const resolved = id === 'states' ? 'comparison' : id === 'vehicles' ? 'usa' : id;
      if (!evidenceIds.includes(resolved)) return;
      const target = document.getElementById(resolved);
      let parent: HTMLElement | null = target;
      while (parent && parent !== root) {
        if (parent instanceof HTMLDetailsElement) parent.open = true;
        parent = parent.parentElement;
      }
      if (scroll) requestAnimationFrame(() => target?.scrollIntoView({ block: 'start' }));
    };
    window.addEventListener('hashchange', () => revealEvidence(location.hash));
    if (location.hash) revealEvidence(location.hash);

    const d = JSON.parse(document.querySelector('#ph-data')!.textContent!);
    const number = (n: number) => n.toLocaleString('en-US');

    // Zoomable maps. Each is built the first time its slide is on screen (a hidden map has no
    // size to draw into) and resized whenever its slide comes back.
    const maps = new Map<string, PowerhouseMap>();
    const mapOptions: Record<string, Parameters<typeof createMap>[1]> = {
      usa: { fit: 'usa' },
      CA: { fit: 'CA', outline: 'state', focusState: 'CA' },
      NY: { fit: 'NY', outline: 'state', focusState: 'NY' },
      FL: { fit: 'FL', outline: 'state', focusState: 'FL' },
      NYC: { fit: 'NYC', outline: 'boroughs' },
    };
    const mapFor = (key: string) => maps.get(key);
    const wake = (slide: Element) => {
      if (slide instanceof HTMLDetailsElement && !slide.open) return;
      slide.querySelectorAll<HTMLElement>('[data-map]').forEach((el) => {
        const key = el.dataset.map!;
        const existing = maps.get(key);
        if (existing) return existing.resize();
        // State maps are vector SVGs, the same files that go into the InDesign book; the US and
        // New York City close-up stay on the fast canvas map.
        const svgMaps: Record<string, string> = { CA: '/maps/california.svg', NY: '/maps/new-york.svg', FL: '/maps/florida.svg' };
        const m = svgMaps[key] ? createSvgMap(el, svgMaps[key]) : createMap(el, mapOptions[key]);
        maps.set(key, m);
        m.ready.then(() => key === 'usa' ? usaFilter() : key === 'NYC' ? cityFilter() : stateFilters.get(key)?.());
      });
    };
    const io = new IntersectionObserver((entries) => entries.forEach((e) => e.isIntersecting && !(e.target as HTMLElement).hidden && wake(e.target)), { rootMargin: '400px 0px' });
    slides.forEach((sl) => { io.observe(sl); if (sl instanceof HTMLDetailsElement) sl.addEventListener('toggle', () => { if (sl.open) requestAnimationFrame(() => wake(sl)); }); });
    // A slide being shown wakes its maps. Watch the slides themselves only: things inside a
    // map (its tooltip) also toggle hidden, and reacting to those would loop.
    const slideWatch = new MutationObserver((records) => {
      for (const r of records) {
        const sl = r.target as HTMLElement;
        if (!sl.hidden && sl.getBoundingClientRect().top < innerHeight + 400) wake(sl);
      }
    });
    slides.forEach((sl) => slideWatch.observe(sl, { attributes: true, attributeFilter: ['hidden'] }));

    // USA filters
    const access = root.querySelector<HTMLSelectElement>('#ph-access')!;
    const usaFilter = () => {
      const a = access.value as 'public' | 'private' | 'all';
      const n = 'all' as const;
      root.querySelectorAll<SVGCircleElement>('[data-us-access]').forEach(dot => dot.classList.toggle('is-filtered', a !== 'all' && dot.dataset.usAccess !== a));
      root.querySelector('#ph-us-svg-title')!.textContent = `US charging infrastructure: ${a} access`;
      const count = d.groups[a][n];
      root.querySelector('#ph-map-ports')!.textContent = number(count.ports);
      root.querySelector('#ph-map-stations')!.textContent = `at ${number(count.stations)} stations · ${a === 'all' ? 'public and private' : a}`;
    };
    access.addEventListener('change', usaFilter);

    // State filters (CA, NY, FL)
    const stateFilters = new Map<string, () => void>();
    (['CA', 'NY', 'FL'] as const).forEach((code) => {
      const stAccess = root.querySelector<HTMLSelectElement>(`[data-st-access="${code}"]`);
      const portsOut = root.querySelector<HTMLElement>(`[data-st-ports="${code}"]`);
      const stOut = root.querySelector<HTMLElement>(`[data-st-stations="${code}"]`);
      if (!stAccess || !portsOut || !stOut) return;
      const update = () => {
        const a = stAccess.value as 'public' | 'private' | 'all';
        const n = 'all' as const;
        mapFor(code)?.setFilter({ access: a, network: n });
        const count = d.stateGroups[code][a][n];
        // The headline figure follows the filters, so there is one number, not two.
        portsOut.textContent = number(count.ports);
        stOut.textContent = `at ${number(count.stations)} stations · ${a === 'all' ? 'public and private' : a}`;
      };
      stateFilters.set(code, update);
      stAccess.addEventListener('change', update);
    });

    // New York City: a borough zooms the map to it; charger type filters the dots
    // (The NYC map is out of 1.1 for now; it returns as its own deep dive. Until then these
    // controls are absent and this block does nothing.)
    const borough = root.querySelector<HTMLSelectElement>('#ph-borough');
    const kind = root.querySelector<HTMLSelectElement>('#ph-city-type');
    const cityFilter = () => {
      if (!borough || !kind) return;
      let count = 0;
      let ports = 0;
      d.city.forEach((s: { borough: string; dc: number; ports: number }) => {
        if ((borough.value === 'all' || s.borough === borough.value) && (kind.value === 'all' || (kind.value === 'dc' ? s.dc > 0 : s.dc === 0))) {
          count++;
          ports += s.ports;
        }
      });
      root.querySelectorAll<SVGCircleElement>('[data-city-station]').forEach(dot => dot.classList.toggle('is-filtered', (borough.value !== 'all' && dot.dataset.borough !== borough.value) || (kind.value === 'dc' && Number(dot.dataset.dc) === 0) || (kind.value === 'ac' && Number(dot.dataset.dc) > 0)));
      root.querySelectorAll<SVGPathElement>('[data-city-borough]').forEach(path => path.classList.toggle('is-muted', borough.value !== 'all' && path.dataset.cityBorough !== borough.value));
      root.querySelectorAll<HTMLElement>('[data-borough-row]').forEach((r) =>
        r.classList.toggle('is-muted', borough.value !== 'all' && r.dataset.boroughRow !== borough.value)
      );
      root.querySelector('#ph-city-result')!.textContent = `${borough.value === 'all' ? 'NYC' : borough.value} · ${number(count)} public stations · ${number(ports)} plugs at these stations`;
    };
    borough?.addEventListener('change', () => { mapFor('NYC')?.fit(borough.value === 'all' ? 'NYC' : borough.value); cityFilter(); });
    kind?.addEventListener('change', cityFilter);
    slides.forEach((sl) => !sl.hidden && wake(sl));
    const wakeIfOpen = () => {
      const s11 = root.querySelector<HTMLDetailsElement>('#s-1-1');
      const ch1Group = root.querySelector<HTMLDetailsElement>('[data-chapter-group="ch1"]');
      if (s11?.open && (!ch1Group || ch1Group.open)) slides.forEach((sl) => !sl.hidden && wake(sl));
    };
    root.querySelector<HTMLDetailsElement>('#s-1-1')?.addEventListener('toggle', wakeIfOpen);
    root.querySelector<HTMLDetailsElement>('[data-chapter-group="ch1"]')?.addEventListener('toggle', wakeIfOpen);
  }
</script>
