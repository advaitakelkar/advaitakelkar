  .ph__references h2 { font-size:clamp(1.75rem,3vw,2.625rem);font-weight:700;line-height:1.1;margin:0 0 24px; }
  .ph__reference-chapter h3 { font-size:21px;font-weight:700;line-height:1.3;margin-bottom:20px; }
  .ph__references :is(.ph__notes-list,.ph__bib-list) li { margin-bottom:12px; }
  .ph__fold-title { font-weight:700; }
  .ph__ch-title { font-size:clamp(1.75rem,3.2vw,2.625rem);font-weight:700;line-height:1.1;letter-spacing:-.025em; }
  :is([data-chapter-group="ch1"],[data-chapter-group="ch2"],[data-chapter-group="ch3"],[data-chapter-group="ch4"]) .ph__fold-title { font-size:clamp(1.25rem,1.1rem + .3vw,1.375rem); }
  @media (min-width: 700px) { .ph__column-turn { break-before:column; } }
  @media (max-width: 699.98px) {
