  .ph__chapters button, .ph__subtabs button, .ph__nav a, .ph__row-label { display: inline-flex; align-items: center; gap: 5px; min-height: 25px; padding: 2px 9px; border: var(--_tokens---pill-border); border-radius: var(--_tokens---radius--pill); font: inherit; font-size: clamp(0.6875rem, 0.65rem + 0.1vw, 0.75rem); line-height: 1.2; white-space: nowrap; text-decoration: none; text-align: left; color: var(--_tokens---color--muted); background-color: color-mix(in srgb, var(--_tokens---color--fg) 6%, transparent); cursor: pointer; transition: background-color var(--_tokens---motion--base), color var(--_tokens---motion--base), border-color var(--_tokens---motion--base); }
