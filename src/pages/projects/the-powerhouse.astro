    border-bottom: 1px solid var(--_tokens---color--line);
  }
  /* All states, ten or so in view: the list fills the column down to the end of the left one */
  .ph__ranklist { display: flex; flex-direction: column; flex: 1 1 0; min-height: 14rem; margin-top: 24px; padding-top: 12px; border-top: 1px solid var(--_tokens---color--line); }
  .ph__ranklist-head { display: flex; justify-content: space-between; gap: 12px; font-size: var(--_tokens---type--micro); margin-bottom: 10px; }
  .ph__ranklist-head span { color: var(--_tokens---color--muted); }
  .ph__ranklist-head b { font-weight: 600; font-variant-numeric: tabular-nums; }
  .ph__ranklist .ph__top5 { flex: 1 1 0; min-height: 0; overflow-y: auto; margin: 0; padding-right: 6px; }
  .ph__six-notes-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
