     at-a-glance component, which no longer appears on this page) */
  .ph__stack100-key { list-style: none; display: flex; flex-wrap: wrap; gap: 4px 14px; margin: 0; padding: 0; font-size: 11px; color: var(--_tokens---color--muted); }
  .ph__stack100-key li { display: flex; align-items: center; gap: 6px; }
  .ph__stack100-key li i { width: 9px; height: 9px; border-radius: 50%; flex: 0 0 auto; }
  .ph__stack100-key b { color: var(--_tokens---color--fg); font-weight: 500; }
  .ph__stack100-key--list { display: grid; gap: 3px; }
  .ph .c-red { background: var(--ph-red); } .ph .c-orange { background: var(--ph-orange); } .ph .c-yellow { background: var(--ph-yellow); } .ph .c-green { background: var(--ph-green); }
  .ph .c-teal { background: var(--ph-teal); } .ph .c-blue { background: var(--ph-blue); } .ph .c-grey { background: var(--ph-grey); } .ph .c-light { background: var(--ph-light); }
  /* State dashboards: rings for the mixes, tiles for the headline numbers */
  .ph__dash { display: grid; gap: 14px; margin: 16px 0 12px; }
  .ph__dash-card { display: grid; grid-template-columns: 112px minmax(0, 1fr); gap: 14px; align-items: center; padding: 12px; border-radius: 14px; background: color-mix(in srgb, var(--_tokens---color--fg) 4%, var(--_tokens---color--bg)); min-height: 136px; }
  .ph__dash-card--years { grid-template-columns: minmax(0, 1fr); gap: 8px; }
  /* All vehicles and charging infrastructure: one multi-segment bar each, the storage-bar way */
  .ph .ph__dash-stack { display: flex; height: 22px; border-radius: 6px; overflow: hidden; gap: 2px; }
  .ph .ph__dash-stack i { display: block; min-width: 3px; flex-basis: 0; }
  .ph__dash-card--vbars { grid-template-columns: minmax(0, 1fr); gap: 8px; align-items: stretch; }
