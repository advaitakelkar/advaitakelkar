  @media (max-width: 1023.98px) { .ph__notes-list, .ph__bib-list { columns: 1; } }
  .ph :global(.ph__book sup[id]), .ph__notes-list li { scroll-margin-top: calc(var(--ph-toc-h, 140px) + 160px); }
  .ph :global(.ph__book-notes) { columns: 2; column-gap: var(--_tokens---space--small); display: block; }
    .ph :global(.ph__book-notes li) { break-inside: avoid; margin-bottom: 8px; }
  }
  .ph :global(.ph__book-notes) { margin: 0; padding: 12px 0 0 1.6em; border-top: 1px solid var(--_tokens---color--line); font-size: var(--_tokens---type--micro); line-height: 1.5; color: var(--_tokens---color--muted); display: grid; gap: 8px; }
  .ph :global(.ph__book-notes a) { color: inherit; overflow-wrap: anywhere; }
  .ph__interpretation td { white-space: normal; min-width: 180px; line-height: 1.6; }
  .ph__interpretation th:first-child { white-space: normal; min-width: 160px; }
  .ph__state-detail > section { padding-top: 16px; }
  .ph__heading--full { margin-bottom: 24px; }
