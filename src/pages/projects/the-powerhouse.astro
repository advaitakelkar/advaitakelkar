  if (p.includes('mcharg') || p.includes('van der ryn') || p.includes('lyle') || p.includes('brundtland') || p.includes('our common future') || p.includes('holland') || p.includes('zhang') || p.includes('greenhouse gas') || p.includes('efficiency') || p.includes('outlook') || p.includes('breakthrough')) {
    return { category: 'sustainability', categoryLabel: 'Sustainability & Grid', lens: 'lens-sustainability' };
  }
  if (p.includes('heidegger') || p.includes('norberg-schulz') || p.includes('cooley') || p.includes('whyte') || p.includes('gehl') || p.includes('auge') || p.includes('augé') || p.includes('non-places') || p.includes('lynch') || p.includes('tuan') || p.includes('xu et al') || p.includes('neurological')) {
    return { category: 'phenomenology', categoryLabel: 'Phenomenology', lens: 'lens-phenomenology' };
  }
  if (p.includes('lefebvre') || p.includes('foucault') || p.includes('jacobs') || p.includes('sennett') || p.includes('kayden') || p.includes('shoup') || p.includes('klinenberg') || p.includes('moreno') || p.includes('15-minute')) {
    return { category: 'social', categoryLabel: 'Social Theory', lens: 'lens-social' };
  }
  return { category: 'fleets', categoryLabel: 'Fleets & Regulations', lens: 'lens-fleets' };
};

const extractShortAuthor = (plain: string) => {
  const matches = [...plain.matchAll(/\b(18\d\d|19\d\d|20\d\d)\b/g)];
  const year = matches.length ? matches[matches.length - 1][1] : '';
  let author = '';
  if (plain.startsWith('U.S. Department of Energy, Vehicle')) author = 'US DOE FOTW';
  else if (plain.startsWith('U.S. Department of Energy')) author = 'US DOE';
  else if (plain.startsWith('U.S. Energy')) author = 'US EIA';
  else if (plain.startsWith('U.S. Environmental')) author = 'US EPA';
  else if (plain.startsWith('U.S. Federal Motor')) author = 'US FMCSA';
  else if (plain.startsWith('U.S. Census')) author = 'US Census';
  else if (plain.startsWith('Federal Highway')) author = 'FHWA NEVI';
  else if (plain.startsWith('European Parliament')) author = 'EU Parliament';
  else if (plain.startsWith('Office of the New York')) author = 'NYS Comptroller';
  else if (plain.startsWith('New York Metropolitan')) author = 'NYMTC';
  else if (plain.startsWith('World Commission')) author = 'WCED Brundtland';
  else if (plain.startsWith('Ministry of Land')) author = 'MLIT Japan';
  else if (plain.startsWith('International Energy Agency. Global EV Outlook 2026')) author = 'IEA EV Outlook 26';
  else if (plain.startsWith('International Energy Agency. Global EV Outlook 2025')) author = 'IEA EV Outlook 25';
  else if (plain.startsWith('International Energy Agency')) author = 'IEA Breakthrough';
  else if (plain.startsWith('Foster + Partners')) author = 'Foster + Partners';
  else if (plain.startsWith('Bjarke Ingels')) author = 'BIG (CopenHill)';
  else {
    const firstSentence = plain.split(/\.\s/)[0];
    const surname1 = firstSentence.split(',')[0].trim();
    if (firstSentence.includes('et al.')) {
      author = `${surname1} et al.`;
    } else if (firstSentence.includes(' and ')) {
      const secondPart = firstSentence.split(' and ')[1].trim();
      const words = secondPart.split(/[\s,]+/);
      const surname2 = words[words.length - 1];
      author = `${surname1} & ${surname2}`;
    } else {
      author = surname1;
    }
  }
  return year ? `${author} (${year})` : author;
};

const rawBibs = bibliography.map((html, i) => {
  const plain = stripHtml(html);
  const cat = getCategory(plain);
  const shortAuthor = extractShortAuthor(plain);
  const surname = plain.split(/[,.]/)[0].trim().toLowerCase();
  const tokens = plain
    .toLowerCase()
    .replace(/[^a-z0-9\s]/g, ' ')
    .split(/\s+/)
    .filter((w) => w.length >= 5 && !STOP_WORDS.has(w));
  return {
    id: `bib-${i + 1}`,
    idx: i + 1,
    shortAuthor,
    category: cat.category,
    categoryLabel: cat.categoryLabel,
    lens: cat.lens,
    surname,
    tokens: tokens.slice(0, 6),
    plain,
    html,
    chapters: new Set<string>(),
    sections: new Set<string>(),
    notes: new Set<string>(),
  };
});

const mindmapNotes = (['1', '2', '3', '4'] as const).flatMap((ch) =>
  notesFor(ch).map((nt) => {
    const plain = stripHtml(nt.html);
    const lower = plain.toLowerCase();
    const matchedBibs = rawBibs.filter((b) => {
      if (b.surname.length >= 4 && lower.includes(b.surname)) return true;
      const hits = b.tokens.filter((t) => lower.includes(t)).length;
      return hits >= 2;
    });
    matchedBibs.forEach((b) => {
      b.chapters.add(ch);
      b.sections.add(nt.from);
      b.notes.add(`Note ${ch}.${nt.n}`);
    });
    const firstPart = plain.split(',')[0] || plain.slice(0, 28);
    const shortLabel = firstPart.length > 28 ? firstPart.slice(0, 26) + '…' : firstPart;
    return {
      id: `note-${ch}-${nt.n}`,
      ch,
      n: nt.n,
      fromSection: nt.from,
      notesSectionId: `5-${ch}`,
      shortLabel,
      plain,
      bibIds: matchedBibs.map((b) => b.id),
    };
  })
);

const referenceKey = (html: string) => stripHtml(html).toLowerCase().replace(/[^a-z0-9]+/g, ' ').trim();
const referenceSources = bibliography.map((html, i) => ({
  html, id: `bib-${i + 1}`,
  urls: [...html.matchAll(/href="([^"#]+)"/g)].map(m => m[1]),
  titles: [...html.matchAll(/<(?:i|em)>([\s\S]*?)<\/(?:i|em)>/g)].map(m => referenceKey(m[1])).filter(t => t.length > 12),
}));
const referenceChapters = book.slice(0, 4).map(chapter => ({chapter, notes: notesFor(chapter.num)}));

const mindmapBibs = rawBibs.map((b) => ({
  id: b.id,
  idx: b.idx,
  shortAuthor: b.shortAuthor,
  category: b.category,
  categoryLabel: b.categoryLabel,
  lens: b.lens,
  plain: b.plain,
  html: b.html,
  chapters: [...b.chapters].sort(),
  sections: [...b.sections],
  notes: [...b.notes],
}));
