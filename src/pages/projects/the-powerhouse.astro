  /* Match the current InDesign editorial report, while retaining responsive navigation. */
  .ph { --ph-panel:color-mix(in srgb,var(--_tokens---color--fg) 3%,var(--_tokens---color--bg));
    --ph-panel-line:color-mix(in srgb,var(--_tokens---color--fg) 12%,var(--_tokens---color--bg)); }
  .ph :global(.ph__book-body),.ph .ph__chapter-lead :global(.ph__book-body) { font-size:var(--ph-reading-size); }
  .ph :global(.ph__book-body p),.ph .ph__chapter-lead :global(.ph__book-body p) { font-size:inherit;line-height:var(--ph-reading-leading);margin-bottom:.65em;orphans:3;widows:3; }
  .ph :global(.ph__book-body) { column-gap:var(--ph-reading-gap);column-fill:balance; }
  [data-chapter-group="ch1"] .ph__read-unit { gap:24px; }
