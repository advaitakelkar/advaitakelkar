      grid-template-columns: 1fr;
    }
  }
  .ph__state-overview-map { margin: 16px 0; }
  .ph__overview-viewport { position: relative; width: 100%; aspect-ratio: 1; overflow: hidden; background: var(--_tokens---color--bg); }
  .ph__overview-viewport .ph__state-overview-svg { width: 100%; height: 100%; cursor: grab; touch-action: pan-y; }
  .ph__overview-viewport .ph__state-overview-svg:active { cursor: grabbing; }
  .ph__state-overview-svg path { vector-effect: non-scaling-stroke; }
  .ph__overview-controls { position: absolute; top: 8px; right: 8px; display: flex; gap: 4px; }
  .ph__overview-controls button { min-width: 28px; min-height: 28px; padding: 2px 8px; border: 1px solid var(--_tokens---color--line); border-radius: var(--_tokens---radius--pill); background: color-mix(in srgb, var(--_tokens---color--bg) 90%, transparent); color: var(--_tokens---color--muted); font: inherit; font-size: 11px; line-height: 1.2; cursor: pointer; transition: color .15s ease, border-color .15s ease, background-color .15s ease; }
  .ph__overview-controls button:is(:hover, :focus-visible, :active) { color: var(--_tokens---color--fg); border-color: var(--_tokens---color--fg); background: var(--_tokens---color--bg); }
  .ph__graphs > .ph__chain-time { margin-top: 24px; }

  .ph__state-overview-map figcaption { font-size: var(--_tokens---type--micro); color: var(--_tokens---color--muted); }
  .ph :is(.ph__national-svg, .ph__city-svg, .ph__state-overview-svg) circle:not(.ph__focus-mark), .ph__mapbox :global(svg circle) { fill: var(--_tokens---color--fg) !important; stroke: none !important; opacity: .7 !important; }
  .ph__mapbox :global(svg) { filter: grayscale(1); }
  .ph__map figcaption .ph__key { display: none; }
  .ph__city-focus > figure { order: 2; }
  .ph__city-argument { order: 1; }
  @media (max-width: 1023.98px) { .ph__national-layout { grid-template-columns: 1fr; gap: 16px; } }
  .ph__chapter-lead, .ph__essential > p, .ph__short-state p, .ph__city-argument p, .ph__takeaway p { font-size: var(--_tokens---type--micro); line-height: 1.65; }
  .ph__chapter-lead p, .ph__city-argument p, .ph__takeaway p { margin: 0 0 1em; }
  .ph .ph__chapter-lead :global(.ph__book-body) { columns: 1; }
  .ph .ph__chapter-lead :global(.ph__book-body p) { font-size: var(--_tokens---type--micro); line-height: 1.65; max-width: none; }
  .ph__lead-bridge { padding-top: 10px; border-top: 1px solid var(--_tokens---color--line); }
  /* Editorial Paired Reading Flow for Chapter 1 */
  .ph__editorial {
    display: flex;
    flex-direction: column;
    gap: 36px;
    margin: 8px 0 28px;
  }
  .ph__read-unit {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: 36px 44px;
    align-items: start;
    padding-bottom: 28px;
    border-bottom: 1px dashed var(--_tokens---color--line);
  }
  .ph__read-unit:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }
  .ph__read-unit--full {
    display: block;
    width: 100%;
    padding-bottom: 28px;
  }
  .ph__read-text {
    min-width: 0;
    font-size: clamp(0.9375rem, 0.9rem + 0.15vw, 1.0625rem);
    line-height: 1.68;
    color: var(--_tokens---color--fg);
  }
  .ph__read-text p {
    margin: 0 0 1.25em;
    max-width: 66ch;
  }
  .ph__read-text p:last-child {
    margin-bottom: 0;
  }
  .ph__read-text .ph__book-lead {
    font-size: clamp(1.0625rem, 1rem + 0.25vw, 1.2rem);
    line-height: 1.55;
    font-weight: 450;
    letter-spacing: -0.01em;
    color: var(--_tokens---color--fg);
    margin-bottom: 1.35em;
  }
  /* Note references in reading text: distinct grey highlight badge */
  .ph :global(sup[id^="ref-"]),
  .ph__read-text sup,
  .ph :global(.ph__book sup) {
    font-size: 0.72em;
    vertical-align: baseline;
    position: relative;
    top: -0.42em;
    line-height: 0;
    margin: 0 2px 0 1px;
  }
  .ph :global(sup[id^="ref-"] a),
  .ph__read-text sup a,
  .ph :global(.ph__book sup a) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.45em;
    height: 1.45em;
    padding: 0 4px;
    background-color: color-mix(in srgb, var(--_tokens---color--fg) 12%, transparent);
    color: var(--_tokens---color--fg);
    border-radius: 3px;
    font-size: 0.85em;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    text-decoration: none;
    line-height: 1;
    transition: background-color var(--_tokens---motion--base, 0.15s ease), color var(--_tokens---motion--base, 0.15s ease);
  }
  @media (hover: hover) {
    .ph :global(sup[id^="ref-"] a:hover),
    .ph__read-text sup a:hover,
    .ph :global(.ph__book sup a:hover) {
      background-color: color-mix(in srgb, var(--_tokens---color--fg) 22%, transparent);
      color: var(--ph-red, #cc2b1d);
      text-decoration: none;
    }
  }
  .ph__read-visual {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .ph__fig-header {
    display: flex;
    align-items: baseline;
    gap: 8px;
    padding-bottom: 6px;
    border-bottom: 1px solid var(--_tokens---color--line);
    font-size: var(--_tokens---type--micro);
  }
  .ph__fig-tag {
    color: var(--ph-red, #cc2b1d);
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    font-size: 11px;
  }
  .ph__fig-title {
    color: var(--_tokens---color--muted);
    font-weight: 500;
  }
  .ph__subfigs-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 180px), 1fr));
    gap: 12px;
  }
  @media (max-width: 1023.98px) {
    .ph__read-unit {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }

  /* Chapter 1 reads as a two-column book page. Prose always runs in two equal columns. Diagrams
     sit in the flow, never stacked to one side: a single figure is set inside the text, one column
     wide; a group is a row of 2, 3 or 4 equal cells above, between or below a passage. One gap. */
  [data-chapter-group="ch1"] { --ph-col-gap: var(--ph-reading-gap); }
  [data-chapter-group="ch1"] .ph__editorial { gap: 56px; }
  [data-chapter-group="ch1"] .ph__read-unit { display: flex; flex-direction: column; gap: 40px; padding: 0; border: 0; }
  [data-chapter-group="ch1"] .ph__read-text {
    font-size: var(--ph-reading-size);
    line-height: var(--ph-reading-leading);
    column-count: 2;
    column-gap: var(--ph-col-gap);
    column-fill: balance;
    orphans: 3;
    widows: 3;
  }
  [data-chapter-group="ch1"] .ph__read-text p { max-width: none; }
  [data-chapter-group="ch1"] .ph__read-text .ph__book-lead { font-size: inherit; line-height: inherit; }
  [data-chapter-group="ch1"] :is(.ph__book-running-head, .ph__book-running-foot) { border: 0; }

  /* A figure inside the text columns */
  [data-chapter-group="ch1"] .ph__infig { display: grid; gap: 14px; margin: 0 0 2em; break-inside: avoid; }
  [data-chapter-group="ch1"] .ph__read-text > .ph__infig:last-child { margin: 2em 0 0; }

  /* A row of figures */
  [data-chapter-group="ch1"] .ph__figrow { display: grid; grid-template-columns: repeat(var(--cols, 1), minmax(0, 1fr)); gap: 24px var(--ph-col-gap); align-items: start; }
  [data-chapter-group="ch1"] .ph__figrow > .ph__fig-header { grid-column: 1 / -1; }
  [data-chapter-group="ch1"] .ph__figrow--2 { --cols: 2; }
  [data-chapter-group="ch1"] .ph__figrow--3 { --cols: 3; }
  [data-chapter-group="ch1"] .ph__figrow--4 { --cols: 4; }
  @media (max-width: 1023.98px) {
    [data-chapter-group="ch1"] :is(.ph__figrow--3, .ph__figrow--4) { --cols: 2; }
  }
  @media (max-width: 699.98px) {
    [data-chapter-group="ch1"] { --ph-col-gap: 24px; }
    [data-chapter-group="ch1"] .ph__read-text { column-count: 1; }
    [data-chapter-group="ch1"] .ph__figrow { --cols: 1; }
  }

  /* Chapter 1 figure system. No boxes: a label, one large number, a muted caption, the graphic,
     then its key and source; space does the separating. Colour is kept for data (the Powerhouse
     palette); everything around the data stays black, white and grey. */
  [data-chapter-group="ch1"] .ph__fig-header {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin: 0;
    padding: 0;
    border: 0;
    font-size: var(--_tokens---type--micro);
  }
  [data-chapter-group="ch1"] .ph__fig-tag {
    color: var(--_tokens---color--muted);
    font-size: inherit;
    font-weight: 500;
    letter-spacing: 0;
    text-transform: none;
    font-variant-numeric: tabular-nums;
  }
  [data-chapter-group="ch1"] .ph__fig-title { color: var(--_tokens---color--fg); font-weight: 500; }
  [data-chapter-group="ch1"] .ph__fig { gap: 10px; padding: 0; border: 0; border-radius: 0; background: none; break-inside: avoid; }
  [data-chapter-group="ch1"] .ph__fig > figcaption { margin-bottom: 4px; gap: 6px; }
  [data-chapter-group="ch1"] .ph__fig-num {
    font-size: clamp(1.75rem, 1.4rem + 0.9vw, 2.25rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }
  [data-chapter-group="ch1"] .ph__fig figcaption > span { font-size: var(--_tokens---type--micro); line-height: 1.45; }
  [data-chapter-group="ch1"] .ph__fig-src { margin-top: 2px; padding-top: 0; border: 0; opacity: 0.8; }
  [data-chapter-group="ch1"] .ph__fig-bar { border-radius: 3px; }
  [data-chapter-group="ch1"] .ph__rings-ring { border: 0; border-radius: 20px; }
  [data-chapter-group="ch1"] .ph__book-table figcaption { margin: 0 0 12px; padding: 0; border: 0; font-size: var(--_tokens---type--micro); font-weight: 500; line-height: 1.45; color: var(--_tokens---color--fg); }
  [data-chapter-group="ch1"] .ph__book-tscroll { overflow-x: auto; }
  [data-chapter-group="ch1"] .ph__book-table table { width: 100%; min-width: 36rem; table-layout: fixed; border-collapse: collapse; font-size: var(--_tokens---type--micro); line-height: 1.45; }
  [data-chapter-group="ch1"] .ph__book-table :is(th, td) { padding: 8px 16px 8px 0; white-space: normal; text-align: left; vertical-align: top; font-weight: 400; border: 0; border-top: 1px solid var(--_tokens---color--line); }
  [data-chapter-group="ch1"] .ph__book-table thead th { border-top: 0; color: var(--_tokens---color--muted); }
  [data-chapter-group="ch1"] .ph__book-table :is(th, td):first-child { width: 22%; font-weight: 500; }
  [data-chapter-group="ch1"] .ph__book-table :is(th, td):nth-child(2) { width: 22%; font-variant-numeric: tabular-nums; }
  [data-chapter-group="ch1"] .ph__book-table tbody tr:last-child :is(th, td) { font-weight: 600; }
  [data-chapter-group="ch1"] .ph__book-table figcaption b { font-weight: 500; color: var(--_tokens---color--muted); }

  /* 1.0 the thesis in one line, and 1.7 the lenses: text cells, the lead set large. */
  [data-chapter-group="ch1"] :is(.ph__statement, .ph__lens) { display: grid; align-content: start; gap: 6px; font-size: var(--_tokens---type--micro); line-height: 1.45; }
  [data-chapter-group="ch1"] :is(.ph__statement, .ph__lens) b { font-weight: 600; color: var(--_tokens---color--fg); }
  [data-chapter-group="ch1"] :is(.ph__statement, .ph__lens) span { color: var(--_tokens---color--muted); }
  [data-chapter-group="ch1"] .ph__statement--lead b { font-size: clamp(1.25rem, 1.05rem + 0.6vw, 1.5rem); font-weight: 500; line-height: 1.2; letter-spacing: -0.02em; }
  [data-chapter-group="ch1"] .ph__lens i { justify-self: start; padding: 3px 8px; border-radius: 4px; font-style: normal; font-size: 11px; color: #111; }

  .ph__intro-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 48px; align-items: start; margin-bottom: 56px; }
  .ph__intro-grid .ph__chapter-lead { margin-bottom: 0; }
  .ph__figs { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 12px; }
  .ph__fig { margin: 0; padding: 12px; border: 1px solid var(--_tokens---color--line); border-radius: 12px; display: flex; flex-direction: column; gap: 8px; font-size: var(--_tokens---type--micro); }
  .ph__fig figcaption, .ph__fig-cap { margin: 0; display: grid; gap: 4px; }
  .ph__fig > figcaption { margin-bottom: auto; } /* free height splits around the diagram, so number top and source bottom line up across cards */
  .ph__fig-num { font-size: clamp(1.4rem, 1.1rem + 1vw, 2rem); font-weight: 500; line-height: 1; letter-spacing: -0.01em; }
  .ph__fig figcaption > span, .ph__fig-cap > span { font-size: var(--_tokens---type--ultrathin); line-height: 1.4; color: var(--_tokens---color--muted); }
  .ph__fig-split { padding-top: 10px; border-top: 1px solid var(--_tokens---color--line); }
  .ph__fig-key { margin: 0; font-size: var(--_tokens---type--ultrathin); color: var(--_tokens---color--muted); display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }
  .ph__fig-src { margin: auto 0 0; padding-top: 8px; border-top: 1px solid var(--_tokens---color--line); font-size: var(--_tokens---type--ultrathin); line-height: 1.4; color: var(--_tokens---color--muted); }
  .ph__fig-note { color: inherit; text-decoration: underline; text-underline-offset: 2px; }
  .ph__swatch { width: 9px; height: 9px; border-radius: 2px; display: inline-block; }
  .ph__waffle { display: grid; grid-template-columns: repeat(20, 1fr); gap: 3px; }
  .ph__waffle i { aspect-ratio: 1; border-radius: 2px; background: var(--ph-light); }
  .ph__waffle i.on { background: var(--ph-red); }
  .ph__fig-bars { display: grid; gap: 5px; }
