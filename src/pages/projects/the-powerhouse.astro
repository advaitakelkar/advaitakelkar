  .ph__ring-track { fill: none; stroke: color-mix(in srgb, var(--_tokens---color--fg) 8%, transparent); stroke-width: 14; }
  .ph__ring-seg { fill: none; stroke-width: 14; }
  .ph .r-red { stroke: var(--ph-red); } .ph .r-orange { stroke: var(--ph-orange); } .ph .r-yellow { stroke: var(--ph-yellow); } .ph .r-green { stroke: var(--ph-green); }
  .ph .r-teal { stroke: var(--ph-teal); } .ph .r-blue { stroke: var(--ph-blue); } .ph .r-grey { stroke: var(--ph-grey); } .ph .r-light { stroke: var(--ph-light); }
