  .ph__argument-path li { padding:12px;border-radius:0;border-color:var(--ph-panel-line);background:var(--ph-panel); }
  [data-chapter-group="ch1"] .ph__infig:not(#usa).ph__infig--civic > .ph__fig { grid-template-columns:minmax(0,1fr) minmax(0,2fr); }
  [data-chapter-group="ch1"] .ph__infig:not(#usa).ph__infig--civic .ph__fig-chips { display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px 22px; }
  [data-chapter-group="ch1"] .ph__infig:not(#usa).ph__infig--civic .ph__fig > .ph__fig-src { grid-column:1 / -1;grid-row:auto;padding-top:8px;border-top:1px solid var(--_tokens---color--line-soft); }
