  .ph__national-map { margin: 16px 0 24px; }
  .ph__national-svg { max-height: 52vh; width: 100%; overflow: visible; }
  .ph__national-data :global(.ph__chain-grid--map) { grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); grid-template-areas: none; }
  .ph__national-data :global(.ph__chain-row) { grid-area: auto; }
  .ph__national-data :global(.is-m) { display: none; }
  .ph__evidence-details { margin: 24px 0; }
  .ph__evidence-intro > p:last-child, .ph__conclusion p { font-size: var(--_tokens---type--micro); line-height: 1.65; }
  .ph__heading > h2 { font-size: var(--_tokens---type--medium); margin-bottom: 12px; }
  .ph__slide, .ph__state-detail { scroll-margin-top: calc(var(--ph-toc-h, 140px) + 68px); }
  .ph__nav { scroll-margin-top: calc(var(--ph-toc-h, 140px) + 68px); margin: var(--_tokens---space--micro) 0 var(--_tokens---space--small); }
  .ph__pager button { display: inline-flex; align-items: center; gap: 12px; min-height: 44px; padding: 8px 16px; border: 1px solid var(--_tokens---color--line); border-radius: var(--_tokens---radius--pill); font: inherit; font-size: var(--_tokens---type--micro); color: inherit; background: transparent; cursor: pointer; }
  .ph__slide { margin-bottom: var(--_tokens---space--medium); scroll-margin-top: 80px; }
  .ph__slide[hidden], .ph__pager[hidden] { display: none; }
  .ph__heading { margin-bottom: var(--_tokens---space--small); }
  .ph__kicker { font-size: var(--_tokens---type--micro); letter-spacing: .08em; text-transform: uppercase; color: var(--_tokens---color--muted); margin: 0 0 12px; }
  .ph h1 { font-size: clamp(2rem, 1.2rem + 3.2vw, 4.5rem); line-height: 1.05; letter-spacing: -.045em; font-weight: var(--_tokens---weight--base); margin: 0 0 16px; }
  .ph__heading > p:last-child { font-size: var(--_tokens---type--small); margin: 0; line-height: 1.45; }
  .ph h2 { font-size: var(--_tokens---type--small); font-weight: 500; line-height: 1.35; margin: 0; }
  .ph h3 { font-size: var(--_tokens---type--micro); font-weight: 600; margin: 0; }
  .ph__state-jump { color: inherit; text-decoration: none; border-bottom: 1px solid var(--_tokens---color--line); }
  .ph__split { display: grid; grid-template-columns: minmax(0, 1.65fr) minmax(0, 1.05fr); gap: var(--_tokens---space--small); align-items: start; }
  .ph__filters { display: flex; gap: 12px; flex-wrap: wrap; }
  .ph__filters label { display: grid; gap: 4px; font-size: var(--_tokens---type--micro); min-width: 0; max-width: 100%; }
  .ph select { font: inherit; color: inherit; background: var(--_tokens---color--bg); border: 1px solid var(--_tokens---color--line); border-radius: var(--_tokens---radius--small); min-height: 44px; padding: 8px 32px 8px 12px; max-width: 100%; }
  .ph__map { margin: 8px 0 0; }
  /* Zoomable maps (src/lib/powerhouse-map.ts): one canvas each, drawn in the page's own
     ink. The canvas, tip, hint and buttons are made in script, so their rules are global. */
  .ph__mapbox { position: relative; width: 100%; aspect-ratio: 16 / 10; min-height: 320px; border: 1px solid var(--_tokens---color--line); border-radius: var(--_tokens---radius--small); overflow: hidden; background: var(--_tokens---color--bg); touch-action: pan-y; }
  .ph__mapbox--city { aspect-ratio: 1 / 1; }
  /* State slides: three columns, the map large and unframed in the middle */
  .ph__tri { display: grid; grid-template-columns: minmax(13rem, 1fr) minmax(0, 2.6fr) minmax(13rem, 1fr); gap: var(--_tokens---space--small); align-items: start; }
  .ph__tri-side { display: grid; gap: 16px; min-width: 0; }
  /* Florida's map: centred, large, its filters a slim row above it */
  .ph__solo { display: grid; justify-items: center; gap: 12px; margin: 0; min-width: 0; }
  .ph__solo > * { min-width: 0; max-width: 100%; }
  .ph__solo-title { font-size: var(--_tokens---type--small); margin: 0; text-align: center; }
  .ph__solo-title b { font-weight: 600; }
  .ph__solo-title > span { color: var(--_tokens---color--muted); font-size: var(--_tokens---type--micro); }
  .ph__filters--row { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px 12px; width: 100%; }
  .ph__filters--row label { display: grid; gap: 4px; min-width: 0; }
  .ph__filters--row select { width: 100%; min-width: 0; }
  .ph__solo-map { margin: 0; width: 100%; }
  .ph__solo-map .ph__mapbox { aspect-ratio: 1 / 1; border: 0; border-radius: 0; }
  .ph__solo-map figcaption { justify-content: center; text-align: center; }
  .ph__tri-side .ph__filters { display: grid; }
  .ph__tri-side .ph__filters label, .ph__tri-side select { width: 100%; min-width: 0; }
  .ph__tri-map { margin: 0; }
  .ph__tri-map .ph__mapbox { aspect-ratio: 1 / 1; border: 0; border-radius: 0; min-height: 420px; }
  .ph__tri-map figcaption { justify-content: center; text-align: center; }
  @media (max-width: 1023.98px) {
    .ph__tri { grid-template-columns: minmax(0, 1fr); }
    .ph__tri-map { order: -1; }
  }
  /* Vector map (Florida): the file's print colours are overridden by layer, in site ink */
  .ph__mapbox :global(.ph-map--svg svg), .ph__mapbox:global(.ph-map--svg) :global(svg) { display: block; width: 100%; height: 100%; cursor: grab; }
  .ph__mapbox :global(svg path) { vector-effect: non-scaling-stroke; }
  .ph__mapbox :global(#land path) { fill: color-mix(in srgb, var(--_tokens---color--fg) 6%, var(--_tokens---color--bg)); }
  .ph__mapbox :global(#counties path) { stroke: color-mix(in srgb, var(--_tokens---color--fg) 18%, var(--_tokens---color--bg)); stroke-width: .5px; }
  .ph__mapbox :global(#roads-primary path) { stroke: color-mix(in srgb, var(--_tokens---color--fg) 30%, var(--_tokens---color--bg)); stroke-width: .6px; }
  .ph__mapbox :global(#roads-trunk path) { stroke: color-mix(in srgb, var(--_tokens---color--fg) 50%, var(--_tokens---color--bg)); stroke-width: .9px; }
  .ph__mapbox :global(#roads-motorway path) { stroke: color-mix(in srgb, var(--_tokens---color--fg) 78%, var(--_tokens---color--bg)); stroke-width: 1.4px; }
  .ph__mapbox :global(#outline path) { stroke: var(--_tokens---color--fg); stroke-width: 1px; }
  .ph__mapbox :global(#stations-other circle) { fill: var(--ph-orange); }
  .ph__mapbox :global(#stations-tesla circle) { fill: var(--ph-red); }
  .ph__mapbox :global(#stations-private circle) { stroke: var(--ph-blue); }
  .ph__mapbox :global(canvas) { display: block; cursor: grab; }
  .ph__mapbox :global(canvas:active) { cursor: grabbing; }
  .ph__mapbox :global(.ph-map__controls) { position: absolute; top: 10px; right: 10px; display: flex; gap: 4px; }
  .ph__mapbox :global(.ph-map__controls button) { min-width: 32px; height: 32px; padding: 0 10px; border: var(--_tokens---pill-border); border-radius: var(--_tokens---radius--pill); background: color-mix(in srgb, var(--_tokens---color--bg) 88%, transparent); color: var(--_tokens---color--fg); font: inherit; font-size: var(--_tokens---type--micro); cursor: pointer; }
  @media (hover: hover) { .ph__mapbox :global(.ph-map__controls button:hover) { background: color-mix(in srgb, var(--_tokens---color--fg) 12%, var(--_tokens---color--bg)); } }
  .ph__mapbox :global(.ph-map__tip) { position: absolute; z-index: 2; max-width: 220px; padding: 8px 10px; border: 1px solid var(--_tokens---color--line); border-radius: var(--_tokens---radius--small); background: var(--_tokens---color--bg); font-size: var(--_tokens---type--micro); line-height: 1.5; pointer-events: none; }
  .ph__mapbox :global(.ph-map__tip span) { color: var(--_tokens---color--muted); }
  .ph__mapbox :global(.ph-map__hint) { position: absolute; inset: 0; display: grid; place-items: center; background: color-mix(in srgb, var(--_tokens---color--bg) 72%, transparent); font-size: var(--_tokens---type--small); opacity: 0; pointer-events: none; transition: opacity var(--_tokens---motion--base); }
  .ph__mapbox :global(.ph-map__hint.is-on) { opacity: 1; }

  .ph__time-row { display: grid; grid-template-columns: 3.5em 1fr 13em; align-items: center; gap: 12px; font-size: var(--_tokens---type--micro); font-variant-numeric: tabular-nums; }
  .ph__time-row b { font-weight: 500; }

  /* Absolute numbers first: three steps read left to right */
  .ph__steps { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr)); gap: var(--_tokens---space--micro); margin: 0 0 var(--_tokens---space--small); }
  .ph__step { display: grid; gap: 4px; align-content: start; padding-top: 10px; border-top: 1px solid var(--_tokens---color--fg); }
  .ph__step span, .ph__step small { font-size: var(--_tokens---type--micro); color: var(--_tokens---color--muted); line-height: 1.45; }
  .ph__step small b { color: var(--_tokens---color--fg); font-weight: 600; }
  .ph__step strong { font-size: clamp(1.8rem, 1rem + 2.6vw, 3.4rem); font-weight: 400; letter-spacing: -.04em; line-height: 1.05; font-variant-numeric: tabular-nums; }

  /* The 2025–2040 chart: three panels, one shared time axis */
  .ph__panels { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr)); gap: var(--_tokens---space--micro); margin: 0 0 var(--_tokens---space--micro); }
  .ph__panel { min-width: 0; padding: 14px; border: 1px solid var(--_tokens---color--line); }
  .ph__panel h2 { margin-bottom: 8px !important; }
  .ph__panel p { font-size: var(--_tokens---type--micro); color: var(--_tokens---color--muted); margin: 6px 0 0; display: flex; gap: 12px; flex-wrap: wrap; }
  .ph__panels figcaption { grid-column: 1 / -1; font-size: var(--_tokens---type--micro); color: var(--_tokens---color--muted); line-height: 1.5; }
  .ph__grid { stroke: var(--_tokens---color--line); stroke-width: .6; stroke-dasharray: 2 3; }
  .ph__area { fill: color-mix(in srgb, var(--ph-red) 12%, transparent); }
  .ph__line { fill: none; stroke: var(--ph-red); stroke-width: 1.8; }
  .ph__pt { fill: var(--ph-red); }
  .ph__next { font-size: var(--_tokens---type--small); margin: var(--_tokens---space--micro) 0; }
  .ph__why-line { font-size: var(--_tokens---type--small); line-height: 1.55; max-width: 72ch; margin: var(--_tokens---space--small) 0 0; padding-top: 10px; border-top: 1px solid var(--_tokens---color--fg); }
  .ph__glossary { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr)); gap: 10px var(--_tokens---space--micro); margin: 0 0 var(--_tokens---space--small); font-size: var(--_tokens---type--micro); line-height: 1.45; }
  .ph__glossary div { padding-top: 6px; border-top: 1px solid var(--_tokens---color--line); }
  .ph__glossary dt { font-weight: 600; }
  .ph__glossary dd { margin: 2px 0 0; color: var(--_tokens---color--muted); }

  /* Every state, largest first, absolute numbers */
  .ph__rank { list-style: none; margin: 0; padding: 0; columns: 2; column-gap: 20px; font-size: 11px; font-variant-numeric: tabular-nums; }
  .ph__rank li { display: grid; grid-template-columns: 4.2em 1fr 4.4em; white-space: nowrap; align-items: center; gap: 6px; padding: 1px 0; break-inside: avoid; color: var(--_tokens---color--muted); }
  .ph__rank li b { font-weight: 400; text-align: right; }
  .ph__rank-track { height: 6px; background: color-mix(in srgb, var(--_tokens---color--fg) 6%, transparent); }
  .ph__rank-track i { display: block; height: 100%; min-width: 1px; background: var(--ph-light); }
  .ph__rank li.is-top { color: var(--_tokens---color--fg); }
  .ph__rank li.is-top b { font-weight: 600; }
  .ph__rank li.is-top .ph__rank-track i { background: var(--ph-red); }

  /* The bridge from the text to the evidence, and each state's role in the argument */
  .ph__evidence-intro { margin: var(--_tokens---space--small) 0; padding: var(--_tokens---space--micro) 0; border-top: 1px solid var(--_tokens---color--line); }
  .ph__evidence-intro p:not(.ph__kicker) { font-size: var(--_tokens---type--small); line-height: 1.6; margin: 0; max-width: 72ch; }
  .ph .ph__quote { font-size: var(--_tokens---type--small); font-style: italic; color: var(--_tokens---color--muted); margin: 0; }
  .ph .ph__quote span { font-style: normal; font-size: var(--_tokens---type--micro); }
  .ph__why { list-style: none; counter-reset: why; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr)); gap: var(--_tokens---space--micro); margin: 0 0 var(--_tokens---space--small); padding: 0; }
  .ph__why li { counter-increment: why; padding-top: 10px; border-top: 1px solid var(--_tokens---color--fg); font-size: var(--_tokens---type--micro); line-height: 1.55; }
  .ph__why li::before { content: counter(why, decimal-leading-zero); display: block; font-variant-numeric: tabular-nums; color: var(--_tokens---color--muted); margin-bottom: 4px; }
  .ph__why :global(b) { display: block; font-size: var(--_tokens---type--small); font-weight: 500; margin-bottom: 4px; }
  .ph__state-role { font-size: var(--_tokens---type--small); margin: 8px 0 12px; }
  .ph__conclusion { margin-top: var(--_tokens---space--small); padding-top: var(--_tokens---space--micro); border-top: 1px solid var(--_tokens---color--fg); }
  .ph__conclusion ol { margin: 12px 0 0; padding-left: 1.4em; display: grid; gap: 10px; font-size: var(--_tokens---type--small); line-height: 1.55; max-width: 80ch; }
  .ph__svg { display: block; width: 100%; height: auto; }
  .ph__land, .ph__land path { fill: color-mix(in srgb, var(--_tokens---color--fg) 5%, var(--_tokens---color--bg)); stroke: var(--_tokens---color--line); stroke-width: .6; }
  .ph__county path { fill: none; stroke: var(--_tokens---color--line); stroke-width: .28; }

  /* Vector road network styles */
  .ph__roads { pointer-events: none; }
  .ph__road-hwy { fill: none; stroke: var(--_tokens---color--fg); stroke-width: .38; opacity: .16; }
  .ph__road-int { fill: none; stroke: var(--_tokens---color--fg); stroke-width: .65; opacity: .32; }
  .ph__city .ph__road-hwy { stroke-width: .45; opacity: .20; }
  .ph__city .ph__road-int { stroke-width: .85; opacity: .36; }

  .ph .is-tesla { fill: var(--ph-accent); background: var(--ph-accent); opacity: .92; }
  .ph .is-other { fill: var(--ph-other); background: var(--ph-other); }
  .ph .is-phev { fill: var(--ph-phev); background: var(--ph-phev); }
  .ph .is-fuel { fill: var(--ph-fuel); background: var(--ph-fuel); }
  .ph__dots circle, .ph__state-dots circle { pointer-events: none; }
  .ph .is-filtered { display: none; }
  .ph .is-muted { opacity: .16; }

  .ph__map figcaption, .ph__legend { display: flex; gap: 8px 16px; flex-wrap: wrap; font-size: var(--_tokens---type--micro); color: var(--_tokens---color--muted); line-height: 1.5; margin-top: 8px; }
  .ph__key::before { content: ''; display: inline-block; width: 8px; height: 8px; margin-right: 6px; border-radius: 50%; background: var(--_tokens---color--fg); vertical-align: middle; }
  .ph__key--tesla::before { background: var(--ph-accent); }
  .ph__key--green::before { background: var(--ph-green); }
  .ph__key--teal::before { background: var(--ph-teal); }
  .ph .c-teal-fill { fill: var(--ph-teal); }
  .ph__key--other::before { background: var(--ph-other); }
  .ph__key--fuel::before { background: var(--ph-fuel); }
  .ph__key--phev::before { background: var(--ph-phev); }
  .ph__key--int::before { width: 14px; height: 2px; border-radius: 0; opacity: .55; }
  .ph__key--hwy::before { width: 14px; height: 1px; border-radius: 0; opacity: .3; }

  .ph__selection { display: flex; flex-wrap: wrap; gap: 8px 20px; justify-content: space-between; border-top: 1px solid var(--_tokens---color--line); padding-top: 12px; margin-top: 12px; font-size: var(--_tokens---type--micro); }
  .ph__summary { display: grid; gap: 16px; }
  .ph__metric { display: grid; gap: 4px; padding-bottom: 12px; border-bottom: 1px solid var(--_tokens---color--line); }
  .ph__metric > span, .ph__metric small, .ph__energy > span { font-size: var(--_tokens---type--micro); color: var(--_tokens---color--muted); }
  .ph__metric strong { font-size: clamp(1.8rem, 1rem + 2.6vw, 3.4rem); font-weight: 400; letter-spacing: -.04em; line-height: 1.08; font-variant-numeric: tabular-nums; }

  /* Visualizer cards & bars */
  .ph__viz-box { display: grid; gap: 10px; padding: 14px; border: 1px solid var(--_tokens---color--line); background: color-mix(in srgb, var(--_tokens---color--fg) 2%, transparent); }
  .ph__viz-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 24px; }
  .ph__viz-grid--one { grid-template-columns: minmax(0, 1fr); }
  .ph__viz-card { padding: 18px; border: 1px solid var(--_tokens---color--line); background: color-mix(in srgb, var(--_tokens---color--fg) 1.5%, transparent); min-width: 0; }
  .ph__viz-head { display: grid; gap: 4px; margin-bottom: 14px; }
  .ph__viz-head b { font-size: var(--_tokens---type--micro); font-weight: 600; }
  .ph__viz-head span { font-size: var(--_tokens---type--micro); color: var(--_tokens---color--muted); }
  .ph__stack-row { display: grid; gap: 5px; }
  .ph__stack-meta { display: flex; justify-content: space-between; gap: 8px; font-size: var(--_tokens---type--micro); font-variant-numeric: tabular-nums; }
  .ph__stack-meta b { font-weight: 500; }
  .ph__stack-bar { display: flex; height: 10px; overflow: hidden; background: color-mix(in srgb, var(--_tokens---color--fg) 8%, transparent); }
  .ph__stack-bar i { display: block; height: 100%; }

  /* Network & Borough horizontal bars */
  .ph__net-chart { display: grid; gap: 10px; }
  .ph__net-row { display: grid; gap: 4px; }
  .ph__net-label { display: flex; justify-content: space-between; font-size: var(--_tokens---type--micro); font-variant-numeric: tabular-nums; }
  .ph__net-label b { font-weight: 500; }
  .ph__net-label span { color: var(--_tokens---color--muted); }
  .ph__net-bar-track { display: flex; height: 9px; background: color-mix(in srgb, var(--_tokens---color--fg) 7%, transparent); overflow: hidden; }
  .ph__net-bar-track i { display: block; height: 100%; }
  .ph__net-states { display: flex; gap: 12px; font-size: 11px; color: var(--_tokens---color--muted); font-variant-numeric: tabular-nums; }

  .ph__svg-label { font-size: 9px; fill: var(--_tokens---color--muted); font-variant-numeric: tabular-nums; }
  .ph__svg-val { font-size: 9.5px; font-weight: 600; fill: var(--_tokens---color--fg); font-variant-numeric: tabular-nums; }

  /* 6-Metric State Dashboard */
  .ph__metric-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
  .ph__mcard { display: grid; gap: 8px; padding: 12px; border: 1px solid var(--_tokens---color--line); background: var(--_tokens---color--bg); }
  .ph__mcard-title { font-size: var(--_tokens---type--micro); font-weight: 500; padding-bottom: 6px; border-bottom: 1px solid var(--_tokens---color--line); }
  .ph__mrow { display: grid; grid-template-columns: 26px 1fr auto; align-items: center; gap: 8px; font-size: var(--_tokens---type--micro); font-variant-numeric: tabular-nums; }
  .ph__mcode { color: var(--_tokens---color--muted); font-weight: 500; }
  .ph__mtrack { height: 8px; background: color-mix(in srgb, var(--_tokens---color--fg) 8%, transparent); overflow: hidden; }
  .ph__mtrack i { display: block; height: 100%; }
  .ph__mval { font-weight: 400; text-align: right; }

  .ph__boro-row { display: grid; gap: 5px; padding: 4px 0; }
  .ph__boro-meta { display: flex; justify-content: space-between; gap: 8px; font-size: var(--_tokens---type--micro); font-variant-numeric: tabular-nums; }
  .ph__boro-meta b { font-weight: 500; }
  .ph__boro-meta span { color: var(--_tokens---color--muted); }
  .ph__gauge-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }

  /* Slide 05 Shift Chart */
  .ph__shift-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
  .ph__shift-card { display: grid; gap: 12px; padding: 12px; border: 1px solid var(--_tokens---color--line); background: var(--_tokens---color--bg); }
  .ph__shift-head { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; padding-bottom: 6px; border-bottom: 1px solid var(--_tokens---color--line); }
  .ph__shift-head span { font-size: 11px; color: var(--_tokens---color--muted); }
  .ph__shift-row { display: grid; gap: 5px; }
  .ph__shift-track { height: 14px; background: color-mix(in srgb, var(--_tokens---color--fg) 5%, transparent); }
  .ph__shift-bar { display: flex; height: 100%; overflow: hidden; }
  .ph__shift-bar i { display: block; height: 100%; }

  .ph__bar-label { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; font-size: var(--_tokens---type--micro); }
  .ph__bar-label b { font-weight: 400; }
  .ph__bar-label strong { font-size: var(--_tokens---type--small); font-weight: 500; }
  .ph__bar { height: 8px; overflow: hidden; background: color-mix(in srgb, var(--_tokens---color--fg) 12%, transparent); }
  .ph__fill { display: block; height: 100%; background: var(--_tokens---color--fg); }
  .ph__fill--tesla { background: var(--ph-accent); }
  .ph__note { font-size: var(--_tokens---type--micro); color: var(--_tokens---color--muted); line-height: 1.55; margin: 8px 0 0; }
  .ph__energy { display: grid; gap: 6px; border-left: 2px solid var(--ph-accent); padding: 0 0 0 14px; }
  .ph__energy strong { font-size: var(--_tokens---type--medium); font-weight: 400; letter-spacing: -.03em; font-variant-numeric: tabular-nums; }
  .ph__energy p { font-size: var(--_tokens---type--micro); line-height: 1.55; margin: 0; }
  .ph__table-wrap { overflow-x: auto; max-width: 100%; margin-top: 20px; }
  .ph table { border-collapse: collapse; width: 100%; font-size: var(--_tokens---type--micro); font-variant-numeric: tabular-nums; }
  .ph caption { text-align: left; font-weight: 500; padding-bottom: 10px; }
  .ph th, .ph td { text-align: right; padding: 10px 12px; border-bottom: 1px solid var(--_tokens---color--line); white-space: nowrap; vertical-align: top; }
  .ph th { font-weight: 500; }
  .ph thead th { color: var(--_tokens---color--muted); font-weight: 400; }
  .ph tr > :first-child { text-align: left; padding-left: 0; }
  .ph__details { margin: 20px 0; border-top: 1px solid var(--_tokens---color--line); border-bottom: 1px solid var(--_tokens---color--line); }
  .ph__details summary { padding: 16px 0; min-height: 44px; font-size: var(--_tokens---type--micro); font-weight: 500; cursor: pointer; }
  .ph__details[open] { padding-bottom: 20px; }
  .ph__definitions { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
  .ph__definitions p { font-size: var(--_tokens---type--micro); line-height: 1.6; margin: 0; }
  .ph__sources { font-size: var(--_tokens---type--micro); line-height: 1.7; color: var(--_tokens---color--muted); margin-top: 20px; }
  .ph__sources a { text-decoration: underline; text-underline-offset: 3px; }
  .ph__state-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  .ph__state-title { display: flex; align-items: baseline; gap: 12px; }
  .ph__state-title > span { font-size: var(--_tokens---type--micro); color: var(--_tokens---color--muted); }
  .ph__state-card { border-top: 1px solid var(--_tokens---color--line); padding-top: 12px; min-width: 0; }
  .ph__state-map { margin: 12px 0; }
  .ph__state-number { font-size: var(--_tokens---type--medium); letter-spacing: -.03em; font-variant-numeric: tabular-nums; margin-bottom: 12px; }
  .ph__state-number span { font-size: var(--_tokens---type--micro); letter-spacing: 0; margin-left: 8px; color: var(--_tokens---color--muted); }
  .ph__ny-grid { display: grid; grid-template-columns: 1fr 1.1fr; gap: 24px; }
  .ph__ny-copy { display: grid; align-content: start; gap: 18px; }
  .ph__ny-copy .ph__table-wrap { margin: 0; }
  .ph__city { max-height: 560px; }
  .ph__city circle { stroke: var(--_tokens---color--bg); stroke-width: .4; }
  .ph__timeline { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; border-top: 1px solid var(--_tokens---color--line); padding-top: 16px; }
  .ph__timeline span { display: grid; gap: 6px; font-size: var(--_tokens---type--micro); color: var(--_tokens---color--muted); }
  .ph__timeline b { font-size: var(--_tokens---type--medium); font-weight: 400; color: var(--_tokens---color--fg); }
  .ph__warning { font-size: var(--_tokens---type--micro); line-height: 1.6; border-left: 2px solid var(--ph-accent); padding-left: 12px; margin: 20px 0 0; max-width: 70rem; }
  .ph__growth td { text-align: left; min-width: 190px; }
  .ph__growth td > strong { display: block; font-size: var(--_tokens---type--medium); font-weight: 400; letter-spacing: -.03em; margin-bottom: 8px; }
  .ph__growth td > span, .ph__growth td > small { display: block; margin: 4px 0; }
  .ph__growth td > small { max-width: 20rem; white-space: normal; line-height: 1.5; color: var(--_tokens---color--muted); font-size: var(--_tokens---type--micro); }
  .ph__projection { background: color-mix(in srgb, var(--_tokens---color--fg) 3%, transparent); }
  .ph__mix { display: flex; height: 8px; margin-top: 12px; background: color-mix(in srgb, var(--_tokens---color--fg) 6%, transparent); }
  .ph__mix i { height: 100%; background: color-mix(in srgb, var(--_tokens---color--fg) 25%, transparent); }
  .ph__growth-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; margin: 24px 0; }
  .ph__growth-rate { font-size: var(--_tokens---type--medium); margin: 12px 0; }
  .ph__growth-rate span { display: block; font-size: var(--_tokens---type--micro); color: var(--_tokens---color--muted); margin-top: 4px; }
  .ph__history > div { display: grid; grid-template-columns: 34px 1fr 90px; align-items: center; gap: 8px; margin: 10px 0; font-size: var(--_tokens---type--micro); font-variant-numeric: tabular-nums; }
  .ph__history b { font-weight: 400; text-align: right; }
  .ph__track { height: 6px; background: color-mix(in srgb, var(--_tokens---color--fg) 8%, transparent); }
  .ph__track i { display: block; height: 100%; background: var(--ph-accent); }
  .ph__pager { display: flex; justify-content: space-between; align-items: center; gap: 16px; border-top: 1px solid var(--_tokens---color--line); padding-top: 20px; font-size: var(--_tokens---type--micro); }
  .ph__pager button:disabled { opacity: .35; cursor: default; }
  .ph :is(a, button, select, summary):focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }

  @media (max-width: 1023.98px) {
    .ph { padding-top: 24px; }
    .ph__split, .ph__ny-grid, .ph__viz-grid, .ph__metric-grid, .ph__shift-grid { grid-template-columns: 1fr; }
    .ph__summary { grid-template-columns: 1fr 1fr; }
    .ph__summary > .ph__viz-box, .ph__summary > .ph__energy { grid-column: 1 / -1; }
    .ph__definitions { grid-template-columns: 1fr; }
  }
  @media (max-width: 699.98px) {
    .ph__state-grid, .ph__growth-grid, .ph__gauge-grid, .ph__summary { grid-template-columns: 1fr; }
    .ph__state-map { max-height: 220px; }
    .ph__timeline { gap: 10px; }
    .ph__timeline span { font-size: 12px; }
    .ph__header { gap: 8px; }
    .ph__brand span { display: block; }
    .ph__nav { gap: 6px; }
    .ph__nav a { padding: 8px 10px; gap: 6px; }
    .ph th, .ph td { padding: 10px 8px; }
    .ph__growth td { min-width: 180px; }
  }

  /* 90% Screen Lightbox Modal for the Obsidian-style Citation, Notes & Bibliography Mindmap */
  .ph__mm-lightbox {
    position: fixed;
    inset: 0;
    z-index: 120;
    display: grid;
    place-items: center;
    padding: 4dvh 4vw;
    box-sizing: border-box;
  }
  .ph__mm-lightbox[hidden] {
    display: none;
  }
  .ph__mm-backdrop {
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--_tokens---color--bg) 82%, transparent);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
  }
  .ph__mm-dialog {
    position: relative;
    z-index: 1;
    width: min(90vw, 1620px);
    height: 90dvh;
    display: grid;
    grid-template-rows: auto auto minmax(0, 1fr);
    gap: 10px;
    padding: 16px 20px;
    box-sizing: border-box;
    background: var(--_tokens---color--bg);
    border: 1px solid var(--_tokens---color--line);
    box-shadow: 0 28px 80px -20px color-mix(in srgb, var(--_tokens---color--fg) 28%, transparent);
    overflow: hidden;
  }
  .ph__mm-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--_tokens---color--line);
    font-size: var(--_tokens---type--micro);
  }
  .ph__mm-head-left {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }
  .ph__mm-head-left strong {
    font-size: var(--_tokens---type--small);
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .ph__mm-stats {
    color: var(--_tokens---color--muted);
    font-variant-numeric: tabular-nums;
  }
  .ph__mm-close {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 32px;
    padding: 4px 12px;
    border: var(--_tokens---pill-border);
    border-radius: var(--_tokens---radius--pill);
    background-color: color-mix(in srgb, var(--_tokens---color--fg) 6%, transparent);
    color: var(--_tokens---color--fg);
    font: inherit;
    font-size: var(--_tokens---type--micro);
    cursor: pointer;
  }
  .ph__mm-close span {
    color: var(--_tokens---color--muted);
  }
  .ph__mm-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
    padding: 8px 12px;
    background-color: color-mix(in srgb, var(--_tokens---color--fg) 2.5%, var(--_tokens---color--bg));
    border: 1px solid var(--_tokens---color--line);
  }
  .ph__mm-search-wrap {
    flex: 1 1 16rem;
    min-width: 0;
  }
  .ph__mm-search {
    width: 100%;
    min-height: 32px;
    padding: 5px 12px;
    border: 1px solid var(--_tokens---color--line);
    border-radius: var(--_tokens---radius--pill);
    background: var(--_tokens---color--bg);
    color: var(--_tokens---color--fg);
    font: inherit;
    font-size: var(--_tokens---type--micro);
  }
  .ph__mm-search::placeholder {
    color: var(--_tokens---color--muted);
  }
  .ph__mm-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .ph__mm-pills button,
  .ph__mm-sidetabs button,
  .ph__mm-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-height: 30px;
    padding: 4px 11px;
    border: var(--_tokens---pill-border);
    border-radius: var(--_tokens---radius--pill);
    background-color: color-mix(in srgb, var(--_tokens---color--fg) 6%, transparent);
    color: var(--_tokens---color--muted);
    font: inherit;
    font-size: var(--_tokens---type--micro);
    line-height: 1.2;
    cursor: pointer;
    transition: background-color var(--_tokens---motion--base), color var(--_tokens---motion--base), border-color var(--_tokens---motion--base);
  }
  .ph__mm-pills button[aria-pressed='true'],
  .ph__mm-sidetabs button[aria-pressed='true'],
  .ph__mm-btn--primary {
    background-color: var(--_tokens---color--fg);
    border-color: var(--_tokens---color--fg);
    color: var(--_tokens---color--bg);
  }
  @media (hover: hover) {
    .ph__mm-pills button:hover,
    .ph__mm-sidetabs button:hover,
    .ph__mm-btn:hover,
    .ph__mm-close:hover {
      background-color: color-mix(in srgb, var(--_tokens---color--fg) 14%, transparent);
      color: var(--_tokens---color--fg);
    }
    .ph__mm-pills button[aria-pressed='true']:hover,
    .ph__mm-sidetabs button[aria-pressed='true']:hover,
    .ph__mm-btn--primary:hover {
      background-color: var(--_tokens---color--fg);
      color: var(--_tokens---color--bg);
    }
  }
  .ph__mm-workspace {
    display: grid;
    grid-template-columns: minmax(0, 1.95fr) minmax(19rem, 0.9fr);
    gap: 12px;
    min-height: 0;
    height: 100%;
  }
  .ph__mm-stage {
    position: relative;
    min-height: 0;
    height: 100%;
    border: 1px solid var(--_tokens---color--line);
    background-color: color-mix(in srgb, var(--_tokens---color--fg) 1.5%, var(--_tokens---color--bg));
    overflow: hidden;
  }
  .ph__mm-canvas {
    display: block;
    width: 100%;
    height: 100%;
    touch-action: none;
  }
  .ph__mm-controls {
    position: absolute;
    top: 12px;
    right: 12px;
    display: flex;
    gap: 4px;
    z-index: 2;
  }
  .ph__mm-controls button {
    min-width: 32px;
    height: 32px;
    padding: 0 10px;
    border: var(--_tokens---pill-border);
    border-radius: var(--_tokens---radius--pill);
    background: color-mix(in srgb, var(--_tokens---color--bg) 88%, transparent);
    color: var(--_tokens---color--fg);
    font: inherit;
    font-size: var(--_tokens---type--micro);
    cursor: pointer;
  }
  .ph__mm-legend {
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 10px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 14px;
    padding: 6px 10px;
    background: color-mix(in srgb, var(--_tokens---color--bg) 86%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid var(--_tokens---color--line);
    font-size: 11px;
    color: var(--_tokens---color--muted);
    pointer-events: none;
  }
  .ph__mm-legend span {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }
  .ph__mm-hint {
    margin-left: auto;
  }
  .ph__mm-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }
  .ph__mm-dot--core { background: var(--_tokens---color--fg); }
  .ph__mm-dot--chapter { background: var(--_tokens---color--fg); }
  .ph__mm-dot--typology { background: var(--ph-red); }
  .ph__mm-dot--sustainability { background: var(--ph-green); }
  .ph__mm-dot--phenomenology { background: var(--ph-teal); }
  .ph__mm-dot--social { background: var(--ph-blue); }
  .ph__mm-dot--fleets { background: var(--ph-orange); }


  /* References are one continuous view: notes and sources paired by chapter. */
  .ph__references { padding: 12px 20px 40px; scroll-margin-top: calc(var(--ph-toc-h, 140px) + 80px); }
  .ph__references-top p { margin: 0 0 32px; font-size: 13px; color: var(--_tokens---color--muted); }
  .ph__reference-chapter { padding: 28px 0 36px; border-top: 1px solid var(--_tokens---color--line); scroll-margin-top: calc(var(--ph-toc-h, 140px) + 80px); }
  .ph__reference-chapter h3 { font-size: clamp(1.25rem, 1.1rem + .5vw, 1.6rem); font-weight: 500; line-height: 1.3; margin: 0 0 28px; }
  .ph__reference-pair { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--ph-reading-gap); align-items: start; }
  .ph__reference-pair > div { min-width: 0; }
  .ph__reference-pair h4 { margin: 0 0 18px; font-size: 11px; font-weight: 500; color: var(--_tokens---color--muted); }
  .ph__references :is(.ph__notes-list, .ph__bib-list) { columns: 1; font-size: 12px; line-height: 1.65; }
  .ph__references :is(.ph__notes-list, .ph__bib-list) li { margin-bottom: 16px; }
  .ph__reference-additional .ph__bib-list { columns: 2; column-gap: var(--ph-reading-gap); }
  .ph__references :is([id^="bib-"], [id^="s-5-"]) { scroll-margin-top: calc(var(--ph-toc-h, 140px) + 80px); }
  @media (max-width: 699.98px) {
    .ph__references { padding-inline: 0; }
    .ph__reference-pair { grid-template-columns: minmax(0, 1fr); gap: 28px; }
    .ph__reference-additional .ph__bib-list { columns: 1; }
  }

  /* A shared, quiet reading surface for the two completed chapters. */
  :is([data-chapter-group="ch1"], [data-chapter-group="ch2"], [data-chapter-group="ch3"], [data-chapter-group="ch4"]) .ph__fold {
    background: transparent; box-shadow: none; padding-inline: 20px;
  }
  :is([data-chapter-group="ch1"], [data-chapter-group="ch2"], [data-chapter-group="ch3"], [data-chapter-group="ch4"]) .ph__fold-meta,
  :is([data-chapter-group="ch1"], [data-chapter-group="ch2"], [data-chapter-group="ch3"], [data-chapter-group="ch4"]) .ph__book-running-foot { display: none; }
  :is([data-chapter-group="ch1"], [data-chapter-group="ch2"], [data-chapter-group="ch3"], [data-chapter-group="ch4"]) .ph__fold-title {
    font-size: clamp(1.3rem, 1.05rem + .6vw, 1.7rem); line-height: 1.25; white-space: normal; overflow: visible;
  }
  .ph__chapter-number { font-size: 11px; font-weight: 400; line-height: 1; vertical-align: super; margin-left: 9px; letter-spacing: .02em; color: var(--_tokens---color--muted); }
  .ph__ch-title .ph__chapter-number { position: relative; top: -.5em; }
  .ph__section-number { display: inline-block; margin-right: 14px; font-size: 12px; font-weight: 400; letter-spacing: .02em; color: var(--_tokens---color--muted); vertical-align: .18em; }
  .ph__argument-path { list-style: none; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; padding: 0; margin: 12px 0 36px; }
  .ph__argument-path li { position: relative; display: grid; align-content: start; gap: 8px; padding: 20px; border: 1px solid color-mix(in srgb, var(--_tokens---color--fg) 16%, var(--_tokens---color--bg)); border-radius: 6px; background: color-mix(in srgb, var(--_tokens---color--fg) 4%, var(--_tokens---color--bg)); font-size: 14px; line-height: 1.4; }
  .ph__argument-path li span { color: var(--_tokens---color--muted); font-size: 10px; }
  .ph__argument-path li:not(:last-child)::after { content: '→'; position: absolute; right: -25px; top: 50%; transform: translateY(-50%); font-size: 21px; color: var(--_tokens---color--muted); }
  :is([data-chapter-group="ch1"], [data-chapter-group="ch2"], [data-chapter-group="ch3"], [data-chapter-group="ch4"]) .ph__book-running-head { border: 0; padding-top: 8px; margin-bottom: 26px; letter-spacing: .035em; font-size: 10px; }
  :is([data-chapter-group="ch1"], [data-chapter-group="ch2"], [data-chapter-group="ch3"], [data-chapter-group="ch4"]) .ph__book-running-head span:last-child { display: none; }
  @media (max-width: 699.98px) {
    .ph { --ph-reading-gap: 24px; }
    .ph__ch-title { font-size: 27px; }
    :is([data-chapter-group="ch1"], [data-chapter-group="ch2"], [data-chapter-group="ch3"], [data-chapter-group="ch4"]) .ph__fold { padding-inline: 0; }
    .ph__argument-path { grid-template-columns: minmax(0, 1fr); gap: 24px; }
    .ph__argument-path li { padding: 16px; font-size: 14px; }
    .ph__argument-path li:not(:last-child)::after { content: '↓'; right: auto; left: 50%; top: auto; bottom: -24px; transform: translateX(-50%); font-size: 17px; }
  }


  /* Prose owns the columns; single diagrams sit in compact rows between passages. */
  [data-chapter-group="ch1"] .ph__read-unit > .ph__infig { width: 100%; margin: 0; }
  [data-chapter-group="ch1"] .ph__infig:not(#usa) > .ph__fig { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--ph-col-gap); align-items: start; }
  [data-chapter-group="ch1"] .ph__infig:not(#usa) .ph__fig > figcaption { grid-column: 1; grid-row: 1; }
  [data-chapter-group="ch1"] .ph__infig:not(#usa) .ph__fig > :is(.ph__fig-bars, .ph__fig-chips, .ph__rings) { grid-column: 2; grid-row: 1 / span 3; }
  [data-chapter-group="ch1"] .ph__infig:not(#usa) .ph__fig > p { grid-column: 1; }
  [data-chapter-group="ch1"] #usa { grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: 20px var(--ph-col-gap); }
  [data-chapter-group="ch1"] #usa > :is(.ph__fig-header, .ph__map-bar, .ph__fig-key, .ph__fig-src) { grid-column: 1 / -1; }
  [data-chapter-group="ch1"] #usa .ph__map-bar { display: flex; justify-content: space-between; align-items: start; gap: 24px; }
  [data-chapter-group="ch1"] #usa .ph__map-bar p { margin: 0; }
  [data-chapter-group="ch1"] #usa .ph__national-map { grid-column: 1; margin: 0; }
  [data-chapter-group="ch1"] #usa .ph__ranklist { grid-column: 2; min-width: 0; }
  [data-chapter-group="ch1"] #usa .ph__top5 { max-height: 290px; }
  [data-chapter-group="ch1"] .ph__read-text { orphans: 3; widows: 3; }
  @media (max-width: 699.98px) {
    [data-chapter-group="ch1"] #usa, [data-chapter-group="ch1"] .ph__infig:not(#usa) > .ph__fig { grid-template-columns: minmax(0, 1fr); }
    [data-chapter-group="ch1"] #usa .ph__map-bar { flex-direction: column; gap: 12px; }
    [data-chapter-group="ch1"] #usa > :is(.ph__national-map, .ph__ranklist) { grid-column: 1; grid-row: auto; }
    [data-chapter-group="ch1"] .ph__infig:not(#usa) .ph__fig > :is(figcaption, .ph__fig-bars, .ph__fig-chips, .ph__rings, p) { grid-column: 1; grid-row: auto; }
  }


  /* Shared figure language: open paper surface, fine rule, readable data and quiet sources. */
  [data-chapter-group="ch1"] :is(.ph__figrow, .ph__infig) { padding-top: 20px; border-top: 1px solid var(--_tokens---color--line-soft); background: transparent; }
  [data-chapter-group="ch1"] .ph__fig-header { gap: 12px; align-items: baseline; }
  [data-chapter-group="ch1"] .ph__fig-tag { font-size: 10px; letter-spacing: .08em; text-transform: uppercase; }
  [data-chapter-group="ch1"] .ph__fig-title { font-size: var(--_tokens---type--micro); }
  [data-chapter-group="ch1"] .ph__fig-num { font-weight: 600; }
  [data-chapter-group="ch1"] .ph__fig figcaption > span { color: var(--_tokens---color--fg); }
  [data-chapter-group="ch1"] .ph__fig-src { opacity: 1; line-height: 1.5; }
  [data-chapter-group="ch1"] :is(.ph__fig-bar, .ph__waffle i, .ph__fig-units i) { border-radius: 1px; }
  [data-chapter-group="ch1"] .ph__fig-bars { gap: 12px; }
  [data-chapter-group="ch1"] .ph__fig-bars > div > span { margin-bottom: 5px; }
  [data-chapter-group="ch1"] .ph__fig-chips { gap: 8px 16px; }
  [data-chapter-group="ch1"] .ph__fig-chips i { border-radius: 0; padding: 4px 0 4px 9px; background: transparent; border-left: 3px solid var(--ph-grey); font-size: var(--_tokens---type--micro); color: var(--_tokens---color--fg); }
  [data-chapter-group="ch1"] .ph__fig-chips .c-teal { border-color: var(--ph-teal); }
  [data-chapter-group="ch1"] .ph__fig-chips .c-orange { border-color: var(--ph-orange); }
  [data-chapter-group="ch1"] .ph__rings { margin: 0; }
  [data-chapter-group="ch1"] .ph__rings-ring { border: 1px solid color-mix(in srgb, var(--ring) 65%, var(--_tokens---color--line-soft)); border-radius: 2px; background: transparent; padding: 10px; }
  [data-chapter-group="ch1"] .ph__rings-ring p { color: var(--_tokens---color--fg); }
  [data-chapter-group="ch1"] .ph__rings-core { border-radius: 1px; background: var(--_tokens---color--fg); color: var(--_tokens---color--bg, #fff); }
  [data-chapter-group="ch1"] .ph__lens i { border-radius: 0; padding: 0; background: transparent; color: var(--_tokens---color--muted); letter-spacing: .04em; }
  [data-chapter-group="ch1"] .ph__lens { border-left: 1px solid var(--_tokens---color--line-soft); padding-left: 14px; gap: 10px; }
  [data-chapter-group="ch1"] .ph__fig-note:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }

  /* One panel treatment for every figure, diagram and table in the reading chapters. */
  [data-chapter-group="ch1"] :is(.ph__figrow, .ph__infig) {
    box-sizing: border-box; width: 100%; padding: 24px;
