  /* 1.5: the network around the charger, nested by length of stay, charger at the core */
  .ph__rings { margin: 12px 0 10px; }
  .ph__rings-ring { padding: 8px 10px 10px; border: 1px solid var(--ring); border-radius: 22px; background: color-mix(in srgb, var(--ring) 14%, transparent); }
  .ph__rings-ring p { margin: 0 0 8px; font-size: var(--_tokens---type--micro); line-height: 1.3; text-align: center; color: var(--_tokens---color--muted); }
  .ph__rings-ring p b { color: var(--_tokens---color--fg); font-weight: 600; }
  .ph__rings-core { padding: 10px; border-radius: 999px; background: var(--ph-red); color: #fff; font-size: var(--_tokens---type--micro); font-weight: 600; text-align: center; }
