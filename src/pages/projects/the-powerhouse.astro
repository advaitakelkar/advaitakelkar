  [data-chapter-group="ch1"] .ph__figrow:has(> .ph__statement) { padding:12px;border:1px solid var(--ph-panel-line);background:var(--ph-panel); }
  [data-chapter-group="ch1"] .ph__lens { border-left:1px solid var(--ph-panel-line); }
  [data-chapter-group="ch1"] .ph__fig-num { font-size:clamp(1.5rem,2.4vw,2rem);font-weight:700;line-height:1.12; }
