---
// The entrance to Virtual Gods. archv.in's animated circle is the door —
// every rotating work leads to its world or pair — and below it the whole
// making, one stage at a time: one person in 2D, one person in 3D, two
// people, four people, the final artwork. Every picture leads on.
import { getEntry } from 'astro:content';
import ExhibitionLayout from '../../layouts/ExhibitionLayout.astro';
import VGHub from '../../components/VGHub.astro';
import VGExhibitionStyles from '../../components/VGExhibitionStyles.astro';
import { publicFileExists } from '../../lib/content';
import { PAIR, worldHref, pairHref, stageOf, isPersons, isPairsFusion } from '../../lib/vg';

const ex = await getEntry('exhibitions', 'virtual-gods');
const data = ex!.data;
const vg = (rel: string) => `/images/virtual-gods/vg/${rel}`;

const everyone: any[] = [];
const pairs: any[] = [];
for (const q of data.quadrants) {
  for (const p of q.pairs) {
    const g: string[] = p.gallery ?? [];
    for (const m of p.members) {
      const gif = g.find(x => stageOf(x) === 'module' && isPersons(x, m.name));
      const video = !gif && m.module && publicFileExists(vg(`modules/${m.module}.mp4`)) ? vg(`modules/${m.module}.mp4`) : null;
      everyone.push({ m, q, p, illustration: g.find(x => stageOf(x) === 'illustration' && isPersons(x, m.name)), gif, video });
    }
    pairs.push({ q, p, fusion: (q.gallery ?? []).find((x: string) => isPairsFusion(x, p.members)) });
  }
}
// A world's picture: its evolution GIF where it has one, else its tile from
// the archv.in hub (VG01 is 9R.gif … VG04 is 12R.gif).
const HUB_TILE: Record<string, string> = { VG01: '9R.gif', VG02: '10R.gif', VG03: '11R.gif', VG04: '12R.gif' };
const worlds = data.quadrants.map((q: any) => ({
  q,
  src: (q.gallery ?? []).find((x: string) => /Evolution/i.test(x))
    ?? (data.gallery ?? []).find((x: string) => x.endsWith('_' + HUB_TILE[q.number])),
}));
const finalArt = data.quadrants.flatMap((q: any) => (q.renders ?? []).map((r: string) => ({ q, src: vg(`posters/${r}.webp`) })))
  .filter((x: any) => publicFileExists(x.src));
---

<ExhibitionLayout
  title="Virtual Gods"
  description="India's first online group art exhibition. Sixteen participants, sixteen architects, four surreal worlds — ARCHV, 2020."
>
  <VGExhibitionStyles />
  <div class="vge">
    <section class="vge-entrance">
      <header class="vge-head">
        <p class="vge-kicker">2020 · ARCHV Collective · live 1–31 August 2020</p>
        <h1 class="vge-title">Virtual Gods</h1>
        <p class="vge-lead">{data.tagline}</p>
        <div class="vge-prose">{(data.intro ?? []).map((p: string) => <p>{p}</p>)}</div>
        <p class="vge-stage__sub">Every rotating work opens its world or its pair.</p>
      </header>
      <VGHub />
    </section>

    <section class="vge-stage">
      <div class="vge-stage__head"><span class="vge-stage__n">01</span><h2 class="vge-stage__title">One person, in 2D</h2></div>
      <p class="vge-stage__sub">Each participant was handed an architect and drew them — the Scarpin’ illustrations the exhibition grew from.</p>
      <div class="vge-grid" style="--cols:4;--cols-sm:2">
        {everyone.filter(x => x.illustration).map(x => (
          <figure><a href={pairHref(x.q.slug, x.p.slug)}>
            <img class="vge-work vge-work--photo" src={x.illustration} alt={`${x.m.architect}, by ${x.m.name}`} loading="lazy" style="--ratio:4/5" />
            <figcaption><strong>{x.m.name}</strong>{x.m.architect}</figcaption>
          </a></figure>
        ))}
      </div>
    </section>

    <section class="vge-stage">
      <div class="vge-stage__head"><span class="vge-stage__n">02</span><h2 class="vge-stage__title">One person, in 3D</h2></div>
      <p class="vge-stage__sub">Then distilled that architect into a single module.</p>
      <div class="vge-grid" style="--cols:4;--cols-sm:2">
        {everyone.map(x => (
          <figure><a href={pairHref(x.q.slug, x.p.slug)}>
            {x.gif
              ? <img class="vge-work" src={x.gif} alt={`${x.m.name}'s module`} loading="lazy" />
              : <video class="vge-work" src={x.video} autoplay muted loop playsinline preload="metadata"></video>}
            <figcaption><strong>{x.m.name}</strong>{x.m.architect}</figcaption>
          </a></figure>
        ))}
      </div>
    </section>

    <section class="vge-stage">
      <div class="vge-stage__head"><span class="vge-stage__n">03</span><h2 class="vge-stage__title">Two people</h2></div>
      <p class="vge-stage__sub">Each pair merged their two modules into one form, keeping both ideologies intact.</p>
      <div class="vge-grid" style="--cols:4;--cols-sm:2">
        {pairs.map(x => (
          <figure><a href={pairHref(x.q.slug, x.p.slug)}>
            {x.fusion
              ? <img class="vge-work" src={x.fusion} alt={PAIR[x.p.slug].title} loading="lazy" />
              : <video class="vge-work" src={vg(`mergers/${x.p.slug}.mp4`)} autoplay muted loop playsinline preload="metadata"></video>}
            <figcaption><strong>{PAIR[x.p.slug].title}</strong>{x.p.members.map((m: any) => m.name).join(' and ')}</figcaption>
          </a></figure>
        ))}
      </div>
    </section>

    <section class="vge-stage">
      <div class="vge-stage__head"><span class="vge-stage__n">04</span><h2 class="vge-stage__title">Four people</h2></div>
      <p class="vge-stage__sub">Each group merged its two pairs into a surreal 3D world.</p>
      <div class="vge-grid" style="--cols:4;--cols-sm:2">
        {worlds.map((x: any) => (
          <figure><a href={worldHref(x.q.slug)}>
            {x.src ? <img class="vge-work" src={x.src} alt={x.q.number} loading="lazy" /> : <div class="vge-work"></div>}
            <figcaption><strong>{x.q.number}</strong>{x.q.architects.join(' × ')}</figcaption>
          </a></figure>
        ))}
      </div>
    </section>

    {finalArt.length > 0 && (
      <section class="vge-stage">
        <div class="vge-stage__head"><span class="vge-stage__n">05</span><h2 class="vge-stage__title">The final artwork</h2></div>
        <div class="vge-grid" style="--cols:4;--cols-sm:2">
          {finalArt.map((x: any) => (
            <figure><a href={worldHref(x.q.slug)}><img class="vge-work vge-work--photo" src={x.src} alt={`${x.q.number}, render`} loading="lazy" /><figcaption>{x.q.number}</figcaption></a></figure>
          ))}
        </div>
      </section>
    )}

    <section class="vge-stage">
      <div class="vge-stage__head"><span class="vge-stage__n">—</span><h2 class="vge-stage__title">Credits</h2></div>
      <ul class="vge-pills" aria-label="Inspired by">
        {['WeSpinSpaces', 'Sanchit Sawaria', 'iHeartBlob', 'Oleomingus', 'Varun Desai', 'Khyati Trehan', 'Prajjwal Chandra'].map(n => <li>Inspired by {n}</li>)}
      </ul>
      <p class="vge-stage__sub" style="margin-top:14px">Web experience created with Rijul Raut (Clockwerk Tech). A development of <a href="/projects/scarpin">Scarpin’</a>.</p>
      <nav class="vge-walk" aria-label="More">
        <a href="/virtual-gods/wheel"><span>The process wheel</span>Every module, fusion and world on one map</a>
        <a href="/archv-in/VirtualGods2020.html"><span>As it was</span>The original exhibition on archv.in</a>
        <a href="/projects/virtual-gods"><span>The project</span>Virtual Gods in the portfolio</a>
      </nav>
    </section>
  </div>
</ExhibitionLayout>
