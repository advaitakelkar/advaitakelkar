---
import Icon from './Icon.astro';
import { getCollection } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import ProjectStackCard from './ProjectStackCard.astro';
import ImageLightbox from './ImageLightbox.astro';
import Arrow from './Arrow.astro';

export interface Props {
  projects: any[];
  title: string;
  crumbs?: { label: string; href?: string }[];
  categoryId?: string;
  intro?: string[];
  tagline?: string;
  /** Project ids to highlight in the footer pill cloud (used by the
      Work studio-tab pages, which have no category record of their own). */
  activeIds?: string[];
  /** og:image for this category page; falls back to the site default. */
  shareImage?: string;
}

const { projects, title, crumbs, categoryId, intro, tagline, activeIds, shareImage } = Astro.props;

// Get all tags and categories for formatting
const allTags = await getCollection('tags');
const allCats = await getCollection('categories');
const tagMap = Object.fromEntries(allTags.map(t => [t.id, t.data.name]));
const catMap = Object.fromEntries(allCats.map(c => [c.id, c.data.displayName]));

// Studio tabs, derived from the studios collection rather than a hard-coded
// pair. These used to filter on `tags`, which stopped matching anything when
// studio became its own field — the Work page lost its tabs silently, because
// an empty tab group just hides itself.
const allStudios = await getCollection('studios');
const studioGroups = allStudios
  .filter(st => st.data.category.id === categoryId)
  .map(st => ({
    id: st.id,
    label: st.data.displayName,
    shortLabel: st.data.shortName ?? st.data.displayName,
    isAll: false,
    projects: projects.filter((p: any) => p.data.studio?.id === st.id),
  }))
  .filter(g => g.projects.length > 0);

// ADVT is Adi's own studio. On the Freelancer page it is not a collaboration
// you would filter TO — it is the default, the work with nobody else's name on
// it — so there it becomes the All tab rather than sitting beside one. Every
// other category keeps its studios and gains All in front of them.
const advtIsAll = categoryId === 'freelancer';
const namedGroups = advtIsAll ? studioGroups.filter(g => g.id !== 'advt') : studioGroups;

// Tabs are worth showing when there is more than one named group to choose
// between; All plus a single studio would be the same list twice. ARCHV has no
// studios at all, so it keeps its flat list.
const showTabs = namedGroups.length > 1;
const tabGroups = showTabs
  ? [{ id: 'all', label: 'All', shortLabel: 'All', isAll: true, projects }, ...namedGroups]
  : studioGroups;
const studioMap = Object.fromEntries(allStudios.map(st => [st.id, st.data.displayName]));

// 3-column intro copy now lives in the category's YAML (editable inline). Sub-views
// without their own category record (e.g. the Work studio tabs) fall back to a
// generic intro. The data-edit bindings below only attach when a categoryId exists.
const introCols = (intro && intro.length) ? intro : [
  `Welcome to the ${title} category — a curated collection of projects highlighting work in this space.`,
  "Each project is part of a unified practice — different mediums tracing the threads of form, material, and concept that recur and evolve from one project to the next.",
  "Browse the selected work below to explore the projects gathered in this collection.",
];
const introTagline = tagline ?? "A curated collection of work in this space.";
const editable = Boolean(categoryId && intro && intro.length);

const PEOPLE: Record<string, string> = {
  'Advaita Kelkar':  '/images/people/advaita-kelkar.jpg',
  'Nayan Mote':      '/images/people/nayan-mote.png',
  'Varun Mehta':     '/images/people/varun-mehta.jpeg',
  'Sneha Desai':     '/images/people/sneha-desai.jpeg',
  'Casimir Esbach':  '/images/people/casimir-esbach.jpeg',
  'Nicole Hammond':  '/images/people/nicole-hammond.png',
  'Ben Cho':         '/images/people/ben-cho.jpeg',
  'Pankti Thakkar':  '/images/people/pankti-thakkar.jpeg',
  'Faizan Khatri':   '/images/people/faizan-khatri.jpeg',
  'Samir Raut':      '/images/people/samir-raut.jpeg',
  'Siddhesh Kadam':  '/images/people/Siddhesh Kadam_823.jpeg',
  'Aaron Wilner':    '/images/people/Aaron-Wilner.webp',
  'Michael Hill':    '/images/people/Architecture-Michael-Hill-Fall-2019-HS_003_JJ_v1.webp',
  'Catalina Pesea-Ogletree': '/images/people/Catalina-Pesea-Ogletree.webp',
};

const uniquePeople = new Set<string>();
projects.forEach(p => {
  if (p.data.people) {
    p.data.people.forEach((person: string) => uniquePeople.add(person));
  }
});
let categoryPeople = Array.from(uniquePeople);

// Populate people dynamically for Work pages based on the studio field
const hasStudio823 = projects.some((p: any) => p.data.studio?.id === 'studio-823');
const hasFaizanKhatri = projects.some((p: any) => p.data.studio?.id === 'faizan-khatri');

if (categoryId === 'work' || (hasStudio823 && hasFaizanKhatri)) {
  categoryPeople = ['Advaita Kelkar', 'Samir Raut', 'Faizan Khatri', 'Siddhesh Kadam'];
} else if (hasStudio823) {
  categoryPeople = ['Advaita Kelkar', 'Samir Raut', 'Siddhesh Kadam'];
} else if (hasFaizanKhatri) {
  categoryPeople = ['Advaita Kelkar', 'Faizan Khatri'];
}

// People row rule (matches the project pages): professors/mentors first, one
// divider, then students/collaborators. No professor → no divider. Besides
// the global always-professor list, anyone named in a project's `professors:`
// field within this category groups left too.
const PROFESSOR_NAMES = ['Samir Raut', 'Faizan Khatri', 'Siddhesh Kadam', 'Casimir Esbach', 'Aaron Wilner', 'Michael Hill', 'Catalina Pesea-Ogletree'];
const perProjectProfessors = new Set<string>();
projects.forEach(p => (p.data.professors ?? []).forEach((n: string) => perProjectProfessors.add(n)));
const isProfessor = (p: string) => PROFESSOR_NAMES.includes(p) || perProjectProfessors.has(p);
/* Advaita sits last among the collaborators — the collective's other members
   read first, and the owner of the site closes the row. Professors keep their
   place ahead of the divider regardless. */
const OWNER = 'Advaita Kelkar';
categoryPeople = [
  ...categoryPeople.filter(isProfessor),
  ...categoryPeople.filter(p => !isProfessor(p) && p !== OWNER),
  ...categoryPeople.filter(p => !isProfessor(p) && p === OWNER),
];
const professorCount = categoryPeople.filter(isProfessor).length;
// Index after which the single divider renders; -1 = no divider
const peopleDividerAfter = professorCount > 0 && professorCount < categoryPeople.length ? professorCount - 1 : -1;
---

<PageLayout
  title={title}
  label={title}
  ogImage={shareImage}
  crumbs={crumbs || [{ label: 'Home', href: '/' }, { label: title }]}
  showFooter={true}
  categoryId={categoryId}
  activeIds={activeIds}
>
  <article class="category-detail">
    <div class="category-sticky-header">
      <!-- The title row is the projects page's header: the name, and how many
           works are under it. Nothing folds — the copy, the people and the
           studio tabs below are always there. -->
      <header class="project-top-header category-hero-header" id="project-top-header">
        <h1 class="project-card__title category-hero-title">{title}</h1>
        <div class="category-hero-right">
          <span class="category-count text-muted">{projects.length} {projects.length === 1 ? 'work' : 'works'}</span>
        </div>
      </header>

      <div class="category-intro-panel" id="category-intro-panel">
      <!-- 3-Column Intro (mirrors the home page). On the phone the people row
           is lifted above this with flex order — see the phone block below —
           rather than being moved in the DOM, so the wider bands keep the
           reading order they already had. -->
      <section class="category-intro">
        <p class="category-intro__tagline" data-edit={editable ? `categories/${categoryId}/tagline` : undefined}>{introTagline}</p>
        <div class="category-intro__body" id="category-intro-body">
          {introCols.map((text, i) => (
            <div class:list={["category-intro__column", i > 0 && "category-intro__column--more"]}>
              <p class="category-intro__desc" data-edit={editable ? `categories/${categoryId}/intro.${i}` : undefined}>{text}</p>
            </div>
          ))}
          {introCols.length > 1 && (
            <button class="category-readmore-btn" id="category-readmore-btn" type="button" aria-expanded="false">
              <span>Read More</span>
              <Arrow class="category-readmore-arrow" />
            </button>
          )}
        </div>
      </section>

      {categoryPeople.length > 0 && (
        <section class="category-people">
          {categoryPeople.map((person, idx) => (
            <>
              <div class="category-people__person" data-person={person}>
                <div class="category-people__avatar">
                  <img src={PEOPLE[person] ?? PEOPLE['Advaita Kelkar']} alt={person} loading="lazy" />
                </div>
                <span class="category-people__name">{person}</span>
              </div>
              {idx === peopleDividerAfter && <div class="category-people__divider" aria-hidden="true" />}
            </>
          ))}
        </section>
      )}

      </div>

      <!-- Project groups — tabbed (Studio 823 / FKD Workshop) on Work, else a flat card list -->
      {showTabs && (
        <section class="cat-tabs" style="margin-top: clamp(2rem, 4vh, 4rem);">
          <div class="cat-tabs__bar" role="tablist" aria-label="Project groups">
            {tabGroups.map((g, i) => (
              <button
                class:list={["cat-tab-btn", g.isAll && "cat-tab-btn--all", i === 0 && "is-active"]}
                role="tab"
                aria-selected={i === 0 ? 'true' : 'false'}
                data-tab={g.id}
                type="button"
                aria-label={g.isAll ? `All ${title} projects` : undefined}
                title={g.isAll ? `All ${title} projects` : undefined}
              >
                {!g.isAll && (
                  <span>
                    <span class="tab-label-full">{g.label}</span>
                    <span class="tab-label-short">{g.shortLabel}</span>
                  </span>
                )}
                <Icon name="arrow" class="pill-arrow" />
              </button>
            ))}
          </div>
        </section>
      )}
    </div>

    {showTabs ? (
      <section class="cat-tabs-content">
        {tabGroups.map((g, i) => (
          <div class:list={["cat-tab-panel", i === 0 && "is-active"]} id={`cat-panel-${g.id}`} role="tabpanel" style={i === 0 ? undefined : 'display:none;'}>
            <div class="cat-card-list project-cards-container">
              {g.projects.map(p => (
                <ProjectStackCard project={p} tagMap={tagMap} catMap={catMap} studioMap={studioMap} />
              ))}
              {g.projects.length === 0 && <p class="cat-tab-empty text-muted">No projects in this group yet.</p>}
            </div>
          </div>
        ))}
      </section>
    ) : (
      <div class="cat-card-list project-cards-container">
        {projects.map(p => (
          <ProjectStackCard project={p} tagMap={tagMap} catMap={catMap} studioMap={studioMap} />
        ))}
        {projects.length === 0 && <p class="cat-tab-empty text-muted">No projects in this category yet.</p>}
      </div>
    )}

    <ImageLightbox />
  </article>

  <style>
    /* Layout styling matched with Project pages */
    .category-detail {
      padding-bottom: clamp(4rem, 8vh, 8rem);
      min-height: 100dvh;
      box-sizing: border-box;
      display: flex;
      flex-direction: column;
      gap: 0; /* header→intro rhythm comes from the 8px header margin, like home */
    }

    /* ── Category title — H1 big on desktop; on mobile it drops to the
       home tagline style ("Architectural Designer": small, 600) ── */
    .category-hero-title {
      font-size: var(--_tokens---type--big);
      font-weight: var(--_tokens---weight--base);
      line-height: 0.95;
      letter-spacing: -0.03em;
      color: var(--_tokens---color--fg);
      margin: 0;
    }

    @media (max-width: 1023.98px) {
      .category-hero-title {
        font-size: var(--_tokens---type--small);
        font-weight: var(--_tokens---weight--strong);
        line-height: 1.2;
        letter-spacing: 0.01em;
      }
    }

    /* ── 1-Column Intro ── */
    .category-intro__body {
      display: flex;
      flex-direction: column;
      gap: 16px;
      width: 100%;
      max-width: 720px;
    }

    .category-intro__column--more {
      display: none;
    }
    .category-intro__body.is-expanded .category-intro__column--more {
      display: block;
    }

    /* Read More pill — same pill language as the home Bio pill */
    .category-readmore-btn {
      display: inline-flex;
      align-items: center;
      gap: var(--_tokens---pill-gap);
      align-self: flex-start; /* Fit content size instead of stretching full width */
      justify-self: start;
      font-family: inherit;
      font-size: var(--_tokens---type--ultrathin);
      font-weight: var(--_tokens---weight--light);
      letter-spacing: 0.05em;
      color: var(--_tokens---color--muted);
      background-color: color-mix(in srgb, var(--_tokens---color--fg) 6%, transparent);
      border: var(--_tokens---pill-border);
      border-radius: var(--_tokens---radius--pill);
      padding: var(--_tokens---pill-pad--xs);
      cursor: pointer;
      transition: background-color var(--_tokens---motion--base), color var(--_tokens---motion--base), border-color var(--_tokens---motion--base);
    }
    .category-readmore-arrow {
      flex-shrink: 0;
      opacity: 0.55;
      transition: transform var(--_tokens---motion--base) cubic-bezier(0.16, 1, 0.3, 1), opacity var(--_tokens---motion--base) ease;
    

      --arrow-size: var(--_tokens---arrow--sm);

    }
    .category-readmore-btn[aria-expanded="true"] {
      background-color: var(--_tokens---color--fg);
      color: var(--_tokens---color--bg);
      border-color: var(--_tokens---color--fg);
    }
    .category-readmore-btn[aria-expanded="true"] .category-readmore-arrow {
      transform: rotate(135deg);
      opacity: 1;
    }

    .category-intro__tagline {
      font-size: var(--_tokens---type--micro);
      font-weight: var(--_tokens---weight--base);
      color: var(--_tokens---color--fg);
      margin: 0 0 12px 0;
      letter-spacing: 0.01em;
    }

    /* ── Category Header ──
       No border here. This block breaks out of the page gutter so its
       background can span edge to edge, which meant its border-bottom did too
       — a full-bleed rule where every other separator on the site is inset to
       the content column. The rules now come from .page-toggle-header and
       .page-toggle-panel, which sit inside the padding. */
    .category-sticky-header {
      width: auto;
      padding-bottom: 24px;
      margin-bottom: 32px;
      margin-inline: calc(-1 * var(--_tokens---space--small));
      padding-inline: var(--_tokens---space--small);
    }
    
    /* Break out of the page gutter so the sticky header's background spans
       edge to edge, then re-pad so its content stays on the page's left edge.
       Ungated: .page-main applies the gutter at every width now, so gating
       this at 1366 left the background short of the edge below that. */
    .category-sticky-header {
      margin-inline: calc(-1 * var(--_tokens---layout--gutter));
      padding-inline: var(--_tokens---layout--gutter);
    }

    /* A flex row: the title, and the count opposite it. (This used to come
       from .page-toggle-header, when the row was also a fold control.) */
    .category-hero-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      width: 100%;
    }
    .category-hero-title {
      margin-block: 0;
      min-width: 0;
    }
    .category-intro-panel {
      /* The panel owns the rule under the collapsed block. */
      padding-top: 20px;
    }

    /* ── Desktop: the projects page's header, exactly ──────────────────
       Same title size, the count set the same way on the right, one hairline
       under the row, and the row at the same height from the top of the
       window (56px, the projects page's --stick-top). */
    @media (min-width: 1024px) {
      .category-hero-header.project-top-header {
        padding: 56px 0 12px;
        margin: 0 0 16px;
        border-bottom: 1px solid var(--_tokens---color--line-soft);
      }
      .category-hero-title {
        font-size: var(--_tokens---type--medium);
        font-weight: var(--_tokens---weight--base);
        letter-spacing: -0.02em;
        line-height: 1.1;
      }
      .category-count {
        font-weight: var(--_tokens---weight--light);
        letter-spacing: 0.04em;
        color: var(--_tokens---color--muted);
      }
      .category-intro-panel {
        padding-top: 0;
      }
    }

    /* Same voice as the home three-column text: micro, muted */
    .category-intro__desc {
      font-size: var(--_tokens---type--micro);
      font-weight: var(--_tokens---weight--base);
      line-height: 1.55;
      color: var(--_tokens---color--muted);
      margin: 0;
      /* Honour newlines written into the YAML copy, so a paragraph can be
         broken where the author wants without splitting it into a second
         intro entry — everything after intro[0] is hidden behind Read More,
         so a split would bury half the sentence. Spaces still collapse. */
      white-space: pre-line;
    }

    /* ── Header — identical rhythm to the home hero: same top padding,
       8px to the paragraph section, static (home's title doesn't stick) ── */
    .project-top-header {
      position: static;
      padding-top: calc(clamp(2rem, 5vh, 3rem) + 48px); /* = home hero */
      padding-bottom: 0;
      margin: 0 0 8px;                                   /* = home header gap */
    }

    /* PAGE HEADING (mobile) — fixed bar, full length (side bar → right
       edge), glass blur, muted full-width border; tap scrolls to top.
       Identical recipe on home / about / projects / project pages. */
    @media (max-width: 1023.98px) {
      .project-top-header {
        position: fixed;
        top: 0;
        left: var(--_tokens---layout--nav); /* clear the side INDEX bar */
        right: 0;
        z-index: 110;
        background-color: var(--_tokens---color--bg); /* opaque — no glass */
        border-bottom: 1px solid var(--_tokens---color--line-soft);
        padding: 16px 12px 14px;
        margin: 0;
        box-sizing: border-box;
        cursor: pointer;
      }
      /* Content starts below the fixed heading (bar ≈52px + 16px gap) */
      .category-detail {
        padding-top: 68px;
      }
    }

    /* ── Project group tabs (same look as the About page tabs) ── */
    .cat-tabs__bar {
      display: flex;
      flex-direction: row;
      gap: 6px;
      flex-wrap: nowrap;
      width: 100%;
      margin-bottom: 16px;
      border-bottom: 1px solid var(--_tokens---color--line-soft);
      padding-bottom: 12px;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .cat-tabs__bar::-webkit-scrollbar { display: none; }

    .cat-tab-btn {
      flex: 0 0 auto;
      display: inline-flex;
      align-items: center;
      gap: var(--_tokens---pill-gap--lg);
      font-size: var(--_tokens---type--medium);
      font-family: inherit;
      font-weight: var(--_tokens---weight--base);
      letter-spacing: -0.03em;
      line-height: 1;
      background-color: color-mix(in srgb, var(--_tokens---color--fg) 6%, transparent);
      border: var(--_tokens---pill-border);
      color: var(--_tokens---color--muted);
      padding: var(--_tokens---pill-pad--lg);
      cursor: pointer;
      border-radius: var(--_tokens---radius--pill);
      white-space: nowrap;
      transition: background-color var(--_tokens---motion--base) ease, color var(--_tokens---motion--base) ease, border-color var(--_tokens---motion--base) ease;
    }
    .cat-tab-btn .pill-arrow {
    --icon-size: 20px;
      flex-shrink: 0;
      opacity: 0.55;
      transition: opacity var(--_tokens---motion--base) ease, transform var(--_tokens---motion--base) cubic-bezier(0.16, 1, 0.3, 1);
      /* Deliberately fixed, not on the em scale: the tab label is
         display-sized, and an arrow that tracked it would dwarf the pill. */
      
  }
    @media (hover: hover) {
      .cat-tab-btn:hover {
      background-color: color-mix(in srgb, var(--_tokens---color--fg) 12%, transparent);
      color: var(--_tokens---color--fg);
      border-color: color-mix(in srgb, var(--_tokens---color--fg) 22%, transparent);
    }
    }
    @media (hover: hover) {
      .cat-tab-btn:hover .pill-arrow { opacity: 1; transform: translate(2px, -2px); }
    }
    .cat-tab-btn.is-active {
      background-color: var(--_tokens---color--fg);
      color: var(--_tokens---color--bg);
      border-color: var(--_tokens---color--fg);
    }
    .cat-tab-btn.is-active .pill-arrow { opacity: 0.7; }

    /* All is a mark, not a word: a round pill carrying only the arrow, so the
       one tab that is not a studio does not read as another studio.

       Its width is built from the same numbers that give a pill its height,
       not from aspect-ratio and not from stretch: a flex item's width is
       resolved from its content before the stretched cross size is known, so
       the ratio never applies — the trap the breadcrumb's round Back button
       documents in tokens.css.

       A pill is as tall as whichever is taller, its line box or its arrow,
       plus 14px of padding top and bottom and a 1px border. Above 700 the
       display-sized label wins; below it the fixed 20px arrow does. max()
       covers both, so the circle never has to be re-derived per band. */
    .cat-tab-btn--all {
      padding-inline: 0;
      width: calc(max(1lh, 20px) + 30px);
      border-radius: 50%;
      justify-content: center;
      gap: 0;
      flex: 0 0 auto;
    }

    /* Short labels (823 / FKD) replace the full names on small screens —
       same mechanism as the About page tabs */
    .tab-label-short { display: none; }
    @media (max-width: 699.98px) {
      .tab-label-full { display: none; }
      .tab-label-short { display: inline; }
      /* Sized so the whole row fits the screen rather than scrolling off it.
         Freelancer carries the most — All plus three studios — and at the
         previous size those four measured 373px against 351px of room, so the
         last one was always half off the edge. At this size they come to 279
         and every category's row is visible at once. */
      .cat-tab-btn {
        padding: 8px 12px;
        font-size: var(--_tokens---type--micro);
        gap: 6px;
      }
      .cat-tab-btn .pill-arrow {
        --icon-size: 14px;
      }
      /* Here the 14px arrow is the taller of the two, not the 12.5px line
         box, and the padding is 8px a side. */
      .cat-tab-btn--all {
        padding-inline: 0;
        width: calc(max(1lh, 14px) + 18px);
      }
      .cat-tabs__bar {
        gap: 6px;
      }
    }

    .cat-tab-empty { padding: 2rem 24px; }


    .cat-card-list {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    /* ── People UI ── */
    .category-people {
      display: flex;
      flex-direction: row;
      flex-wrap: wrap;
      gap: 20px;
      width: 100%;
      margin-top: 32px;
      margin-bottom: 24px;
    }
    
    .category-people__person {
      display: flex;
      flex-direction: row;
      align-items: center;
      gap: 8px;
      cursor: pointer;
      position: relative;
    }

    /* Hairline between professors (left) and students (right) — same family
       divider as the project pages' people row */
    .category-people__divider {
      width: 1px;
      height: 48px;
      background-color: var(--_tokens---color--line-soft);
      align-self: center;
      margin-inline: 2px;
    }

    .category-people__avatar {
      width: 72px;
      height: 72px;
      border-radius: 50%;
      overflow: hidden;
      flex-shrink: 0;
      background-color: var(--_tokens---color--bg-glass);
      border: 1px solid var(--_tokens---color--line-soft);
    }

    .category-people__avatar img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      filter: grayscale(1);
      opacity: 0.6;
      transition: filter var(--_tokens---motion--base) ease, opacity var(--_tokens---motion--base) ease;
    }

    /* Name is hidden by default — revealed as a floating tooltip above the
       avatar on hover (desktop) or tap (via .is-active, all pointer types). */
    .category-people__name {
      position: absolute;
      bottom: calc(100% + 8px);
      left: 50%;
      transform: translateX(-50%) translateY(4px);
      font-size: var(--_tokens---type--micro);
      color: var(--_tokens---color--bg);
      background-color: var(--_tokens---color--fg);
      padding: 4px 10px;
      border-radius: var(--_tokens---radius--pill, 999px);
      white-space: nowrap;
      opacity: 0;
      pointer-events: none;
      transition: opacity var(--_tokens---motion--base) ease, transform var(--_tokens---motion--base) ease;
      z-index: 5;
    }

    @media (hover: hover) {
      .category-people__person:hover .category-people__avatar img {
      filter: grayscale(0);
      opacity: 1;
    }
    }

    .category-people__person.is-active .category-people__name {
      opacity: 1;
      transform: translateX(-50%) translateY(0);
    }
    @media (hover: hover) {
      .category-people__person:hover .category-people__name {
      opacity: 1;
      transform: translateX(-50%) translateY(0);
    }
    }

    .category-people__person.is-active .category-people__avatar img {
      filter: grayscale(0);
      opacity: 1;
    }

    /* ── Sticky Header Mobile Layout ── */
    @media (max-width: 1023.98px) {
      .category-hero-header.project-top-header {
        position: static !important;
        background-color: transparent !important;
        width: auto !important;
      }

      .category-sticky-header {
        position: sticky;
        top: 0;
        background-color: var(--_tokens---color--bg);
        z-index: 100;
        padding-top: 16px;
        padding-bottom: 16px;
        margin-bottom: 0;
      }

      .category-detail {
        padding-top: 0 !important;
      }

      .cat-tabs__bar {
        border-bottom: none !important;
        padding-bottom: 0 !important;
        margin-bottom: 0 !important;
      }
      
      .cat-card-list {
        margin-top: 24px !important;
      }

      /* 5 avatars in a row on mobile — a 5-column grid sizes every circle
         to fit exactly 5 across, regardless of how many people are listed. */
      .category-people {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        max-width: none;
        width: 100%;
        gap: 12px;
        margin-bottom: 28px;
      }

      .category-people__person {
        flex-direction: column;
        gap: 0;
      }

      .category-people__avatar {
        width: 100%;
        height: auto;
        aspect-ratio: 1 / 1;
      }
    }

    /* The count sits with the fold control, the way it does on the projects
       page — the header says what this is and how much of it there is. */
    .category-hero-right {
      display: flex;
      align-items: center;
      gap: 12px;
      flex: 0 0 auto;
    }
    .category-count {
      font-size: var(--_tokens---type--micro);
      white-space: nowrap;
    }

    @media (min-width: 1024px) {
      /* ── The card, cut down: name, arrow, pills ──
         No subtitle and no thumbnails here, and the name at the page-title
         size, so a card is one line plus its pills. */
      /* :global — the card is ProjectStackCard's markup and carries none of
         this component's scoping attribute. */
      .cat-card-list.project-cards-container :global(.project-card) {
        --card-name: var(--_tokens---type--medium);
        grid-template-rows: auto auto;
        row-gap: 4px;
        padding-block: 8px 10px;
      }
      .cat-card-list.project-cards-container :global(.project-card__description-col),
      .cat-card-list.project-cards-container :global(.project-card__image-col) {
        display: none;
      }
      .cat-card-list.project-cards-container :global(.project-card__bottom-bar) {
        grid-row: 2;
        /* The whole card's width — in a half-width card the left half alone
           wrapped six pills onto three lines. */
        grid-column: 1 / -1;
      }

      /* Four pills at most: year, location, status, and what the work is.
         The category and the studio are what this page already is, so a
         pill repeating them on every card says nothing; one discipline is
         enough to tell the cards apart. */
      .cat-card-list.project-cards-container :global(.project-card__filter-pill[data-axis="category"]),
      .cat-card-list.project-cards-container :global(.project-card__filter-pill[data-axis="studio"]),
      .cat-card-list.project-cards-container :global(.project-card__filter-pill[data-axis="tag"] ~ .project-card__filter-pill[data-axis="tag"]) {
        display: none;
      }

            /* Two columns of cards. Each card is a name and its pills now, so two
         sit side by side comfortably and the list is half as long. */
      .cat-card-list.project-cards-container {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
        align-items: stretch;
      }
      .cat-card-list.project-cards-container :global(.project-card) {
        align-content: start;
      }
      .cat-card-list.project-cards-container :global(.cat-tab-empty) {
        grid-column: 1 / -1;
      }
    }

    /* ══ Phone: the projects-page chassis ═══════════════════════════════
       Same shape as /projects, with the category's own copy in place of the
       search. Reading order runs bottom-to-top: breadcrumb, then the category
       card, then the studio tabs, then the works stacking upward away from
       your thumb. The two fixed elements sit exactly where the search and the
       selector sit on the projects page, so the two pages feel like one.

       Heights are measured rather than guessed — the card holds a people row
       and a paragraph that Read More can grow, so nothing here can be a fixed
       number. The script below writes --cat-card-h and --cat-tabs-h. */
    @media (max-width: 699.98px) {
      /* ── Top card: the category name, and how many works are under it ── */
      .category-hero-header.project-top-header {
        flex-wrap: nowrap;
        align-items: flex-start;
        gap: 10px;
        padding-block: 2px 6px;
        margin-bottom: 0;
      }
      .category-hero-title {
        flex: 1 1 auto;
        min-width: 0;
      }
      .category-hero-right {
        flex: 0 0 auto;
        padding-top: 4px;
      }
      #category-intro-panel {
        max-height: none !important;
        opacity: 1 !important;
        overflow: visible !important;
        margin-top: 0 !important;
        border-bottom: none;
      }

      /* ── Bottom card: people on top, then the short line and the copy ── */
      .category-intro-panel {
        position: fixed;
        left: 12px;
        right: 12px;
        bottom: calc(var(--cat-dock-h, 66px) + 6px);
        z-index: 95;
        display: flex;
        flex-direction: column;
        gap: 8px;
        margin: 0;
        padding: 8px 0 10px;
        background-color: var(--_tokens---color--bg);
      }
      .category-people {
        /* People on top of the bottom card. Visual order only — the DOM keeps
           the reading order the wider bands use.

           One scrolling row, not the 5-column grid the wider bands use: nine
           collaborators wrapped to a second row there, and every extra row is
           height taken straight off the works above. */
        order: -1;
        display: flex;
        flex-wrap: nowrap;
        overflow-x: auto;
        scrollbar-width: none;
        margin: 0;
        gap: 8px;
        padding-bottom: 2px;
      }
      .category-people__person {
        flex: 0 0 auto;
      }
      .category-people__avatar {
        width: 44px;
        height: 44px;
      }
      .category-people__divider {
        flex: 0 0 auto;
        align-self: stretch;
      }
      .category-people::-webkit-scrollbar { display: none; }
      .category-intro {
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 4px;
      }
      .category-intro__tagline {
        margin: 0;
        font-size: var(--_tokens---type--micro);
        font-weight: var(--_tokens---weight--strong);
        line-height: 1.35;
      }
      .category-intro__body {
        display: block;
        gap: 0;
        margin: 0;
      }
      .category-intro__desc {
        margin: 0;
        font-size: var(--_tokens---type--ultrathin);
        line-height: 1.45;
      }
      /* Collapsed, the copy is a two-line hook. Read More opens the rest into
         a scrolling block rather than letting the card grow without limit. */
      .category-intro__body:not(.is-expanded) .category-intro__column:first-child .category-intro__desc {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }
      .category-intro__body.is-expanded {
        max-height: 38dvh;
        overflow-y: auto;
      }
      .category-intro__body.is-expanded .category-intro__column + .category-intro__column {
        margin-top: 6px;
      }
      .category-readmore-btn {
        margin-top: 4px;
      }

      /* ── The studio tabs take the selector's slot, right above the card ── */
      .cat-tabs {
        position: fixed;
        left: 12px;
        right: 12px;
        bottom: calc(var(--cat-dock-h, 66px) + var(--cat-card-h, 150px) + 18px);
        z-index: 95;
        margin: 0 !important;
        padding-block: 6px;
        background-color: var(--_tokens---color--bg);
      }
      .cat-tabs__bar {
        margin: 0;
        overflow-x: auto;
        scrollbar-width: none;
        flex-wrap: nowrap;
      }
      .cat-tabs__bar::-webkit-scrollbar { display: none; }

      /* One surface behind the whole bottom stack. Without it the works show
         through the gaps between the breadcrumb, the card and the tabs.
         z-index 80, below the fixed children at 95 and above the cards. */
      .category-detail::after {
        content: '';
        position: fixed;
        left: 0;
        right: 0;
        bottom: 0;
        height: calc(var(--cat-dock-h, 66px) + var(--cat-card-h, 150px) + var(--cat-tabs-h, 0px) + 24px);
        background-color: var(--_tokens---color--bg);
        z-index: 80;
        pointer-events: none;
      }

      /* Clear the stack, and give the works a full screen to settle at the
         bottom of — the same inverted list the projects page uses. */
      .category-detail {
        padding-bottom: calc(var(--cat-dock-h, 66px) + var(--cat-card-h, 150px) + var(--cat-tabs-h, 0px) + 36px);
      }
      .cat-card-list.project-cards-container {
        --stack-clear: calc(var(--cat-dock-h, 66px) + var(--cat-card-h, 150px) + var(--cat-tabs-h, 0px) + 72px);
        margin-top: 0;
        /* The works stack upward out of the bottom card, same as the projects
           page. Stated here rather than relying on the shared rule: this
           components own .cat-card-list carries a scoping attribute and wins
           on specificity over the global one, whatever the source order. */
        display: flex;
        flex-direction: column-reverse;
        justify-content: flex-start;
        gap: 10px;
      }
      .cat-tabs-content {
        margin-top: 0;
      }
      .category-sticky-header {
        margin-bottom: 0;
      }
    }

  </style>

  <script>
    import { shuffleChildren } from '../lib/random';

    // Shuffle every project card list so the order differs on each load
    function shuffleCardLists() {
      document.querySelectorAll('.cat-card-list').forEach(shuffleChildren);
    }

    function initCategorySliders() {
      const slider = document.getElementById('project-slider');
      if (!slider) return;

      const images = slider.querySelectorAll('.slider-image');
      const prevBtn = slider.querySelector('.prev');
      const nextBtn = slider.querySelector('.next');
      if (images.length <= 1) return;

      let currentIdx = 0;
      let interval: number;

      function showSlide(idx: number) {
        images[currentIdx].classList.remove('active');
        currentIdx = (idx + images.length) % images.length;
        images[currentIdx].classList.add('active');
      }

      function nextSlide() { showSlide(currentIdx + 1); }
      function prevSlide() { showSlide(currentIdx - 1); }

      function startAutoSlide() {
        clearInterval(interval);
        interval = setInterval(nextSlide, 3000);
      }

      function stopAutoSlide() {
        clearInterval(interval);
      }

      nextBtn?.addEventListener('click', () => { nextSlide(); startAutoSlide(); });
      prevBtn?.addEventListener('click', () => { prevSlide(); startAutoSlide(); });

      slider.addEventListener('mouseenter', stopAutoSlide);
      slider.addEventListener('mouseleave', startAutoSlide);

      startAutoSlide();
    }

    function initHoverReveal() {
      const rows = document.querySelectorAll('.switch-row');
      rows.forEach(row => {
        const revealImg = row.querySelector('.hover-reveal-img') as HTMLElement;
        if (!revealImg) return;

        row.addEventListener('mousemove', (e: Event) => {
          const mouseEvent = e as MouseEvent;
          // Set coordinates exactly at the cursor
          revealImg.style.left = `${mouseEvent.clientX}px`;
          revealImg.style.top = `${mouseEvent.clientY}px`;
        });
      });
    }

    function initCategoryTabs() {
      const tabs = document.querySelectorAll<HTMLElement>('.cat-tab-btn');
      const panels = document.querySelectorAll<HTMLElement>('.cat-tab-panel');
      if (!tabs.length) return;
      tabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          const target = tab.dataset.tab;
          tabs.forEach((t) => {
            const m = t === tab;
            t.classList.toggle('is-active', m);
            t.setAttribute('aria-selected', String(m));
          });
          panels.forEach((p) => {
            const m = p.id === `cat-panel-${target}`;
            p.style.display = m ? '' : 'none';
            p.classList.toggle('is-active', m);
          });
        });
      });
    }

    // Run on initial load (no View Transitions router here, so astro:page-load
    // doesn't fire) and again after any swap.
    // Read More pill (mobile): reveals the hidden intro paragraphs
    function initIntroReadMore() {
      const introBody = document.getElementById('category-intro-body');
      const readMoreBtn = document.getElementById('category-readmore-btn');

      if (introBody && readMoreBtn) {
        readMoreBtn.addEventListener('click', () => {
          const isExpanded = introBody.classList.contains('is-expanded');
          if (isExpanded) {
            introBody.classList.remove('is-expanded');
            readMoreBtn.setAttribute('aria-expanded', 'false');
          } else {
            introBody.classList.add('is-expanded');
            readMoreBtn.setAttribute('aria-expanded', 'true');
          }
        });
      }
      
      // People avatars: tapping one opens its name pill, tapping it again
      // closes it, and an open pill auto-closes after 10s. Only one is open
      // at a time. (Same behavior as the project pages' people row.)
      const PEOPLE_PILL_TIMEOUT = 10000;
      const peopleEls = document.querySelectorAll('.category-people__person');
      let peopleHideTimer: number | null = null;
      const closeAllPeople = () => {
        if (peopleHideTimer) { clearTimeout(peopleHideTimer); peopleHideTimer = null; }
        peopleEls.forEach(p => p.classList.remove('is-active'));
      };

      peopleEls.forEach(el => {
        el.addEventListener('click', (e) => {
          e.stopPropagation();
          const wasActive = el.classList.contains('is-active');
          closeAllPeople();
          if (wasActive) return; // second tap on the open one → just close
          el.classList.add('is-active');
          peopleHideTimer = window.setTimeout(() => {
            el.classList.remove('is-active');
            peopleHideTimer = null;
          }, PEOPLE_PILL_TIMEOUT);
        });
      });
      document.addEventListener('click', closeAllPeople);
    }

    // Page heading: tap scrolls back to top (same as home/about)
    function initHeadingScrollTop() {
      const h = document.getElementById('project-top-header');
      if (!h || (h as any)._topWired) return;
      (h as any)._topWired = true;
      h.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
    }

    shuffleCardLists();
    initCategorySliders();
    initHoverReveal();
    initCategoryTabs();
    initIntroReadMore();
    initHeadingScrollTop();
    document.addEventListener('astro:after-swap', () => {
      shuffleCardLists();
      initCategorySliders();
      initHoverReveal();
      initCategoryTabs();
      initIntroReadMore();
      initHeadingScrollTop();
    });

    // ── Phone: measure the fixed bottom stack ─────────────────────────
    // The category card holds a people row and a paragraph Read More can
    // grow, so its height is not a number anyone can write down. Everything
    // that has to clear it — the tabs above it, the seal behind it, the
    // padding under the works — reads these two variables instead.
    function measureCategoryStack() {
      const root = document.querySelector('.category-detail') as HTMLElement | null;
      if (!root) return;
      const card = document.getElementById('category-intro-panel');
      const tabs = document.querySelector('.cat-tabs') as HTMLElement | null;
      if (!window.matchMedia('(max-width: 699.98px)').matches) {
        root.style.removeProperty('--cat-card-h');
        root.style.removeProperty('--cat-tabs-h');
        root.style.removeProperty('--cat-dock-h');
        return;
      }
      // The breadcrumb docks to the bottom on this band and its height moves
      // with the device's safe area, so it is measured rather than assumed.
      const dock = document.querySelector('.page-breadcrumb') as HTMLElement | null;
      root.style.setProperty('--cat-dock-h', Math.round(dock?.getBoundingClientRect().height ?? 66) + 'px');
      root.style.setProperty('--cat-card-h', Math.round(card?.getBoundingClientRect().height ?? 0) + 'px');
      root.style.setProperty('--cat-tabs-h', Math.round(tabs?.getBoundingClientRect().height ?? 0) + 'px');
    }

    function initCategoryStackMeasure() {
      measureCategoryStack();
      window.addEventListener('resize', measureCategoryStack, { passive: true });
      const card = document.getElementById('category-intro-panel');
      if (card && 'ResizeObserver' in window) {
        new ResizeObserver(() => measureCategoryStack()).observe(card);
      }
      // Read More changes the card height; re-measure after the class lands.
      document.getElementById('category-readmore-btn')
        ?.addEventListener('click', () => requestAnimationFrame(measureCategoryStack));
    }

    initCategoryStackMeasure();
    document.addEventListener('astro:after-swap', initCategoryStackMeasure);

    // ── The card pills go somewhere ───────────────────────────────────
    // A category page has no search of its own, so a pill here hands the
    // query to the projects page rather than sitting there inert. The
    // projects page already reads ?q= on load.
    function initCategoryPillLinks() {
      document.querySelectorAll('.cat-card-list').forEach(list => {
        if ((list as any)._pillsWired) return;
        (list as any)._pillsWired = true;
        list.addEventListener('click', (e: Event) => {
          const pill = (e.target as HTMLElement)?.closest('.project-card__filter-pill') as HTMLElement | null;
          if (!pill) return;
          const value = pill.dataset.filterValue;
          if (!value) return;
          window.location.href = '/projects?q=' + encodeURIComponent(value);
        });
      });
    }

    initCategoryPillLinks();
    document.addEventListener('astro:after-swap', initCategoryPillLinks);

  </script>
</PageLayout>
