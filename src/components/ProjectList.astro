---
import Icon from './Icon.astro';
import { getCollection } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import fs from 'node:fs';
import path from 'node:path';
import { isProjectLocked, visibleProjectImages } from '../lib/content';
import Arrow from './Arrow.astro';

export interface Props {
  projects: any[];
  title: string;
  crumbs?: { label: string; href?: string }[];
}

const { projects, title, crumbs } = Astro.props;

const allTags = await getCollection('tags');
const allCats = await getCollection('categories');
const allStudios = await getCollection('studios');

// Sort by number then year
const sorted = [...projects].sort((a, b) => {
  if (a.data.numbr && b.data.numbr) return a.data.numbr - b.data.numbr;
  if (a.data.numbr) return -1;
  if (b.data.numbr) return 1;
  return parseInt(b.data.year ?? '0') - parseInt(a.data.year ?? '0');
});

const tagMap = Object.fromEntries(allTags.map(t => [t.id, t.data.name]));
const catMap = Object.fromEntries(allCats.map(c => [c.id, c.data.displayName]));
const studioMap = Object.fromEntries(allStudios.map(s => [s.id, s.data.displayName]));

// Resolve AI works preview images if any project is ai-works
const aiWorksImages: string[] = [];
try {
  const aiWorksDir = path.resolve('public/images/ai-works');
  if (fs.existsSync(aiWorksDir)) {
    const folders = fs.readdirSync(aiWorksDir).filter(f => {
      const fullPath = path.join(aiWorksDir, f);
      return fs.statSync(fullPath).isDirectory();
    }).sort();

    for (const folder of folders) {
      const folderPath = path.join(aiWorksDir, folder);
      const files = fs.readdirSync(folderPath).filter(file => {
        const ext = path.extname(file).toLowerCase();
        return ['.png', '.jpg', '.jpeg', '.webp'].includes(ext);
      }).sort();

      if (files.length > 0) {
        aiWorksImages.push(`/images/ai-works/${folder}/${files[0]}`);
      }
    }
  }
} catch (e) {
  console.error("Error reading AI works folders in ProjectList:", e);
}

// Abbreviate project names for footer bubbles (same logic as Footer.astro)
function abbrevName(name: string): string {
  return name.trim().split(/\s+/).filter(w => w.length > 0).map(w => w.length <= 3 ? w : w.slice(0, 3)).join(' ');
}

// Count projects per tag to find top 4
const tagCounts: Record<string, number> = {};
projects.forEach(p => {
  (p.data.tags ?? []).forEach(t => {
    tagCounts[t.id] = (tagCounts[t.id] || 0) + 1;
  });
});
const sortedTags = [...allTags].sort((a, b) => (tagCounts[b.id] || 0) - (tagCounts[a.id] || 0));
---

<PageLayout
  title={title}
  label={title}
  crumbs={crumbs || [
    { label: 'Home', href: '/' },
    { label: title }
  ]}
  showFooter={false}
>
  <section class="projects-page">
    <!-- Top Section: Header, search, filters, and cards -->
    <div class="projects-top-section">
      <div class="projects-header-blur-overlay"></div>
      <div class="projects-fixed-wrapper">
        <!-- Title scrolls away with the page; only the bar below stays stuck -->
        <header class="projects-header page-toggle-header">
          <div class="projects-title-slot">
            <h1 class="projects-title">{title}</h1>
            <input
              type="search"
              id="projects-collapsed-search"
              class="projects-collapsed-search"
              placeholder="Search by year"
              autocomplete="off"
              aria-label="Search projects"
            />
            <button class="projects-search-clear projects-collapsed-search-clear" id="projects-collapsed-search-clear" type="button" aria-label="Clear search and all filters" title="Clear search and filters" hidden>
              <Icon name="close" class="projects-search-clear__icon" />
            </button>
          </div>
          <div class="projects-header__right">
            <span class="projects-count text-muted">{projects.length} of {projects.length} works</span>
            <button class="page-toggle-btn" data-page-toggle="projects-filter-panel" aria-expanded="true" aria-label="Toggle search and filters" type="button">
              <Arrow />
            </button>
          </div>
        </header>
      {/* Search field and selector collapse together: the bar you carry down
          the page is the compact one, and the filters belong to the open
          state. */}
      <div class="projects-sticky-header page-toggle-panel" id="projects-filter-panel">

      <!-- Search bar matching home UI -->
      <div class="projects-search-bar">
        <input
          type="search"
          id="projects-search-input"
          class="projects-search-input"
          placeholder="Search by year"
          autocomplete="off"
          aria-label="Search projects"
        />
        <button class="projects-search-clear" id="projects-search-clear" type="button" aria-label="Clear search and all filters" title="Clear search and filters" hidden>
          <Icon name="close" class="projects-search-clear__icon" />
        </button>
      </div>

      <!-- Filter bar with dropdown and scrollable tag picker -->
      <div class="filter-bar">
        <div class="filter-group">
          <span class="filter-label text-muted">Category</span>
          <div class="filter-select-wrap">
            <select id="cat-select" class="filter-select">
              <option value="">All Categories</option>
              {allCats.map(cat => (
                <option value={cat.id}>{cat.data.displayName}</option>
              ))}
            </select>
            <Icon name="chevron" dir="s" class="filter-select-arrow" />
          </div>
        </div>
        
        <div class="filter-group filter-group--tags">
          <div class="tag-picker-wrapper">
            <button class="tag-picker-item is-active" data-filter="" id="all-tag-btn" type="button">All</button>
            <span class="tag-picker-divider">|</span>
            <div class="tag-scroll-nav">
              <button class="tag-scroll-arrow tag-scroll-arrow--left" id="tag-scroll-left" aria-label="Scroll tags left" type="button">
                <Icon name="chevron" dir="w" />
              </button>
              <div class="tag-picker-container" id="tag-picker-container">
                <div class="tag-picker" id="tag-picker">
                  {sortedTags.map(tag => (
                    <button class="tag-picker-item" data-filter={tag.id} type="button">
                      {tag.data.name}
                    </button>
                  ))}
                </div>
              </div>
              <button class="tag-scroll-arrow tag-scroll-arrow--right" id="tag-scroll-right" aria-label="Scroll tags right" type="button">
                <Icon name="chevron" dir="e" />
              </button>
            </div>
          </div>
          </div>
        </div>
      </div>
      </div>


      <!-- Project list — accordion cards -->
    <div class="project-cards-container" id="project-cards-container">
      {sorted.map((p, i) => {
        // ── The three axes, and the rule that no card says a thing twice ──
        // The pills are the taxonomy: bucket, studio, discipline. They win,
        // and any free-text field that merely restates one of them is dropped
        // rather than printed again. Five SCAD projects named SCAD as both the
        // studio and the Client; XBKC did the same with Studio Stumbles.
        // Search reads data-tags / data-studio, which are built from the raw
        // project data, so nothing here narrows what the page can find.
        const dedupeKey = (s: string) => s.toLowerCase().replace(/[^a-z0-9]/g, '');
        const categoryLabel = p.data.category ? (catMap[p.data.category.id] || p.data.category.id) : '';
        const studioLabel = p.data.studio ? (studioMap[p.data.studio.id] || p.data.studio.id) : '';
        const tagsArr = (p.data.tags ?? []).map(t => tagMap[t.id] || t.id);
        // The three pills ARE the taxonomy, and they always survive: they are
        // the only part of the card you can also filter by. A free-text field
        // that merely restates one is the redundant half, so it drops instead
        // — Client "SCAD" beside the SCAD studio pill, Program "Architecture"
        // beside the Architecture discipline pill.
        const axisLabels = new Set(
          [categoryLabel, studioLabel, ...tagsArr].filter(Boolean).map(t => dedupeKey(String(t)))
        );
        // Ordered by how much it identifies the project. The responsive tiers
        // below reveal the first N of these, so the order IS the priority.
        const metaParts = [
          { label: 'Year',     val: p.data.year },
          { label: 'Location', val: p.data.location },
          { label: 'Status',   val: p.data.status },
        ].filter(m => m.val && !axisLabels.has(dedupeKey(String(m.val))));
        // All images — cover first, then the rest; strip is horizontally scrollable
        const allImgs: string[] = [];
        if (p.id === 'ai-works') {
          allImgs.push(...aiWorksImages);
        } else {
          if (p.data.coverImage) allImgs.push(p.data.coverImage);
          if (p.data.multiImage) allImgs.push(...(p.data.multiImage as string[]));
        }
        // Scrub shows only the curated set when a project defines one
        const scrubImgsRaw: string[] = (p.data.scrubImages as string[] | undefined)?.length
          ? (p.data.scrubImages as string[])
          : allImgs;
        const isLocked = isProjectLocked(p.id, p.data?.passcode);
        // A locked project shows no imagery anywhere in a listing.
        const scrubImgs = visibleProjectImages(p.id, p.data?.passcode, scrubImgsRaw);
        return (
        <div
          class:list={["project-card", isLocked && "is-locked"]}
          data-name={p.data.name}
          data-loc={p.data.location ?? ''}
          data-year={p.data.year ?? ''}
          data-client={p.data.client ?? ''}
          data-status={p.data.status ?? ''}
          data-size={p.data.size ?? ''}
          data-program={p.data.program ?? ''}
          data-cat={p.data.category ? (catMap[p.data.category.id] || p.data.category.id) : ''}
          data-studio={studioLabel}
          data-cat-id={p.data.category ? p.data.category.id : ''}
          data-tags={(p.data.tags ?? []).map(t => tagMap[t.id] || t.id).join(',')}
          data-tag-ids={(p.data.tags ?? []).map(t => t.id).join(',')}
        >
          <!-- Header -->
          <div class="project-card__header">
            <h2 class:list={["project-card__stack-name", isLocked && "is-locked"]}>{p.data.name}</h2>
            <span class="project-card__stack-right">
              <a
                href={`/projects/${p.id}`}
                class="project-card__pill"
                aria-label={`Go to ${p.data.name}`}
                title={`Go to ${p.data.name}`}
              >
                <Icon name="arrow" />
              </a>
            </span>
          </div>

          <div class="project-card__body">
            <div class="project-card__body-inner">
              <div class="project-card__columns">
                <!-- Left: description -->
                <div class="project-card__description-col">
                  <p class="project-card__intro">{p.data.smallIntro}</p>
                  {p.data.description && (
                    <p class="project-card__desc">
                      {p.data.description.replace(/<[^>]*>/g, '').substring(0, 120) + (p.data.description.replace(/<[^>]*>/g, '').length > 120 ? '...' : '')}
                    </p>
                  )}
                </div>

                <!-- Right: scrollable thumbnail strip (omitted entirely when a
                     project has no images — no empty column) -->
                {scrubImgs.length > 0 && (
                <div class="project-card__image-col">
                  <div class:list={['project-card__thumbs-scroll', scrubImgs.length < 5 && 'is-few']}>
                    {scrubImgs.map((src, idx) => (
                      <button
                        type="button"
                        class="project-card__thumb-item"
                        data-src={src}
                        data-alt={p.data.name}
                        aria-label={`View image ${idx + 1} of ${p.data.name}`}
                      >
                        <img src={src} alt={`${p.data.name} ${idx + 1}`} loading="lazy" />
                      </button>
                    ))}
                  </div>
                </div>
                )}
              </div>

              <!-- Bottom Bar -->
              <div class="project-card__bottom-bar">
                <div class="project-card__bottom-left">
                  <div class="project-card__metaline">
                    {metaParts.map((m) => (
                      <button
                        type="button"
                        class="project-card__meta-item project-card__filter-pill"
                        data-filter-value={String(m.val)}
                        title={`Show only ${m.val}`}
                      >
                        <span class="project-card__meta-val">{m.val}</span>
                        <Icon name="arrow" />
                      </button>
                    ))}
                  </div>
                </div>
                <!-- Three axes, widest first: bucket, then studio within it,
                     then what the work actually is. Each says a different
                     thing, so none of them repeats another. -->
                <div class="project-card__bottom-right">
                  {[categoryLabel, studioLabel, ...tagsArr].filter(Boolean).map(label => (
                    <button
                      type="button"
                      class="project-card__filter-pill"
                      data-filter-value={String(label)}
                      title={`Show only ${label}`}
                    >
                      <span>{label}</span>
                      <Icon name="arrow" />
                    </button>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </div>
        );
      })}
    </div>
    </div> <!-- End projects-top-section -->

    <!-- Bottom Section: Bubbles interface — styled to match Footer -->
    <div class="projects-bottom-section">
      <!-- Bottom quick-search bubbles — all projects, grey by default, highlight on match -->
      <div class="proj-bubbles" id="proj-bubbles" aria-label="Quick project search">
        {sorted.map(p => {
          const tagsArr = (p.data.tags ?? []).map(t => tagMap[t.id] || t.id);
          return (
            <a
              href={`/projects/${p.id}`}
              class="proj-bubble"
              data-name={p.data.name}
              data-loc={p.data.location ?? ''}
              data-year={p.data.year ?? ''}
              data-client={p.data.client ?? ''}
              data-status={p.data.status ?? ''}
              data-program={p.data.program ?? ''}
              data-cat={p.data.category ? (catMap[p.data.category.id] || p.data.category.id) : ''}
              data-studio={p.data.studio ? (studioMap[p.data.studio.id] || p.data.studio.id) : ''}
              data-tags={tagsArr.join(',')}
            >
              <span class="proj-bubble__name" data-short={p.data.shortName || abbrevName(p.data.name)} data-full={p.data.name}>{p.data.shortName || abbrevName(p.data.name)}</span>
              <span class="proj-bubble__tag">{tagsArr[0] || (p.data.category ? catMap[p.data.category.id] : 'Design')}</span>
              <Arrow class="proj-bubble__arrow" />
            </a>
          );
        })}
      </div>
    </div>

    <!-- Desktop hover preview — shared, top-level so it overlays all cards -->
    <div class="project-card__hover-preview" id="desktop-preview">
      <img class="project-card__hover-preview-img" id="desktop-preview-img" src="" alt="" />
    </div>

    <!-- Single full-screen frosted-glass background. The card's scrub strip is
         lifted sharp on top; image fills the larger region; link + ✕ bar by the strip -->
    <div class="project-lightbox" id="project-lightbox" aria-hidden="true">
      <div class="project-lightbox__image-area" id="lightbox-image-area">
        <img class="project-lightbox__img" id="lightbox-img" src="" alt="" />
      </div>
      <h2 class="project-lightbox__title" id="lightbox-title"></h2>
      <div class="project-lightbox__bar" id="lightbox-bar">
        <a class="project-lightbox__link" id="lightbox-link" href="#">
          <span>Go to project</span>
          <Icon name="arrow" />
        </a>
        <button class="project-lightbox__close" id="lightbox-close" type="button" aria-label="Close image">
          <Icon name="close" />
        </button>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  :global(html) {
    /* This page opts INTO snapping (see --page-snap below). The rule has to
       stay var-driven rather than a flat `none`, because it and the one in
       Base both carry !important on `html` — whichever lands later would
       otherwise decide, and this one used to hard-disable snapping on the
       very page that wants it. */
    scroll-snap-type: var(--page-snap, none) !important;
    scroll-behavior: smooth;
    /* Opening the panel adds ~144px above the fold, and scroll anchoring
       "helpfully" pushed the scroll position down to compensate — which read
       as leaving the top, which closed the panel again, which moved it back.
       The page oscillated between 4px and 252px. Nothing else on this page
       relies on anchoring. */
    overflow-anchor: none;
    /* Anchored jumps land clear of the pinned bar, same measured offset the
       snap points use; 64px is the fallback before the script measures. */
    scroll-padding-top: var(--snap-offset, 64px);
  }

  @media (max-width: 699.98px) {
    :global(html) {
      /* The bar still pins here even though the breadcrumb docks to the
         bottom, so the snapport inset is the bar, not a token 12px. */
      scroll-padding-top: var(--snap-offset, 12px);
    }
  }

  .projects-page {
    padding-top: calc(clamp(2rem, 5vh, 3rem) + 48px); /* = home hero padding */
    padding-bottom: var(--_tokens---space--small);
    min-height: 100dvh;
    box-sizing: border-box;
    position: relative;
  }

  @media (max-width: 1023.98px) {
    .projects-page {
      padding-top: 0;
    }
  }

  @media (max-width: 699.98px) {
    .projects-page {
      padding-bottom: 80px; /* space for mobile bottom docked breadcrumbs */
    }
  }

  /* Sticky search + filter bar — sticks below the breadcrumb; the title above
     it scrolls away normally */
  .projects-sticky-header {
    position: sticky;
    top: 64px; /* parks just below the fixed breadcrumb */
    z-index: 90; /* Lower than Breadcrumb (100) and SideNav (200) */
    background-color: transparent; /* transparent to let bubbles float independently */
    padding-inline: 0; /* aligned flush with projects-header and project-card */
    padding-top: 16px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--_tokens---color--line-soft);
    transition: background-color var(--_tokens---motion--base) ease;
    pointer-events: none; /* let clicks pass through empty space */
  }

  .projects-sticky-header > * {
    pointer-events: auto; /* restore clickability for search input and filter controls */
  }

  /* The header scrolls in-flow now, so the old fixed blur overlay and the
     0–64px breadcrumb mask strip are gone — the fixed breadcrumb bar has its
     own opaque background. */
  .projects-header-blur-overlay {
    display: none;
  }

  .projects-header {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    border-top: none;
    /* No rule under the title — see .page-toggle-header in tokens.css. */
    border-bottom: none;
    padding-block: 18px 20px;
    margin-bottom: 0;
  }

  .projects-header__right {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-shrink: 0;
  }

  .projects-title-slot {
    position: relative;
    flex: 1;
    min-width: 0;
  }

  /* Title — H1 big on desktop; family small style on mobile */
  .projects-title {
    font-size: var(--_tokens---type--medium);
    font-weight: var(--_tokens---weight--base);
    color: var(--_tokens---color--fg);
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin: 0;
  }

  .projects-collapsed-search {
    display: none;
    width: 100%;
    min-width: 0;
    height: 56px;
    padding: 0 18px;
    border: 0;
    border-radius: 4px;
    outline: 0;
    background: color-mix(in srgb, var(--_tokens---color--fg) 6%, transparent);
    color: var(--_tokens---color--fg);
    -webkit-text-fill-color: var(--_tokens---color--fg);
    caret-color: var(--_tokens---color--fg);
    font: inherit;
    font-size: var(--_tokens---type--medium);
    font-weight: var(--_tokens---weight--base);
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .projects-collapsed-search::placeholder {
    font-weight: var(--_tokens---weight--light);
    color: color-mix(in srgb, var(--_tokens---color--fg) 34%, transparent);
    -webkit-text-fill-color: color-mix(in srgb, var(--_tokens---color--fg) 34%, transparent);
    opacity: 1;
  }

  .projects-search-input::-webkit-search-cancel-button,
  .projects-collapsed-search::-webkit-search-cancel-button {
    -webkit-appearance: none;
    appearance: none;
    display: none;
  }

  .projects-title-slot .projects-collapsed-search-clear {
    display: none;
  }

  .projects-header:has(.page-toggle-btn[aria-expanded="false"]) .projects-title {
    display: none;
  }

  .projects-header:has(.page-toggle-btn[aria-expanded="false"]) .projects-collapsed-search {
    display: block;
  }

  .projects-header:has(.page-toggle-btn[aria-expanded="false"]) .projects-collapsed-search-clear:not([hidden]) {
    display: inline-flex;
  }

  .projects-header:has(.page-toggle-btn[aria-expanded="false"]) + .projects-sticky-header {
    padding-top: 0;
    padding-bottom: 0;
    margin-top: 0;
  }

  .projects-header:has(.page-toggle-btn[aria-expanded="false"]) {
    padding-bottom: 4px;
  }

  .projects-fixed-wrapper:has(.page-toggle-btn[aria-expanded="false"]) + .project-cards-container {
    margin-top: 0;
  }

  @media (max-width: 1023.98px) {
    .projects-title {
      font-size: var(--_tokens---type--medium) !important;
      font-weight: var(--_tokens---weight--base) !important;
      letter-spacing: -0.02em !important;
      line-height: 1.1 !important;
      text-transform: none !important;
      color: var(--_tokens---color--fg) !important;
    }
  }

  .projects-count {
    font-size: var(--_tokens---type--micro);
    font-weight: var(--_tokens---weight--light);
    letter-spacing: 0.04em;
    color: var(--_tokens---color--muted);
    margin: 0;
    white-space: nowrap;
  }

  /* Search Bar — ONE full-length bar; the clear ✕ floats inside its right edge */
  .projects-search-bar {
    position: relative;
    display: flex;
    margin: 0 0 18px;
    width: 100%;
    max-width: 100%;
  }

  .projects-search-input {
    flex: 1;
    min-width: 0;
    height: clamp(72px, 6.5vw, 104px);
    padding: 0 76px 0 32px; /* right side clears the inline ✕ */
    font-size: clamp(2rem, 1.375rem + 3.5vw, 4rem);
    font-weight: var(--_tokens---weight--base);
    letter-spacing: -0.01em;
    font-family: inherit;
    background: color-mix(in srgb, var(--_tokens---color--fg) 6%, transparent);
    border: none;
    color: var(--_tokens---color--fg);
    -webkit-text-fill-color: var(--_tokens---color--fg);
    caret-color: var(--_tokens---color--fg);
    border-radius: 4px;
    outline: none;
    opacity: 1;
    transition: background-color var(--_tokens---motion--base);
  }

  .projects-search-input::placeholder {
    font-weight: var(--_tokens---weight--light);
    color: color-mix(in srgb, var(--_tokens---color--fg) 34%, transparent);
    -webkit-text-fill-color: color-mix(in srgb, var(--_tokens---color--fg) 34%, transparent);
    opacity: 1;
  }

  /* Clears the search AND all filters — always available, inside the field */
  .projects-search-clear {
    position: absolute;
    right: 14px;
    top: 50%;
    transform: translateY(-50%);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    padding: 0;
    background: none;
    border: none;
    border-radius: 50%;
    color: var(--_tokens---color--muted);
    cursor: pointer;
    transition: background-color var(--_tokens---motion--base), color var(--_tokens---motion--base);
  }

  .projects-search-clear[hidden] {
    display: none;
  }

  .projects-search-clear__icon {
    --icon-size: 18px;
    flex-shrink: 0;
  
  }

  @media (hover: hover) {
    .projects-search-clear:hover {
    background-color: var(--_tokens---color--fg);
    color: var(--_tokens---color--bg);
  }
  }

  /* Filters (Dropdown Category + Scrollable Tag Picker) */
  .filter-bar {
    display: flex;
    flex-direction: row;
    gap: 32px;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    max-width: 100%;
    margin: 0;
  }

  .filter-group {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .filter-group--tags {
    flex: 1;
    min-width: 0;
    opacity: 0.35; /* grayed out by default */
    transition: opacity var(--_tokens---motion--base) ease;
  }

  .filter-group--tags:focus-within, .filter-group--tags.is-active {
    opacity: 1; /* activated */
  }
  @media (hover: hover) {
    .filter-group--tags:hover {
    opacity: 1; /* activated */
  }
  }

  .filter-label {
    font-size: var(--_tokens---type--micro);
    font-weight: var(--_tokens---weight--light);
    text-transform: none;
    letter-spacing: 0.08em;
    color: var(--_tokens---color--muted);
    flex-shrink: 0;
  }

  .filter-select-wrap {
    position: relative;
    display: inline-block;
    flex-shrink: 0;
    opacity: 0.35; /* grayed out by default */
    transition: opacity var(--_tokens---motion--base) ease;
  }

  .filter-select-wrap:focus-within, .filter-select-wrap.is-active {
    opacity: 1; /* activated */
  }
  @media (hover: hover) {
    .filter-select-wrap:hover {
    opacity: 1; /* activated */
  }
  }

  .filter-select {
    appearance: none;
    -webkit-appearance: none;
    background-color: color-mix(in srgb, var(--_tokens---color--fg) 6%, transparent);
    color: var(--_tokens---color--fg);
    font-family: inherit;
    font-size: var(--_tokens---type--micro);
    font-weight: var(--_tokens---weight--light);
    text-transform: none;
    letter-spacing: 0.04em;
    border: none;
    border-radius: var(--_tokens---radius--pill);
    padding: 10px 40px 10px 20px;
    cursor: pointer;
    outline: none;
    min-width: 180px;
    transition: background-color var(--_tokens---motion--base);
  }

  @media (hover: hover) {
    .filter-select:hover {
    background-color: color-mix(in srgb, var(--_tokens---color--fg) 10%, transparent);
  }
  }

  .filter-select option {
    background-color: var(--_tokens---color--bg);
    color: var(--_tokens---color--fg);
  }

  .filter-select-arrow {
    --icon-size: var(--_tokens---arrow--md);
    position: absolute;
    right: 14px;
    top: 50%;
    transform: translateY(-50%);
    font-size: var(--_tokens---type--micro);
    pointer-events: none;
    color: var(--_tokens---color--fg);
    opacity: 0.7;
    
  }

  /* Tag horizontal scrollable picker */
  .tag-picker-wrapper {
    display: flex;
    align-items: center;
    gap: 12px;
    flex: 1;
    min-width: 0;
  }

  .tag-picker-divider {
    color: color-mix(in srgb, var(--_tokens---color--fg) 15%, transparent);
    font-weight: var(--_tokens---weight--light);
    font-size: var(--_tokens---type--micro);
    user-select: none;
    flex-shrink: 0;
  }

  .tag-scroll-nav {
    display: flex;
    align-items: center;
    gap: 4px;
    flex: 1;
    min-width: 0;
  }

  .tag-scroll-arrow {
    display: none;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: none;
    background-color: color-mix(in srgb, var(--_tokens---color--fg) 6%, transparent);
    color: var(--_tokens---color--fg);
    cursor: pointer;
    flex-shrink: 0;
    transition: background-color var(--_tokens---motion--base), opacity var(--_tokens---motion--base);
    opacity: 0.8;
  }

  @media (hover: hover) {
    .tag-scroll-arrow:hover {
    background-color: color-mix(in srgb, var(--_tokens---color--fg) 12%, transparent);
    opacity: 1;
  }
  }

  .tag-scroll-arrow:disabled {
    opacity: 0.15;
    cursor: not-allowed;
  }

  .tag-scroll-arrow svg {
    --icon-size: 16px;
  }

  .tag-picker-container {
    flex: 1;
    min-width: 0;
    max-width: 420px;
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    padding-bottom: 2px;
    scroll-behavior: smooth;
  }

  .tag-picker-container::-webkit-scrollbar {
    display: none;
  }

  .tag-picker {
    display: flex;
    gap: 8px;
    white-space: nowrap;
    width: max-content;
  }

  .tag-picker-item {
    background-color: transparent;
    color: var(--_tokens---color--fg);
    border: 1px solid color-mix(in srgb, var(--_tokens---color--fg) 22%, transparent);
    border-radius: var(--_tokens---radius--pill);
    padding: 6px 14px;
    font-size: var(--_tokens---type--micro);
    font-weight: var(--_tokens---weight--base);
    text-transform: none;
    letter-spacing: 0.04em;
    cursor: pointer;
    transition: background-color var(--_tokens---motion--base) ease, border-color var(--_tokens---motion--base) ease, color var(--_tokens---motion--base) ease;
  }

  .tag-picker-item.is-active {
    background-color: var(--_tokens---color--fg);
    color: var(--_tokens---color--bg);
    border-color: var(--_tokens---color--fg);
  }
  @media (hover: hover) {
    .tag-picker-item:hover {
    background-color: var(--_tokens---color--fg);
    color: var(--_tokens---color--bg);
    border-color: var(--_tokens---color--fg);
  }
  }

  /* ── Card snapping ──────────────────────────────────────────────────
     Each card slots under the pinned bar as you scroll, so the list settles
     on a whole card rather than halfway through one.

     `proximity`, not `mandatory`. Mandatory snaps from anywhere, which fights
     the user on a card taller than the viewport — you can end up unable to
     reach the middle of one. Proximity only pulls when you are already close,
     which is the resistance this wants and nothing more.

     The inset that keeps a snapped card clear of the bar is scroll-padding on
     the scrollport, and ONLY that. Setting scroll-margin on the cards as well
     stacks the two: cards landed a full bar-height too low, identically at
     every nudge, which is what a double inset looks like rather than a broken
     snap. It is measured, because the bar's height changes when the search
     panel folds and again between bands. */
  .project-card {
    scroll-snap-align: start;
  }

  /* ── Accordion Card List ── */
  .project-cards-container {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-top: 8px; /* sticky bar is in normal flow now — no big clearance needed */
  }

  .project-card {
    width: 100%;
    box-sizing: border-box;
    cursor: default;
    background-color: color-mix(in srgb, var(--_tokens---color--fg) 2.5%, var(--_tokens---color--bg));
    border-top: none;
    border-left: none;
    border-right: none;
    border-bottom: 1px solid var(--_tokens---color--line-soft);
    padding-block: 16px 14px;
    border-radius: 0;
    overflow: visible;
    box-shadow: 0 8px 24px -10px color-mix(in srgb, var(--_tokens---color--fg) 12%, transparent);
    /* No isolation: the fixed hover-preview must escape the card's stacking
       context so the image floats above ALL cards, not just its own */
  }

  .project-card.is-keyboard-selected {
    background-color: color-mix(in srgb, var(--_tokens---color--fg) 8%, var(--_tokens---color--bg));
    outline: 1px solid color-mix(in srgb, var(--_tokens---color--fg) 30%, transparent);
    outline-offset: -1px;
  }

  .project-card[hidden] { display: none !important; }

  /* ── Always-visible header strip ── */
  .project-card__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 4px 20px 6px;
    user-select: none;
  }

  .project-card__stack-name {
    font-size: clamp(2rem, 1.375rem + 3.5vw, 4rem); /* between --type--medium and --type--big */
    font-weight: var(--_tokens---weight--base);
    letter-spacing: -0.01em;
    /* A project name is never truncated, at any width — it is the one field
       every tier has to deliver in full. `nowrap` + ellipsis used to cut 16
       of 50 names at 390px and still clipped the longest four on desktop
       ("TOQW Tower of Quiet Witness"). Two lines at full scale instead. */
    white-space: normal;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    color: var(--_tokens---color--fg);
    transition: opacity var(--_tokens---motion--base) ease;
    margin: 0;
  }

  /* ── Protected vs live projects ──────────────────────────────────────
     A locked project is still listed — the point is that it exists, not
     that it is readable — so the whole card recedes rather than only its
     title. Before this, muting stopped at the name and the intro, summary
     and pills below it were rendered at full strength, so a protected card
     read as live from the second line down.

     Carried on the text, not the card, so the border and background keep
     the list's rhythm and a locked row does not punch a hole in it. The
     arrow stays more legible than the copy: it is the one thing you can
     still act on. */
  .project-card.is-locked .project-card__stack-name,
  .project-card.is-locked .project-card__intro,
  .project-card.is-locked .project-card__desc,
  .project-card.is-locked .project-card__bottom-bar {
    opacity: 0.32;
    transition: opacity var(--_tokens---motion--base) ease;
  }

  .project-card.is-locked .project-card__pill {
    opacity: 0.55;
  }

  @media (hover: hover) {
    .project-card.is-locked:hover .project-card__stack-name,
    .project-card.is-locked:hover .project-card__intro,
    .project-card.is-locked:hover .project-card__desc,
    .project-card.is-locked:hover .project-card__bottom-bar {
      opacity: 0.5;
    }
    .project-card.is-locked:hover .project-card__pill {
      opacity: 1;
    }
  }

  .project-card__stack-right {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
  }

  .project-card__stack-tags,
  .project-card__stack-year {
    font-size: var(--_tokens---type--micro);
    font-weight: var(--_tokens---weight--light);
    color: var(--_tokens---color--muted);
    white-space: nowrap;
  }

  /* ── Pill / CTA button ── */
  /* The label is gone and the arrow carries the whole affordance, so the pill
     becomes the circle that holds it. --arrow--lg is the step the design
     system specifies for exactly this case: a standalone row where the arrow
     IS the control, rather than a glyph trailing a word. */
  .project-card__pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    gap: 0;
    font-size: var(--_tokens---type--small);
    font-weight: var(--_tokens---weight--base);
    color: var(--_tokens---color--fg);
    text-decoration: none;
    border: 1px solid color-mix(in srgb, var(--_tokens---color--fg) 22%, transparent);
    border-radius: 50%;
    white-space: nowrap;
    flex-shrink: 0;
    --icon-size: var(--_tokens---arrow--lg);
    transition: background-color var(--_tokens---motion--base) ease, border-color var(--_tokens---motion--base) ease, color var(--_tokens---motion--base) ease;
  }

  .project-card__pill svg {
    transition: transform var(--_tokens---motion--base) ease;
  }

  @media (hover: hover) {
    .project-card__pill:hover {
    background-color: var(--_tokens---color--fg);
    color: var(--_tokens---color--bg);
    border-color: var(--_tokens---color--fg);
  }
  }

  @media (hover: hover) {
    .project-card__pill:hover svg { transform: translate(2px, -2px); }
  }

  /* Cards are always open — no accordion, no clipping */
  .project-card__body {
    overflow: visible;
  }

  .project-card__body-inner {
    position: relative;
    overflow: visible;
    min-height: 0;
  }

  .project-card__columns {
    display: flex;
    flex-direction: row;
    width: 100%;
    min-height: 76px;
    overflow: visible;
    position: relative;
  }

  .project-card__description-col {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 2px 20px 6px;
    box-sizing: border-box;
  }

  .project-card__intro {
    font-size: var(--_tokens---type--small);
    font-weight: var(--_tokens---weight--strong); /* semibold */
    line-height: 1.4; /* slightly tighter */
    color: var(--_tokens---color--muted);
    margin: 0;
    max-width: 62ch;
  }

  .project-card__desc {
    font-size: var(--_tokens---type--micro); /* micro size */
    line-height: 1.55;
    color: var(--_tokens---color--muted);
    margin: 0;
    max-width: 62ch;
    opacity: 0.85;
  }

  .project-card__image-col {
    width: 40%;
    flex-shrink: 0;
    overflow: hidden;
    position: relative;
    display: flex;
    align-items: stretch;
    background: none;
  }

  /* ── Thumbnail strip: shows exactly 5 thumbs; >5 scrolls horizontally ── */
  .project-card__thumbs-scroll {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    overflow: hidden; /* strip never scrolls — JS prunes it to 5 random thumbs */
    width: 100%;
    height: 100%;
    gap: 0;
    padding: 0;
    background: none;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .project-card__thumbs-scroll::-webkit-scrollbar { display: none; }

  /* Fewer than 5 images → arrange from the right (no scroll needed) */
  .project-card__thumbs-scroll.is-few { justify-content: flex-end; }

  /* Square thumbnails sized so 5 fill the strip; a 6th+ overflows → scroll */
  .project-card__thumb-item {
    all: unset;
    flex: 0 0 20%; /* 5 thumbs filling the strip completely */
    aspect-ratio: 1;
    max-height: 100%;
    overflow: hidden;
    cursor: crosshair;
    position: relative;
  }

  .project-card__thumb-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: opacity var(--_tokens---motion--fast) ease, filter var(--_tokens---motion--fast) ease;
  }

  /* While a preview is active: the scrubbed thumbnail stays in colour, the rest
     drop to grayscale so the active image reads clearly */
  .project-card.is-previewing .project-card__thumb-item img {
    filter: grayscale(1);
    opacity: 0.5;
  }
  .project-card.is-previewing .project-card__thumb-item.is-active img {
    filter: none;
    opacity: 1;
  }

  /* ── Scrub preview: big image filling the left 60% of the viewport, centered,
        independent of card height. Fixed → escapes the card bounds entirely. ── */
  .project-card__hover-preview {
    position: fixed;
    left: 44px; /* clear the side-nav index bar */
    top: 0;     /* grows up beneath the frosted breadcrumb (it sits over the image) */
    bottom: 0;
    width: 56vw; /* left ~60% of the screen, minus the side-nav bar */
    z-index: 95; /* above all cards, under breadcrumb (100) + sidenav (200) */
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 48px;
    box-sizing: border-box;
    background-color: var(--_tokens---color--bg-glass); /* same glass as the mobile preview / breadcrumb */
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--_tokens---motion--base) ease;
  }

  .project-card__hover-preview.is-visible {
    opacity: 1;
    pointer-events: none; /* scrubbing passes through to the thumbnails */
  }

  /* As big as it can fit in the left 60%, centered. Portrait images go tall. */
  .project-card__hover-preview-img {
    max-width: 100%;
    max-height: 90vh;
    width: auto;
    height: auto;
    object-fit: contain;
    display: block;
  }

  /* No placeholder art: projects without images leave the space empty */

  /* One left-aligned line: the facts, then the taxonomy. The pills used to be
     pushed to the right edge on their own axis, which read as a second,
     competing column. Everything now sits on the reading edge at the smallest
     step on the type scale, so the card has one baseline to scan, not two. */
  .project-card__bottom-bar {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    flex-wrap: nowrap;
    padding: 6px 20px 4px;
    box-sizing: border-box;
    font-size: var(--_tokens---type--ultrathin);
    color: var(--_tokens---color--muted);
    gap: var(--_tokens---pill-gap);
    min-width: 0;
    /* Hidden-scrollbar strip rather than a clip, so a long combination stays
       reachable instead of being cut off. initScrollFades() finds this by
       inspection and adds the affordance. */
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .project-card__bottom-bar::-webkit-scrollbar {
    display: none;
  }

  /* Says "there is more to the right" without a scrollbar. Anchored to the
     padding box, so it stays at the edge while the row scrolls under it. A
     row that fits ends before the fade zone and is untouched — which is why
     this needs no JS to detect the overflow. */
  .project-card__bottom-bar {
    -webkit-mask-image: linear-gradient(to right, #000 calc(100% - 20px), transparent 100%);
    mask-image: linear-gradient(to right, #000 calc(100% - 20px), transparent 100%);
  }

  .project-card__bottom-left {
    display: flex;
    align-items: center;
    flex: 0 0 auto;
  }

  .project-card__bottom-right {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    flex-wrap: nowrap;
    gap: var(--_tokens---pill-gap);
    flex: 0 0 auto;
    font-weight: var(--_tokens---weight--light);
  }

  /* One pill spec for all three axes — bucket, studio and discipline are the
     same kind of object, so they get the same object's styling. On the house
     tokens (xs padding, the mid border that holds against body text) rather
     than the hand-rolled values this used to carry. */
  /* All six are the same object and now the same control: every value on the
     row filters the list to the projects that share it. One spec, on the
     house tokens, with the arrow that means "this goes somewhere". */
  .project-card__filter-pill,
  .project-card__meta-item {
    display: inline-flex;
    align-items: center;
    gap: var(--_tokens---pill-gap--xs);
    color: var(--_tokens---color--muted);
    background: color-mix(in srgb, var(--_tokens---color--fg) 5%, transparent);
    border: var(--_tokens---pill-border--mid);
    border-radius: var(--_tokens---radius--pill);
    padding: var(--_tokens---pill-pad--xs);
    font-family: inherit;
    font-size: var(--_tokens---type--ultrathin);
    font-weight: var(--_tokens---weight--light);
    line-height: 1.1;
    white-space: nowrap;
    cursor: pointer;
    /* Ultrathin label, so the small step on the arrow scale. */
    --icon-size: var(--_tokens---arrow--sm);
    transition: background-color var(--_tokens---motion--base) ease,
                border-color var(--_tokens---motion--base) ease,
                color var(--_tokens---motion--base) ease;
  }

  .project-card__filter-pill svg,
  .project-card__meta-item svg {
    flex-shrink: 0;
    opacity: 0.55;
    transition: opacity var(--_tokens---motion--base) ease;
  }

  @media (hover: hover) {
    .project-card__filter-pill:hover,
    .project-card__meta-item:hover {
      background-color: var(--_tokens---color--fg);
      color: var(--_tokens---color--bg);
      border-color: var(--_tokens---color--fg);
    }
    .project-card__filter-pill:hover svg,
    .project-card__meta-item:hover svg {
      opacity: 1;
    }
  }

  .project-card__filter-pill:focus-visible,
  .project-card__meta-item:focus-visible {
    outline: 2px solid var(--_tokens---color--fg);
    outline-offset: 2px;
  }

  .project-card__metaline {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: var(--_tokens---pill-gap);
    font-size: var(--_tokens---type--ultrathin);
    white-space: nowrap;
  }

  /* Every item on the row is the same object, so it gets the same object's
     styling — see .project-card__filter-pill, which this shares a rule with.
     Dot separators are gone: pills carry their own edges, and a dot between
     two of them reads as a third thing. */
  .project-card__meta-item { flex-shrink: 0; }
  .project-card__meta-val { color: inherit; font-weight: inherit; }

  /* ── Meta ladder ───────────────────────────────────────────────────────
     metaParts is ordered Year, Location, Status — most identifying first —
     so each tier reveals the first N and never repeats the tier below.
       compact  (<700)      Year
       medium+  (>=700)     + Location, Status
     Client and Program are deliberately absent. Both were long enough to
     outweigh the whole rest of the row ("Specialty Restaurants Private
     Limited", "Hospitality Interior") while identifying the project less
     than its year does, and Program largely restated the discipline pill.
     The >=1024 step for this row is therefore a no-op by design; the
     n + 4 rule below is kept so the ladder still holds if a field returns. */
  @media (max-width: 699.98px) {
    .project-card__meta-item:nth-child(n + 2) {
      display: none;
    }
  }

  @media (min-width: 700px) and (max-width: 1023.98px) {
    .project-card__meta-item:nth-child(n + 4) {
      display: none;
    }
  }

  .project-card__pill--cta {
    padding: 8px 16px;
    font-size: var(--_tokens---type--small);
  }

  .projects-top-section {
    position: relative;
    width: 100%;
  }

  .projects-fixed-wrapper {
    display: contents;
  }

  /* ── Desktop: title + search + filters stay fixed while scrolling,
     parked below the top breadcrumb bar; cards scroll underneath.
     Clearance is measured by script (same mechanism as mobile). ── */
  @media (min-width: 1024px) {
    /* Sticky in BOTH states, not just collapsed — the bar you are using to
       filter should not be the first thing to leave when you scroll the
       results. The clearance above it is a margin, never padding: padding
       sits inside the sticky box and would inflate the pinned bar, and the
       margin has to equal `top` or sticky snaps the bar down by the
       difference and paints it over the first card. */
    .projects-fixed-wrapper {
      --stick-top: 56px;
      display: block;
      position: sticky;
      top: var(--stick-top);
      margin-top: var(--stick-top);
      padding: 0;
      z-index: 90;
      border-bottom: 1px solid var(--_tokens---color--line-soft);
      box-sizing: border-box;
    }
    /* Opaque once pinned, not frosted. At 92% the card text underneath stayed
       legible straight through the bar — blur smears an image, it does not
       hide 8% of a black glyph on a light ground. */
    .projects-fixed-wrapper.is-stuck {
      background-color: var(--_tokens---color--bg);
    }
    /* Open, the search field is 94px of display type — fine as a landing
       state, far too tall to carry down the page. Pinned, it stands down to
       roughly half that so the bar stays a bar. */
    .projects-search-input {
      transition: height var(--_tokens---motion--base) var(--_tokens---ease-out),
                  font-size var(--_tokens---motion--base) var(--_tokens---ease-out),
                  background-color var(--_tokens---motion--base);
    }
    .projects-fixed-wrapper.is-stuck .projects-search-input {
      height: 52px;
      font-size: var(--_tokens---type--medium);
      padding-inline: 20px 64px;
    }
    .projects-fixed-wrapper.is-stuck .projects-search-bar {
      margin-bottom: 10px;
    }
    .projects-fixed-wrapper.is-stuck .projects-header {
      padding-block: 10px 8px;
    }

    /* The bar parks BELOW the breadcrumb, which is a row of floating pills
       rather than a solid bar — so a 15px window of page was left between
       the two, and cards scrolled visibly through it. This seals that strip
       up to the top of the viewport. It sits at the wrapper's own z-index
       (90), under the breadcrumb (100), so the pills still read on top of
       it. Inset to the wrapper's width, which is also the cards' width, so
       there is nothing outside it to cover. */
    .projects-fixed-wrapper.is-stuck::before {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      bottom: 100%;
      height: var(--stick-top);
      background-color: var(--_tokens---color--bg);
      pointer-events: none;
    }
    .projects-page {
      padding-top: 0; /* clearance comes from the measured cards padding */
    }
    .projects-header {
      padding-inline: 0;
    }
    .projects-sticky-header {
      position: static;
      top: auto;
      padding-inline: 0;
      padding-top: 0;
      background-color: transparent;
    }
    .projects-sticky-header::before {
      display: none;
    }
    /* Drop the "Category" label on desktop (the dropdown reads for itself) and
       let the tag scroller stretch across the whole remaining row out to the
       right edge instead of capping at 420px — mirrors the mobile treatment. */
    .filter-label {
      display: none;
    }
    .filter-group {
      gap: 0;
    }
    .tag-picker-container {
      max-width: none;
    }
  }
  /* No gutter here. The wrapper is in-flow inside .page-main, which already
     applies it — adding it again inset the title/search/filters twice as far
     as the cards below them at wide widths. (This dates from when the wrapper
     was position:fixed and genuinely needed its own inset.) */



  /* ── Bottom quick-search section — matches Footer visual style ── */
  .projects-bottom-section {
