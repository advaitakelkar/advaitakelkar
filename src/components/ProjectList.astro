<script>
  import { shuffleChildren } from '../lib/random';

  const container = document.getElementById('project-cards-container');
  const cards = Array.from(container?.querySelectorAll<HTMLElement>('.project-card') ?? []);
  const searchInput = document.getElementById('projects-search-input') as HTMLInputElement;
  const collapsedSearchInput = document.getElementById('projects-collapsed-search') as HTMLInputElement;
  const clearBtn = document.getElementById('projects-search-clear');
  const collapsedClearBtn = document.getElementById('projects-collapsed-search-clear');
  const countLabel = document.querySelector('.projects-count');

  const catSelect = document.getElementById('cat-select') as HTMLSelectElement;
  const tagPicker = document.getElementById('tag-picker');

  let searchQuery = '';
  let activeCat = '';
  let activeTag = '';
  let keyboardProjectIndex = -1;
  const searchPrompts = [
    'Search by year',
    'Search by tag',
    'Search by location',
    'Search by category',
  ];
  let searchPromptIndex = 0;
  let searchPromptTimer: number | undefined;

  function stopSearchPrompts() {
    if (searchPromptTimer !== undefined) {
      window.clearInterval(searchPromptTimer);
      searchPromptTimer = undefined;
    }
  }

  function settleSearchPrompt() {
    stopSearchPrompts();
    if (searchInput) searchInput.placeholder = 'Search';
    if (collapsedSearchInput) collapsedSearchInput.placeholder = 'Search';
  }

  if (searchInput && !searchInput.value) {
    searchInput.placeholder = searchPrompts[0];
    searchPromptTimer = window.setInterval(() => {
      if (!searchInput.value) {
        searchPromptIndex = (searchPromptIndex + 1) % searchPrompts.length;
        searchInput.placeholder = searchPrompts[searchPromptIndex];
        if (collapsedSearchInput) collapsedSearchInput.placeholder = searchPrompts[searchPromptIndex];
      }
    }, 1400);
  }

  // ── State ──────────────────────────────────────────────────

  function getVisibleCards() {
    return cards.filter(c => !c.hidden);
  }

  function clearKeyboardProjectSelection() {
    cards.forEach(card => {
      card.classList.remove('is-keyboard-selected');
      card.removeAttribute('aria-current');
    });
    keyboardProjectIndex = -1;
  }

  function moveKeyboardProjectSelection(direction: 1 | -1) {
    const visibleCards = getVisibleCards();
    if (!visibleCards.length) return;

    cards.forEach(card => {
      card.classList.remove('is-keyboard-selected');
      card.removeAttribute('aria-current');
    });

    if (keyboardProjectIndex < 0) {
      keyboardProjectIndex = direction > 0 ? 0 : visibleCards.length - 1;
    } else {
      keyboardProjectIndex = (keyboardProjectIndex + direction + visibleCards.length) % visibleCards.length;
    }

    const selectedCard = visibleCards[keyboardProjectIndex];
    selectedCard.classList.add('is-keyboard-selected');
    selectedCard.setAttribute('aria-current', 'true');
    selectedCard.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
  }

  // Click to toggle open/close has been removed - cards are statically open.



  function applyVisibility(matchingCards: HTMLElement[]) {
    clearKeyboardProjectSelection();
    cards.forEach(card => {
      card.hidden = true;
    });
    matchingCards.forEach(card => { card.hidden = false; });
    if (countLabel) {
      countLabel.textContent = `${matchingCards.length} of ${cards.length} works`;
    }
  }

  // Project cards: shuffle so the list order is different on every load
  if (container) shuffleChildren(container);

  // Bottom bubbles: always present, grey by default, highlight on search match
  const grid = document.getElementById('proj-bubbles');
  if (grid) shuffleChildren(grid);

  // Hover name swap: abbreviated → full on mouseenter, back on mouseleave
  document.querySelectorAll<HTMLElement>('.proj-bubble__name').forEach(nameEl => {
    const bubble = nameEl.closest('.proj-bubble') as HTMLElement;
    if (!bubble) return;
    bubble.addEventListener('mouseenter', () => {
      nameEl.textContent = nameEl.dataset.full ?? nameEl.textContent;
    });
    bubble.addEventListener('mouseleave', () => {
      nameEl.textContent = nameEl.dataset.short ?? nameEl.textContent;
    });
  });

  const bubbles = document.querySelectorAll<HTMLElement>('.proj-bubble');
  function updateBubbles(keywords: string[]) {
    if (grid) {
      grid.classList.toggle('has-search', keywords.length > 0);
    }
    bubbles.forEach(b => {
      if (!keywords.length) { b.classList.remove('is-match'); return; }
      const hay = [
        b.dataset.name, b.dataset.loc, b.dataset.year, b.dataset.client,
        b.dataset.status, b.dataset.program, b.dataset.cat, b.dataset.studio, b.dataset.tags
      ].join(' ').toLowerCase();
      b.classList.toggle('is-match', keywords.every(kw => hay.includes(kw)));
    });
  }

  function updateFieldActivation() {
    // 1. Search input
    if (searchInput) {
      if (searchInput.value.trim()) searchInput.classList.add('is-active');
      else searchInput.classList.remove('is-active');
    }
    // 2. Category select dropdown
    const selectWrap = document.querySelector('.filter-select-wrap');
    if (catSelect && selectWrap) {
      if (catSelect.value) selectWrap.classList.add('is-active');
      else selectWrap.classList.remove('is-active');
    }
    // 3. Tag group wrapper
    const tagGroup = document.querySelector('.filter-group--tags');
    if (tagGroup) {
      if (activeTag) tagGroup.classList.add('is-active');
      else tagGroup.classList.remove('is-active');
    }
    if (clearBtn) {
      clearBtn.hidden = !(searchQuery.trim() || activeCat || activeTag);
    }
    if (collapsedClearBtn) {
      collapsedClearBtn.hidden = !(searchQuery.trim() || activeCat || activeTag);
    }
  }

  // A card is dense at rest and thinned out while you are working. "Working"
  // is either scrolling or filtering — both mean you are hunting one project
  // rather than browsing them, and imagery and pills are in the way of that.
  // Lives here rather than with the sticky logic because the filter state it
  // depends on is in this scope.
  // TOP_ZONE, not a couple of pixels: snapping parks the page a few pixels
  // short of zero, and a 4px threshold read that as "scrolled" — which turned
  // into a latch, because snapping stays on while scrolled and keeps parking
  // it there. The zone has to be wider than any resting position snap can
  // leave behind. Kept in step with the same constant in the sticky script.
  // Searching swaps the list to names only — see the note in the compact
  // block. No scroll listener and no anchor compensation: nothing here
  // changes size while the list is moving, which is what made the previous
  // version restless.
  function updateCardDensity() {
    if (!container) return;
    const searching = Boolean(searchQuery.trim() || activeCat || activeTag);
    container.classList.toggle('is-searching', searching);
  }
  updateCardDensity();

  function applyFilter() {
    updateFieldActivation();
    updateCardDensity();
    const query = searchQuery.trim().toLowerCase();
    const keywords = query.split(/\s+/).filter(Boolean);

    const matchingCards: HTMLElement[] = [];

    cards.forEach(card => {
      const name = (card.dataset.name ?? '').toLowerCase();
      const loc = (card.dataset.loc ?? '').toLowerCase();
      const year = (card.dataset.year ?? '').toLowerCase();
      const client = (card.dataset.client ?? '').toLowerCase();
      const status = (card.dataset.status ?? '').toLowerCase();
      const size = (card.dataset.size ?? '').toLowerCase();
      const program = (card.dataset.program ?? '').toLowerCase();
      const cat = (card.dataset.cat ?? '').toLowerCase();
      // Studio moved off the tag list, so it needs indexing on its own or
      // searching "Studio 823" / "F'KD" would stop finding anything.
      const studio = (card.dataset.studio ?? '').toLowerCase();
      const tags = (card.dataset.tags ?? '').toLowerCase();
      const catId = card.dataset.catId ?? '';
      const tagIds = (card.dataset.tagIds ?? '').split(',').filter(Boolean);

      // smart multi-keyword match (AND logic)
      const searchMatch = !keywords.length || keywords.every(kw =>
        name.includes(kw) ||
        loc.includes(kw) ||
        year.includes(kw) ||
        client.includes(kw) ||
        status.includes(kw) ||
        size.includes(kw) ||
        program.includes(kw) ||
        cat.includes(kw) ||
        studio.includes(kw) ||
        tags.includes(kw)
      );

      const catMatch = !activeCat || catId === activeCat;
      const tagMatch = !activeTag || tagIds.includes(activeTag);

      if (searchMatch && catMatch && tagMatch) {
        matchingCards.push(card);
      }
    });

    applyVisibility(matchingCards);
    updateBubbles(keywords);
  }

  // Input typing listener
  searchInput?.addEventListener('input', (e) => {
    settleSearchPrompt();
    searchQuery = (e.target as HTMLInputElement).value;
    if (collapsedSearchInput) collapsedSearchInput.value = searchQuery;
    applyFilter();
  });

  collapsedSearchInput?.addEventListener('input', (e) => {
    settleSearchPrompt();
    searchQuery = (e.target as HTMLInputElement).value;
    if (searchInput) searchInput.value = searchQuery;
    applyFilter();
  });

  // Every value on a card's bottom row is a filter. Clicking one drives the
  // existing search path rather than a parallel mechanism, so the count, the
  // clear button and the collapsed field all stay in step for free.
  container?.addEventListener('click', (e) => {
    const pill = (e.target as HTMLElement).closest('[data-filter-value]') as HTMLElement | null;
    if (!pill) return;
    e.preventDefault();
    e.stopPropagation();
    const value = pill.dataset.filterValue ?? '';
    if (!value) return;
    searchQuery = value;
    if (searchInput) searchInput.value = value;
    if (collapsedSearchInput) collapsedSearchInput.value = value;
    applyFilter();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  // Select dropdown filter listeners
  catSelect?.addEventListener('change', (e) => {
    activeCat = (e.target as HTMLSelectElement).value;
    applyFilter();
  });

  // --- Tag Picker Scroll Navigation ---
  const tagPickerContainer = document.getElementById('tag-picker-container');
  const scrollLeftBtn = document.getElementById('tag-scroll-left') as HTMLButtonElement;
  const scrollRightBtn = document.getElementById('tag-scroll-right') as HTMLButtonElement;

  function updateScrollArrows() {
    if (!tagPickerContainer || !scrollLeftBtn || !scrollRightBtn) return;
    const { scrollLeft, scrollWidth, clientWidth } = tagPickerContainer;
    
    // Disable arrows based on scroll position limits
    scrollLeftBtn.disabled = scrollLeft <= 1;
    scrollRightBtn.disabled = scrollLeft + clientWidth >= scrollWidth - 2;
    
    // Only display arrows if container actually has overflow
    const hasOverflow = scrollWidth > clientWidth;
    scrollLeftBtn.style.display = hasOverflow ? 'flex' : 'none';
    scrollRightBtn.style.display = hasOverflow ? 'flex' : 'none';
  }

  // Smooth scroll offset on arrow click
  scrollLeftBtn?.addEventListener('click', () => {
    tagPickerContainer?.scrollBy({ left: -140, behavior: 'smooth' });
  });

  scrollRightBtn?.addEventListener('click', () => {
    tagPickerContainer?.scrollBy({ left: 140, behavior: 'smooth' });
  });

  tagPickerContainer?.addEventListener('scroll', updateScrollArrows, { passive: true });
  window.addEventListener('resize', updateScrollArrows, { passive: true });

  const allTagBtn = document.getElementById('all-tag-btn');

  // Static All Tag button click listener
  allTagBtn?.addEventListener('click', () => {
    // Remove active state from all scrolling tag buttons
    tagPicker?.querySelectorAll('.tag-picker-item').forEach(b => b.classList.remove('is-active'));
    allTagBtn.classList.add('is-active');
    activeTag = '';
    applyFilter();
    setTimeout(updateScrollArrows, 50);
  });

  // Tag scrollable picker click listener using event delegation
  tagPicker?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('.tag-picker-item');
    if (!btn) return;

    const filter = (btn as HTMLElement).dataset.filter ?? '';
    activeTag = filter;

    // Set active state on clicked button and remove from all others (including All tag button)
    allTagBtn?.classList.remove('is-active');
    tagPicker.querySelectorAll('.tag-picker-item').forEach(b => {
      b.classList.toggle('is-active', b === btn);
    });

    applyFilter();
    // Re-check arrows in case item selection changes container layout (unlikely but safe)
    setTimeout(updateScrollArrows, 50);
  });

  // Clear search and filters trigger
  function clearSearchAndFilters() {
    settleSearchPrompt();
    if (searchInput) searchInput.value = '';
    if (collapsedSearchInput) collapsedSearchInput.value = '';
    if (catSelect) catSelect.value = '';
    searchQuery = '';
    activeCat = '';
    activeTag = '';
    // Reset tag picker active states
    allTagBtn?.classList.add('is-active');
    tagPicker?.querySelectorAll('.tag-picker-item').forEach(btn => {
      btn.classList.remove('is-active');
    });
    applyFilter();
    updateScrollArrows();
  }

  clearBtn?.addEventListener('click', clearSearchAndFilters);
  collapsedClearBtn?.addEventListener('click', clearSearchAndFilters);

  function getVisibleSearchInput() {
    const toggle = document.querySelector('[data-page-toggle="projects-filter-panel"]');
    return toggle?.getAttribute('aria-expanded') === 'false'
      ? collapsedSearchInput
      : searchInput;
  }

  function handleProjectSearchKeyboard(event: KeyboardEvent) {
    if (event.key === 'Enter') {
      const target = event.target;
      const isSearchField = target === searchInput || target === collapsedSearchInput;
      if (!isSearchField || !searchQuery.trim()) return;

      const selectedMatch = document.querySelector<HTMLElement>('.project-card.is-keyboard-selected');
      const destination = selectedMatch ?? getVisibleCards()[0];
      const projectLink = destination?.querySelector<HTMLAnchorElement>('.project-card__pill');
      if (!projectLink) return;

      event.preventDefault();
      projectLink.click();
      return;
    }

    if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
      const target = event.target;
      const isSearchField = target === searchInput || target === collapsedSearchInput;
      if (!isSearchField) return;
      event.preventDefault();
      moveKeyboardProjectSelection(event.key === 'ArrowDown' ? 1 : -1);
      return;
    }

    if (event.key === 'Escape') {
      event.preventDefault();
      clearSearchAndFilters();
      searchInput?.blur();
      collapsedSearchInput?.blur();
      return;
    }

    if (event.key.length !== 1 || event.metaKey || event.ctrlKey || event.altKey) return;

    const target = event.target as HTMLElement | null;
    if (target?.closest('input, textarea, select, [contenteditable="true"]')) return;

    const visibleSearch = getVisibleSearchInput();
    if (!visibleSearch) return;

    event.preventDefault();
    settleSearchPrompt();
    visibleSearch.focus({ preventScroll: true });
    visibleSearch.value += event.key;
    visibleSearch.setSelectionRange(visibleSearch.value.length, visibleSearch.value.length);
    searchQuery = visibleSearch.value;
    if (searchInput) searchInput.value = searchQuery;
    if (collapsedSearchInput) collapsedSearchInput.value = searchQuery;
    applyFilter();
  }

  document.addEventListener('keydown', handleProjectSearchKeyboard);
  document.addEventListener('astro:before-swap', () => {
    document.removeEventListener('keydown', handleProjectSearchKeyboard);
  }, { once: true });

  // Mobile space-saver: abbreviate "All Categories".
  if (window.matchMedia('(max-width: 1023.98px)').matches) {
    const allCatOpt = catSelect?.querySelector('option[value=""]');
    if (allCatOpt) allCatOpt.textContent = 'CTGRY';
  }

  // Pre-load search query from URL params if present (links from skillset click on About page)
  const urlParams = new URLSearchParams(window.location.search);
  const qParam = urlParams.get('search') || urlParams.get('q');
  if (qParam) {
    settleSearchPrompt();
    searchQuery = qParam;
    if (searchInput) searchInput.value = qParam;
    if (collapsedSearchInput) collapsedSearchInput.value = qParam;
  }

  // Initialize visibility and tag scroll arrows
  applyFilter();
  setTimeout(updateScrollArrows, 100);
</script>

<script>
  // ── Mobile fixed header stack ────────────────────────────────
  // On mobile the entire top section wrapper (header + search + filters) is position:fixed
  // with a glass blur, so the project cards scroll underneath it.
  // We measure the wrapper height and apply it as paddingTop to cards container.
  function positionMobileProjectsHeader() {
    const fixedWrapper = document.querySelector('.projects-fixed-wrapper') as HTMLElement | null;
    const overlay = document.querySelector('.projects-header-blur-overlay') as HTMLElement | null;
    const cards = document.getElementById('project-cards-container');
    if (!fixedWrapper || !cards) return;

    // The header/filters now scroll in-flow above the cards (no longer fixed),
    // so the cards need no measured top offset.
    cards.style.paddingTop = '0px';
    if (overlay) {
      overlay.style.height = '';
    }
  }

  positionMobileProjectsHeader();
  window.addEventListener('resize', () => {
    clearTimeout((window as any)._projHeaderTimer);
    (window as any)._projHeaderTimer = setTimeout(positionMobileProjectsHeader, 120);
  });

  // ── Pinned state, and the panel following the scroll ───────────────
  // The wrapper's resting position and its sticky `top` are deliberately the
  // same value, so it never visually moves when it starts sticking — which
  // means position cannot tell you whether it is pinned. Scroll offset can.
  //
  // The panel tracks the top of the page: leaving the top closes it, coming
  // back to the top opens it again. Carrying a 94px search field and a filter
  // row down the page was the wrong half of the header to keep.
  //
  // It fires on the CROSSING, not on the position. Acting on position would
  // mean the panel could never be closed by hand while at the top, or opened
  // by hand while scrolled — it would spring back on the next frame. Acting
  // on the crossing leaves anything the user does inside a zone alone.
  // rAF-throttled, so this costs one check per frame at most.
  function setupStuckState() {
    const wrapper = document.querySelector('.projects-fixed-wrapper') as HTMLElement | null;
    if (!wrapper || (wrapper as any)._stuckWired) return;
    (wrapper as any)._stuckWired = true;

    const root = document.documentElement;
    const toggle = document.querySelector('[data-page-toggle="projects-filter-panel"]') as HTMLElement | null;
    const isOpen = () => toggle?.getAttribute('aria-expanded') === 'true';
    const panel = document.getElementById('projects-filter-panel') as HTMLElement;
    let unclamp: number | undefined;

    // null until the first run, so a page that loads already scrolled (a back
    // navigation, a restored position) still gets its state corrected once.
    let prevAtTop: boolean | null = null;
    let queued = false;

    // Snapping is only ever on in the scrolled region. Left on near the top it
    // makes scrollY 0 unreachable — the first card's snap point pulls the page
    // to ~75px, "at top" never becomes true, and the panel can never reopen.
    // The two features were fighting over the same pixels; this gives each its
    // own territory. Also off mid-resize (see below) and for reduced motion.
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    // The panel folds on the medium band only. Below 700 and from 1024 up
    // the search and filters are docked at the bottom of the screen and
    // never fold.
    const folds = window.matchMedia('(min-width: 700px) and (max-width: 1023.98px)');
    // Snapping is a desktop/tablet behaviour only. On the phone the cards
    // change height as you stop and start, which moves every snap point under
    // the snap engine while it is mid-flight — the two cannot both be smooth.
    // See the note on updateCardDensity.
    const snaps = window.matchMedia('(min-width: 700px)');
    // Must match the constant of the same name in the filter script — see the
    // note there. A threshold narrower than snap's resting slop latches on.
    const TOP_ZONE = 48;
    let atTopNow = true;
    let resizing = false;
    const updateSnap = () => {
      const on = snaps.matches && !atTopNow && !resizing && !reducedMotion.matches;
      root.style.setProperty('--page-snap', on ? 'y proximity' : 'none');
    };

    const apply = () => {
      queued = false;
      const atTop = window.scrollY <= TOP_ZONE;
      atTopNow = atTop;
      updateSnap();
      wrapper.classList.toggle('is-stuck', !atTop);

      const crossed = prevAtTop === null || atTop !== prevAtTop;
      prevAtTop = atTop;
      if (!crossed) return;

      // Below 700 the panel does not fold at all — the toggle is hidden and
      // the search lives at the bottom of the screen — so there is nothing to
      // open or close, and pressing a hidden control would only desync the
      // aria state from what is on screen.
      if (folds.matches && atTop !== isOpen()) {
        toggle?.click();
        // Base animates max-height to a measured pixel value and only clears
        // it on the max-height transitionend. Child transitions inside the
        // panel bubble the same event first, and when the panel is re-opened
        // at a size it already held, no max-height transition runs at all —
        // either way it can be left pinned to a stale number smaller than its
        // own content, which is what was cutting the filter row off. Clear it
        // once the animation is over.
        window.clearTimeout(unclamp);
        unclamp = window.setTimeout(() => {
          if (isOpen()) panel.style.maxHeight = 'none';
        }, 450);
      }
    };

    const onScroll = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(apply);
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    apply();

    // Where a snapped card should come to rest: the bottom edge of the pinned
    // bar. Measured rather than hard-coded, because that edge moves — the bar
    // is shorter once the search panel folds, and shorter again on a phone.
    // Without this a snapped card lands under the bar with its title hidden.
    // Snapping and the folding panel fight each other. Closing the panel takes
    // ~144px out of the flow, every card jumps up by that much, and snap —
    // which is mid-flight holding a target — re-resolves against content that
    // moved under it. The result is a scroll that stutters or overshoots.
    //
    // So snapping stands down while the bar is changing size and comes back
    // once it has settled. The inline value shadows the :root declaration and
    // removing it restores it, so there is one source of truth either way.
    let resettle: number | undefined;
    const suspendSnapWhileResizing = () => {
      resizing = true;
      updateSnap();
      window.clearTimeout(resettle);
      resettle = window.setTimeout(() => { resizing = false; updateSnap(); }, 280);
    };

    let lastHeight = wrapper.offsetHeight;
    const syncSnapOffset = () => {
      const stickTop = parseFloat(getComputedStyle(wrapper).getPropertyValue('--stick-top')) || 0;
      const height = wrapper.offsetHeight;
      root.style.setProperty('--snap-offset', `${Math.round(stickTop + height)}px`);
      if (height !== lastHeight) {
        lastHeight = height;
        suspendSnapWhileResizing();
      }
    };
    syncSnapOffset();
    if ('ResizeObserver' in window) {
      new ResizeObserver(syncSnapOffset).observe(wrapper);
      // The list changes height too, when cards thin out and fill back in.
      // Every snap point moves when it does, so snapping has to stand down
      // for the same reason it does when the bar resizes — otherwise it
      // re-resolves against content that shifted underneath it and drags the
      // view with it. This was the 95px jump on settling.
      const list = document.getElementById('project-cards-container');
      if (list) {
        let listHeight = list.offsetHeight;
        new ResizeObserver(() => {
          if (list.offsetHeight === listHeight) return;
          listHeight = list.offsetHeight;
          suspendSnapWhileResizing();
        }).observe(list);
      }
    }
    window.addEventListener('resize', syncSnapOffset, { passive: true });
  }
  setupStuckState();

  function setupScrollToTop() {
    const fixedWrapper = document.querySelector('.projects-fixed-wrapper');
    if (fixedWrapper) {
      fixedWrapper.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (!target.closest('input') && !target.closest('select') && !target.closest('button') && !target.closest('a')) {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        }
      });
    }
  }
  setupScrollToTop();

  document.addEventListener('astro:after-swap', () => {
    positionMobileProjectsHeader();
    setupStuckState();
    setupScrollToTop();
  });
</script>
