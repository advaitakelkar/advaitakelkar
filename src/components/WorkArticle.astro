---
import type { WorkFigure as Figure, MediaRole } from '../lib/workMedia';
import WorkFigure from './WorkFigure.astro';
import { workStories } from '../data/work-stories';
import figureLabels from '../data/work-figure-labels.json';
interface Props { figures: Figure[]; name: string; slug: string }
const { figures, name, slug } = Astro.props;
type Editorial = { label: string; reading?: string; articleRole?: MediaRole };
const labels = figureLabels as Record<string, Editorial>;
const groups: Array<{ role: MediaRole; title: string }> = [
  { role: 'plan', title: 'Plans' },
  { role: 'illustration', title: 'Space & volume' },
  { role: 'section', title: 'Sections & elevations' },
  { role: 'detail', title: 'Materials & details' },
  { role: 'making', title: 'Making & site' },
];
// Editorial selections never change the two-column introduction's media roles.
const selected = figures.filter(f => f.role !== 'main' || labels[f.image]?.articleRole).map(f => ({ ...f, role: labels[f.image]?.articleRole ?? f.role }));
const titleFor = (f: Figure) => labels[f.image]?.label ?? f.label ?? f.caption?.split(' — ').pop()?.split(';')[0] ?? `${name} · ${f.role}`;
const readingFor = (f: Figure) => labels[f.image]?.reading ?? f.note ?? f.caption?.replace(/;?\s*AI-assisted.*$/i, '').replace(`${name} — `, '');
let sequence = 0;
const chapters = groups.flatMap(group => {
  const items = selected.filter(f => f.role === group.role).map(f => ({ ...f, number: ++sequence }));
  if (!items.length) return [];
  return [{ ...group, items, story: workStories[slug]?.[group.role as keyof typeof workStories[string]], drawing: ['plan', 'illustration', 'section'].includes(group.role) }];
});
---
{chapters.length > 0 && <article class="work-article" aria-label={`${name} drawings and details`}>
  <nav class="work-article__index" aria-label="Project story">
    {chapters.map((g, i) => <a href={`#work-${g.role}`}><span>{String(i + 1).padStart(2, '0')}</span>{g.title}</a>)}
    <span class="work-article__hint">Select an image to look closer</span>
  </nav>
  {chapters.map((chapter, index) => <section class="work-article__chapter" id={`work-${chapter.role}`} aria-labelledby={`work-title-${chapter.role}`}>
    {chapter.drawing || chapter.items.length === 1 ? chapter.items.map((figure, i) => <div class="work-article__spread">
      <WorkFigure figure={figure} label={titleFor(figure)} number={figure.number} shape={chapter.role === 'section' && (figure.width ?? 1) / (figure.height ?? 1) > 1.7 ? '2x1' : '2x2'} />
      <div class="work-article__text">
        {i === 0 ? <><span class="work-article__eyebrow">{String(index + 1).padStart(2, '0')} / {chapter.title}</span><h2 id={`work-title-${chapter.role}`}>{chapter.story?.title ?? titleFor(figure)}</h2>{chapter.story && <p>{chapter.story.text}</p>}</> : <><span class="work-article__eyebrow">Figure {String(figure.number).padStart(2, '0')}</span><h3>{titleFor(figure)}</h3></>}
        {readingFor(figure) && <p class:list={{ 'work-article__reading': i === 0 && !!chapter.story }}>{readingFor(figure)}</p>}
      </div>
    </div>) : <>
      <header class="work-article__chapter-intro">
        <div><span class="work-article__eyebrow">{String(index + 1).padStart(2, '0')} / {chapter.title}</span><h2 id={`work-title-${chapter.role}`}>{chapter.story?.title ?? chapter.title}</h2></div>
        {chapter.story && <div class="work-article__text"><p>{chapter.story.text}</p></div>}
      </header>
      <div class="work-article__gallery">
        {chapter.items.map(figure => <WorkFigure figure={figure} label={titleFor(figure)} number={figure.number} shape={(figure.width ?? 1) / (figure.height ?? 1) < 0.9 ? '1x2' : '1x1'} />)}
      </div>
    </>}
  </section>)}
  <dialog class="work-image-dialog" aria-label="Enlarged project image">
    <header class="work-image-dialog__toolbar">
      <span class="work-image-dialog__title"></span>
      <div><button type="button" data-image-fit aria-pressed="true">Fit</button><button type="button" data-image-detail aria-pressed="false">Detail</button><form method="dialog"><button autofocus aria-label="Close enlarged image">Close ×</button></form></div>
    </header>
    <div class="work-image-dialog__stage" tabindex="0" role="region" aria-label="Image detail. Scroll to explore when zoomed."><img alt="" /></div>
    <footer><p></p><a target="_blank" rel="noopener">Open original ↗</a></footer>
  </dialog>
</article>}
<style>
  .work-article { width: 100%; min-width: 0; padding: 16px 0 64px; --article-gap: clamp(16px, 2vw, 32px); }
  .work-article__index { display: flex; align-items: center; flex-wrap: wrap; gap: 4px 20px; padding: 10px 0; border-block: 1px solid var(--_tokens---color--line-soft); }
  .work-article__index a { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; font-size: var(--_tokens---type--micro); color: inherit; text-decoration: none; }
  .work-article__index a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .work-article__index a span, .work-article__hint, .work-article__eyebrow { color: var(--_tokens---color--muted); font-size: var(--_tokens---type--micro); line-height: 1.5; }
  .work-article__hint { margin-left: auto; }
  .work-article__chapter { padding-top: 32px; margin-top: 32px; border-top: 1px solid var(--_tokens---color--line-soft); scroll-margin-top: 90px; }
  .work-article__chapter:first-of-type { border-top: 0; margin-top: 0; }
  .work-article__spread { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--article-gap); align-items: start; }
  .work-article__spread > :global(.work-figure) { grid-column: span 2; }
  .work-article__spread + .work-article__spread { margin-top: 32px; }
  .work-article__spread > .work-article__text { padding-top: clamp(16px, 4vw, 56px); }
  .work-article__text { min-width: 0; }
  h2, h3 { margin: 12px 0 20px; font-size: var(--_tokens---type--small); font-weight: var(--_tokens---weight--base); line-height: 1.3; text-wrap: balance; }
  .work-article__text p { margin: 0 0 16px; font-size: var(--_tokens---type--reading); line-height: var(--_tokens---leading--reading); max-width: var(--_tokens---measure--reading); }
  .work-article__text .work-article__reading { padding-top: 16px; border-top: 1px solid var(--_tokens---color--line-soft); }
  .work-article__chapter-intro { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: var(--article-gap); margin-bottom: 24px; }
  .work-article__gallery { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px var(--article-gap); align-items: start; }
  .work-image-dialog { box-sizing: border-box; width: calc(100vw - 32px); max-width: 1700px; max-height: 94svh; padding: 16px; color: var(--_tokens---color--fg); background: var(--_tokens---color--bg); border: 1px solid var(--_tokens---color--line-soft); }
  .work-image-dialog::backdrop { background: rgb(0 0 0 / 85%); }
  .work-image-dialog__toolbar, .work-image-dialog__toolbar > div { display: flex; gap: 8px; align-items: center; }
  .work-image-dialog__toolbar { justify-content: space-between; flex-wrap: wrap; margin-bottom: 12px; }
  .work-image-dialog__title { font-size: var(--_tokens---type--micro); }
  .work-image-dialog form { margin: 0; }
  .work-image-dialog button, .work-image-dialog a { display: inline-flex; align-items: center; justify-content: center; min-width: 44px; min-height: 44px; padding: 8px 12px; background: transparent; color: inherit; border: 1px solid var(--_tokens---color--line-soft); font: inherit; font-size: var(--_tokens---type--micro); cursor: pointer; }
  .work-image-dialog button[aria-pressed="true"] { background: var(--_tokens---color--fg); color: var(--_tokens---color--bg); }
  .work-image-dialog__stage { overflow: auto; height: 65svh; overscroll-behavior: contain; background: #fff; }
  .work-image-dialog__stage img { display: block; width: 100%; height: 100%; object-fit: contain; max-width: none; }
  .work-image-dialog[data-detail] .work-image-dialog__stage img { width: var(--detail-width); height: auto; }
  .work-image-dialog footer { display: flex; align-items: start; flex-wrap: wrap; justify-content: space-between; gap: 8px 16px; margin-top: 12px; }
  .work-image-dialog footer p { flex: 1 1 240px; margin: 0; font-size: var(--_tokens---type--micro); line-height: 1.5; }
  @media (max-width: 1023.98px) {
    .work-article__spread { grid-template-columns: 1fr; gap: 16px; }
    .work-article__spread > :global(.work-figure) { grid-column: 1; }
    .work-article__spread > .work-article__text { padding-top: 0; }
    .work-article__gallery { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .work-article__chapter-intro { grid-template-columns: 1fr; gap: 0; }
    .work-article__hint { flex-basis: 100%; margin: 0 0 8px; }
  }
  @media (max-width: 699.98px) {
    .work-article__gallery { grid-template-columns: 1fr; }
    .work-article__chapter { margin-top: 24px; padding-top: 24px; }
    .work-image-dialog { width: calc(100vw - 16px); padding: 12px; }
    .work-image-dialog__stage { height: 55svh; }
  }
</style>
<script>
  function initWorkArticle() {
    document.querySelectorAll<HTMLElement>('.work-article:not([data-wired])').forEach(root => {
      root.dataset.wired = 'true';
      const dialog = root.querySelector<HTMLDialogElement>('dialog')!;
      const img = dialog.querySelector('img')!;
      const stage = dialog.querySelector<HTMLElement>('.work-image-dialog__stage')!;
      const fit = dialog.querySelector<HTMLButtonElement>('[data-image-fit]')!;
      const detail = dialog.querySelector<HTMLButtonElement>('[data-image-detail]')!;
      let opener: HTMLButtonElement | null = null;
      function zoom(detailed: boolean) {
        dialog.toggleAttribute('data-detail', detailed);
        dialog.style.setProperty('--detail-width', `${Math.max(img.naturalWidth, stage.clientWidth * 1.75)}px`);
        fit.setAttribute('aria-pressed', String(!detailed)); detail.setAttribute('aria-pressed', String(detailed));
        stage.scrollTo(0, 0);
      }
      dialog.addEventListener('keydown', e => e.stopPropagation());
      fit.addEventListener('click', () => zoom(false));
      detail.addEventListener('click', () => zoom(true));
      img.addEventListener('load', () => { if (dialog.hasAttribute('data-detail')) zoom(true); });
      root.querySelectorAll<HTMLButtonElement>('[data-work-image]').forEach(button => button.addEventListener('click', () => {
        opener = button;
        img.src = button.dataset.workImage!; img.alt = button.dataset.caption!;
        dialog.querySelector('.work-image-dialog__title')!.textContent = button.dataset.label!;
        dialog.querySelector('footer p')!.textContent = img.alt;
        dialog.querySelector('a')!.href = img.src;
        dialog.showModal(); zoom(false);
      }));
      dialog.addEventListener('close', () => { zoom(false); opener?.focus({ preventScroll: true }); });
      dialog.addEventListener('click', e => { if (e.target === dialog) { const r = dialog.getBoundingClientRect(); if (e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom) dialog.close(); } });
      document.addEventListener('astro:before-swap', () => dialog.close(), { once: true });
    });
  }
  initWorkArticle();
  document.addEventListener('astro:after-swap', initWorkArticle);
</script>
