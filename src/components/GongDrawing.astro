---
import ReadMore from './ReadMore.astro';
const { view, wide = false } = Astro.props;
---
<figure class:list={["gong-drawing", { "gong-drawing--wide": wide }]}>
  <h3>{view.label}</h3>
  <img src={view.image} alt={view.alt ?? view.label} loading="lazy" decoding="async" />
  <details class="gong-drawing__notes">
    <ReadMore as="summary" />
    {view.caption && <p>{view.caption}</p>}
    <div class="gong-drawing__annotations">
      {(view.annotations ?? []).map((section: any) => <section><h4>{section.heading}</h4><ul>{section.lines.map((line: string) => <li>{line}</li>)}</ul></section>)}
    </div>
    {view.drawingSource && <p class="gong-drawing__source">{view.drawingSource}</p>}
  </details>
</figure>
<style>
  .gong-drawing { margin: 0; min-width: 0; padding: 16px; border: 1px solid var(--_tokens---color--line-soft); }
  .gong-drawing--wide { grid-column: 1 / -1; }
  h3 { margin: 0 0 12px; font-size: var(--_tokens---type--small); font-weight: var(--_tokens---weight--base); }
  img { width: 100%; height: auto; display: block; object-fit: contain; }
  .gong-drawing__notes { margin-top: 12px; font-size: var(--_tokens---type--micro); line-height: 1.5; }
  .gong-drawing__notes > :global(.read-more) { margin-bottom: 12px; }
  .gong-drawing__annotations { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  h4 { margin: 12px 0 6px; font-size: inherit; font-weight: var(--_tokens---weight--base); }
  ul { list-style: none; padding: 0; margin: 0; }
  li + li { margin-top: 4px; }
  .gong-drawing__source { color: var(--_tokens---color--muted); }
  @media (max-width: 699.98px) { .gong-drawing__annotations { grid-template-columns: 1fr; } }
</style>
