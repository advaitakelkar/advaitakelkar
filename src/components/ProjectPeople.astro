---
import { PEOPLE } from '../data/people';
interface Props { people: string[]; faculty?: string[] }
const { people, faculty = [] } = Astro.props;
const ordered = [...people.filter(p=>faculty.includes(p)), ...people.filter(p=>!faculty.includes(p))];
const facultyCount = ordered.filter(p=>faculty.includes(p)).length;
---
<div class="project-team" role="group" aria-label="Project team">
  {ordered.map((person,index) => <>
    {index === facultyCount && facultyCount > 0 && facultyCount < ordered.length && <span class="project-team__divider" role="separator" aria-label="Faculty / students" />}
    <span class="project-team__person" tabindex="0" aria-label={person}>
    {PEOPLE[person] ? <img src={PEOPLE[person]} alt={person} width="30" height="30" loading="lazy" /> : <span class="project-team__initials" aria-hidden="true">{person.split(' ').map(n=>n[0]).join('')}</span>}
    <span class="project-team__name" aria-hidden="true">{person}</span>
  </span></>)}
</div>
<style>
.project-team { display:flex; flex-wrap:wrap; align-items:center; gap:4px; width:100%; padding:24px 0 32px; }
.project-team__person { position:relative; display:block; width:32px; height:32px; border-radius:50%; border:1px solid var(--_tokens---color--line-soft); box-sizing:border-box; flex-shrink:0; }
.project-team__person img { display:block; width:100%; height:100%; object-fit:cover; border-radius:50%; filter:grayscale(1); opacity:.6; transition:opacity var(--_tokens---motion--base) ease; }
.project-team__person:hover img,.project-team__person:focus-visible img { opacity:1; }
.project-team__divider { width:1px; height:28px; margin:0 4px; background:var(--_tokens---color--line); }
.project-team__initials { display:grid; place-items:center; width:100%; height:100%; border-radius:50%; background:color-mix(in srgb,var(--_tokens---color--fg) 6%,transparent); font-size:12px; }
.project-team__name { position:absolute; left:50%; bottom:calc(100% + 8px); transform:translateX(-50%); width:max-content; max-width:220px; padding:5px 9px; border-radius:var(--_tokens---radius--pill); color:var(--_tokens---color--bg); background:var(--_tokens---color--fg); border:1px solid var(--_tokens---color--line); font-size:var(--_tokens---type--ultrathin); line-height:1.4; opacity:0; visibility:hidden; pointer-events:none; z-index:20; }
.project-team__person:hover .project-team__name,.project-team__person:focus-visible .project-team__name { opacity:1; visibility:visible; }
.project-team__person:focus-visible { outline:2px solid currentColor; outline-offset:3px; }
</style>
