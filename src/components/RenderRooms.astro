---
/**
 * The renders template — a visualisation project, shown as rooms.
 *
 * A rendering project is not a set of pictures. It is a set of ROOMS, each
 * rendered from one or more VIEWS, and each view rendered several times.
 * Laid out flat, XBKC read as fifty-one works for one flat.
 *
 * The page separates the three so that each one answers a different question:
 *
 *   tabs    which room            an All pill first, then the rooms
 *   rail    which view of it      the covers, along the bottom
 *   column  which take of it      the variations, top right, on demand
 *
 * **Variations are not shown until you ask.** They are alternates of one
 * picture, not more pictures, and a grid of thirty-eight of them is a render
 * study nobody asked to read. Pick a view and its takes appear beside it.
 *
 * The tabs wrap rather than scroll sideways, the way the footer's pill cloud
 * wraps: a row that scrolls hides the rooms you have not thought of yet.
 */
import Icon from './Icon.astro';
import { projectThumbnail } from '../lib/projectImages';
import ImageLightbox from './ImageLightbox.astro';

export interface Props {
  views: Array<{ room?: string; label?: string; note?: string; caption?: string; image: string; variations?: string[] }>;
  name: string;
  /* How the groups are chosen between. 'tabs' is a row of pills and suits a
     flat with eight rooms. 'chapters' is a column of dropdowns and suits a
     study that is read in order: twelve plateaus, each holding three panels,
     where the group has a position in an argument and a row of twelve pills
     would flatten that back into a filter bar. Same data either way — only
     the control changes. */
  groups?: 'tabs' | 'chapters' | 'grid';
  /* What one group is called, for the labels and the count line. */
  groupNoun?: { one: string; many: string };
}
const { views, name, groups = 'tabs', groupNoun } = Astro.props;
const NOUN = groupNoun ?? (groups === 'chapters'
  ? { one: 'chapter', many: 'chapters' }
  : { one: 'room', many: 'rooms' });
const asChapters = groups === 'chapters';
const asGrid = groups === 'grid';

/* Rooms in the order they first appear. A view with no room named falls into
   one called after the project, so a half-filled YAML still renders.

   A project where NO view names a room is not a set of rooms — it is one set
   of pictures. CARLO, SHLF and CONCRT are artworks, not flats: they have five
   or six frames of one object and nowhere to go between them. For those the
   tab row is dropped entirely rather than shown as All plus a single tab
   named after the project, which is two controls doing one job, and the line
   under the picture counts views instead of naming a room it would otherwise
   repeat under every frame. */
const hasRooms = views.some(v => !!v.room);
const rooms: string[] = [];
for (const v of views) {
  const r = v.room || name;
  if (!rooms.includes(r)) rooms.push(r);
}
const indexed = views.map((v, i) => ({
  i,
  room: v.room || name,
  label: v.label || v.room || (hasRooms ? name : `View ${String(i + 1).padStart(2, '0')}`),
  image: v.image,
  caption: v.caption,
  variations: v.variations ?? [],
}));
const totalTakes = indexed.reduce((a, v) => a + 1 + v.variations.length, 0);
---

{asGrid ? (
  /* ── Groups as a grid ────────────────────────────────────────────────
     No stage and no rail: each group's pictures sit side by side, full
     size, under the Journey tab row. All shows every group in order, one
     under the other; a group's tab shows it alone. For a set that is a few
     pictures per idea — CARLO's two configurations and two variations —
     where comparing them next to each other IS the point. */
  <section class="rr rr--grid" data-rr-grid aria-label={`${name} — ${NOUN.many}`}>
    <div class="rr__tabrow">
      <div class="rr__tabs" role="tablist" aria-label={NOUN.many}>
        <button class="rr__tab rr__tab--all is-active" role="tab" type="button" data-rrg-tab="all" aria-selected="true" aria-label="All" title="All">
          <Icon name="arrow" />
        </button>
        {rooms.map(r => (
          <button class="rr__tab" role="tab" type="button" data-rrg-tab={r} aria-selected="false">
            <span>{r}</span>
            <span class="rr__tab-n">{indexed.filter(v => v.room === r).length}</span>
          </button>
        ))}
      </div>
      <div class="rr__tabnav">
        <button class="rr__tabstep" type="button" data-rrg-step="-1" aria-label={`Previous ${NOUN.one}`}>
          <Icon name="chevron" dir="w" />
        </button>
        <button class="rr__tabstep" type="button" data-rrg-step="1" aria-label={`Next ${NOUN.one}`}>
          <Icon name="chevron" dir="e" />
        </button>
      </div>
    </div>
    {rooms.map(r => {
      /* A group can carry a line of text (the first view's `note`). It sits
         on the left, the pictures to the right of it. */
      const note = views.find(v => (v.room || name) === r && v.note)?.note;
      return (
        <div class:list={['rrg__group', note && 'rrg__group--noted']} data-rrg-room={r}>
          <p class="rrg__label">{r}</p>
          {note && <p class="rrg__note">{note}</p>}
          <div class="rrg__grid">
            {indexed.filter(v => v.room === r).map(v => v.caption ? (
              <figure class="rrg__fig">
                <img class="rrg__img" src={v.image} alt={`${name} — ${r}`} loading="lazy" decoding="async" />
                <figcaption class="rrg__caption">{v.caption}</figcaption>
              </figure>
            ) : (
              <img class="rrg__img" src={v.image} alt={`${name} — ${r}`} loading="lazy" decoding="async" />
            ))}
          </div>
        </div>
      );
    })}
  </section>
) : asChapters ? (
  /* ── Chapters as cards ────────────────────────────────────────────────
     Twelve plateaus as a stack of cards, the shape the projects list uses:
     the name on the left, the pictures in a strip on the right, and the row
     opening to show them. No stage — in a card the strip IS the content, and
     a big panel above twelve cards would show the same picture twice.

     A chapter is a unit of an argument, so it gets a card of its own rather
     than a tab that swaps the contents of one frame. You can have two open
     and compare them, which a tab row cannot do. */
  <section class="rr rr--cards" data-rr-cards aria-label={`${name} — ${NOUN.many}`}>
    {rooms.map((r, i) => {
      const panels = indexed.filter(v => v.room === r);
      return (
        <article class="rrc project-card" data-rrc>
          {/* A heading, not a control. Every chapter is open — there is
              nothing to disclose, so there is no button and no arrow. */}
          <h3 class="rrc__head">
            <span class="rrc__no">{String(i + 1).padStart(2, '0')}</span>
            <span class="rrc__name">{r}</span>
            <span class="rrc__n">{panels.length}</span>
          </h3>
          <div class="rrc__body">
            {/* The projects list's own scrub. The class names are theirs so
                ImageLightbox binds to it — hover preview on a desktop, the
                frosted scrub lightbox on a phone — and the layout is ours.
                data-keep-all because that component prunes a strip to five
                random thumbs, which is right for a card teasing a project and
                wrong where the nine panels ARE the argument, in order. */}
            <div class="rrc__strip project-card__thumbs-scroll" data-keep-all>
              {panels.map(v => (
                <button
                  class="rrc__panel project-card__thumb-item"
                  type="button"
                  data-src={v.image}
                  data-alt={`${name} — ${v.label}`}
                  aria-label={v.label}
                >
                  <img src={projectThumbnail(v.image)} alt={`${name} — ${v.label}`} loading="lazy" decoding="async" />
                </button>
              ))}
            </div>
          </div>
        </article>
      );
    })}
    <p class="rr__total">{`${rooms.length} ${rooms.length === 1 ? NOUN.one : NOUN.many} · ${views.length} panels`}</p>

    <ImageLightbox />
  </section>
) : (
<section class="rr" data-rr data-rr-rooms={hasRooms ? "true" : "false"} aria-label={hasRooms ? `${name} — rooms` : `${name} — views`}>

  {/* Rooms, as the About page's Journey tabs: All first (every view), then
      one pill per room with its view count, and a round previous / next pair
      at the right that wraps. Dropped when no view names a room — there is
      nothing to choose between, and the rail is the way through the set. */}
  {hasRooms && (
    <div class="rr__tabrow">
      <div class="rr__tabs" role="tablist" aria-label="Rooms">
        <button class="rr__tab rr__tab--all is-active" role="tab" type="button" data-rr-room="all" aria-selected="true" aria-label="All" title="All">
          <Icon name="arrow" />
        </button>
        {rooms.map(r => (
          <button class="rr__tab" role="tab" type="button" data-rr-room={r} aria-selected="false">
            <span>{r}</span>
            <span class="rr__tab-n">{indexed.filter(v => v.room === r).length}</span>
          </button>
        ))}
      </div>
      <div class="rr__tabnav">
        <button class="rr__tabstep" type="button" data-rr-step="-1" aria-label="Previous room">
          <Icon name="chevron" dir="w" />
        </button>
        <button class="rr__tabstep" type="button" data-rr-step="1" aria-label="Next room">
          <Icon name="chevron" dir="e" />
        </button>
      </div>
    </div>
  )}

  <div class="rr__body">
    <!-- The work. -->
    <div class="rr__stage" data-rr-stage>
      <!-- The takes of the view you are on, over the picture's top right
           corner. Out of the flow, so opening them costs the render no
           width — it stays as big as the page allows. -->
      <aside class="rr__takes" data-rr-takes hidden aria-label="Variations">
        <div class="rr__takes-list" data-rr-takes-list></div>
      </aside>
      {indexed.map(v => (
        <img class="rr__img" src={v.i === 0 ? v.image : undefined} data-src={v.image} data-thumb={projectThumbnail(v.image)} alt={`${name} — ${v.label}`} data-rr-view={v.i} data-rr-take="0" loading={v.i === 0 ? 'eager' : 'lazy'} decoding="async" />
      ))}
      {indexed.flatMap(v => v.variations.map((src, k) => (
        <img class="rr__img" data-src={src} data-thumb={projectThumbnail(src)} alt={`${name} — ${v.label}, take ${k + 2}`} data-rr-view={v.i} data-rr-take={k + 1} loading="lazy" decoding="async" />
      )))}
    </div>

  </div>

  <!-- The covers of the active tab. One per view, and the only thing that
       scrolls. -->
  <div class="rr__rail" data-rr-rail>
    {indexed.map(v => (
      <button
        class="rr__cover"
        type="button"
        data-rr-cover={v.i}
        data-rr-room={v.room}
        data-short={v.label}
        data-room={v.room}
        aria-label={v.label === v.room ? v.room : `${v.room} · ${v.label}`}
      >
        <img src={projectThumbnail(v.image)} alt="" loading="lazy" decoding="async" />
      </button>
    ))}
  </div>

  <!-- Everything the page has to say sits under the pictures, a line each:
       where you are, then what the whole set holds. -->
  <div class="rr__bar">
    <span class="rr__where" data-rr-where></span>
    <span class="rr__right">
      <span class="rr__count" data-rr-count></span>
      <button class="rr__play" type="button" aria-label="Pause" aria-pressed="true" data-rr-play hidden>
        <svg class="rr__ring" viewBox="0 0 24 24" aria-hidden="true">
          <circle class="rr__ring-track" cx="12" cy="12" r="9" />
          <circle class="rr__ring-fill" cx="12" cy="12" r="9" data-rr-ring />
        </svg>
      </button>
    </span>
  </div>
  <p class="rr__total">
    {hasRooms && <>{`${rooms.length} ${rooms.length === 1 ? NOUN.one : NOUN.many} · `}</>}
    {`${views.length} ${asChapters ? 'panels' : 'views'}`}
    {totalTakes > views.length && <> · {totalTakes} frames</>}
  </p>
</section>
)}

<style is:global>
  /* Global, not scoped: the takes column is built in script, and a runtime
     node carries no data-astro-cid-*, so a scoped rule would silently fail to
     match it. Every selector is .rr-prefixed. */
  /* padding-top, because the copy above ends on a paragraph and the stage
     started immediately under it — the work needs a beat before it begins. */
  .rr {
    display: flex;
    flex-direction: column;
    gap: 5px;
    width: 100%;
    min-width: 0;
    padding-top: var(--_tokens---space--small);
  }

  /* ── Chapters as cards ──────────────────────────────────────────────
     The projects list's shape: a hairline between rows, the name large on the
     left, the pictures in a strip on the right. Nothing here reuses
     .project-card's own classes — those styles ship with ProjectStackCard and
     that component is not on this page, so they would not be loaded. */
  .rr--cards { display: block; padding-top: 0; }

  .rrc { border-bottom: 1px solid var(--_tokens---color--line-soft); }
  .rrc__head {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 14px;
    width: 100%;
    margin: 0;
    padding: 18px 2px 10px;
    color: var(--_tokens---color--fg);
    font-family: inherit;
    font-weight: var(--_tokens---weight--base);
    text-align: left;
  }
  /* The plateau number, in the mono the counters use — a plateau is cited by
     it, so it is part of the name rather than an ornament. */
  .rrc__no {
    font-family: var(--_tokens---font--mono);
    font-size: var(--_tokens---type--micro);
    opacity: 0.45;
    min-width: 2.5ch;
  }
  .rrc__name {
    font-size: var(--_tokens---type--medium);
    font-weight: var(--_tokens---weight--base);
    line-height: 1.05;
    min-width: 0;
  }
  .rrc__n { font-family: var(--_tokens---font--mono); font-size: var(--_tokens---type--ultrathin); opacity: 0.5; }
  .rrc__body { padding: 0 2px 18px; }
  /* Scrolls sideways, like the card strip it is modelled on: nine panels at a
     readable size are wider than the column, and wrapping them into rows
     would turn a sequence into a grid — the order a to i is the argument. */
  /* One bar, not a row of pictures. The nine share the width and touch, so the
     strip reads as a single object you run along — which is what it is: a
     scrubber. Nothing scrolls; nine that need scrolling would hide part of the
     argument behind a gesture nobody is told about. */
  .rrc__strip {
    display: flex;
    gap: 0;
    width: 100%;
    overflow: hidden;
  }
  .rrc__panel {
    flex: 1 1 0;
    min-width: 0;
    aspect-ratio: 1;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    overflow: hidden;
    /* No radius: rounded corners would put nine notches along a bar that is
       meant to read as continuous. */
    border-radius: 0;
  }
  .rrc__panel img { width: 100%; height: 100%; object-fit: cover; display: block; }
  /* ── The scrubbed panel, shown above its bar ─────────────────────────
     ImageLightbox ships the element and fills it; the styles that place it
     live with ProjectStackCard, which is not on a detail page, so on this
     page the preview existed and was invisible. Restated here, and placed
     differently on purpose: on the projects list it covers the left 60% of
     the window, because there the cards are full-width rows and the preview
     has nowhere else to be. Here each bar is its own scrubber, so the picture
     belongs directly above the bar it came from — the script writes that
     bar's position into the custom properties below. */
  .rr--cards .project-card__hover-preview {
    position: fixed;
    left: var(--rrp-x, 0px);
    width: var(--rrp-w, 100%);
    top: var(--rrp-top, 0px);
    height: var(--rrp-h, 40vh);
    z-index: 95;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding: 0 0 8px;
    box-sizing: border-box;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--_tokens---motion--fast) ease;
  }
  /* Hung from the bar, whichever side of it the script picked. Above, the
     picture sits on the bar's top edge; below, under its bottom edge.

     This block carries the alignment and NOTHING else. Splitting the rule
     above to add it once left `opacity: 0` and `pointer-events: none` behind
     in this one, so the preview was drawn at full opacity from first paint
     and swallowed the pointer — which reads as a picture that appears
     unbidden and then will not go away. */
  .rr--cards .project-card__hover-preview[data-rrp-side="below"] {
    align-items: flex-start;
    padding: 8px 0 0;
  }
  .rr--cards .project-card__hover-preview.is-visible { opacity: 1; }
  /* As big as the space above the bar allows, and never wider than the bar. */
  .rr--cards .project-card__hover-preview-img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    display: block;
    box-shadow: 0 18px 44px rgba(0, 0, 0, 0.32);
  }

  /* While a strip is being scrubbed the rest of its panels recede, so the one
     under the cursor is the one being previewed. ProjectStackCard carries this
     rule for the projects list and ships it with itself, so it is restated
     here — that component is not on this page. */
  .rrc.is-previewing .rrc__panel { opacity: 0.35; transition: opacity var(--_tokens---motion--fast) ease; }
  .rrc.is-previewing .rrc__panel.is-active { opacity: 1; }

  .rrc__panel:focus-visible { outline: 2px solid var(--_tokens---color--fg); outline-offset: 2px; }

  @media (max-width: 699.98px) {
    .rrc__head { padding: 14px 0 8px; gap: 10px; }
    .rrc__name { font-size: var(--_tokens---type--small); }
  }

  /* ── Rooms: the Journey tabs ─────────────────────────────────────── */
  .rr__tabrow {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 12px;
  }
  .rr__tabs {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    gap: 6px;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .rr__tabs::-webkit-scrollbar { display: none; }
  .rr__tab,
  .rr__tabstep {
    font-family: inherit;
    font-size: calc(var(--_tokens---type--small) * 1.2);
    font-weight: var(--_tokens---weight--base);
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--_tokens---color--muted);
    background-color: color-mix(in srgb, var(--_tokens---color--fg) 6%, transparent);
    border: var(--_tokens---pill-border);
    cursor: pointer;
    transition: background-color var(--_tokens---motion--base) ease,
                color var(--_tokens---motion--base) ease,
                border-color var(--_tokens---motion--base) ease;
  }
  .rr__tab {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: var(--_tokens---pill-gap);
    padding: var(--_tokens---pill-pad--lg-compact);
    border-radius: var(--_tokens---radius--pill);
    white-space: nowrap;
  }
  /* All is a mark, not a word — an arrow in a circle, the same as the All
     tab on a category page. It names no group, so it needs no label. */
  .rr__tab--all {
    width: calc(1lh + 20px + 2px);
    height: calc(1lh + 20px + 2px);
    padding: 0;
    border-radius: 50%;
    justify-content: center;
  }
  .rr__tab-n {
    font-size: var(--_tokens---type--micro);
    font-variant-numeric: tabular-nums;
    opacity: 0.6;
  }
  .rr__tab.is-active {
    background-color: var(--_tokens---color--fg);
    border-color: var(--_tokens---color--fg);
    color: var(--_tokens---color--bg);
  }
  .rr__tabnav { display: flex; gap: 6px; flex-shrink: 0; }
  .rr__tabstep {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: calc(1lh + 20px + 2px);
    height: calc(1lh + 20px + 2px);
    padding: 0;
    border-radius: 50%;
    --icon-size: 0.8em;
  }
  .rr__tabstep:focus-visible {
    background-color: var(--_tokens---color--fg);
    color: var(--_tokens---color--bg);
    border-color: var(--_tokens---color--fg);
  }
  @media (hover: hover) {
    .rr__tab:not(.is-active):hover {
      background-color: color-mix(in srgb, var(--_tokens---color--fg) 12%, transparent);
      color: var(--_tokens---color--fg);
    }
    .rr__tabstep:hover {
      background-color: var(--_tokens---color--fg);
      color: var(--_tokens---color--bg);
      border-color: var(--_tokens---color--fg);
    }
  }
  @media (max-width: 699.98px) {
    .rr__tab,
    .rr__tabstep { font-size: var(--_tokens---type--small); }
  }

  /* ── Groups as a grid ── */
  .rrg__group { margin-top: 16px; }
  .rrg__group[hidden] { display: none; }
  .rrg__label {
    font-size: var(--_tokens---type--micro);
    color: var(--_tokens---color--muted);
    margin: 0 0 8px;
  }
  .rrg__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    align-items: start;
  }
  .rrg__img { width: 100%; height: auto; display: block; }
  .rrg__fig { margin: 0; min-width: 0; }
  .rrg__caption {
    margin: 12px 0 0;
    max-width: 48ch;
    font-size: var(--_tokens---type--small);
    line-height: 1.4;
    color: var(--_tokens---color--fg);
  }
  /* Text left, pictures right: the note takes the first of the two columns
     and the pictures share the second. */
  .rrg__group--noted {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 12px;
    align-items: start;
  }
  .rrg__group--noted .rrg__label { grid-column: 1 / -1; }
  .rrg__note {
    margin: 0;
    max-width: 40ch;
    font-size: var(--_tokens---type--small);
    line-height: 1.4;
    color: var(--_tokens---color--fg);
  }
  .rrg__group--noted .rrg__grid { grid-template-columns: minmax(0, 1fr); }
  @media (max-width: 699.98px) {
    .rrg__grid { grid-template-columns: minmax(0, 1fr); }
    .rrg__group--noted { display: block; }
    .rrg__note { margin-bottom: 12px; }
  }

  /* ── The work, and the takes beside it ─────────────────────────────── */
  .rr__body { display: flex; gap: 5px; align-items: flex-start; min-width: 0; }

  /* No box behind the picture. `object-fit: contain` in a fixed-height frame
     left tall grey bands above and below every landscape render, and a tinted
     rectangle is not the work. The stage takes the renders' own proportion
     instead, so the frame IS the picture and there is nothing to fill. */
  .rr__stage {
    position: relative;
    flex: 1 1 auto;
    min-width: 0;
    aspect-ratio: 3 / 2;
    /* The cap, not the width, decides the size on a wide screen. 85vh let the
       3:2 box take 719px at 1440x900, which is a picture that fills the window
       by itself; 68vh brings it to 612 and lets more of the page show at once.
       It does NOT get the rail above the fold — that depends on how long the
       copy above runs, and on these pages it still does not. */
    max-height: 68vh;
    background: none;
    overflow: hidden;
  }
  .rr__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    opacity: 0;
    transition: opacity var(--_tokens---motion--base) ease;
    pointer-events: none;
  }
  .rr__img.is-on { opacity: 1; }

  /* Over the picture's top-right corner, one below the other. Out of the
     flow on purpose: opening the takes costs the render no width, so the
     work stays as big as the page allows. */
  .rr__takes {
    position: absolute;
    top: 6px;
    right: 6px;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 4px;
    width: 84px;
    max-height: calc(100% - 12px);
    overflow-y: auto;
    scrollbar-width: none;
  }
  .rr__takes::-webkit-scrollbar { display: none; }
  .rr__takes[hidden] { display: none; }
  .rr__takes-list { display: flex; flex-direction: column; gap: 4px; }
  .rr__take {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    padding: 0;
    border: 1px solid transparent;
    border-radius: 3px;
    background: none;
    overflow: hidden;
    cursor: pointer;
    opacity: 0.5;
    transition: opacity var(--_tokens---motion--base) ease,
                border-color var(--_tokens---motion--base) ease;
  }
  .rr__take img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .rr__take.is-on { opacity: 1; border-color: var(--_tokens---color--fg); }
  @media (hover: hover) { .rr__take:hover { opacity: 1; } }

  /* ── The line under it ─────────────────────────────────────────────── */
  .rr__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    min-width: 0;
    font-size: var(--_tokens---type--ultrathin);
    color: var(--_tokens---color--muted);
  }
  .rr__where { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .rr__right { display: flex; align-items: center; gap: 6px; flex: 0 0 auto; }
  .rr__count { font-variant-numeric: tabular-nums; }
  .rr__play { display: inline-flex; width: 16px; height: 16px; padding: 0; border: 0; background: none; cursor: pointer; color: var(--_tokens---color--fg); }
  .rr__play[hidden] { display: none; }
  /* Exempt from the icon family on purpose, like the slider and project
     countdown rings: it animates its own stroke-dashoffset. */
  .rr__ring { width: 100%; height: 100%; transform: rotate(-90deg); }
  .rr__ring circle { fill: none; stroke: currentColor; stroke-width: 2.5; }
  .rr__ring-track { opacity: 0.2; }
  .rr__ring-fill { stroke-dasharray: 56.5; stroke-dashoffset: 56.5; transition: stroke-dashoffset 80ms linear; }

  /* ── The covers ────────────────────────────────────────────────────── */
  .rr__rail { display: flex; gap: 3px; overflow-x: auto; scrollbar-width: none; }
  .rr__rail::-webkit-scrollbar { display: none; }
  .rr__cover {
    position: relative;
    flex: 0 0 auto;
    width: 116px;
    padding: 0;
    border: 1px solid transparent;
    border-radius: 3px;
    background: none;
    overflow: hidden;
    cursor: pointer;
    opacity: 0.55;
    transition: opacity var(--_tokens---motion--base) ease,
                border-color var(--_tokens---motion--base) ease;
  }
  .rr__cover[hidden] { display: none; }
  .rr__cover img { width: 100%; height: 74px; object-fit: cover; display: block; }
  .rr__cover.is-on { opacity: 1; border-color: var(--_tokens---color--fg); }
  @media (hover: hover) { .rr__cover:hover { opacity: 1; } }

  .rr__total { margin: 0; font-size: var(--_tokens---type--ultrathin); color: var(--_tokens---color--muted); line-height: 1.2; }

  @media (min-width: 1024px) {
    .rr__takes { width: 116px; }
    .rr__cover { width: 164px; }
    .rr__cover img { height: 104px; }
  }
  /* On the phone the picture keeps the page's grid — it lines up with the
     tabs above it and the covers below, rather than bleeding past both. It
     ran edge to edge for a moment and was the one thing on the page that did.

     Its height is what is left over, not its 3:2. Everything else on this
     band is fixed furniture — the name, the tabs, the line, the rail — and
     the card at the bottom measures its own height into --pp-card-h. Without
     the cap the stage held its ratio and pushed the last line under the card,
     on a page too short to scroll it back out. The 280 is that furniture,
     measured: at 375x812 it leaves the stage 231px, which is within 3px of
     the 3:2 it wants anyway — so the cap only bites on a shorter screen. */
  @media (max-width: 699.98px) {
    /* The stage takes whatever the fixed furniture leaves. The subtrahend was
       280, which stopped the block about 70px short of the card on a 812-tall
       phone — a band of empty screen between the last line of the slider and
       the card under it. 224 lets the picture grow into that instead, which
       is the right thing to give the space to. */
    .rr__stage {
      max-height: calc(100dvh - var(--pp-card-h, 200px) - var(--pp-dock-h, 66px) - 224px);
      min-height: 140px;
    }
    /* Five covers across, measured from the row rather than guessed at: the
       width less the four gaps between them, split five ways. Three at a
       time showed a third of a thirteen-view flat and made the rail feel
       like a queue instead of an index. */
    .rr__cover {
      flex: 0 0 calc((100% - 12px) / 5);
      width: auto;
    }
    .rr__cover img { height: 48px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .rr__img { transition: none; }
    .rr__ring-fill { transition: none; }
  }
</style>

<script>
  /* ── Chapters as cards ──────────────────────────────────────────────────
     Open and close a chapter, and show one panel full size. Separate from the
     stage/rail wiring below, which this mode does not render at all. */

  /* Put the shared preview directly above whichever bar is being scrubbed.
     ImageLightbox decides WHAT it shows and when; this only decides where,
     because that component has one preview for a whole page and no idea which
     of twelve bars the pointer is on. Measured on enter and on resize rather
     than every move — the bar does not move while you run along it. */
  function initRRPreview() {
    const cards = document.querySelector('.rr--cards');
    if (!cards || (cards as any)._pvWired) return;
    (cards as any)._pvWired = true;
    const preview = document.getElementById('desktop-preview');
    if (!preview) return;

    /* Above the bar or below it, whichever side has more room.

       It only ever went above, which is right for the first chapter and wrong
       for the rest: a bar near the top of the window has a few hundred pixels
       over it and most of the screen under it, and the picture was drawn into
       the smaller of the two. It is the same picture either way, so the only
       question is which gap it fits better in.

       Both gaps are measured from the bar's own edges with the same 10px
       breathing room, and the top one also clears 64px for the breadcrumb.
       The bar's rect is clamped to the window first: a bar below the fold is
       further from the top of the viewport than the viewport is tall, and
       measuring to it gave a 1004px picture on a 900px screen. */
    const GAP = 10;
    const HEAD = 64;
    const placeOver = (strip: HTMLElement) => {
      const r = strip.getBoundingClientRect();
      const vh = window.innerHeight;
      const barTop = Math.min(Math.max(r.top, 0), vh);
      const barBottom = Math.min(Math.max(r.bottom, 0), vh);

      const roomAbove = barTop - HEAD - GAP;
      const roomBelow = vh - barBottom - GAP * 2;
      const below = roomBelow > roomAbove;

      const top = below ? barBottom + GAP : HEAD;
      const h = Math.max(120, below ? roomBelow : roomAbove);

      preview.style.setProperty('--rrp-x', `${Math.round(r.left)}px`);
      preview.style.setProperty('--rrp-w', `${Math.round(r.width)}px`);
      preview.style.setProperty('--rrp-top', `${Math.round(top)}px`);
      preview.style.setProperty('--rrp-h', `${Math.round(h)}px`);
      /* Which end of that box the picture sits at — against the bar, never
         floating in the middle of the gap with the bar it came from a hundred
         pixels away. */
      preview.dataset.rrpSide = below ? 'below' : 'above';
    };

    cards.querySelectorAll<HTMLElement>('.rrc__strip').forEach(strip => {
      strip.addEventListener('pointerenter', () => placeOver(strip));
      /* A bar low on a long page has little room above it; re-measuring on
         scroll keeps the picture in the gap rather than off the top. */
      strip.addEventListener('pointermove', () => {
        if (preview.classList.contains('is-visible')) placeOver(strip);
      }, { passive: true });
    });
  }
  initRRPreview();
  document.addEventListener('astro:after-swap', initRRPreview);

  function initRenderRooms() {
    const root = document.querySelector<HTMLElement>('[data-rr]');
    if (!root || root.dataset.rrWired) return;
    root.dataset.rrWired = '1';

    const imgs = Array.from(root.querySelectorAll<HTMLImageElement>('.rr__img'));
    const covers = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-rr-cover]'));
    /* Either control. A tab and a chapter row do the same job — pick a group —
       so the script knows them as one thing and nothing below has to care
       which one the project chose. */
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-rr-room]'))
      .filter(b => b.classList.contains('rr__tab') || b.classList.contains('rr__ch'));
    const takes = root.querySelector<HTMLElement>('[data-rr-takes]');
    const takesList = root.querySelector<HTMLElement>('[data-rr-takes-list]');
    const where = root.querySelector<HTMLElement>('[data-rr-where]');
    const count = root.querySelector<HTMLElement>('[data-rr-count]');
    const play = root.querySelector<HTMLButtonElement>('[data-rr-play]');
    const ring = root.querySelector<SVGCircleElement>('[data-rr-ring]');
    if (!imgs.length || !covers.length) return;

    const frame = (view: number, take: number) =>
      imgs.find(im => Number(im.dataset.rrView) === view && Number(im.dataset.rrTake) === take);
    const takesOf = (view: number) =>
      imgs.filter(im => Number(im.dataset.rrView) === view && Number(im.dataset.rrTake) > 0);

    /* All arrives in a different order every load, the way the footer's pill
       cloud and the skillset reshuffle do. Thirteen views in one fixed order
       means the last four are the ones nobody ever sees; shuffled, the tab
       reads as the flat rather than as a list with a beginning and an end.
       A named room keeps its own order — View 01 before View 02 is the
       sequence the work was made in, and that one means something.

       Shuffled once per load, not per click, so leaving All and coming back
       does not move the ground under you.

       A project with no rooms is NOT shuffled. The argument for shuffling is
       that thirteen views in a fixed order leaves the last four unseen — that
       is a problem of length, and CARLO has six. What those six have instead
       is a written sequence, 01 to 05 behind the cover, which is the order
       the work was made and photographed in. Shuffling six pictures gains
       nothing and throws that away. */
    const rail = root.querySelector<HTMLElement>('[data-rr-rail]');
    const naturalOrder = covers.slice();
    const allOrder = covers.slice();
    if (root.dataset.rrRooms === 'true') {
      for (let i = allOrder.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [allOrder[i], allOrder[j]] = [allOrder[j], allOrder[i]];
      }
    }

    /* Which take of each view a ROOM opens on — one roll per view, kept for
       the visit. A render study's alternates are all the picture, and always
       opening on the first meant the other thirty-eight were work nobody
       arrived at.

       All does not roll. It is the flat as it is meant to be seen, playing
       through the chosen frame of each view; the alternates are something
       you go into a room for. */
    const roll = new Map<number, number>();
    covers.forEach(c => {
      const v = Number(c.dataset.rrCover);
      const n = takesOf(v).length;
      roll.set(v, n ? Math.floor(Math.random() * (n + 1)) : 0);
    });
    const takeFor = (v: number) => (room === 'all' ? 0 : roll.get(v) ?? 0);

    let room = 'all';
    let view = Number(allOrder[0].dataset.rrCover);
    let take = 0;

    /* All plays by itself. It is the tab you land on and it holds every
       view, so it reads as the project rather than a list to work through.
       A named room does not: you went there to look at that room, and
       something moving under you is then an interruption. Takes stop it for
       the same reason — you opened them to compare, not to be walked past. */
    const DWELL = 3000;
    const CIRC = 56.5;
    let playing = true, t0 = 0, raf = 0;
    const canPlay = () => room === 'all' && (takes?.hidden ?? true);

    /* Rail order, not the order the markup was written in — All reshuffles
       its covers, so the counter and the autoplay have to walk what is on
       screen. */
    function shown() {
      return Array.from(rail?.children ?? [])
        .filter((c): c is HTMLButtonElement => c instanceof HTMLButtonElement && !c.hidden);
    }

    function paint() {
      const on = frame(view, take);
      if (on && !on.getAttribute('src') && on.dataset.src) on.src = on.dataset.src;
      imgs.forEach(im => im.classList.toggle('is-on', im === on));
      covers.forEach(c => c.classList.toggle('is-on', Number(c.dataset.rrCover) === view));
      const list = shown();
      const at = list.findIndex(c => Number(c.dataset.rrCover) === view);
      const cov = covers.find(c => Number(c.dataset.rrCover) === view);
      /* The room in All, the view number inside a room — the same rule the
         thumbnails follow, so the line and the caption under the picture you
         are on always say the same thing. The full name stays on aria-label,
         where a screen reader still needs to tell five Living views apart.

         A project with no rooms has no room to name, and naming the project
         under every frame is a caption that never changes — so it falls back
         to the view number, which is the one thing that does. */
      const named = root.dataset.rrRooms === 'true';
      const label = (room === 'all' && named ? cov?.dataset.room : cov?.dataset.short) ?? '';
      if (where) where.textContent = take === 0 ? label : `${label} — take ${take + 1}`;
      if (count) count.textContent = `${at + 1} / ${list.length}`;
      /* Keep the active cover in view INSIDE the rail, and move nothing else.
         This was `scrollIntoView({ block: 'nearest' })`, which scrolls every
         scrollable ancestor — including the document — whenever the rail is
         not already fully on screen. paint() runs on every autoplay tick, so
         a page left alone crept downward every three seconds until the rail
         was in frame, repeatedly and while you were reading something else.
         Setting the rail's own scrollLeft touches one axis of one element. */
      const onCover = root.querySelector<HTMLElement>('.rr__cover.is-on');
      if (rail && onCover) {
        const left = onCover.offsetLeft;
        const right = left + onCover.offsetWidth;
        if (left < rail.scrollLeft) rail.scrollLeft = left;
        else if (right > rail.scrollLeft + rail.clientWidth) rail.scrollLeft = right - rail.clientWidth;
      }
      takesList?.querySelectorAll('.rr__take').forEach((b, i) =>
        b.classList.toggle('is-on', i === take - 1));
      if (play) play.hidden = !canPlay();
      t0 = performance.now();
      if (ring) ring.style.strokeDashoffset = String(CIRC);
    }

    function tick(now: number) {
      raf = requestAnimationFrame(tick);
      if (!playing || !canPlay()) return;
      const p = Math.min(1, (now - t0) / DWELL);
      if (ring) ring.style.strokeDashoffset = String(CIRC * (1 - p));
      if (p >= 1) {
        const list = shown();
        const at = list.findIndex(c => Number(c.dataset.rrCover) === view);
        const next = list[(at + 1) % list.length];
        if (next) { view = Number(next.dataset.rrCover); take = takeFor(view); paint(); }
      }
    }

    function setPlaying(on: boolean) {
      playing = on;
      play?.setAttribute('aria-pressed', String(on));
      play?.setAttribute('aria-label', on ? 'Pause' : 'Play');
      t0 = performance.now();
      if (!on && ring) ring.style.strokeDashoffset = String(CIRC);
    }

    /* The takes column is built only when there is something to put in it,
       and taken down again when there is not — its width is the image's. */
    function buildTakes() {
      if (!takes || !takesList) return;
      const list = takesOf(view);
      takesList.innerHTML = '';
      if (!list.length) { takes.hidden = true; return; }
      takes.hidden = false;
      list.forEach((im, i) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'rr__take';
        b.setAttribute('aria-label', `Take ${i + 2}`);
        const t = document.createElement('img');
        t.src = im.dataset.thumb || im.dataset.src || im.src; t.alt = ''; t.loading = 'lazy'; t.decoding = 'async';
        b.appendChild(t);
        b.addEventListener('click', () => { take = i + 1; paint(); });
        takesList.appendChild(b);
      });
    }

    /* In a named room the takes are always up. You went to Living to look at
       the living room, and the alternates of the view you are on are the
       thing to compare — asking for a click first hides them behind a step
       nobody knows to take. All is the exception: it is playing through the
       whole flat, and a column of takes changing every three seconds under a
       picture you did not choose is noise. There they open on a click. */
    function setView(v: number, openTakes: boolean) {
      view = v; take = takeFor(v);
      if (openTakes || room !== 'all') buildTakes();
      else if (takes) { takes.hidden = true; }
      paint();
    }

    function setRoom(r: string) {
      room = r;
      tabs.forEach(b => {
        const on = b.dataset.rrRoom === r;
        b.classList.toggle('is-active', on);
        b.setAttribute('aria-selected', String(on));
      });
      // Re-append in the order this tab wants. appendChild MOVES a node, so
      // the rail is reordered rather than rebuilt and the listeners survive.
      (r === 'all' ? allOrder : naturalOrder).forEach(c => rail?.appendChild(c));
      /* The thumbnail shows whatever the stage will show, so the rail and
         the picture never disagree about which frame a view is on. */
      covers.forEach(c => {
        const v = Number(c.dataset.rrCover);
        const src = frame(v, r === 'all' ? 0 : roll.get(v) ?? 0)?.dataset.thumb;
        const thumb = c.querySelector('img');
        if (src && thumb && thumb.src !== src) thumb.src = src;
      });
      /* No captions under the thumbnails. They are pictures of rooms — a row
         of them captioned "Master Bedroom / Master Washroom / Guest Washroom"
         is a list of words in front of the thing the words describe. The line
         under the picture names the one you are on, and the outline says
         which thumbnail that is; the full name stays on aria-label. */
      covers.forEach(c => { c.hidden = !(r === 'all' || c.dataset.rrRoom === r); });
      const first = shown()[0];
      if (first) setView(Number(first.dataset.rrCover), false);
    }

    tabs.forEach(b => b.addEventListener('click', () => setRoom(b.dataset.rrRoom!)));
    // Previous / next step through the room tabs, wrapping at the ends.
    root.querySelectorAll<HTMLButtonElement>('[data-rr-step]').forEach(btn => btn.addEventListener('click', () => {
      const cur = tabs.findIndex(t => t.dataset.rrRoom === room);
      const next = tabs[(cur + Number(btn.dataset.rrStep) + tabs.length) % tabs.length];
      if (!next) return;
      setRoom(next.dataset.rrRoom!);
      // Bring the tab into view inside its own row only — scrollIntoView
      // would scroll the page as well.
      const row = next.parentElement;
      if (row) {
        const l = next.offsetLeft - row.offsetLeft, r = l + next.offsetWidth;
        if (l < row.scrollLeft) row.scrollLeft = l;
        else if (r > row.scrollLeft + row.clientWidth) row.scrollLeft = r - row.clientWidth;
      }
    }));
    // Clicking a cover is the ask: it opens that view's takes beside it.
    covers.forEach(c => c.addEventListener('click', () => setView(Number(c.dataset.rrCover), true)));
    play?.addEventListener('click', () => setPlaying(!playing));

    // Swipe the image to walk the covers of the room you are in. The stage
    // owns the gesture, so the page-level swipe leaves it alone.
    const stage = root.querySelector<HTMLElement>('[data-rr-stage]');
    if (stage) {
      stage.setAttribute('data-swipe-own', '');
      let x0 = 0, y0 = 0, live = false;
      stage.addEventListener('touchstart', (e) => {
        live = e.touches.length === 1;
        if (live) { x0 = e.touches[0].clientX; y0 = e.touches[0].clientY; }
      }, { passive: true });
      stage.addEventListener('touchend', (e) => {
        if (!live) return;
        live = false;
        const t = e.changedTouches[0];
        const dx = t.clientX - x0, dy = t.clientY - y0;
        if (Math.abs(dx) < 40 || Math.abs(dx) <= Math.abs(dy)) return;
        const list = shown();
        const at = list.findIndex(c => Number(c.dataset.rrCover) === view);
        const next = list[(at + (dx < 0 ? 1 : -1) + list.length) % list.length];
        if (next) setView(Number(next.dataset.rrCover), false);
      }, { passive: true });
    }

    // Nothing animates while the page cannot be seen.
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) { cancelAnimationFrame(raf); raf = 0; }
      else if (!raf) { t0 = performance.now(); raf = requestAnimationFrame(tick); }
    });

    setRoom('all');
    raf = requestAnimationFrame(tick);
  }

  initRenderRooms();
  document.addEventListener('astro:after-swap', initRenderRooms);

  /* Groups as a grid: the tab row shows All or one group; the pair at the
     right steps through them, wrapping. */
  function initRenderGrid() {
    const root = document.querySelector<HTMLElement>('[data-rr-grid]');
    if (!root || root.dataset.rrgWired) return;
    root.dataset.rrgWired = '1';
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-rrg-tab]'));
    const groups = Array.from(root.querySelectorAll<HTMLElement>('[data-rrg-room]'));
    let cur = 'all';
    const select = (key: string) => {
      cur = key;
      tabs.forEach(t => {
        const on = t.dataset.rrgTab === key;
        t.classList.toggle('is-active', on);
        t.setAttribute('aria-selected', String(on));
      });
      groups.forEach(g => { g.hidden = key !== 'all' && g.dataset.rrgRoom !== key; });
    };
    tabs.forEach(t => t.addEventListener('click', () => select(t.dataset.rrgTab!)));
    root.querySelectorAll<HTMLButtonElement>('[data-rrg-step]').forEach(btn => btn.addEventListener('click', () => {
      const i = tabs.findIndex(t => t.dataset.rrgTab === cur);
      select(tabs[(i + Number(btn.dataset.rrgStep) + tabs.length) % tabs.length].dataset.rrgTab!);
    }));
  }
  initRenderGrid();
  document.addEventListener('astro:after-swap', initRenderGrid);
</script>
