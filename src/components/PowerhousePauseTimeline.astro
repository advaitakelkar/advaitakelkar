---
import studies from '../data/powerhouse-book-studies.json';
const dates = ['Before 1600', '1677', '1830–1913', '1913', '1940', '1962'];
const stays = ['A night', 'A night', 'An hour', '5 min', '20 min', 'Hours'];
// Canvas units (1200 × 1300). Each stop is a picture a quarter of the width with its
// caption under it, so centres sit at least a box apart: four corners, then the
// inner turn, then the Powerhouse in the middle.
const W = 1200, H = 1300;
const positions = [[170,150],[1030,150],[1030,1110],[170,1110],[190,640],[790,430]];
const centre = [600,800];
const stops = studies.pause.items.map((item, i) => ({...item, date: dates[i], stay: stays[i], x:positions[i][0], y:positions[i][1]}));
const curves = [
  [[170,150],[450,20],[750,20],[1030,150]],
  [[1030,150],[1230,420],[1230,840],[1030,1110]],
  [[1030,1110],[750,1260],[450,1260],[170,1110]],
  [[170,1110],[20,960],[20,780],[190,640]],
  [[190,640],[340,470],[560,380],[790,430]],
  [[790,430],[1000,500],[880,820],centre],
];
const spiral = `M${curves[0][0].join(' ')} `+curves.map(c=>`C${c[1].join(' ')} ${c[2].join(' ')} ${c[3].join(' ')}`).join(' ');
const arrows=curves.map(c=>{
  const t=.5, u=1-t;
  const x=u*u*u*c[0][0]+3*u*u*t*c[1][0]+3*u*t*t*c[2][0]+t*t*t*c[3][0];
  const y=u*u*u*c[0][1]+3*u*u*t*c[1][1]+3*u*t*t*c[2][1]+t*t*t*c[3][1];
  const dx=3*u*u*(c[1][0]-c[0][0])+6*u*t*(c[2][0]-c[1][0])+3*t*t*(c[3][0]-c[2][0]);
  const dy=3*u*u*(c[1][1]-c[0][1])+6*u*t*(c[2][1]-c[1][1])+3*t*t*(c[3][1]-c[2][1]);
  return {x,y,angle:Math.atan2(dy,dx)*180/Math.PI};
});
const at = (x: number, y: number) => `--x:${(x / W * 100).toFixed(2)}%;--y:${(y / H * 100).toFixed(2)}%`;
---
<section class="pause" aria-labelledby="pause-timeline-title" data-book-studies="pause">
  <header><h3 id="pause-timeline-title">Architecture of the pause</h3><p>Follow the spiral from the historic stop to a new civic place at the centre.</p></header>
  <div class="pause__viewport" role="region" aria-label="Spiral timeline from caravanserai to the proposed Powerhouse">
    <svg class="ph__svg pause__spiral" viewBox={`0 0 ${W} ${H}`} aria-hidden="true"><path class="pause__line" d={spiral} />{arrows.map(a=><path class="pause__arrow" d="M-9 -6L0 0L-9 6" transform={`translate(${a.x} ${a.y}) rotate(${a.angle})`} />)}</svg>
    <ol class="pause__track">
      {stops.map((stop, i) => <li style={at(stop.x, stop.y)}>
        <a class="pause__art" href={stop.src} target="_blank" rel="noopener" aria-label={`Open full-size architectural study: ${stop.title}`}><img src={stop.src} alt={stop.caption} width="1536" height="1024" loading="lazy" decoding="async" /></a>
        <div class="pause__axis" aria-hidden="true"><span class="pause__node" /></div>
        <div class="pause__label"><img class="pause__symbol" src={`/powerhouse/symbols/solid/${stop.symbol}.svg`} alt="" aria-hidden="true" width="22" height="22" /><b><small>{String(i+1).padStart(2,'0')}</small>{stop.title}</b><span>{stop.date} · <em>{stop.stay}</em></span></div>
      </li>)}
      <li class="pause__proposal" style={at(centre[0], centre[1])}>
        <div class="pause__art" role="img" aria-label="A blurred circular field: the Powerhouse remains an open architectural proposition"><div class="pause__blob" /></div>
        <div class="pause__axis" aria-hidden="true"><span class="pause__node" /></div>
        <div class="pause__label"><img class="pause__symbol" src="/powerhouse/symbols/solid/power.svg" alt="" aria-hidden="true" width="22" height="22" /><b><small>07</small>The Powerhouse</b><span>Proposed · <em>20 min – a night</em></span></div>
      </li>
    </ol>
  </div>
  <p class="pause__note">AI-generated interpretive studies, not measured reconstructions or a common scale. Dates identify precedents; spacing does not represent elapsed time. The blurred circle leaves the Powerhouse’s form open.</p>
</section>
<style>
  .pause { width:100%;min-width:0;display:grid;gap:16px;margin:24px 0; }
  header h3 { margin:0;font-size:var(--_tokens---type--small);font-weight:600; }
  header p { margin:6px 0 0;font-size:var(--_tokens---type--micro);color:var(--_tokens---color--muted); }
  .pause__viewport { min-width:0;position:relative;aspect-ratio:1200 / 1300;container-type:inline-size; }
  .pause__spiral { position:absolute;inset:0;width:100%;height:100%;overflow:visible; }
  .pause__line,.pause__arrow { fill:none;stroke:var(--_tokens---color--fg);stroke-width:var(--pause-line-weight,1.5); }
  .pause__track { list-style:none;position:absolute;inset:0;margin:0;padding:0; }
  /* The picture is centred on its point on the spiral; the caption hangs under it, so
     the line meets the picture rather than the words. */
  li { position:absolute;left:var(--x);top:var(--y);width:25%;min-width:0;transform:translate(-50%,calc(-8px - (25cqw - 16px) / 3));display:flex;flex-direction:column;align-items:stretch;background:var(--_tokens---color--bg);padding:8px; }
  .pause__art { display:flex;align-items:center;justify-content:center;width:100%;min-width:0;aspect-ratio:3 / 2;background:#fff; }
  .pause__art img { display:block;width:100%;height:100%;object-fit:contain; }
  .pause__axis { display:none; }
  .pause__label { display:grid;grid-template-columns:22px minmax(0,1fr);column-gap:10px;row-gap:2px;align-items:center;padding:10px 0 0;font-size:var(--_tokens---type--micro);line-height:1.35; }
  .pause__symbol { grid-row:1 / span 2;display:block;width:22px;height:22px; }
  .pause__label b { font-weight:600; }
  .pause__label small { color:var(--_tokens---color--muted);font-size:.8em;font-weight:400;margin-right:6px; }
  .pause__label span { color:var(--_tokens---color--muted);font-size:var(--_tokens---type--ultrathin); }
  .pause__label em { font-style:italic;color:var(--_tokens---color--fg); }
  .pause__proposal .pause__art { background:none; }
  .pause__blob { width:62%;aspect-ratio:1;border-radius:50%;background:radial-gradient(ellipse at 42% 40%,#d5cec1 0%,#a9aca2 30%,#c7c9bf 47%,#e3e2dc 62%,transparent 75%);filter:blur(10px);opacity:.85; }
  .pause__note { margin:0;font-size:var(--_tokens---type--ultrathin);line-height:1.5;color:var(--_tokens---color--muted); }
  :global(html.mode-dark) .pause__symbol { filter:invert(1); }
  @media (prefers-color-scheme: dark) { :global(html:not(.mode-light)) .pause__symbol { filter:invert(1); } }
  @media (max-width: 1023.98px) {
    .pause__viewport { aspect-ratio:auto; }
    .pause__spiral { display:none; }
    .pause__track { position:relative;display:grid;grid-template-columns:minmax(0,1fr); }
    li { position:relative;left:auto;top:auto;transform:none;width:auto;display:grid;grid-template-columns:24px minmax(0,46%) minmax(0,1fr);padding:0 0 24px;background:none; }
    .pause__art { grid-column:2;grid-row:1; }
    .pause__axis { position:relative;display:grid;place-items:center;grid-column:1;grid-row:1; }
    .pause__label { grid-column:3;grid-row:1;align-content:center;padding:0 0 0 14px; }
    .pause__axis::before { content:'';position:absolute;top:0;bottom:-24px;left:50%;width:1px;background:currentColor; }
    .pause__node { position:relative;width:7px;height:7px;border-radius:50%;background:currentColor;box-shadow:0 0 0 4px var(--_tokens---color--bg); }
    li:first-child .pause__axis::before { top:50%; }
    li:last-child .pause__axis::before { bottom:0; }
    li:last-child .pause__axis::after { content:'';position:absolute;left:calc(50% - 3px);bottom:0;width:6px;height:6px;border-top:1px solid currentColor;border-right:1px solid currentColor;transform:rotate(135deg); }
  }
  @media (max-width: 699.98px) {
    .pause__label { grid-template-columns:minmax(0,1fr); }
    .pause__symbol { grid-row:auto;margin-bottom:4px; }
  }
</style>
