---
import studies from '../data/powerhouse-book-studies.json';
const dates = ['Before 1600', '1677', '1830–1913', '1913', '1940', '1962'];
const stays = ['A night', 'A night', 'An hour', '5 min', '20 min', 'Hours'];
const stops = studies.pause.items.map((item, i) => ({ ...item, date: dates[i], stay: stays[i] }));
---
<section class="pause" aria-labelledby="pause-timeline-title" data-book-studies="pause">
  <header><h3 id="pause-timeline-title">Architecture of the pause</h3><p>Follow the path from historic stops to a new civic place.</p></header>
  <div class="pause__viewport" role="region" aria-label="Timeline from caravanserai to the proposed Powerhouse">
    <ol class="pause__track">
      {stops.map((stop, i) => <li>
        <a class="pause__art" href={stop.src} target="_blank" rel="noopener" aria-label={`Open full-size architectural study: ${stop.title}`}><img src={stop.src} alt={stop.caption} width="1536" height="1024" loading="lazy" decoding="async" /></a>
        <div class="pause__axis" aria-hidden="true"><span class="pause__node" /></div>
        <div class="pause__label"><img class="pause__symbol" src={`/powerhouse/symbols/solid/${stop.symbol}.svg`} alt="" aria-hidden="true" width="22" height="22" /><b><small>{String(i+1).padStart(2,'0')}</small>{stop.title}</b><span>{stop.date} · <em>{stop.stay}</em></span></div>
      </li>)}
      <li class="pause__proposal">
        <div class="pause__art" role="img" aria-label="A blurred circular field: the Powerhouse remains an open architectural proposition"><div class="pause__blob" /></div>
        <div class="pause__axis" aria-hidden="true"><span class="pause__node" /></div>
        <div class="pause__label"><img class="pause__symbol" src="/powerhouse/symbols/solid/power.svg" alt="" aria-hidden="true" width="22" height="22" /><b><small>07</small>The Powerhouse</b><span>Proposed · <em>20 min – a night</em></span></div>
      </li>
    </ol>
  </div>
  <p class="pause__note">AI-generated interpretive studies, not measured reconstructions or a common scale. Dates identify precedents; spacing does not represent elapsed time. The blurred circle leaves the Powerhouse’s form open.</p>
</section>
<style>
  .pause { width:100%;min-width:0;display:grid;gap:16px;margin:24px 0; }
  header h3 { margin:0;font-size:clamp(1.25rem, 1.1rem + .4vw, 1.5rem);line-height:1.25;font-weight:500; }
  header p { margin:6px 0 0;font-size:var(--_tokens---type--micro);color:var(--_tokens---color--muted); }
  .pause__viewport { min-width:0; }
  .pause__track { list-style:none;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:36px 26px;margin:0;padding:0; }
  .pause__track > li { position:relative;min-width:0; }
  .pause__track > li:nth-child(4) { grid-column:3;grid-row:2; }
  .pause__track > li:nth-child(5) { grid-column:2;grid-row:2; }
  .pause__track > li:nth-child(6) { grid-column:1;grid-row:2; }
  .pause__track > li:not(:nth-child(3)):not(:nth-child(6)):not(:last-child)::after { content:'→';position:absolute;right:-21px;top:25%;font-size:18px;color:var(--_tokens---color--muted); }
  .pause__track > li:nth-child(4)::after,.pause__track > li:nth-child(5)::after { content:'←';right:auto;left:-21px; }
  .pause__track > li:nth-child(3)::after { content:'↷';position:absolute;right:-15px;bottom:-30px;font-size:26px;color:var(--_tokens---color--muted); }
  .pause__track > li:nth-child(6)::after { content:'↘';position:absolute;right:-15px;bottom:-25px;font-size:22px;color:var(--_tokens---color--muted); }
  .pause__track > .pause__proposal { grid-column:2;grid-row:3; }
  .pause__proposal .pause__art { width:100%;aspect-ratio:3 / 2; }
  .pause__art { display:flex;align-items:center;justify-content:center;width:100%;min-width:0;aspect-ratio:3 / 2;background:#fff; }
  .pause__art img { display:block;width:100%;height:100%;object-fit:contain; }
  .pause__axis { display:none; }
  .pause__label { display:grid;grid-template-columns:22px minmax(0,1fr);column-gap:10px;row-gap:2px;align-items:center;padding:10px 0 0;font-size:var(--_tokens---type--micro);line-height:1.35; }
  .pause__symbol { grid-row:1 / span 2;display:block;width:22px;height:22px; }
  .pause__label b { font-weight:600; }
  .pause__label small { color:var(--_tokens---color--muted);font-size:.8em;font-weight:400;margin-right:6px; }
  .pause__label span { color:var(--_tokens---color--muted);font-size:var(--_tokens---type--ultrathin); }
  .pause__label em { font-style:italic;color:var(--_tokens---color--fg); }
  .pause__proposal .pause__art { background:none; }
  .pause__blob { width:62%;aspect-ratio:1;border-radius:50%;background:radial-gradient(ellipse at 42% 40%,#d5cec1 0%,#a9aca2 30%,#c7c9bf 47%,#e3e2dc 62%,transparent 75%);filter:blur(10px);opacity:.85; }
  .pause__note { margin:0;font-size:var(--_tokens---type--ultrathin);line-height:1.5;color:var(--_tokens---color--muted); }
  :global(html.mode-dark) .pause__symbol { filter:invert(1); }
  @media (prefers-color-scheme: dark) { :global(html:not(.mode-light)) .pause__symbol { filter:invert(1); } }
  @media (max-width: 699.98px) {
    .pause__track { grid-template-columns:minmax(0,1fr);gap:20px; }
    .pause__track > li:nth-child(n) { grid-column:1;grid-row:auto; }
    .pause__track > li:not(:last-child)::after { content:'↓';position:absolute;left:10px;right:auto;top:auto;bottom:-20px;font-size:16px; }
    .pause__track > .pause__proposal { display:block; }
    .pause__track > li:not(.pause__proposal) { display:grid;grid-template-columns:minmax(0, 1fr) minmax(0, 1fr);gap:12px;align-items:center; }
    .pause__label { padding:0; }
  }
</style>
