---
const panels = [
  { number: '01', title: 'Start with the bar', text: 'The bar sits at the centre of the room, giving the café and evening bar one shared focus.' },
  { number: '02', title: 'Step the seating around it', text: 'Timber platforms rise around the bar. Steps, railings and banquettes give each level its own place while keeping the tables turned towards the centre.' },
  { number: '03', title: 'Keep the room connected', text: 'Open routes pass between the bar and the raised seating. The terraces, booths and lower café area share a view of the room and what is happening around the bar.' },
];
---
<section class="terrace-concept" id="work-concept" aria-labelledby="terrace-concept-title">
  <header><span class="terrace-concept__eyebrow">Concept / Terraced seating</span><h2 id="terrace-concept-title">The terraces, in three moves</h2></header>
  <div class="terrace-concept__panels">
    {panels.map(panel => <figure>
      <button class="terrace-concept__image" type="button" data-work-image={`/images/social-malad/concept-${panel.number}-detailed-v2.webp`} data-label={panel.title} data-caption={`SOCIAL Malad — ${panel.title}; AI-assisted concept illustration based on the venue isometric.`} aria-label={`Enlarge concept: ${panel.title}`}>
        <img src={`/images/social-malad/concept-${panel.number}-detailed-v2.webp`} width="1382" height="1135" loading="lazy" decoding="async" alt={`${panel.title} — isometric concept showing the bar, stepped platforms, tables, booths and railings.`} />
      </button>
      <figcaption><div class="terrace-concept__label"><span>{panel.number}</span><h3>{panel.title}</h3></div><p>{panel.text}</p></figcaption>
    </figure>)}
  </div>
  <p class="terrace-concept__note">AI-assisted concept illustrations based on the venue isometric. Select a panel to look closer.</p>
</section>
<style>
  .terrace-concept { margin-top: 40px; padding-top: 28px; border-top: 1px solid var(--_tokens---color--line-soft); scroll-margin-top: 90px; }
  .terrace-concept__eyebrow, .terrace-concept__note { font-size: var(--_tokens---type--micro); line-height: 1.5; color: var(--_tokens---color--muted); }
  h2 { margin: 8px 0 24px; font-size: var(--_tokens---type--small); font-weight: 500; }
  .terrace-concept__panels { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(16px, 2vw, 32px); }
  figure { margin: 0; min-width: 0; }
  .terrace-concept__image { display: block; width: 100%; aspect-ratio: 4 / 3; margin: 0 0 20px; padding: 0; border: 0; background: transparent; cursor: zoom-in; }
  img { display: block; width: 100%; height: 100%; object-fit: contain; }
  .terrace-concept__label { display: flex; align-items: center; gap: 10px; }
  .terrace-concept__label > span { display: inline-flex; width: 20px; height: 20px; border: 1px solid var(--_tokens---color--line); border-radius: 50%; align-items: center; justify-content: center; flex-shrink: 0; font-size: 12px; }
  h3 { margin: 0; font-size: var(--_tokens---type--micro); font-weight: 600; }
  figcaption p { margin: 12px 0 0; font-size: var(--_tokens---type--reading); line-height: var(--_tokens---leading--reading); }
  .terrace-concept__note { margin: 24px 0 0; }
  @media (max-width: 699.98px) { .terrace-concept__panels { grid-template-columns: 1fr; gap: 28px; } }
</style>
