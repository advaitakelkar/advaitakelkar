---
import { workPropositions } from '../data/work-propositions';
interface Props { projectId: string }
const { projectId } = Astro.props;
const text = workPropositions[projectId];
---
{text && <section class="work-proposition" aria-label="Design proposition">
  <h2>Abstract</h2><p>{text.abstract}</p>
  <h2>Brief</h2><p class="work-proposition__brief">{text.brief}</p>
</section>}
<style>
.work-proposition { min-width:0; }
h2 { margin:0 0 12px; font-size:var(--_tokens---type--micro); font-weight:var(--_tokens---weight--base); color:var(--_tokens---color--muted); }
p { margin:0; font-size:clamp(.8125rem,.775rem + .15vw,.9375rem); line-height:1.6; }
p + h2 { margin-top:24px; }
.work-proposition__brief { font-size:clamp(1.125rem,1rem + .4vw,1.375rem); line-height:1.4; letter-spacing:-.01em; font-weight:600; }
</style>
