---
import studies from '../data/powerhouse-book-studies.json';
import PowerhousePauseTimeline from './PowerhousePauseTimeline.astro';
interface Props { group: keyof typeof studies; }
const {group}=Astro.props;
const study=studies[group];
---
{group === 'pause' ? <PowerhousePauseTimeline /> : <section class="ph-studies" aria-label={study.title} data-book-studies={group}>
  <h3>{study.title}</h3>
  <div class:list={['ph-studies__grid', {'ph-studies__grid--pair':group==='room-canopy','ph-studies__grid--four':study.items.length===8}]}>
    {study.items.map((item)=><figure>
      <img class="ph-studies__symbol" src={`/powerhouse/symbols/solid/${item.symbol}.svg`} alt="" aria-hidden="true" width="32" height="32" />
      <a href={item.src} target="_blank" rel="noopener" aria-label={`Open full-size study: ${item.title}`}><img src={item.src} alt={`${item.title}: ${item.caption} Interpretive architectural study.`} width="1536" height="1024" loading="lazy" decoding="async" /></a>
      <figcaption><b>{item.title}</b><span>{item.caption}</span></figcaption>
    </figure>)}
  </div>
  <p>AI-generated interpretive typological studies; not measured reconstructions or a common scale.{group==='waiting' && ' Ochre marks pedestrian arrival; pale grey marks vehicle territory.'}</p>
</section>}
<style>
  .ph-studies { width:100%;min-width:0;display:grid;gap:20px;margin:24px 0; }
  .ph-studies h3 { margin:0;font-size:var(--_tokens---type--small);font-weight:600; }
  .ph-studies__grid { display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:28px var(--ph-reading-gap,40px); }
  .ph-studies__grid--pair { grid-template-columns:repeat(2,minmax(0,1fr)); }
  figure { margin:0;min-width:0; }
  a { display:block; }
  img { display:block;width:100%;height:auto;aspect-ratio:3 / 2;object-fit:contain;background:#fff; }
  .ph-studies__symbol { width:32px;height:32px;aspect-ratio:1;margin-bottom:8px;background:none; }
  figcaption { display:grid;gap:4px;font-size:var(--_tokens---type--micro);line-height:1.45;margin-top:10px; }
  .ph-studies p { margin:0;color:var(--_tokens---color--muted);font-size:var(--_tokens---type--ultrathin);line-height:1.5; }
  .ph-studies__grid--four { grid-template-columns:repeat(4,minmax(0,1fr));gap:28px 24px; }
  :global(html.mode-dark) .ph-studies__symbol { filter:invert(1); }
  @media (prefers-color-scheme: dark) { :global(html:not(.mode-light)) .ph-studies__symbol { filter:invert(1); } }
  @media (max-width: 1023.98px) { .ph-studies__grid, .ph-studies__grid--four { grid-template-columns:repeat(2,minmax(0,1fr)); } }
  @media (max-width: 699.98px) { .ph-studies__grid { grid-template-columns:minmax(0,1fr); } }
</style>
