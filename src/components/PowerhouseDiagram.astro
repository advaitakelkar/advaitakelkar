<style>
  .phd { display:grid;gap:14px;min-width:0;color:var(--_tokens---color--fg);font-size:12px;line-height:1.4; }
  .phd svg { width:100%;height:auto;fill:none;stroke:currentColor;stroke-width:1.2;stroke-linecap:round;stroke-linejoin:round; }
  .phd .t { fill:currentColor;stroke:none;font-size:13px; }
  .phd .t-axis { font-size:11px;opacity:.65; }
  .phd .t-zone { font-size:11px;letter-spacing:.04em;text-transform:uppercase;opacity:.55; }
  .phd .t-r { text-anchor:end; } .phd .t-c { text-anchor:middle; }
  .phd .t-b { font-weight:600; } .phd .t-s { font-size:11px;opacity:.75; }
  .phd__note { margin:0;font-size:10px;line-height:1.4;color:var(--_tokens---color--muted); }
  .phd__cols { display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px 24px; }
  .phd__cols b { display:block;margin-bottom:6px;font-weight:600; }
  .phd__cols ul { margin:0;padding:0;list-style:none;columns:2;column-gap:16px;font-size:11px;line-height:1.5; }
  .phd__cols--labels { font-size:12px; }
  @media (max-width: 699.98px) { .phd__cols { grid-template-columns:minmax(0,1fr); } .phd__cols ul { columns:1; } }

  /* Node–place */
  .phd--nodeplace .band { fill:var(--ph-light);fill-opacity:.55;stroke:none; }
  .phd--nodeplace .axis { stroke-width:1; }
  .phd--nodeplace .move { stroke:var(--ph-lamp,#d49963);stroke-width:1.6;stroke-dasharray:4 4; }
  .phd--nodeplace .move-head { stroke-dasharray:none; }
  .phd--nodeplace .today { fill:var(--ph-dawn,#8091aa);stroke:none; }
  .phd--nodeplace .ph { fill:var(--ph-lamp,#d49963);stroke:none; }
  .phd--nodeplace .set { fill:var(--_tokens---color--bg);stroke-width:1.4; }

  /* Five needs */
  .phd--needs { grid-template-columns:repeat(5,minmax(0,1fr));gap:16px 14px;align-items:start; }
  .phd--needs .phd__need { display:grid;gap:6px;min-width:0; }
  .phd--needs svg { width:36px;height:32px;stroke-width:1.6; }
  .phd--needs b { font-weight:600; } .phd--needs span { font-size:11px;line-height:1.4;color:var(--_tokens---color--fg); }
  .phd--needs .phd__note { grid-column:1 / -1; }
  @media (max-width: 1023.98px) { .phd--needs { grid-template-columns:repeat(3,minmax(0,1fr)); } }
  @media (max-width: 699.98px) { .phd--needs { grid-template-columns:repeat(2,minmax(0,1fr)); } }

  /* No plug */
  .phd__share { display:flex;height:34px;gap:2px; }
  .phd__share span { display:flex;align-items:center;min-width:0;padding:0 10px;background:var(--ph-lamp,#d49963);color:#111;font-size:11px;white-space:nowrap;overflow:hidden; }
  .phd__share span b { margin-right:6px;font-weight:700; }
  .phd__share .is-plug, .phd__share .is-set { background:var(--ph-light);color:var(--_tokens---color--fg); }
  .phd__share .is-op { background:var(--_tokens---color--fg);color:var(--_tokens---color--bg); }
  .phd__share--tall { height:44px; }
  .phd__rows { display:grid;gap:8px; }
  .phd__axis { display:flex;justify-content:space-between;font-size:10px;color:var(--_tokens---color--muted); }
  .phd__cells { display:grid;grid-template-columns:repeat(11,minmax(0,1fr));gap:4px; }
  .phd__cells i { display:block;aspect-ratio:1;background:var(--ph-light); } .phd__cells i.is-on { background:var(--ph-lamp,#d49963); }
  .phd__measure .phd__bar { grid-template-columns:minmax(0,1fr); } .phd__measure .phd__bar em { display:none; }
  .phd__measure > b { font-weight:600; } .phd__measure > span { font-size:11px;line-height:1.4; }

  /* Ground section */
  .phd--ground .asphalt { fill:var(--ph-asphalt,#1b1714);stroke:none; }
  .phd--ground .soil { fill:var(--ph-light);stroke:none; }
  .phd--ground .planted { stroke:var(--ph-green);stroke-width:2; }
  .phd--ground .tree { fill:var(--ph-green);fill-opacity:.3;stroke:var(--ph-green); }
  .phd--ground .canopy { fill:var(--ph-lamp,#d49963);fill-opacity:.3; }
  .phd--ground .sun { stroke:var(--ph-yellow);stroke-width:1.6; }
  .phd--ground .heat { stroke:var(--ph-red);stroke-width:1.4;opacity:.8; }
  .phd--ground .rain, .phd--ground .soak, .phd--ground .runoff { stroke:var(--ph-blue);stroke-width:1.6; }
  .phd--ground .car { fill:var(--ph-light);fill-opacity:.5; }
  .phd--ground .thermo { stroke-width:1; }
  .phd--ground .thermo-fill { fill:var(--ph-red);stroke:none; }
  .phd--ground .divide { stroke-width:1;stroke-dasharray:3 5;opacity:.5; }

  /* Access layers, rules, measures share the layer fills */
  .phd .site { stroke-width:1; }
  .phd .loop { fill:var(--ph-grey);fill-opacity:.22;stroke:none; }
  .phd .bay { fill:none;stroke-width:1; }
  .phd .open { fill:var(--ph-lamp,#d49963);fill-opacity:.35;stroke:var(--ph-lamp,#d49963);stroke-width:1.4; }
  .phd .set { fill:var(--ph-light);fill-opacity:.6;stroke-dasharray:4 4; }
  .phd .op { fill:none;stroke-width:1.4; }
  .phd .door { stroke-width:2; }
  .phd__hours { display:grid;gap:6px;font-size:11px; }
  .phd__hours > div { display:grid;grid-template-columns:72px minmax(0,1fr);align-items:center;gap:10px;position:relative;height:14px; }
  .phd__hours i, .phd__day-track i { position:absolute;top:0;bottom:0;left:calc(var(--a) / 24 * 100%);width:calc((var(--b) - var(--a)) / 24 * 100%);background:var(--ph-light); }
  .phd__hours > div { position:relative; } .phd__hours > div i { grid-column:2;left:calc(72px + 10px + (100% - 82px) * var(--a) / 24);width:calc((100% - 82px) * (var(--b) - var(--a)) / 24); }
  .phd .is-open { background:var(--ph-lamp,#d49963) !important; }
  .phd .is-set { background:var(--ph-grey) !important;opacity:.55; }
  .phd .is-op { background:var(--_tokens---color--fg) !important;opacity:.7; }
  .phd__hours > .phd__hours-axis { display:flex;justify-content:space-between;padding-left:82px;color:var(--_tokens---color--muted);font-size:10px; }

  /* Catalogue counts */
  .phd--catalogue { grid-template-columns:repeat(3,minmax(0,1fr));gap:16px 28px; }
  .phd__group { display:grid;gap:8px;min-width:0; }
  .phd__group > b { font-weight:600; }
  .phd__bar { display:grid;grid-template-columns:minmax(0,1fr) 24px;gap:2px 8px;align-items:center;font-size:11px; }
  .phd__bar span { grid-column:1 / -1; }
  .phd__track { height:10px;background:var(--ph-light); } .phd__track i { display:block;height:100%;background:var(--ph-lamp,#d49963); }
  .phd__bar em { font-style:normal;font-variant-numeric:tabular-nums;font-weight:600;text-align:right; }
  .phd--catalogue .phd__note { grid-column:1 / -1; }
  @media (max-width: 699.98px) { .phd--catalogue { grid-template-columns:minmax(0,1fr); } }

  /* Framework steps */
  .phd--steps ol { display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:10px;margin:0;padding:0;list-style:none; }
  .phd--steps li { position:relative;display:grid;gap:4px;align-content:start;min-width:0;padding:10px;border:1px solid var(--_tokens---color--fg);font-size:11px;line-height:1.35; }
  .phd--steps li:not(:last-child)::after { content:'→';position:absolute;right:-11px;top:10px;font-size:14px;color:var(--_tokens---color--muted); }
  .phd--steps li b { font-weight:600;font-size:12px; } .phd--steps li small { font-size:10px;color:var(--_tokens---color--muted); }
  .phd--steps .phd__n { font-size:10px;letter-spacing:.06em;color:var(--_tokens---color--muted); }
  .phd--steps .is-out { background:var(--_tokens---color--fg);color:var(--_tokens---color--bg); }
  @media (max-width: 1023.98px) { .phd--steps ol { grid-template-columns:repeat(3,minmax(0,1fr)); } .phd--steps li::after { display:none; } }
  @media (max-width: 699.98px) { .phd--steps ol { grid-template-columns:repeat(2,minmax(0,1fr)); } }

  /* Three settings, six rules, measures */
  .phd--settings, .phd--measures { grid-template-columns:repeat(3,minmax(0,1fr));gap:16px 24px;align-items:start; }
  .phd__setting, .phd__measure { display:grid;gap:6px;min-width:0; }
  .phd__setting b, .phd__measure b, .phd__rule b { font-weight:600; }
  .phd__setting span, .phd__measure span { font-size:11px;line-height:1.4; }
  .phd--settings .phd__note, .phd--measures .phd__note, .phd--rules .phd__note, .phd--day .phd__note { grid-column:1 / -1; }
  .phd .ground { opacity:.5;stroke-width:.8; } .phd .road { opacity:.3;stroke-width:3;stroke-dasharray:8 6; }
  .phd .canopy { fill:var(--ph-lamp,#d49963);fill-opacity:.35; }
  .phd .room { fill:var(--ph-light);fill-opacity:.5; }
  .phd .tree { fill:var(--ph-green);fill-opacity:.3;stroke:var(--ph-green); }
  .phd .green, .phd .planted { stroke:var(--ph-green);stroke-width:1.6; }
  .phd .truck { fill:var(--ph-light);fill-opacity:.4; }
  .phd--rules { grid-template-columns:repeat(6,minmax(0,1fr));gap:14px 16px; }
  .phd__rule { display:grid;gap:4px;min-width:0;font-size:11px; } .phd__rule small { font-size:10px;color:var(--_tokens---color--muted); }
  .phd .ring { stroke-width:1; } .phd .core { fill:currentColor;stroke:none; } .phd .wall { stroke-width:2; }
  .phd .walk { stroke-dasharray:3 3; } .phd .soak { stroke:var(--ph-blue);stroke-width:1.4; }
  .phd .life { stroke-width:1; } .phd .life-1 { fill:var(--ph-red);fill-opacity:.4;stroke:var(--ph-red); } .phd .life-2 { fill:var(--ph-orange);fill-opacity:.25;stroke:var(--ph-orange); } .phd .life-3 { fill:var(--ph-light);fill-opacity:.4; }
  @media (max-width: 1023.98px) { .phd--rules { grid-template-columns:repeat(3,minmax(0,1fr)); } }
  @media (max-width: 699.98px) { .phd--settings, .phd--measures { grid-template-columns:minmax(0,1fr); } .phd--rules { grid-template-columns:repeat(2,minmax(0,1fr)); } }

  /* Power center, inverted */
  .phd--inversion { grid-template-columns:repeat(2,minmax(0,1fr));gap:16px 28px;align-items:start; }
  .phd__plan { display:grid;gap:6px;min-width:0; } .phd__plan b { font-weight:600; } .phd__plan span { font-size:11px;line-height:1.4; }
  .phd--inversion .box { fill:var(--ph-light);fill-opacity:.7;stroke-width:1.4; }
  .phd--inversion .lot { fill:var(--ph-grey);fill-opacity:.28;stroke:none; }
  .phd--inversion .stall { opacity:.35;stroke-width:.8; }
  .phd--inversion .drive { stroke-width:1.6; } .phd--inversion .walkhead { stroke-width:1.4;stroke-dasharray:none; }
  .phd__inv { grid-column:1 / -1;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;padding-top:10px;border-top:1px solid var(--_tokens---color--line-soft);font-size:11px; }
  .phd__inv div { display:grid;gap:2px; } .phd__inv b { font-weight:600;font-size:10px;letter-spacing:.04em;text-transform:uppercase;color:var(--_tokens---color--muted); }
  .phd--inversion .phd__note { grid-column:1 / -1; }
  @media (max-width: 699.98px) { .phd--inversion { grid-template-columns:minmax(0,1fr); } .phd__inv { grid-template-columns:repeat(2,minmax(0,1fr)); } }

  /* Day */
  .phd__day-who { display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;font-size:11px;line-height:1.35; }
  .phd__day-who div { display:grid;gap:2px;padding:6px 8px;border-top:1px solid var(--_tokens---color--line); } .phd__day-who b { font-weight:600;font-variant-numeric:tabular-nums; }
  .phd__day-rows { display:grid;gap:5px;font-size:11px; }
  .phd__day-row { display:grid;grid-template-columns:minmax(0,180px) minmax(0,1fr);gap:10px;align-items:center; }
  .phd__day-row span { overflow:hidden;text-overflow:ellipsis;white-space:nowrap; }
  .phd__day-track { position:relative;height:12px;background:color-mix(in srgb,var(--ph-light) 45%,transparent); }
  /* The hour axis is a row like the others, so its 00–24 sit under the tracks, not the labels. */
  .phd__day-rows .phd__hours-axis > div { display:flex;justify-content:space-between;min-width:0;color:var(--_tokens---color--muted);font-size:10px; }
  .phd__legend { display:flex;flex-wrap:wrap;align-items:center;gap:6px 8px;font-size:10px;color:var(--_tokens---color--muted); }
  .phd__legend i { width:10px;height:10px;margin-left:8px; } .phd__legend i:first-child { margin-left:0; }
  @media (max-width: 699.98px) { .phd__day-who { grid-template-columns:repeat(2,minmax(0,1fr)); } .phd__day-row { grid-template-columns:minmax(0,110px) minmax(0,1fr); } }
</style>
