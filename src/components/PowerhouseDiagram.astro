---
import diagrams from '../data/powerhouse-programme-diagrams.json';
interface Props { name: string; }
type Diagram = { title:string; width?:number; height?:number; src:string; alt:string; readings:string[][]; note?:string; detailsTitle?:string; details?:string[][] };
const { name } = Astro.props;
const diagram = (diagrams as Record<string,Diagram>)[name];
---
{diagram && <div class="ph-program" data-programme-diagram={name}>
  <a class="phi__image-link ph-program__art" href={diagram.src} target="_blank" rel="noopener" aria-label={`Open full-size diagram: ${diagram.title}`}><img src={diagram.src} alt={diagram.alt} width={diagram.width ?? 1536} height={diagram.height ?? 1024} loading="lazy" decoding="async" /></a>
  <dl class="ph-program__readings" style={`--programme-columns:${diagram.readings.length === 4 ? 2 : Math.min(diagram.readings.length,3)}`}>
    {diagram.readings.map(([title,text])=><div><dt>{title}</dt><dd>{text}</dd></div>)}
  </dl>
  {diagram.note && <p class="ph-program__note">{diagram.note}</p>}
  {diagram.details && <details><summary>{diagram.detailsTitle}</summary><dl>{diagram.details.map(([title,text])=><div><dt>{title}</dt><dd>{text}</dd></div>)}</dl></details>}
  <p class="ph-program__credit">AI-generated architectural programme diagram</p>
</div>}
<style>
  .ph-program { display:grid;gap:12px;min-width:0;width:100%; }
  .ph-program__art { display:block;width:100%;max-width:900px;margin:0 auto;background:#fff;cursor:zoom-in; }
  .ph-program__art img { display:block;width:100%;height:auto;max-height:520px;object-fit:contain; }
  .ph-program__art:focus-visible { outline:2px solid currentColor;outline-offset:3px; }
  dl { display:grid;gap:12px;margin:0;font-size:12px;line-height:1.45; }
  .ph-program__readings { grid-template-columns:repeat(var(--programme-columns),minmax(0,1fr)); }
  dt { margin:0 0 3px;font-size:12px;font-weight:600; }
  dd { margin:0;color:var(--_tokens---color--fg); }
  .ph-program__note,.ph-program__credit { margin:0;font-size:10px;line-height:1.4;color:var(--_tokens---color--muted); }
  details { padding-top:8px;border-top:1px solid var(--_tokens---color--line-soft);font-size:12px; }
  summary { cursor:pointer; }
  details dl { margin-top:12px; }
  @media (max-width: 699.98px) { .ph-program__readings { grid-template-columns:repeat(2,minmax(0,1fr));gap:12px; } }
</style>
