---
// Shared styles for the Virtual Gods exhibition pages (entrance, the four
// worlds, the eight pairs). is:global so the three page templates share one
// sheet; every selector is .vge-prefixed, so nothing escapes the exhibition.
//
// The work is black line art on transparent ground (GIFs with alpha), so
// every picture of it sits on archv.in's own #f2f2f2 in every scheme —
// on a dark scheme the lines would otherwise vanish.
---

<style is:global>
  .vge { --vge-ground: #f2f2f2; max-width: 1180px; margin: 0 auto; padding: clamp(20px, 4vh, 48px) clamp(16px, 3vw, 40px) 80px; box-sizing: border-box; }

  /* ── page head ── */
  .vge-head { display: grid; gap: 14px; max-width: 72ch; }
  .vge-kicker {
    margin: 0;
    font-size: var(--_tokens---type--ultrathin);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ex-accent, var(--_tokens---color--muted));
  }
  .vge-title {
    margin: 0;
    font-size: var(--_tokens---type--medium);
    font-weight: var(--_tokens---weight--strong);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--_tokens---color--fg);
  }
  .vge-lead { margin: 0; font-size: var(--_tokens---type--small); line-height: 1.5; color: var(--_tokens---color--fg); }
  .vge-pills { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .vge-pills li {
    font-size: var(--_tokens---type--micro);
    padding: var(--_tokens---pill-pad--xs);
    border: var(--_tokens---pill-border);
    border-radius: var(--_tokens---radius--pill);
    color: var(--_tokens---color--fg);
  }

  /* ── prose ── */
  .vge-prose { max-width: 68ch; }
  .vge-prose p { margin: 0 0 0.9em; font-size: var(--_tokens---type--small); line-height: 1.55; color: var(--_tokens---color--fg); }
  .vge-verse { margin: 0 0 1.2em; padding-left: 14px; border-left: 2px solid var(--ex-accent, var(--_tokens---color--line-soft)); }
  .vge-verse p { margin: 0; font-size: var(--_tokens---type--small); line-height: 1.6; font-style: italic; color: var(--_tokens---color--fg); }

  /* ── a stage of the work ── */
  .vge-stage { margin-top: clamp(40px, 7vh, 72px); padding-top: 18px; border-top: 1px solid var(--_tokens---color--line-soft); }
  .vge-stage__head { display: flex; align-items: baseline; gap: 12px; margin: 0 0 16px; }
  .vge-stage__n {
    font-size: var(--_tokens---type--micro);
    font-variant-numeric: tabular-nums;
    color: var(--ex-accent, var(--_tokens---color--muted));
  }
  .vge-stage__title { margin: 0; font-size: var(--_tokens---type--small); font-weight: var(--_tokens---weight--strong); color: var(--_tokens---color--fg); }
  .vge-stage__sub { margin: 0 0 16px; font-size: var(--_tokens---type--micro); color: var(--_tokens---color--muted); max-width: 68ch; }

  /* ── grids of work ── */
  .vge-grid { display: grid; grid-template-columns: repeat(var(--cols, 3), minmax(0, 1fr)); gap: 20px 12px; }
  .vge-grid figure { margin: 0; min-width: 0; }
  .vge-grid a { color: inherit; text-decoration: none; display: block; }
  .vge-work {
    display: block;
    width: 100%;
    aspect-ratio: var(--ratio, 1 / 1);
    object-fit: contain;
    background-color: var(--vge-ground);
    border-radius: var(--_tokens---radius--small);
  }
  .vge-work--photo { object-fit: cover; }
  .vge-grid figcaption { margin-top: 8px; font-size: var(--_tokens---type--micro); line-height: 1.4; color: var(--_tokens---color--muted); }
  .vge-grid figcaption strong { display: block; font-weight: var(--_tokens---weight--base); color: var(--_tokens---color--fg); }
  @media (hover: hover) {
    .vge-grid a:hover .vge-work { outline: 1px solid var(--ex-accent, var(--_tokens---color--fg)); outline-offset: 2px; }
  }
  @media (max-width: 1023.98px) {
    .vge-grid { grid-template-columns: repeat(var(--cols-sm, min(var(--cols, 3), 2)), minmax(0, 1fr)); }
  }

  /* ── a live Sketchfab model ── */
  .vge-model { width: 100%; aspect-ratio: 16 / 10; border: 0; display: block; border-radius: var(--_tokens---radius--small); background: var(--vge-ground); }
  .vge-film { width: 100%; display: block; border-radius: var(--_tokens---radius--small); background: #000; }

  /* ── the page with its map beside it ── */
  .vge-layout { display: grid; grid-template-columns: minmax(0, 1fr) 250px; gap: 56px; align-items: start; }
  .vge-layout > article { min-width: 0; }
  .vge-map { position: sticky; top: 24px; order: 2; }
  .vge-map__home { display: flex; justify-content: space-between; color: inherit; text-decoration: none; font-size: var(--_tokens---type--micro); padding-bottom: 14px; border-bottom: 1px solid var(--_tokens---color--line-soft); }
  .vge-key-map { margin: 28px 18px; }
  .vge-key-list { display: grid; gap: 22px; }
  .vge-key-group { display: grid; justify-items: start; gap: 6px; }
  .vge-key-group a { color: var(--_tokens---color--fg); font-size: var(--_tokens---type--micro); line-height: 1.4; text-decoration: none; padding: 7px 12px; border-radius: var(--_tokens---radius--pill); max-width: 100%; box-sizing: border-box; }
  .vge-key-group .vge-key-world { font-size: var(--_tokens---type--small); font-weight: 600; letter-spacing: 0.04em; }
  .vge-key-group a[aria-current="page"] { color: var(--key-ink); background: var(--key-color); }
  .vge-key-group a:hover { text-decoration: underline; }
  .vge-key-group a:focus-visible { outline: 2px solid var(--key-color); outline-offset: 3px; }
  @media (max-width: 1023.98px) {
    .vge-layout { grid-template-columns: minmax(0, 1fr); gap: 32px; }
    .vge-map { position: static; order: 0; display: grid; grid-template-columns: 160px minmax(0, 1fr); gap: 20px; }
    .vge-map__home { grid-column: 1 / -1; }
    .vge-key-map { margin: 12px; align-self: center; }
    .vge-key-list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 699.98px) {
    .vge-map { grid-template-columns: 100px minmax(0, 1fr); gap: 12px; }
    .vge-key-list { grid-template-columns: minmax(0, 1fr); max-height: 180px; overflow-y: auto; }
    .vge-title { font-size: clamp(1.8rem, 6vw, 2.8rem); }
  }

  /* ── walking on ── */
  .vge-walk { margin-top: 64px; display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 12px; }
  .vge-walk a {
    display: grid;
    gap: 4px;
    padding: 14px 16px;
    border: 1px solid var(--_tokens---color--line-soft);
    border-radius: var(--_tokens---radius--small);
    color: var(--_tokens---color--fg);
    text-decoration: none;
    font-size: var(--_tokens---type--micro);
    transition: border-color var(--_tokens---motion--base) ease;
  }
  .vge-walk a span { font-size: var(--_tokens---type--ultrathin); letter-spacing: 0.08em; text-transform: uppercase; color: var(--_tokens---color--muted); }
  @media (hover: hover) { .vge-walk a:hover { border-color: var(--ex-accent, var(--_tokens---color--fg)); } }

  /* ── the entrance ── */
  .vge-entrance { display: grid; gap: clamp(28px, 5vw, 64px); align-items: center; }
  @media (min-width: 1024px) { .vge-entrance { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); } }
  .vge-entrance .vge-title { font-size: clamp(3rem, 2rem + 4vw, 5.5rem); line-height: 0.95; }
</style>
