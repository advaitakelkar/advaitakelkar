---
import story from '../data/habersham-story.json';
import ProjectPeople from './ProjectPeople.astro';
interface Props { stage: number }
const { stage } = Astro.props;
const section = story.stages[stage];
---
<div class="hh-stage" data-hh-stage={stage}>
  <div class="hh-stage-heading"><p class="hh-eyebrow">{section.credit}</p>
    <details class="hh-credit"><summary>Studio credits</summary><ProjectPeople people={section.people} /></details>
  </div>
  <div class="hh-story">{section.intro.map(paragraph => <p>{paragraph}</p>)}</div>
  {section.groups.length > 0 && <nav class="hh-index" aria-label="In this design stage">
    {section.groups.map((group,index) => <a href={`#hh-${group.id}`}><span>{String(index+1).padStart(2,'0')}</span>{group.title}</a>)}
  </nav>}
  {section.groups.map(group => <section class="hh-document" id={`hh-${group.id}`} aria-labelledby={`hh-title-${group.id}`}>
    <header class="hh-document-heading">
      <h4 id={`hh-title-${group.id}`}>{group.title}</h4>
      <p>{group.credit}</p>
      {group.people.length > 0 && <div class="hh-group-people"><ProjectPeople people={group.people} /></div>}
    </header>
    {group.id === 'the-veil' && <nav class="hh-index" aria-label="Explore The Veil">
      <a href="#hh-the-veil-14">Proposal</a><a href="#hh-veil-development-34">Sketches + spatial studies</a><a href="#hh-the-veil-19">Plans + section</a><a href="#hh-the-veil-references">References + case studies</a>
    </nav>}
    {(group.id === 'the-veil' ? [
      {id:'design',title:'The Veil · design proposal',blocks:group.blocks.filter(block => block.presentation === 'design')},
      {id:'references',title:'References + case studies gallery',blocks:group.blocks.filter(block => block.presentation === 'reference')},
      {id:'background',title:'Original brief + early research',blocks:group.blocks.filter(block => block.presentation === 'background')}
    ] : [{id:'design',title:'',blocks:group.blocks}]).map(collection => <div class:list={['hh-collection',`hh-collection--${collection.id}`]} id={`hh-${group.id}-${collection.id}`}>
      {collection.id === 'references' && <div class="hh-copy hh-gallery-intro"><h5>{collection.title}</h5><p>Precedents, mood boards and research collected during the development of The Veil. These images are reference material, not drawings of the Habersham Hall proposal. Named projects retain their source attribution; unattributed references are not assigned to the proposal team.</p></div>}
      <details class="hh-collection-content" open={collection.id === 'design'}>
        <summary>{collection.id === 'design' ? 'Design sequence' : collection.title}</summary>
    {collection.blocks.map(block => <section class:list={['hh-block',block.images.length===0 && 'hh-block--text']} id={`hh-${block.id}`}>
      <div class="hh-block-copy">
        <h5>{block.title}</h5>
        <div class="hh-copy">{block.paragraphs.map(paragraph => <p>{paragraph}</p>)}</div>
      </div>
      {block.images.length > 0 && <div class:list={['hh-image-grid',block.images.length===1 && 'hh-image-grid--single',block.images.length>2 && 'hh-image-grid--many']}>
        {block.images.map(picture => <figure class:list={['hh-figure',picture.height>picture.width && 'hh-figure--portrait']}>
          <a class="hh-open" href={picture.src} data-hh-open aria-label={`Enlarge ${picture.label} · ${picture.sourceLabel}`}>
            <img src={picture.src} width={picture.width} height={picture.height} alt={`${picture.label} · ${picture.sourceLabel}`} loading="lazy" decoding="async" />
          </a>
          <figcaption>{picture.sourceLabel}{block.images.length>1 && ` · image ${picture.image}`}</figcaption>
        </figure>)}
      </div>}
    </section>)}
      </details>
    </div>)}
  </section>)}
  <dialog class="hh-viewer" aria-label="Habersham presentation image">
    <div class="hh-viewer-bar">
      <p class="hh-viewer-caption" aria-live="polite"></p>
      <button type="button" data-hh-close>Close</button>
    </div>
    <div class="hh-viewer-image"><img alt="Enlarged Habersham Hall presentation" /></div>
    <div class="hh-viewer-nav">
      <button type="button" data-hh-previous>Previous</button>
      <a data-hh-full target="_blank" rel="noreferrer">Open image</a>
      <button type="button" data-hh-next>Next</button>
    </div>
  </dialog>
</div>
<script>
  function initHabersham() {
    document.querySelectorAll<HTMLElement>('.hh-stage').forEach(root => {
      if (root.dataset.ready) return;
      root.dataset.ready = 'true';
      const dialog = root.querySelector<HTMLDialogElement>('dialog')!;
      const picture = dialog.querySelector<HTMLImageElement>('.hh-viewer-image img')!;
      const caption = dialog.querySelector<HTMLElement>('.hh-viewer-caption')!;
      const full = dialog.querySelector<HTMLAnchorElement>('[data-hh-full]')!;
      const previous = dialog.querySelector<HTMLButtonElement>('[data-hh-previous]')!;
      const next = dialog.querySelector<HTMLButtonElement>('[data-hh-next]')!;
      let opener: HTMLAnchorElement | null = null;
      let links: HTMLAnchorElement[] = [];
      let index = 0;
      const show = (position: number) => {
        index = Math.max(0, Math.min(position, links.length - 1));
        const link = links[index];
        picture.src = link.href;
        picture.alt = link.querySelector('img')?.alt ?? 'Habersham Hall presentation';
        caption.textContent = `${picture.alt} · ${index + 1} / ${links.length}`;
        full.href = link.href;
        previous.disabled = index === 0;
        next.disabled = index === links.length - 1;
      };
      root.querySelectorAll<HTMLAnchorElement>('[data-hh-open]').forEach(link => {
        link.addEventListener('click', event => {
          if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
          event.preventDefault();
          opener = link;
          const collection = link.closest('.hh-collection') ?? root;
          links = Array.from(collection.querySelectorAll<HTMLAnchorElement>('[data-hh-open]'));
          show(links.indexOf(link));
          dialog.showModal();
        });
      });
      dialog.querySelector('[data-hh-close]')!.addEventListener('click', () => dialog.close());
      dialog.addEventListener('close', () => opener?.focus());
      previous.addEventListener('click', () => show(index - 1));
      next.addEventListener('click', () => show(index + 1));
      dialog.addEventListener('keydown', event => {
        if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
          event.preventDefault();
          event.stopPropagation();
          show(index + (event.key === 'ArrowRight' ? 1 : -1));
        }
      });
    });
  }
  initHabersham();
  document.addEventListener('astro:page-load', initHabersham);
</script>

<style>
  /* A quiet reading surface; all changes are confined to Habersham. */
  :global([data-project-id="habersham-hall"] .project-chapters .ch-card) { background:transparent; box-shadow:none; }
  :global([data-project-id="habersham-hall"] .project-chapters .ch-card__inner) { background:transparent; }
  .hh-stage { max-width:1080px; margin-inline:auto; padding:24px 0 56px; min-width:0; }
  .hh-stage-heading { display:flex; flex-wrap:wrap; justify-content:space-between; align-items:baseline; gap:16px; margin-bottom:24px; }
  .hh-eyebrow { margin:0; font-size:12px; line-height:1.5; color:var(--_tokens---color--muted); }
  .hh-credit { max-width:100%; }
  .hh-credit summary { cursor:pointer; font-size:12px; line-height:1.5; min-height:44px; display:flex; align-items:center; text-decoration:underline; text-underline-offset:4px; }
  .hh-credit :global(.project-team) { padding:16px 0; }
  :global([data-project-id="habersham-hall"] .project-team__initials) { background:#d3d3d3; color:#383838; }
  .hh-story,.hh-copy { max-width:62ch; }
  .hh-story p,.hh-copy p { font-size:16px; line-height:1.8; margin:0 0 20px; overflow-wrap:anywhere; text-wrap:pretty; }
  .hh-story { margin-bottom:32px; }
  .hh-index { display:flex; flex-wrap:wrap; column-gap:28px; row-gap:4px; margin:24px 0 48px; }
  .hh-index a { display:flex; align-items:center; gap:8px; min-height:44px; padding:8px 0; color:inherit; text-decoration:underline; text-decoration-color:var(--_tokens---color--line-soft); text-underline-offset:6px; font-size:13px; line-height:1.5; box-sizing:border-box; }
  .hh-index a:hover { text-decoration-color:currentColor; }
  .hh-index a span { color:var(--_tokens---color--muted); font-size:11px; }
  .hh-document { border-top:1px solid var(--_tokens---color--line-soft); padding:56px 0 24px; scroll-margin-top:96px; }
  .hh-document-heading { margin:0 0 28px; }
  h4 { font-size:clamp(32px,4vw,52px); line-height:1.1; letter-spacing:-.035em; font-weight:500; margin:0 0 14px; }
  .hh-document-heading p,figcaption { font-size:12px; line-height:1.6; color:var(--_tokens---color--muted); }
  .hh-document-heading p { margin:0; }
  .hh-group-people { margin-top:20px; }
  .hh-group-people :global(.project-team) { padding:0; }
  .hh-block { margin:0 0 64px; scroll-margin-top:96px; }
  .hh-block:last-child { margin-bottom:32px; }
  .hh-block--text { max-width:62ch; margin-bottom:36px; }
  .hh-block-copy { margin-bottom:24px; }
  h5 { font-size:20px; line-height:1.4; letter-spacing:-.015em; font-weight:500; margin:0 0 14px; text-wrap:balance; }
  .hh-image-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:32px 24px; align-items:start; }
  .hh-image-grid--single { grid-template-columns:1fr; }
  .hh-image-grid--single .hh-figure--portrait { width:min(100%,640px); }
  figure { min-width:0; margin:0; }
  .hh-open { display:block; background:#fff; min-height:44px; }
  .hh-open img { display:block; width:100%; height:auto; }
  figcaption { margin-top:10px; }
  .hh-collection { scroll-margin-top:96px; }
  .hh-collection--design > details > summary { display:none; }
  .hh-collection-content > summary { min-height:44px; padding:16px 0; margin-bottom:32px; cursor:pointer; font-size:14px; line-height:1.6; border-top:1px solid var(--_tokens---color--line-soft); }
  .hh-gallery-intro { padding-top:32px; margin-bottom:16px; border-top:1px solid var(--_tokens---color--line-soft); }
  .hh-collection--references .hh-image-grid { grid-template-columns:repeat(3,minmax(0,1fr)); }
  .hh-collection--references h5,.hh-collection--background h5 { font-size:17px; }
  .hh-viewer { width:min(1400px,calc(100vw - 24px)); max-width:none; max-height:calc(100dvh - 24px); padding:20px; border:1px solid var(--_tokens---color--line-soft); color:var(--_tokens---color--fg); background:var(--_tokens---color--bg); box-sizing:border-box; }
  .hh-viewer::backdrop { background:rgb(0 0 0 / .85); }
  .hh-viewer-bar,.hh-viewer-nav { display:flex; align-items:center; gap:12px; justify-content:space-between; }
  .hh-viewer-caption { font-size:13px; line-height:1.6; margin:0; overflow-wrap:anywhere; }
  .hh-viewer-image { margin:20px 0; }
  .hh-viewer-image img { display:block; width:100%; max-height:calc(100dvh - 230px); object-fit:contain; }
  .hh-viewer button,.hh-viewer-nav a { display:inline-flex; align-items:center; justify-content:center; min-width:44px; min-height:44px; box-sizing:border-box; padding:8px 12px; font:inherit; font-size:13px; color:inherit; background:none; border:1px solid var(--_tokens---color--line-soft); border-radius:var(--_tokens---radius--pill); cursor:pointer; }
  .hh-viewer button:disabled { opacity:.35; cursor:default; }
  :is(a,button,summary):focus-visible { outline:2px solid currentColor; outline-offset:4px; }
  @media (max-width: 1023.98px) { .hh-collection--references .hh-image-grid { grid-template-columns:repeat(2,minmax(0,1fr)); } }
  @media (max-width: 699.98px) {
    .hh-stage { padding:12px 0 32px; }
    .hh-document { padding-top:36px; }
    .hh-story p,.hh-copy p { font-size:15px; line-height:1.75; }
    .hh-index { column-gap:20px; margin-bottom:32px; }
    .hh-block { margin-bottom:40px; }
    .hh-image-grid,.hh-collection--references .hh-image-grid { grid-template-columns:1fr; gap:24px; }
    .hh-viewer { padding:12px; }
    .hh-viewer-caption { font-size:12px; }
  }
</style>
