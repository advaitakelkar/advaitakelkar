---
import { getEntry } from 'astro:content';
import Icon from './Icon.astro';
import { PAIR, worldHref, pairHref } from '../lib/vg';
const exhibition = await getEntry('exhibitions', 'virtual-gods');
const worlds = [...exhibition!.data.quadrants].sort((a, b) => a.number.localeCompare(b.number));
const pairName = (slug: string) => PAIR[slug].title.replace(' × ', ' + ');
---
<nav class="vg-toolbar" aria-label="Exhibition navigation">
  <a href="#vg-map" data-vg-home aria-current="page"><Icon name="circle" /><span>Map</span></a>

  <details class="vg-dropdown" data-vg-world>
    <summary aria-label="Choose world"><span data-vg-label>World</span><span class="vg-dropdown__arrow"><Icon name="chevron" dir="s" /></span></summary>
    <div class="vg-dropdown__menu" aria-label="Worlds">
      {worlds.map(world => <a href={worldHref(world.slug)} data-no-scramble data-vg-option data-world-label={world.number}>
        <span>{world.number}</span>
        <small class="vg-dropdown__architects">
          <span>{world.architects.slice(0, 2).join(' + ')}</span>
          <span>{world.architects.slice(2, 4).join(' + ')}</span>
        </small>
      </a>)}
    </div>
  </details>

  <details class="vg-dropdown vg-dropdown--pairs" data-vg-pair>
    <summary aria-label="Choose pair"><span data-vg-label>Pair</span><span class="vg-dropdown__arrow"><Icon name="chevron" dir="s" /></span></summary>
    <div class="vg-dropdown__menu" aria-label="Pairs">
      {worlds.map(world => <div class="vg-dropdown__group">
        {world.pairs.map(pair => <a href={pairHref(world.slug, pair.slug)} data-no-scramble data-vg-option data-world={worldHref(world.slug)}>{pairName(pair.slug)}</a>)}
      </div>)}
    </div>
  </details>
</nav>
