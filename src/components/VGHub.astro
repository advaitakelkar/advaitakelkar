---
// The Virtual Gods hub exactly as archv.in had it: eight pair modules on an
// octagon around the four worlds, every one a rotating GIF and a link to its
// original page. Positions are the original's, measured from the rebuilt
// page (public/archv-in/VirtualGods2020.html) — a 702px square of 207px
// tiles — and set here as shares of the square so it scales with its column.
//
// The GIFs are black line art on transparent ground, so the square keeps the
// original's #f2f2f2 page colour in every scheme; on a dark scheme the lines
// would otherwise vanish.

const S = 702; // the original composition's side, px
const T = 207; // one tile, px
const img = (p: string) => `/archv-in/images/${p}`;

const tiles = [
  // outer ring — the eight pairs, clockwise from the top
  { x: 124, y: 0,   gif: 'HejdukxScarpa/024_6.gif',   href: 'SANAAxAndo',      label: 'SANAA x Tadao Ando' },
  { x: 371, y: 0,   gif: 'ItoxCorbusier/024_7.gif',   href: 'AndoxCorrea',     label: 'Tadao Ando x Charles Correa' },
  { x: 495, y: 124, gif: 'AndoxCorrea/046_8.gif',     href: 'ItoxCorbusier',   label: 'Toyo Ito x Le Corbusier' },
  { x: 495, y: 371, gif: 'VenturixZumthor/024_1.gif', href: 'ScarpaxIto',      label: 'Carlo Scarpa x Toyo Ito' },
  { x: 371, y: 495, gif: 'ScarpaxIto/024_2.gif',      href: 'VenturixZumthor', label: 'Peter Zumthor x Robert Venturi' },
  { x: 124, y: 495, gif: 'VirtualGods2020/006_3.gif', href: 'ArchigramxBaeza', label: 'Archigram x Alberto Campo Baeza' },
  { x: 0,   y: 371, gif: 'ArchigramxBaeza/024_4.gif', href: 'ZahaxMarx',       label: 'Zaha Hadid x Roberto Burle Marx' },
  { x: 0,   y: 124, gif: 'SANAAxAndo/024_5.gif',      href: 'HejdukxScarpa',   label: 'John Hejduk x Carlo Scarpa' },
  // centre — the four worlds
  { x: 174, y: 174, gif: 'VirtualGods2020/014_9R.gif',  href: 'VG01', label: 'VG01' },
  { x: 321, y: 174, gif: 'VirtualGods2020/015_10R.gif', href: 'VG02', label: 'VG02' },
  { x: 321, y: 321, gif: 'VirtualGods2020/012_11R.gif', href: 'VG03', label: 'VG03' },
  { x: 174, y: 321, gif: 'VirtualGods2020/013_12R.gif', href: 'VG04', label: 'VG04' },
];
const pct = (v: number) => `${(v / S * 100).toFixed(3)}%`;
---

<nav class="vgh" aria-label="Virtual Gods — the eight pairs and four worlds">
  {tiles.map((t) => (
    <a
      class="vgh__tile"
      href={`/archv-in/${t.href}.html`}
      style={`left:${pct(t.x)};top:${pct(t.y)};width:${pct(T)};`}
      aria-label={t.label}
    >
      <img src={img(t.gif)} alt="" loading="lazy" decoding="async" />
      <span class="vgh__label">{t.label}</span>
    </a>
  ))}
</nav>

<style>
  .vgh {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    isolation: isolate;
  }
  /* The ground is a circle, not the square the tiles are laid out on: the
     outer pair modules reach past a circle inscribed in that square, so it
     is drawn 6% wider all round and nothing is clipped. */
  .vgh::before {
    content: '';
    position: absolute;
    inset: -6%;
    border-radius: 50%;
    background-color: #f2f2f2;
    z-index: -1;
  }

  .vgh__tile {
    position: absolute;
    aspect-ratio: 1 / 1;
    display: block;
    transition: filter var(--_tokens---motion--base) ease;
  }
  /* The hovered tile comes forward over its overlapping neighbours, as the
     worlds in the centre overlap each other on the original. */
  .vgh__tile:hover, .vgh__tile:focus-visible { z-index: 2; filter: drop-shadow(0 0 14px rgb(0 0 0 / 0.18)); }
  .vgh__tile:focus-visible { outline: 2px solid #111; outline-offset: 2px; }

  .vgh__tile img { width: 100%; height: 100%; display: block; }

  /* The original's hover caption: a small grey plate under the work. */
  .vgh__label {
    position: absolute;
    left: 0;
    top: 100%;
    padding: 2px 6px;
    font-size: var(--_tokens---type--ultrathin);
    line-height: 1.4;
    color: #333;
    background-color: #dedede;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--_tokens---motion--base) ease;
  }
  .vgh__tile:hover .vgh__label, .vgh__tile:focus-visible .vgh__label { opacity: 1; }

  @media (prefers-reduced-motion: reduce) {
    .vgh__tile, .vgh__label { transition: none; }
  }
</style>
