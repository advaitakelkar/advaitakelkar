---
// Skadoogee: the COTE Top Ten table and the shared figure styles used inside its
// chapter bodies. Chapter text lives in src/content/projects/skadoogee.yaml.
const measures = [
  ['01', 'Integration', 'Suspension is the single idea: one pier, one crown, one tank and one roof do structure, water, energy and air at once.', 'Narrative and integration diagram'],
  ['02', 'Equitable Community', 'The trail and the pavilion are public; the refuge serves the county, not the members.', 'Walk Score and network diagram'],
  ['03', 'Ecosystems', 'The ground stays forest. Floors sit 5.5 m above it; wildlife and water pass beneath.', '% site area supporting vegetation; trees retained'],
  ['04', 'Water', 'Water-tower towers, permeable platforms, bioswales and the stepwell pond.', '% of the 2-year 24-hour storm managed on site; tank volume vs demand'],
  ['05', 'Economy', 'Two foundations, no earthworks, prefabricated steel; the core and tank are shared services.', 'Cut-and-fill avoided; cost logic'],
  ['06', 'Energy', 'Photovoltaic sawtooth, stack ventilation through the core, daylight through polycarbonate.', 'EUI, PV generation, net EUI'],
  ['07', 'Well-Being', 'Body and mind programme, forest views from every floor, the running trail.', '% floor area daylit; % of year comfortable passively'],
  ['08', 'Resources', 'Steel, timber and polycarbonate over concrete; one concrete pier per tower.', 'Embodied carbon estimate'],
  ['09', 'Change', 'The Center for Resilience runs off-grid in storm, flood and outage; floors sit above flow paths.', 'Days of autonomy; refuge capacity'],
  ['10', 'Discovery', 'Tank level, PV yield and stack flow are monitored and shown in the learning wing.', 'Post-occupancy monitoring plan'],
] as const;
---

<section class="skd-cote" id="cote-top-ten" aria-labelledby="skd-cote-title">
  <header class="skd-cote__heading">
    <p class="skd-eyebrow">AIA COTE Top Ten / Framework for Design Excellence</p>
    <h2 id="skd-cote-title">Ten measures, one idea.</h2>
  </header>
  <ol class="skd-cote__list">
    {measures.map(([n, title, answer, metric]) => (
      <li>
        <span class="skd-cote__n">{n}</span>
        <h3>{title}</h3>
        <p>{answer}</p>
        <p class="skd-cote__metric">{metric}</p>
      </li>
    ))}
  </ol>
  <p class="skd-method">Metrics are the quantities the entry will carry; the numbers are being calculated from the model and are not yet published here.</p>
</section>

<style>
  .skd-cote{scroll-margin-top:78px;padding:48px 0;border-top:1px solid var(--_tokens---color--line-soft);color:var(--_tokens---color--fg);min-width:0}
  .skd-cote__heading{max-width:850px;margin-bottom:28px}.skd-eyebrow{font-size:12px;letter-spacing:.04em;color:var(--_tokens---color--muted);margin:0 0 16px}
  h2{font-size:clamp(28px,3vw,44px);font-weight:500;line-height:1.1;letter-spacing:-.035em;margin:0}
  .skd-cote__list{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 40px}
  .skd-cote__list li{display:grid;grid-template-columns:36px 1fr;grid-template-rows:auto auto auto;column-gap:12px;padding:20px 0;border-top:1px solid var(--_tokens---color--line-soft)}
  .skd-cote__n{grid-row:1 / span 3;font-size:12px;color:var(--_tokens---color--muted);padding-top:4px}
  h3{font-size:17px;font-weight:500;line-height:1.25;margin:0 0 6px}
  .skd-cote__list p{font-size:14px;line-height:1.55;margin:0 0 6px}
  .skd-cote__metric{color:var(--_tokens---color--muted);font-size:12px!important;border-left:2px solid #9caf88;padding-left:12px}
  .skd-method{font-size:12px;line-height:1.6;color:var(--_tokens---color--muted);max-width:100ch;margin:24px 0 0}
  @media(max-width: 699.98px){.skd-cote{padding:32px 0}.skd-cote__list{grid-template-columns:1fr}}
</style>

<style is:global>
  /* Figures inside the Skadoogee chapter bodies (raw HTML via set:html). Drawings are
     contained, never cropped, unlike the generic .ch-hero cover image. */
  .skd-fig{margin:20px 0 0}
  .skd-fig img{display:block;width:100%;height:auto;background:#fff;border:1px solid var(--_tokens---color--line-soft)}
  .skd-fig figcaption{font-size:12px;line-height:1.5;color:var(--_tokens---color--muted);margin:8px 0 0}
  .skd-fig--hero img{max-height:70vh;object-fit:contain}
  .skd-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}
  @media(max-width: 699.98px){.skd-grid{grid-template-columns:1fr}}
</style>
