---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import slots from '../data/powerhouse-image-slots.json';
// Narrative images for Chapters 1–4. A slot shows its image once a file named after
// its id is in public/powerhouse/images/; until then it shows a placeholder.
interface Props { section: string; imageIndex?: number; inline?: boolean; only?: 'diagram'; }
type Slot = { id: string; family: 'today' | 'proposal' | 'archival'; title: string; caption: string; src?: string; medium?: 'sketch' | 'realistic' | 'diagram'; fit?: 'full' };
const { section, imageIndex, inline = false, only } = Astro.props;
const items = ((slots as Record<string, Slot[]>)[section] || []).filter((s,index) => (imageIndex === undefined || index === imageIndex) && (!only || s.medium === only)).map((s) => {
  if (s.src) return s;
  const ext = ['webp', 'jpg', 'png'].find((e) => existsSync(join(process.cwd(), 'public/powerhouse/images', `${s.id}.${e}`)));
  return { ...s, src: ext ? `/powerhouse/images/${s.id}.${ext}` : undefined };
});
const credit = { today: 'AI-generated illustration', proposal: 'AI-generated illustration, speculative', archival: 'Archival photograph' };
const kind = { today: 'Today', proposal: 'The Powerhouse', archival: 'Archive' };
---
{items.length > 0 && (
  <div class:list={['phi', { 'phi--single': items.length === 1, 'phi--inline': inline }]}>
    {items.map((s) => (
      <figure class:list={['phi__fig', `phi__fig--${s.family}`, { 'phi__fig--sketch': s.medium === 'sketch' || s.medium === 'diagram', 'phi__fig--diagram': s.medium === 'diagram', 'phi__fig--full': s.fit === 'full' }]} data-image-slot={s.id}>
        {s.src ? (
          <a class="phi__image-link" href={s.src} target="_blank" rel="noopener" data-phi-open aria-label={`Open full-size image: ${s.title}`}><img src={s.src} alt={s.caption} loading="lazy" decoding="async" sizes="(max-width: 699.98px) calc(100vw - 32px), 50vw" /></a>
        ) : (
          <div class="phi__ph" role="img" aria-label={`Image to come: ${s.title}`}>
            <span class="phi__ph-kind">{kind[s.family]}</span>
            <b>{s.title}</b>
            <code>public/powerhouse/images/{s.id}.webp</code>
          </div>
        )}
        <figcaption><b>{s.title}.</b>{' '}{s.caption}<span>{s.medium === 'diagram' ? 'AI-generated architectural programme diagram, speculative' : s.medium === 'sketch' ? (s.family === 'proposal' ? 'AI-generated architectural study, speculative' : 'AI-generated architectural study') : credit[s.family]}</span></figcaption>
      </figure>
    ))}
  </div>
)}
<style>
  /* Narrative renders share the reading columns, including single-image sections. */
  .phi { display:grid;grid-template-columns:repeat(2,minmax(0,1fr));align-items:start;gap:24px var(--ph-reading-gap, 40px);margin:0 0 32px; }
  .phi__fig { margin:0;display:grid;gap:10px;min-width:0; }
  .phi__fig img,.phi__ph { width:100%;aspect-ratio:3 / 2;object-fit:cover;display:block; }
  .phi__image-link { display:block;min-width:0;cursor:zoom-in; }
  .phi__image-link:focus-visible { outline:2px solid currentColor;outline-offset:3px; }
  /* Sketches sit on their own paper: a hairline keeps the white sheet from floating in dark mode. */
  .phi__fig--sketch img { object-fit:contain;background:#fff;box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--_tokens---color--fg) 10%,transparent); }
  .phi--single .phi__fig--sketch img { aspect-ratio:3 / 2; }
  .phi--single .phi__fig--full img { aspect-ratio:auto;height:auto;object-fit:contain;background:#fff; }
  .phi__fig--diagram { grid-column:1 / -1;width:100%;max-width:960px;margin-inline:auto; }
  .phi__fig--diagram img { max-height:560px; }
  .phi__ph { box-sizing:border-box;display:flex;flex-direction:column;justify-content:flex-end;gap:6px;padding:16px;
    border:1px dashed color-mix(in srgb,var(--_tokens---color--fg) 28%,var(--_tokens---color--bg));
    background:color-mix(in srgb,var(--_tokens---color--fg) 5%,var(--_tokens---color--bg));color:var(--_tokens---color--fg); }
  .phi__fig--proposal .phi__ph { background:color-mix(in srgb,var(--_tokens---color--fg) 10%,var(--_tokens---color--bg)); }
  .phi__ph-kind { font-size:10px;letter-spacing:.08em;text-transform:uppercase;color:var(--_tokens---color--muted); }
  .phi__ph b { font-size:clamp(1rem,.9rem + .4vw,1.25rem);font-weight:600;line-height:1.2; }
  .phi__ph code { font-size:10px;color:var(--_tokens---color--muted);overflow-wrap:anywhere; }
  .phi figcaption { font-size:12px;line-height:1.45;color:var(--_tokens---color--fg); }
  .phi figcaption span { display:block;margin-top:2px;font-size:10px;color:var(--_tokens---color--muted); }
  @media (max-width: 699.98px) { .phi { grid-template-columns:minmax(0,1fr);gap:20px; } }
  /* In the editorial flow, each image belongs to a text column with its caption. */
  .phi--inline { display:block;margin:0 0 18px;break-inside:avoid; }
  .phi--inline .phi__fig { gap:7px;break-inside:avoid; }
  .phi--inline img { aspect-ratio:auto;height:auto;object-fit:contain; }
  .phi--inline figcaption { font-size:11px;line-height:1.4; }
</style>
<style is:global>
  /* One lightbox for every chapter image, built once by the script below. */
  .phi-lightbox { inset:0;margin:auto;max-width:min(96vw,1600px);max-height:96dvh;padding:0;border:0;background:transparent;color:var(--_tokens---color--bg); }
  .phi-lightbox::backdrop { background:color-mix(in srgb,#111 92%,transparent); }
  .phi-lightbox img { display:block;max-width:min(96vw,1600px);max-height:calc(96dvh - 56px);width:auto;height:auto;margin:0 auto;object-fit:contain; }
  .phi-lightbox p { margin:12px 0 0;font-size:12px;line-height:1.45;color:#fff;text-align:center;padding:0 16px; }
  .phi-lightbox button { position:fixed;top:16px;right:16px;width:44px;height:44px;border:1px solid rgba(255,255,255,.4);border-radius:50%;background:rgba(0,0,0,.4);color:#fff;font-size:18px;cursor:pointer; }
</style>
<script>
  // Chapter images open in place rather than in a new tab: the studies, the typology
  // sections and the narrative slots all share one dialog. Esc and the backdrop close it.
  const SEL = 'a.phi__image-link, a.ph2-study, .ph-studies a[href]';
  let dialog: HTMLDialogElement | null = null;
  const build = () => {
    dialog = document.createElement('dialog');
    dialog.className = 'phi-lightbox';
    dialog.innerHTML = '<button type="button" aria-label="Close">×</button><img alt=""><p></p>';
    dialog.querySelector('button')!.addEventListener('click', () => dialog!.close());
    dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog!.close(); });
    document.body.append(dialog);
    return dialog;
  };
  document.addEventListener('click', (e) => {
    const link = (e.target as Element).closest<HTMLAnchorElement>(SEL);
    if (!link || e.metaKey || e.ctrlKey) return;
    e.preventDefault();
    const d = dialog ?? build();
    const img = link.querySelector('img');
    // innerText keeps the caption's line break before the credit; it becomes a middle dot.
    const caption = (link.closest('figure')?.querySelector<HTMLElement>('figcaption')?.innerText ?? img?.alt ?? '').trim().replace(/\s*\n+\s*/g, ' · ');
    d.querySelector('img')!.src = link.href;
    d.querySelector('img')!.alt = img?.alt ?? caption;
    d.querySelector('p')!.textContent = caption;
    d.showModal();
  });
</script>
