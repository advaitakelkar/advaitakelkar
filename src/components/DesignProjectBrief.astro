---
interface Props { abstract: string; hypothesis: string }
const { abstract, hypothesis } = Astro.props;
---

<section class="design-brief" aria-label="Design proposition">
  <div>
    <h2>Abstract</h2>
    <p>{abstract}</p>
  </div>
  <div>
    <h2>Hypothesis</h2>
    <p class="design-brief__claim">{hypothesis}</p>
  </div>
</section>

<style>
  .design-brief { display: grid; gap: 24px; padding: 24px 0; border-top: 1px solid var(--_tokens---color--line-soft); }
  h2 { margin: 0 0 12px; font-size: var(--_tokens---type--micro); font-weight: var(--_tokens---weight--base); color: var(--_tokens---color--muted); }
  p { margin: 0; max-width: 68ch; font-size: var(--_tokens---type--small); line-height: 1.55; color: var(--_tokens---color--fg); overflow-wrap: anywhere; }
  .design-brief__claim { font-size: var(--_tokens---type--small); line-height: 1.4; font-weight: 500; }
  @media (min-width: 1024px) {
    .design-brief { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 48px; }
  }
</style>
