---
/**
 * The site's one Read more / Read less pill. Styles live in tokens.css
 * (`.read-more`), so markup written as a string — chapter YAML, the GONG
 * intro — can use the same classes.
 *
 *   <ReadMore id="x" aria-controls="y" />   a button; the page script flips
 *                                            aria-expanded and the label follows
 *   <ReadMore as="summary" />               the first child of a <details>;
 *                                            needs no script at all
 */
import Icon from './Icon.astro';

const { as = 'button', class: className, ...rest } = Astro.props;
const Tag = as;
const buttonProps = as === 'button' ? { type: 'button', 'aria-expanded': 'false' } : {};
---
<Tag class:list={['read-more', className]} {...buttonProps} {...rest}>
  <span class="read-more__more">Read more</span>
  <span class="read-more__less">Read less</span>
  <Icon name="arrow" class="read-more__icon" />
</Tag>
