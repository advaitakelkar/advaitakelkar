---
/**
 * The site arrow — now a thin alias over `Icon.astro`.
 *
 * The glyph, the spec and the rotation logic all live in Icon. This file
 * exists so the 54 `<Arrow />` call sites keep working unchanged, and because
 * "arrow" is the one symbol used often enough to deserve its own name.
 *
 *   <Arrow />            ↗  outbound link (default)
 *   <Arrow dir="s" />    ↓  disclosure, open
 *
 * Equivalent to `<Icon name="arrow" />`. New code can use either; prefer Icon
 * when you are already reaching for other symbols in the same file.
 *
 * Size is `--icon-size` (`--arrow-size` still works), weight is the pen curve
 * in tokens.css. Neither is set here — see Icon.astro for why.
 */
import Icon from './Icon.astro';
import type { IconDir } from '../lib/icons';

/** Compass point the arrow should aim at. Kept as an export: several files
    import this type to annotate their own props. */
export type ArrowDir = IconDir;

interface Props {
  dir?: ArrowDir;
  class?: string;
  [key: string]: unknown;
}

const { dir = 'ne', class: className, ...rest } = Astro.props as Props;
---

<Icon name="arrow" dir={dir} class={className} {...rest} />
