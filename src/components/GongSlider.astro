---
interface Props { figures: Array<{ image: string; caption?: string }>; name?: string }
const { figures, name = 'GONG' } = Astro.props;
---
<div class="gong-slider" data-gong-slider aria-label={`${name} interior views`} aria-roledescription="carousel">
  <div class="gong-slider__stage">
    {figures.map((f, i) => <img src={f.image} alt={f.caption ?? `${name} interior ${i + 1}`} class:list={{'is-active': i === 0}} loading={i === 0 ? 'eager' : 'lazy'} />)}
  </div>
  <div class="gong-slider__controls">
    <button type="button" data-prev aria-label="Previous interior view">←</button>
    <span data-count>1 / {figures.length}</span>
    <button type="button" data-pause aria-label="Pause slideshow">Pause</button>
    <button type="button" data-next aria-label="Next interior view">→</button>
  </div>
</div>
<style>
  .gong-slider { width: 100%; }
  .gong-slider__stage { width: 100%; }
  .gong-slider__stage img { display: none; width: 100%; height: auto; object-fit: contain; opacity: 0; transition: opacity 600ms ease; border-radius: var(--_tokens---radius--small); }
  .gong-slider__stage img.is-active { display: block; opacity: 1; }
  .gong-slider__controls { display: flex; align-items: center; justify-content: space-between; gap: 8px; font-size: var(--_tokens---type--micro); }
  .gong-slider__controls button { color: inherit; background: none; border: 0; cursor: pointer; min-height: 44px; min-width: 44px; font: inherit; }
  @media (prefers-reduced-motion: reduce) { .gong-slider__stage img { transition: none; } }
</style>
<script>
  function initGongSlider() {
    document.querySelectorAll<HTMLElement>('[data-gong-slider]:not([data-wired])').forEach(root => {
      root.dataset.wired = 'true';
      const images = Array.from(root.querySelectorAll('img'));
      const count = root.querySelector('[data-count]')!;
      const copy = root.closest<HTMLElement>('.project-card-info');
      const resize = new ResizeObserver(() => copy?.style.setProperty('--rr-aside-h', `${root.getBoundingClientRect().height}px`));
      resize.observe(root);
      document.addEventListener('astro:before-swap', () => resize.disconnect(), { once: true });
      const pause = root.querySelector<HTMLButtonElement>('[data-pause]')!;
      let current = 0;
      let stopped = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const reflect = () => { pause.textContent = stopped ? 'Play' : 'Pause'; pause.setAttribute('aria-label', stopped ? 'Play slideshow' : 'Pause slideshow'); };
      const show = (delta: number) => {
        images[current].classList.remove('is-active');
        current = (current + delta + images.length) % images.length;
        images[current].classList.add('is-active');
        count.textContent = `${current + 1} / ${images.length}`;
      };
      root.querySelector('[data-prev]')?.addEventListener('click', () => show(-1));
      root.querySelector('[data-next]')?.addEventListener('click', () => show(1));
      pause.addEventListener('click', () => { stopped = !stopped; reflect(); });
      reflect();
      const timer = window.setInterval(() => {
        if (!root.isConnected) { clearInterval(timer); return; }
        if (!stopped && !document.hidden && !root.matches(':hover') && !root.contains(document.activeElement)) show(1);
      }, 5000);
    });
  }
  initGongSlider();
  document.addEventListener('astro:after-swap', initGongSlider);
</script>
