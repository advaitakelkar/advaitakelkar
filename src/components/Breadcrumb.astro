    flex: 0 0 auto;
    width: auto;
  }
  .breadcrumb__dropdown-trigger {
    width: auto;
    padding: 0 16px;
    height: 40px;
    gap: 8px;
  }

  /* Center the pages dropdown menu on tablet */
  .breadcrumb__dropdown-panel {
    position: fixed !important;
    left: 50% !important;
    right: auto !important;
    bottom: 84px !important;
    width: min(300px, calc(100vw - 48px)) !important;
    transform-origin: bottom center !important;
    z-index: 550 !important;
  }

  .breadcrumb__dropdown-panel.is-open {
    animation: bc-panel-in-center var(--_tokens---motion--base) var(--_tokens---ease-out) !important;
    transform: translateX(-50%) !important;
