  .breadcrumb__list-item[hidden],
  .breadcrumb__divider[hidden] {
    display: none;
  }

  .breadcrumb__list-item:focus-visible {
    background-color: var(--_tokens---color--fg);
    color: var(--_tokens---color--bg);
    border-color: var(--_tokens---color--fg);
    outline: none;
  }
  @media (hover: hover) {
    /* Full invert on hover / focus */
  .breadcrumb__list-item:hover {
    background-color: var(--_tokens---color--fg);
    color: var(--_tokens---color--bg);
    border-color: var(--_tokens---color--fg);
    outline: none;
  }
  }

  /* Active item (the page you are on) — muted invert */
  .breadcrumb__list-item.is-active {
    background-color: color-mix(in srgb, var(--_tokens---color--fg) 14%, transparent);
    color: var(--_tokens---color--fg);
    border-color: color-mix(in srgb, var(--_tokens---color--fg) 28%, transparent);
    font-weight: var(--_tokens---weight--base);
  }

  /* Category items slightly muted to distinguish from page links */
  .breadcrumb__list-item--cat { opacity: 0.85; }
  @media (hover: hover) {
    .breadcrumb__list-item--cat:hover { opacity: 1; }
  }

  .breadcrumb__proj-name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    text-align: left;
    flex: 1;
  }

  .breadcrumb__arrow-icon {
    --icon-size: 8px;
    flex-shrink: 0;
    opacity: 0.5;
    transition: opacity var(--_tokens---motion--fast);
  
  }
  .breadcrumb__list-item:focus-visible .breadcrumb__arrow-icon { opacity: 1; }
  @media (hover: hover) {
    .breadcrumb__list-item:hover .breadcrumb__arrow-icon { opacity: 1; }
  }

  /* ── Backdrop ───────────────────────────────────────────────── */
  .breadcrumb__backdrop {
    position: fixed; inset: 0;
    background-color: rgba(0, 0, 0, 0.2);
    z-index: 450;
    display: none;
    pointer-events: auto;
  }
  .breadcrumb__backdrop.is-open {
    display: block;
    animation: bc-fade-in var(--_tokens---motion--base) ease;
  }
  @keyframes bc-fade-in {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  /* Pills signal keyboard focus by inverting (bg↔fg) in the :focus-visible
     rules above; the prev/next arrows fall back to the global focus ring. */

  /* ── Pages points the way the panel opens ─────────────────────────
     The bar docks at the bottom below 700 and the panel opens UPWARD from
     it, so a chevron pointing down was aiming at the screen edge. Closed it
     points up, toward where the list will appear; open it points down, the
     way it will go back.

     Stated as a transform rather than a dir on the icon: dir="s" writes
     --arrow-rot inline, and inline wins over any rule. Placed after the
     open-state rule above because that selector is identical — a media query
     adds no specificity, so source order is what decides. */
  @media (max-width: 1023.98px) {
    .breadcrumb__trigger-chevron {
