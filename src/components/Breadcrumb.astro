  .breadcrumb__custom-dropdown {
    flex: 1 1 0;
    min-width: 0;
    z-index: 500;
  }
}

/* ── Tablet only: navigation pills hug content, more spaced out, pages dropdown centered ── */
@media (min-width: 700px) and (max-width: 1023.98px) {
  .breadcrumb {
    width: auto;
    gap: 12px;
  }
  .breadcrumb__list {
    gap: 12px;
