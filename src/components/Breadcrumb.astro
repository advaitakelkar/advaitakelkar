  .breadcrumb__custom-dropdown.is-docked .breadcrumb__pages-list {
    max-height: var(--bc-dock-room, calc(100dvh - 100px));
  }
  /* The dim sits in the top bar's stacking context, which paints over the
     search bar — it would cover the very list it frames. Outside clicks
