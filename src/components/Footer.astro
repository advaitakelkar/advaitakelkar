---
import Icon from './Icon.astro';
import { getCollection } from 'astro:content';

/* The Quick Search bar, and only that. It used to carry a cloud of every
   project as pills; that is gone from every page but /projects, which has
   its own. Searching from here takes the query to /projects?q=, where the
   results are. The props stay so existing call sites keep compiling. */
export interface Props {
  isEmbedded?: boolean;
  categoryId?: string;
  activeIds?: string[];
  isHome?: boolean;
}

const { isEmbedded = false, isHome = false } = Astro.props;

/* Suggestions: every project, with the same search text the projects page
   matches on — name, place, year, client, status, program, category,
   studio, discipline, subtitle, short name, people and chapter text — so a
   query suggests here exactly what it would find there. */
const [allProjects, allTags, allCats, allStudios] = await Promise.all([
  getCollection('projects'), getCollection('tags'), getCollection('categories'), getCollection('studios'),
]);
const tagMap = Object.fromEntries(allTags.map(t => [t.id, t.data.name]));
const catMap = Object.fromEntries(allCats.map(c => [c.id, c.data.displayName]));
const studioMap = Object.fromEntries(allStudios.map(s => [s.id, s.data.displayName]));
const suggestions = allProjects
  .map((p: any) => ({
    id: p.id,
    label: p.data.shortName || p.data.name,
    name: p.data.name,
    hay: [
      p.data.name, p.data.location, p.data.year, p.data.client, p.data.status, p.data.program,
      p.data.category && catMap[p.data.category.id], p.data.studio && studioMap[p.data.studio.id],
      ...(p.data.tags ?? []).map((t: any) => tagMap[t.id] || t.id),
      p.data.shortName, p.data.smallIntro, ...(p.data.people ?? []),
      // Chapter text is capped: this index ships on every page, and a
      // chapter's opening lines are what a quick search is looking for.
      ...(p.data.chapters ?? []).flatMap((c: any) => [c.title, c.subtitle, String(c.body ?? '').replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').slice(0, 300)]),
    ].filter(Boolean).join(' ').replace(/\s+/g, ' ').toLowerCase(),
  }))
  .sort((a, b) => a.name.localeCompare(b.name));
---

<footer class:list={["home-search-footer", isEmbedded && "home-search-footer--embedded", isHome && "home-search-footer--home"]} id="home-search-footer">

  <!-- Search bar sits at the bottom of the footer -->
  {/* The field is wrapped so the ✕ positions against the field, not the bar:
      from 1024 up PageLayout docks the Pages button at the bar's right end. */}
  <div class="home-search__bar" data-pages-dock>
    {/* Matching projects, above the bar while you type. Hidden until a query
        matches; only the matches show. */}
    <div class="qs-sug" id="qs-sug" aria-label="Matching projects" hidden>
      {suggestions.map((sg) => (
        <a class="qs-sug__pill" href={`/projects/${sg.id}`} data-hay={sg.hay} title={sg.name} hidden>
          {sg.label}<Icon name="arrow" class="qs-sug__arrow" />
        </a>
      ))}
    </div>
    <div class="home-search__field">
      <input
        type="search"
        id="qs-input"
        enterkeyhint="search"
        class="home-search__input"
        placeholder="Quick Search"
        autocomplete="off"
        aria-label="Search projects"
      />
      <button class="home-search__clear" id="qs-clear" type="button" aria-label="Clear search">
        <Icon name="close" class="qs-clear-icon" />
      </button>
    </div>
  </div>
</footer>

<style>

  .home-search-footer {
    width: 100%;
    border-top: 1px solid var(--_tokens---color--line-soft); /* family hairline */
    padding-top: 32px;
    padding-bottom: 24px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
  }

  /* standalone (non-embedded) padding to match standard page margins */
  .home-search-footer:not(.home-search-footer--embedded) {
    margin-top: clamp(3rem, 6vh, 5rem);
  }

  /* ── No pill cloud on the phone ──────────────────────────────────────
     Every project on the site, listed again as pills, under whatever page you
     are already reading. On a desktop it is a quick-jump index sitting in
     spare width; on a 375px screen it is hundreds of taps of vertical scroll
     between you and the end of the page. The pages list in the bottom bar
     does this job here.
     After the base rule, which sets display:flex at the same specificity. */
  @media (max-width: 699.98px) {
    .home-search-footer {
      display: none;
    }
  }

  .home-search-footer--embedded {
    border-top: none !important;
    margin-top: auto; /* push to the bottom when placed in a flex layout */
  }

  /* One full-width bar; the clear ✕ floats INSIDE the field's right edge */
  .home-search__bar {
    position: relative;
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 14px;
  }

  /* ── Suggestions ── they stand on the bar, over the page. The pills are
     the site's ordinary pill — the Skillset's own: tinted, hairline, muted
     text at the suggestion size — so on About the project suggestions and
     the skills read as one set. The one Enter opens is inverted. The panel
     has no box of its own and no inset, so the pills start on the same
     edge as the page's text and the Skillset above them. */
  .qs-sug {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 100%;
    z-index: 5;
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    max-height: 32vh;
    overflow-y: auto;
    scrollbar-width: none;
    padding: 10px 0;
    background-color: var(--_tokens---color--bg);
  }
  .qs-sug[hidden] { display: none; }
  .qs-sug::-webkit-scrollbar { display: none; }
  .qs-sug__pill {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.7rem;
    font-weight: var(--_tokens---weight--light);
    padding: 4px 10px;
    white-space: nowrap;
    text-decoration: none;
    color: var(--_tokens---color--muted);
    background-color: color-mix(in srgb, var(--_tokens---color--fg) 6%, transparent);
    border: var(--_tokens---pill-border);
    border-radius: var(--_tokens---radius--pill);
    --icon-size: var(--_tokens---arrow--sm);
    transition: background-color var(--_tokens---motion--base), color var(--_tokens---motion--base), border-color var(--_tokens---motion--base);
  }
  .qs-sug__pill[hidden] { display: none; }
  /* The one Enter opens. */
  .qs-sug__pill.is-sel {
    background-color: var(--_tokens---color--fg);
    color: var(--_tokens---color--bg);
    border-color: var(--_tokens---color--fg);
  }
  @media (hover: hover) {
    .qs-sug__pill:hover {
      background-color: var(--_tokens---color--fg);
      color: var(--_tokens---color--bg);
      border-color: var(--_tokens---color--fg);
    }
  }

  .home-search__field {
    position: relative;
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: center;
  }

  .home-search__input {
    flex: 1;
    height: 42px;
    padding: 0 46px 0 16px; /* right side clears the inline ✕ */
    font-size: var(--_tokens---type--micro);
    font-family: inherit;
    background: color-mix(in srgb, var(--_tokens---color--fg) 6%, transparent);
    border: none;
    color: var(--_tokens---color--fg);
    -webkit-text-fill-color: var(--_tokens---color--fg);
    caret-color: var(--_tokens---color--fg);
    border-radius: 4px;
    outline: none;
    opacity: 0.85;
    transition: background-color var(--_tokens---motion--base), opacity var(--_tokens---motion--base) ease;
  }

  /* The browser's own clear button doubled up with the ✕ beside it. */
  .home-search__input::-webkit-search-cancel-button {
    -webkit-appearance: none;
    appearance: none;
    display: none;
  }

  .home-search__input::placeholder {
    color: var(--_tokens---color--muted);
    -webkit-text-fill-color: var(--_tokens---color--muted);
  }
  .home-search__input:focus,
  .home-search__input:not(:placeholder-shown),
  .home-search__input.is-active {
    opacity: 1; /* activated on focus / input */
    background: color-mix(in srgb, var(--_tokens---color--fg) 10%, transparent);
  }

  .home-search__clear {
    position: absolute;
    right: 6px;
    top: 50%;
    transform: translateY(-50%);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    color: var(--_tokens---color--muted);
    background: none;
    border: none;
    border-radius: 50%;
    padding: 0;
    cursor: pointer;
    opacity: 0.35; /* grayed out by default */
    transition: background-color var(--_tokens---motion--base), color var(--_tokens---motion--base), opacity var(--_tokens---motion--base) ease;
  }

  .qs-clear-icon {
    --icon-size: 16px;
    flex-shrink: 0;
  
  }

  .home-search__input:focus ~ .home-search__clear, .home-search__input:not(:placeholder-shown) ~ .home-search__clear {
    opacity: 1; /* activated on search/hover */
  }
  @media (hover: hover) {
    .home-search__clear:hover {
    opacity: 1; /* activated on search/hover */
  }
  }

  @media (hover: hover) {
    .home-search__clear:hover {
    background-color: var(--_tokens---color--fg);
    color: var(--_tokens---color--bg);
  }
  }

  @media (max-width: 1023.98px) {
    .home-search-footer {
      padding-top: 16px !important;
      padding-bottom: 24px !important;
    }
  }

  /* ── Desktop: the bar is fixed at the bottom of the window ─────────────
     On every page with a footer the Quick Search bar (Pages docked at its
     right end) sits fixed at the bottom, and the footer itself takes no room
     in the page. */
  @media (min-width: 1024px) {
    .home-search-footer,
    .home-search-footer:not(.home-search-footer--embedded) {
      border-top: none;
      padding: 0;
      margin: 0;
    }

    .home-search__bar {
      position: fixed;
      bottom: 0;
      left: var(--_tokens---layout--nav, 0px);
      right: 0;
      z-index: 80;
      background-color: var(--_tokens---color--bg);
      border-top: 1px solid var(--_tokens---color--line-soft);
      padding-inline: var(--_tokens---layout--gutter);
      padding-block: 12px;
      margin: 0;
      box-sizing: border-box;
    }

    .qs-sug {
      left: var(--_tokens---layout--gutter);
      right: var(--_tokens---layout--gutter);
    }

    /* Page content must end above the fixed bar. */
    :global(.page-main:has(.home-search__bar)) {
      padding-bottom: 96px;
    }
  }

</style>

<script>
  import { matchesSkill } from '../lib/skills';

  // Enter takes the query where its answer is: the best-matching project's
  // own page; a skill to About's Skillset, filtered to it; and only with
  // neither, /projects filtered by ?q=. On About this field IS the
  // Skillset's search (about.astro filters the cloud as you type), so there
  // Enter with a skill only brings the Skillset into view.
  // Escape and the ✕ clear the field.
  const onAbout = () => (window.location.pathname.replace(/\/$/, '') || '/') === '/about';

  function initQuickSearch() {
    const input = document.getElementById('qs-input') as HTMLInputElement | null;
    const clearBtn = document.getElementById('qs-clear');
    if (!input || input.dataset.qsInit) return;
    input.dataset.qsInit = '1';

    const sync = () => input.classList.toggle('is-active', !!input.value.trim());
    input.addEventListener('input', sync);

    // Suggestions: every keyword must appear in a project's search text.
    // On About the same field also filters the Skillset below (about.astro),
    // so a query there narrows both at once: skills in the cloud, projects
    // in the panel over the bar.
    const sug = document.getElementById('qs-sug');
    const pills = Array.from(sug?.querySelectorAll<HTMLAnchorElement>('.qs-sug__pill') ?? []);
    /* Rank a matching project by how its NAME answers the query: the name
       itself, then a name that starts with it, then a word in the name that
       does, then everything that only matched its other text. The top one
       is what Enter opens, so it is shown first and marked. */
    const rank = (pl: HTMLAnchorElement, q: string) => {
      const name = (pl.title || '').toLowerCase();
      const label = (pl.textContent || '').trim().toLowerCase();
      if (name === q || label === q) return 0;
      if (name.startsWith(q) || label.startsWith(q)) return 1;
      if (name.split(/\s+/).some(w => w.startsWith(q))) return 2;
      return 3;
    };
    let ranked: HTMLAnchorElement[] = [];
    let sel = 0;
    const mark = () => pills.forEach(pl => pl.classList.toggle('is-sel', pl === ranked[sel]));
    const suggest = () => {
      if (!sug) return;
      const q = input.value.trim().toLowerCase();
      const kws = q.split(/\s+/).filter(Boolean);
      ranked = [];
      pills.forEach(pl => {
        const on = kws.length > 0 && kws.every(k => (pl.dataset.hay ?? '').includes(k));
        pl.hidden = !on;
        if (on) ranked.push(pl);
      });
      ranked.sort((a, b) => rank(a, q) - rank(b, q));
      ranked.forEach((pl, i) => { pl.style.order = String(i); });
      sel = 0;
      mark();
      sug.hidden = !ranked.length;
    };
    input.addEventListener('input', suggest);
    input.addEventListener('focus', suggest);
    // Close when focus leaves the bar, but let a click on a pill land first.
    input.addEventListener('blur', () => setTimeout(() => {
      if (sug && !sug.contains(document.activeElement)) sug.hidden = true;
    }, 150));

    input.addEventListener('keydown', (e) => {
      if ((e.key === 'ArrowDown' || e.key === 'ArrowUp') && ranked.length) {
        e.preventDefault();
        sel = (sel + (e.key === 'ArrowDown' ? 1 : -1) + ranked.length) % ranked.length;
        mark();
        ranked[sel].scrollIntoView({ block: 'nearest' });
        return;
      }
      if (e.key === 'Enter') {
        const q = input.value.trim();
        if (!q) return;
        e.preventDefault();
        /* Enter opens the project itself — the one marked in the
           suggestions. A skill goes to About only when no project NAME
           answers the query; with neither, the Database list is the answer. */
        const top = ranked[sel];
        if (top && (rank(top, q.toLowerCase()) < 3 || !matchesSkill(q))) {
          window.location.href = top.href;
          return;
        }
        if (matchesSkill(q)) {
          if (onAbout()) {
            document.querySelector('.skillset-header')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
          } else {
            window.location.href = `/about?skill=${encodeURIComponent(q)}`;
          }
          return;
        }
        window.location.href = `/projects?q=${encodeURIComponent(q)}`;
      } else if (e.key === 'Escape') {
        input.value = '';
        input.dispatchEvent(new Event('input', { bubbles: true }));
        input.blur();
      }
    });

    clearBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      input.value = '';
      input.dispatchEvent(new Event('input', { bubbles: true }));
      input.focus();
    });
  }

  initQuickSearch();
  document.addEventListener('astro:after-swap', initQuickSearch);
</script>
